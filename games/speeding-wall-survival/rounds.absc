-- rounds.absc — ラウンド: 全員アリーナへ → カベが次々 → 最後の1人（1人のときは記録）

let started_with = 0

func prepare()
  clear_walls()
  wave = 0
  let i = 0
  for p in rnd_players() do
    i = i + 1
    p.wall_state = "in"
    p.shield = p.start_shield == true
    p.size = 1
    p.jump = 1
    p.speed = base_speed(p)
    p.teleport(block("Arena Spot " + ((i - 1) % 16 + 1)))
  end
  started_with = i
  ui_remove("wall_wave")
end

func begin()
  after(1, func() launch_wall() end)
end

func round_over_check()
  if not rnd_playing() then return true end
  let left = len(alive_in())
  if left == 0 or (started_with >= 2 and left <= 1) then
    rnd_end("done")
    return true
  end
  return false
end

func results(reason)
  clear_walls()
  ui_remove("wall_wave")
  let lines = []
  let winners = alive_in()
  let title = "🧱 " + wave + " まいめで終了"
  for p in winners do
    p.wins = (p.wins or 0) + 1
    p.score = p.score + 1
    kit_give(p, WIN_COINS)
    kit_quest_progress(p, "win", 1)
    if wave >= 20 then kit_badge(p, "wall20", "カベ20まい") end
    append(lines, "🏆 " + p.name + " — 生きのこり！ +" + WIN_COINS)
  end
  if len(winners) == 1 and started_with >= 2 then title = "🏆 " + winners[1].name + " の勝ち！（" + wave + "まい）" end
  for p in rnd_players() do
    leaderboard("walls_best", p, p.best_wave or 0)
    if p.wall_state != "in" then append(lines, "💥 " + p.name) end
    p.wall_state = nil
    p.size = 1
    p.jump = 1
    p.speed = base_speed(p)
    p.teleport(block("Spawn " + random(1, 8)))
  end
  rnd_results(title, lines)
end

on leave(p)
  if rnd_playing() then
    after(0.1, func()
      round_over_check()
    end)
  end
end
