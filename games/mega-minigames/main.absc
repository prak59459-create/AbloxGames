-- Mega Minigames — 投票で次のゲームを決めるパーティー。12種類のミニゲームで⭐を集めて総合優勝！
--
-- ファイル:
--   data.absc    ミニゲーム12種・色
--   common.absc  状態・画面
--   games.absc   12のミニゲームのしくみ
--   match.absc   投票・結果・総合優勝
--   main.absc    このファイル

kit_setup("Mega Minigames", "投票して、遊んで、⭐を集めよう", [
  "🗳 3つの中から次のミニゲームを投票で決める",
  "🏅 1位 ⭐3・2位 ⭐2・3位 ⭐1。生きのこり系は最後まで残った人みんなが1位",
  "🎮 10ゲームで⭐がいちばん多い人が総合優勝！",
  "🟥 落ちる床・⛰ 山の王・🎨 色あわせ・☄️ 玉よけ・🔨 ハンマーよけ・🥚 たまご集め",
  "🏃 リレー・🖌 床ぬり・🎯 的当て・🐔 にわとりつかまえ・🪑 いすとり・💣 ばくだんパス"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["game_wins"])


kit_quest("win3", "ミニゲームで3回1位", 3, 200)
kit_quest("play10", "10ゲーム遊ぶ", 10, 150)
kit_quest("champ", "総合優勝する", 1, 800)

kit_shop_title = "パーティーグッズ"
kit_shop_add("cap", "🧢 キャップ", 100, func(p) p.hat = "cap" end)
kit_shop_add("antenna", "📡 アンテナ", 200, func(p) p.hat = "antenna" end)
kit_shop_add("halo", "😇 天使の輪", 500, func(p) p.hat = "halo" end)
kit_shop_add("party", "🎉 パーティーの服", 300, func(p)
  p.color = "#F472B6"
  p.leg_color = "#7C3AED"
end)

on start()
  every(10, func() kit_leaderboard("⭐") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.stars = 0
  p.game_wins = 0
  p.playing = false
  p.g_score = 0
  kit_give(p, 20)
  p.teleport(lobby_spot())
  if phase == "vote" then vote_panel(p) end
  if phase == "play" then p.message("🎮 いまゲーム中。次のゲームから参加！", 2) end
end
