-- Toy Factory Night Shift — おもちゃ工場の夜間警備。カメラで見張って、ドアを閉めて、朝6時まで耐える。
--
-- ファイル:
--   data.absc     おもちゃ・夜ごとのかしこさ・カメラ・警備用品
--   common.absc   夜の状態・電力・画面
--   cameras.absc  9台のカメラ・オルゴールのねじ巻き
--   office.absc   ドア・ライト・通気口・停電・持ち場・警備用品
--   shift.absc    夜の流れ（12AM → 6AM）
--   toys.absc     ボブ・リリ・コッコ・ルー・ポチ・ジャック・まぼろし
--   main.absc     このファイル

kit_setup("Toy Factory Night Shift", "朝6時まで耐えろ。6夜目はナイトメア", [
  "🏢 警備室から出ずに、12AM から 6AM まで耐える。電力がなくなると停電…",
  "📷 カメラ（9台）でおもちゃの場所を見る。ドアの前は死角 → 💡 ライトで確かめて 🚪 ドアを閉める",
  "🦊 ルーは見られていないとおもちゃ箱から出てくる。ときどきカメラ3を見よう",
  "🎁 オルゴールが止まるとびっくり箱が開く。カメラ8で 🎵 ねじを巻きつづけて",
  "🌀 3夜目から通気口にも。👻 まぼろしが見えたらすぐカメラを上げる",
  "🛒 警備用品で電力やカメラを強くしよう。みんなで役わりを分けると強い！"
])

kit_currency = "コイン"
kit_shop_title = "制服"
kit_shop_add("cap", "🧢 警備員の帽子", 40, func(p)
  p.hat = "cap"
  p.color = "#1E3A8A"
end)
kit_shop_add("antenna", "📡 アンテナ", 80, func(p) p.hat = "antenna" end)
kit_shop_add("crown", "👑 夜のボス", 500, func(p) p.hat = "crown" end)

kit_quest("nights", "夜を3回のりきる", 3, 300)
kit_quest("block", "ドアで10回追い返す", 10, 150)
kit_quest("cams", "カメラを20回見る", 20, 60)
kit_quest("wind", "オルゴールのねじを30回巻く", 30, 80)
kit_quest("doors", "ドアを20回しめる", 20, 50)
kit_quest("phantom", "まぼろしを消す", 1, 80)
kit_quest("upgrade", "警備用品を2つ買う", 2, 100)

on start()
  game.respawn_time = 3
  after(3, func() start_night(1) end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_give(p, 20)
  p.cam = 0
  p.away_since = 0
  p.ui_button("shop_open", "🛒 警備用品", {at: "right", dy: 180, w: 150, h: 46, size: 16, bg: "#0E7490"})
  buttons_hud(p)
  shift_hud()
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Spawn " + random(1, 6)).position + {x: 0, y: 1, z: 0})
end
