-- Slime Roll — 運でスライムを引いて、いっしょに戦ってかせぐ
-- ロールでスライムを引く → つけると横について敵をこうげき → コインとゼリーで強化・お守り・新しいゾーン。
--
-- ファイル:
--   data.absc     表（スライム・へんい・天気・ゾーン・強化・ポーション・お守り・図鑑）
--   common.absc   運・速さ・コイン・力の計算、画面の上
--   roll.absc     ロール・演出・オートロール
--   bag.absc      バッグ・つける・売る・フュージョン
--   buddies.absc  ついてくるスライムとこうげき
--   zones.absc    ゾーン・敵・ボス・ワープ・広場のパッド
--   shop.absc     強化とポーション
--   craft.absc    お守りのクラフト
--   index.absc    図鑑とごほうび
--   weather.absc  天気
--   main.absc     このファイル

kit_setup("Slime Roll", "100万分の1のスライムを引き当てろ", [
  "🎲 ロールでスライムを引く。レアなほど強い（10回ごとに運×2）",
  "🐾 つけたスライムがついてきて、近くの敵を勝手にこうげき",
  "🌿 北の草原で戦おう。🪙コインと🟢ゼリーが手に入る",
  "⬆ 強化・🧪ポーション・🔨お守り・🔷フュージョンは広場のパッドで",
  "🏜 さばく・🌋かざん・☁空の島は、パッドからコインで開けてワープ",
  "🌧 天気が変わると、その天気だけのスライムが出る",
  "👑 4分ごとにボス！ こうげきした人みんなでごほうび"
])

kit_quest("roll100", "100回ロールする", 100, 100)
kit_quest("roll1000", "1000回ロールする", 1000, 3000)
kit_quest("species", "10しゅるい見つける", 10, 1000)
kit_quest("rare", "1/1000 より レアを引く", 1, 800)
kit_quest("kill", "敵を50たおす", 50, 500)
kit_quest("boss", "ボスをたおす", 1, 2000)
kit_quest("upgrade", "強化を5回", 5, 400)
kit_quest("potion", "ポーションを使う", 1, 100)
kit_quest("craft", "お守りを作る", 1, 1000)
kit_quest("fuse", "フュージョンする", 1, 300)
kit_quest("sell", "スライムを売る", 1, 20)
kit_quest("zone", "新しいゾーンを開ける", 1, 1500)

on start()
  setup_zones()
  set_weather(WEATHERS[1])
  every(10, func() kit_leaderboard("📖") end)
end

on join(p)
  kit_welcome(p)
  p.ups = {}
  p.pots = {}
  p.heaven = 0
  p.bag = []
  p.equipped = []
  p.auto_equip = true
  p.auto_sell = 1
  p.index = {}
  p.index_done = []
  p.index_luck = 0
  p.found = 0
  p.jelly = {}
  p.charms = []
  p.charms_on = []
  p.zones = ["grass"]
  p.rolls = 0
  p.auto = false
  p.auto_on = false
  kit_give(p, 0)
  p.ui_button("roll", "🎲 ロール", {at: "bottom", dy: -100, w: 200, h: 64, size: 24, bg: "#7C3AED", radius: 20})
  p.ui_button("open_bag", "🎒 バッグ", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#78350F"})
  p.ui_button("open_index", "📖 図鑑", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end

on leave(p)
  clear_buddies(p.id)
  remove(buddies, p.id)
end

on respawn(p)
  if p.is_npc then return end
  -- たおれたら広場にもどる。スライムもいっしょに
  kit_later(p, 0.5, func() refresh_buddies(p) end)
end
