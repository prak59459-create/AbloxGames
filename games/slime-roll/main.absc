-- Slime Roll — 運でスライムを引いて、戦わせてかせぐ

kit_setup("Slime Roll", "100万分の1のスライムを引き当てろ", [
  "「ロール」ボタンでスライムを引く（レアほど強い）",
  "いちばん強いスライムがついてきて、草原の敵と勝手に戦う",
  "敵をたおすとコイン。コインで運やロールの速さを強化",
  "「図鑑」で集めたスライムを見られます",
  "とてもレアなスライムはみんなにお知らせされる"
])

let slimes = [
  {name: "みどりスライム", chance: 2, power: 1, color: "#4ADE80"},
  {name: "あおスライム", chance: 4, power: 2, color: "#60A5FA"},
  {name: "あかスライム", chance: 8, power: 4, color: "#F87171"},
  {name: "きいろスライム", chance: 16, power: 7, color: "#FACC15"},
  {name: "むらさきスライム", chance: 40, power: 12, color: "#A78BFA"},
  {name: "メタルスライム", chance: 100, power: 25, color: "#CBD5E1"},
  {name: "ほのおスライム", chance: 250, power: 45, color: "#F97316"},
  {name: "こおりスライム", chance: 600, power: 80, color: "#A5F3FC"},
  {name: "かみなりスライム", chance: 1500, power: 150, color: "#FDE047"},
  {name: "ゴールドスライム", chance: 4000, power: 300, color: "#F59E0B"},
  {name: "にじいろスライム", chance: 12000, power: 700, color: "#F0ABFC"},
  {name: "ギャラクシースライム", chance: 50000, power: 2000, color: "#6D28D9"},
  {name: "キングスライム", chance: 200000, power: 6000, color: "#DC2626"},
  {name: "かみさまスライム", chance: 1000000, power: 25000, color: "#FFFFFF"}
]
for s in slimes do s.weight = 1 / s.chance end
let buddies = {}

kit_shop_add("luck1", "運 +25%（ずっと）", 150, func(p)
  p.luck = p.luck + 0.25
  show(p)
end)
kit_shop_add("fast", "ロールが速くなる", 300, func(p)
  p.roll_cd = max(0.4, p.roll_cd - 0.3)
  show(p)
end)
kit_shop_add("auto", "オートロール", 1500, func(p) p.auto = true end)
kit_shop_add("potion", "運ポーション（60秒 ×3）", 400, func(p)
  p.potion_until = time() + 60
  show(p)
end)

func luck(p)
  let l = p.luck
  if p.potion_until != nil and time() < p.potion_until then l = l * 3 end
  return l
end

func show(p)
  let best = p.best
  let text = "🍀 運 ×" + fixed(luck(p), 2) + "   ⏱ " + fixed(p.roll_cd, 1) + "秒"
  if best != nil then text = text + "   ⭐ " + best.name + "（1/" + kit_short(best.chance) + "）" end
  p.ui_text("stats", text, {at: "top", dy: 30, size: 16, bold: true})
end

func equip(p)
  let old = buddies[p.id]
  if old != nil and kit_here(old) then old.destroy() end
  let s = p.best
  if s == nil then return end
  let size = 0.5 + min(1.5, log(s.chance) / 10)
  let n = create_npc({name: p.name + "の" + s.name, position: p.position + {x: 1.5, y: 0.5, z: 0}, color: s.color,
                      head_color: s.color, size: size, health: 999999, speed: 1.3, team: "slimes"})
  n.owner = p.id
  n.power = s.power
  n.follow(p)
  buddies[p.id] = n
end

func roll(p)
  if not kit_ready(p, "roll", p.roll_cd) then return end
  -- 運は「レアの重さを持ち上げる」
  let l = luck(p)
  let total = 0
  for s in slimes do total = total + s.weight * pow(s.chance, min(0.5, (l - 1) * 0.1)) end
  let r = random() * total
  let got = slimes[1]
  for s in slimes do
    r = r - s.weight * pow(s.chance, min(0.5, (l - 1) * 0.1))
    if r <= 0 then
      got = s
      break
    end
  end
  p.index[got.name] = (p.index[got.name] or 0) + 1
  p.ui_text("rolled", "🎲 " + got.name + "（1/" + kit_short(got.chance) + "）", {at: "center", dy: -140, size: 26, bold: true, color: got.color})
  kit_later(p, 1.5, func() p.ui_remove("rolled") end)
  if got.chance >= 1000 then
    announce("🌟 " + p.name + " が " + got.name + "（1/" + kit_short(got.chance) + "）を引いた！", 4)
    p.fade(got.color, 0.15)
    kit_later(p, 0.3, func() p.fade(nil, 1) end)
    sound("goal")
  else
    p.sound("collect")
  end
  if p.best == nil or got.power > p.best.power then
    p.best = got
    equip(p)
  end
  p.score = len(keys(p.index))
  show(p)
end

func open_index(p)
  let h = 120 + len(slimes) * 26
  p.ui_panel("index", {at: "center", w: 460, h: h, bg: "#0F172AF0", radius: 20, layer: 30})
  p.ui_text("index_t", "📖 スライム図鑑", {parent: "index", y: 26 / h, size: 22, bold: true})
  let i = 0
  for s in slimes do
    i = i + 1
    let n = p.index[s.name] or 0
    let label = n > 0 and (s.name + " ×" + n) or "？？？"
    p.ui_text("idx" + i, label + "  （1/" + kit_short(s.chance) + "）", {parent: "index", y: (40 + i * 26) / h, size: 15, color: n > 0 and s.color or "#64748B"})
  end
  p.ui_button("index_close", "閉じる", {parent: "index", y: (h - 26) / h, w: 120, h: 38, size: 15, bg: "gray"})
end

func spawn_blob(i)
  let spot = block("Blob Spot " + i)
  let n = create_npc({name: "わるいブロブ", position: spot.position + {x: 0, y: 1, z: 0}, color: "#334155", head_color: "#0F172A",
                      health: 40 + random(0, 60), speed: 0.2, team: "blobs"})
  n.spot = i
end

on start()
  for i in 1 to 8 do spawn_blob(i) end
  every(1, func()
    for p in players() do
      if p.auto then roll(p) end
    end
    -- スライムが近くの敵をこうげき
    for n in npcs() do
      if n.owner != nil then
        let target = nil
        for b in npcs() do
          if b.spot != nil and distance(n, b) < 14 then target = b end
        end
        if target != nil then
          target.damage(n.power, n)
        end
      end
    end
  end)
  every(10, func() kit_leaderboard("📖") end)
end

on join(p)
  kit_welcome(p)
  p.luck = 1
  p.roll_cd = 1.6
  p.index = {}
  kit_give(p, 0)
  kit_shop_button(p)
  p.ui_button("roll", "🎲 ロール", {at: "bottom", dy: -100, w: 200, h: 64, size: 24, bg: "#7C3AED", radius: 20})
  p.ui_button("open_index", "📖 図鑑", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  show(p)
end

on leave(p)
  let n = buddies[p.id]
  if n != nil and kit_here(n) then n.destroy() end
  remove(buddies, p.id)
end

on button(p, id)
  if id == "roll" then roll(p)
  elif id == "open_index" then open_index(p)
  elif id == "index_close" then p.ui_remove("index")
  end
end

on death(victim, killer)
  if victim.spot != nil then
    let i = victim.spot
    after(4, func() spawn_blob(i) end)
    if killer != nil and killer.owner != nil then
      let owner = nil
      for p in players() do
        if p.id == killer.owner then owner = p end
      end
      if owner != nil then kit_give(owner, 5 + floor(killer.power / 2)) end
    end
  end
end
