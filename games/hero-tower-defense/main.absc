-- Hero Tower Defense — ヒーローを置いて城を守る
-- 難易度を投票 → 道ばたの台にヒーローを置く → ウェーブをたおしてお金 → 強化。
-- 試合のおわりにジェム。ジェムでヒーローの館から新しいヒーローを解放できる。
--
-- ファイル:
--   data.absc     表（ヒーロー12・敵9・ボス8・難易度・ねらい方）
--   common.absc   小さな道具
--   enemies.absc  敵の出現・道・とくしゅな敵・ボス
--   heroes.absc   ヒーローを置く・強化・売る・ねらい方
--   combat.absc   ヒーローのこうげきと司令官の強化
--   waves.absc    投票・ウェーブ・勝ち負け
--   lobby.absc    ヒーローの館（解放・持っていく5体）
--   stats.absc    まとめと成績
--   main.absc     このファイル

kit_setup("Hero Tower Defense", "ヒーローを置いて、敵の大群から城を守れ", [
  "🗳 はじめに難易度を投票（かんたん・ふつう・むずかしい・エンドレス）",
  "👇 下のボタンでヒーローをえらび、道ばたの灰色の台にさわって置く",
  "⬆ 自分のヒーローの台にもう一度さわると、強化・売る・ねらい方",
  "🦇 空の敵は剣士・ほのお・守護騎士・大砲では当たらない",
  "👻 透明の敵は スナイパー・天使・Lv4以上・司令官のそば だけが見える",
  "💰 商人でお金をかせぎ、📯 司令官でまわりを強化",
  "💎 試合のおわりにジェム。🏛 ヒーローの館で新しいヒーローを解放"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["gems", "owned", "loadout", "selected"])
kit_save_coins = false  -- コインは1回の防衛戦の中だけのお金

kit_quest("place", "ヒーローを10体置く", 10, 100)
kit_quest("upgrade", "強化を10回", 10, 150)
kit_quest("max", "ヒーローを最大レベルに", 1, 200)
kit_quest("kill", "敵を300体たおす", 300, 300)
kit_quest("waves", "ウェーブを20回クリア", 20, 200)
kit_quest("boss", "ボスをたおす", 1, 200)
kit_quest("farm", "商人で1000かせぐ", 1000, 150)
kit_quest("unlock", "ヒーローを解放する", 1, 100)
kit_quest("win", "どれかの難易度をクリア", 1, 300)
kit_quest("win_hard", "むずかしいをクリア", 1, 1000)

func round_reset(p)
  p.dmg = 0
  p.kills = 0
  p.placed = 0
  p.farmed = 0
  p.panel_spot = nil
  p.ui_remove("hero_box")
  p.ui_remove("sum_box")
  p.ui_remove("skip")
end

on start()
  clear_heroes()
  clear_enemies()
  for p in players() do
    if ready(p) then round_reset(p) end
  end
  start_vote()
end

on join(p)
  kit_welcome(p)
  p.gems = 0
  p.owned = ["sword", "bow", "magic", "merchant"]
  p.loadout = ["sword", "bow", "magic", "merchant"]
  p.selected = "sword"
  round_reset(p)
  if phase == "play" then
    -- 途中から: 今のウェーブにあわせたお金
    p.coins = mode.money + wave * 60
  else
    p.coins = mode.money
  end
  kit_show_money(p)
  hotbar(p)
  p.ui_button("hall", "🏛 ヒーロー", {at: "right", dy: -60, w: 150, h: 50, size: 16, bg: "#B45309"})
  p.ui_button("stats", "📊", {at: "top_right", dy: 180, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  kit_quest_button(p)
  kit_camera_button(p)
  if phase == "vote" then vote_buttons(p) end
  show_game()
end

on leave(p)
  -- その人のヒーローはいなくなる
  for n in heroes_of(p) do
    remove(heroes, n.spot)
    kit_gone(n)
  end
end
