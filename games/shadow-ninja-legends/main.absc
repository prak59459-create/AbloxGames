-- Shadow Ninja Legends — 影の忍者をめざせ
-- ⚔️ をタップして にんじゅつをためる（帯がいっぱいになるまで）。⛩ 黄色いパッド（ほこら）で売ってお金。
-- 売った合計でランクが上がり、💨 空中ジャンプの回数がふえる。空の島ほど 修行も売りねも ×大きく。
--
-- ファイル:
--   ../../lib/kit_sim.absc  タップ・帯・ショップ・たまご・ペット・生まれかわり
--   data.absc    刀・帯・たまご・ランク・島
--   ninja.absc   ランク・空中ジャンプ・島・ほこら・たからばこ
--   main.absc    このファイル

kit_setup("Shadow Ninja Legends", "刀をふって、空の修行島へ！", [
  "⚔️ 右下のボタンをタップして にんじゅつ をためる（帯がいっぱいになるまで）",
  "⛩ 黄色いパッドで売ると お金。売った合計でランクが上がる",
  "💨 空中ジャンプ: ランクが上がると回数がふえる。てっぺんで もう一度おすと高くとべる",
  "☁️ 空の島では 修行 ×2〜×32、売りねも ×2〜×32",
  "🛒 ショップで 刀と帯。🥚 たまごでペット",
  "🧰 島のたからばこ をわすれずに"
])
kit_keep(["chests", "isles"])

kit_quest("sell", "ほこらで3回 売る", 3, 80)
kit_quest("sim_tool", "刀を買う", 1, 60)
kit_quest("rank", "ランクを上げる", 1, 200)
kit_quest("island", "空の島の たからばこ", 1, 200)
kit_quest("sim_hatch", "たまごをかえす", 1, 100)

on join(p)
  kit_welcome(p)
  kit_show_money(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.camera_distance = 10
  p.hat = "headband"
  p.ui_button("air_jump", "💨 ジャンプ", {at: "bottom_right", dx: -180, dy: -200, w: 110, h: 90, size: 17, bg: "#1E293B", radius: 26})
end

on start()
  world.music = "adventure"
  every(12, func() kit_leaderboard("🥷 にんじゅつ") end)
end
