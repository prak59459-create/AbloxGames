-- Oni Blade — 夜にあらわれる鬼を斬る剣士のRPG
-- 昼: カカシと滝で修行・村の依頼・鍛冶場で刀をきたえる。夜: 鬼が村の家をこわしに来る。
-- 流派7つ（型5つずつ・熟練）、闘気解放、ステータス、刀5段階、階級（十級〜剣聖）。
-- 4夜ごとに神社へ昔話の鬼の大将（土蜘蛛・雷獣・茨木童子・酒呑童子）。
--
-- ファイル:
--   data.absc     表（刀・流派と型・階級・鬼・大将・依頼）
--   common.absc   小さな道具・エフェクト・画面の左上
--   combat.absc   ダメージ・気・闘気・経験値
--   forms.absc    流派の型（7 × 5）・ボタン
--   oni.absc      夜の鬼（出現・動き・たおしたとき）
--   bosses.absc   鬼の大将
--   village.absc  昼夜・家・カカシ・滝行・依頼
--   menus.absc    流派・ステータス・鍛冶場・道具・掲示板の画面
--   main.absc     このファイル

kit_setup("Oni Blade", "流派の型をきわめ、鬼の大将を討て", [
  "☀️ 昼: 訓練場のカカシ・滝の石で修行。掲示板（黄色）で村の依頼",
  "🌙 夜: 森から鬼が来て村の家をこわす。家を守りきると夜明けのごほうびが増える",
  "📜 レベル3で流派を選ぶ（道場のピンクのマット）。型はレベル3・8・14・22・30で増える",
  "🔥 攻撃すると闘気がたまる。MAXで「闘気解放」（15びょう強く・気が半分）",
  "⚒ 鍛冶場（オレンジ）: 両と鬼の角・妖石で刀をきたえる",
  "⛩ 4夜ごとに神社へ鬼の大将。討てば妖石と「月影流派」",
  "🛡 鎧の鬼はしびれさせるか岩砕流派でくだくと斬りやすい"
])
kit_currency = "両"
kit_level_base = 40
for b in BLADES do kit_melee(b.name, b.dmg, 2.4, 6) end

kit_quest("school", "流派を選ぶ", 1, 100)
kit_quest("oni10", "鬼を10体たおす", 10, 200)
kit_quest("oni100", "鬼を100体たおす", 100, 1500)
kit_quest("forms", "型を50回使う", 50, 300)
kit_quest("ougi", "奥義を使う", 1, 500)
kit_quest("awaken", "闘気解放を5回", 5, 250)
kit_quest("forge", "刀をきたえる", 1, 150)
kit_quest("forge3", "刀を3回きたえる", 3, 1000)
kit_quest("boss", "鬼の大将を討つ", 1, 1500)
kit_quest("defend", "家をひとつもこわされずに夜明け", 1, 300)
kit_quest("chores", "村の依頼を5つ", 5, 300)
kit_quest("waterfall", "滝行を10回", 10, 250)
kit_quest("lv10", "レベル10になる", 9, 300)
kit_quest("lv30", "レベル30になる", 29, 1500)
kit_quest("mastery", "流派の熟練を3回上げる", 3, 300)
kit_quest("rank", "階級「五級」になる", 1, 500)

kit_shop_title = "身なり"
kit_shop_add("h_cap", "笠", 200, func(p) set_hat(p, "cap") end)
kit_shop_add("h_ant", "角かざり", 400, func(p) set_hat(p, "antenna") end)
kit_shop_add("c_black", "黒の隊服", 300, func(p) p.color = "#111827" end)
kit_shop_add("c_white", "白の羽織", 300, func(p) p.color = "#F8FAFC" end)
kit_shop_add("c_green", "市松の羽織", 300, func(p) p.color = "#15803D" end)

func set_hat(p, hat)
  p.own_hat = hat
  if not active_until(p.awaken_until) then p.hat = hat end
end

on start()
  game.respawn_time = 6
  -- 前のラウンドのNPCは消す
  for n in npcs() do n.destroy() end
  setup_houses()
  sky_day()
  new_chores()
  spawn_chore_items()
  respawn_dummies()
  every(10, func() kit_leaderboard("👹") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.team = "slayer"
  p.level = 1
  p.xp = 0
  p.points = 0
  p.stats = {}
  p.smxp = {}
  p.kills = 0
  p.boss_kills = 0
  p.horns = 0
  p.stones = 0
  p.blade = 1
  p.ki = 100
  p.touki = 0
  p.fcd = {}
  p.btn = {}
  p.give(BLADES[1].name)
  kit_show_money(p)
  kit_show_level(p)
  p.ui_button("open_stats", "📊 ステータス", {at: "right", dy: -60, w: 150, h: 50, size: 16, bg: "#0F766E"})
  p.ui_button("open_items", "🎒 道具", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#15803D"})
  refresh_body(p)
  show_bars(p)
  hud(p)
  if night then p.message("🌙 いまは夜。鬼に気をつけて、まずは村の近くで戦おう", 3) end
end

on respawn(p)
  if not ready(p) then return end
  p.ki = max_ki(p)
  p.frozen = false
  p.visible = true
  p.poison_until = 0
  p.slow_until = 0
  refresh_body(p)
  p.heal(p.max_health)
  p.give(blade_of(p).name)
  show_bars(p)
end

on leave(p)
  if lost_child != nil and kit_here(lost_child) and lost_child.guide == p.id then lost_child.guide = nil end
end
