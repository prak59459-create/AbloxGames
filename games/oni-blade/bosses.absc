-- bosses.absc — 鬼の大将（4夜ごと・神社）
-- 土蜘蛛（糸・とびかかり・子蜘蛛・毒だまり）→ 雷獣（落雷・突進・ほうこう）→
-- 茨木童子（なぎはらい・たたきつけ・つかみ）→ 酒呑童子（酒の霧・炎の息・手下）。16夜で一巡し、次はもっと強い。
-- 体力が半分をきると怒って技が速くなる。夜明けまでに討てないと逃げる。
-- 討つと、当てたダメージに応じてごほうび。手伝った人みんなに妖石。

let boss = nil
let boss_clock = 0
let poison_pools = []

func boss_data_for(night_no)
  let idx = (floor(night_no / BOSS_EVERY) - 1) % len(BOSSES) + 1
  return BOSSES[idx]
end

func spawn_boss()
  let b = boss_data_for(nights)
  let spot = block("Boss Spot 1")
  if spot == nil then return end
  let cycle = floor((nights - 1) / (BOSS_EVERY * len(BOSSES)))
  let hp = b.hp * (1 + (fighters() - 1) * 0.5) * (1 + cycle * 0.6)
  let n = create_npc({name: b.name, position: spot.position + {x: 0, y: 2, z: 0}, color: b.color, head_color: b.head,
                      size: b.size, health: floor(hp), speed: 0.8, team: "oni"})
  n.kind = "boss"
  n.bid = b.id
  n.max_hp = hp
  n.dmg = b.dmg * (1 + cycle * 0.4)
  n.dmg_by = {}
  n.skill_i = 0
  n.next_skill = time() + 5
  n.next_hit = 0
  n.angry = false
  n.home = spot.position
  boss = n
  announce("⛩ 神社に鬼の大将「" + b.name + "」があらわれた！", 4)
  shake(0.4, 0.8)
end

func boss_dawn()
  if boss != nil and kit_here(boss) then
    announce("🌅 " + boss.name + " は夜明けとともに逃げていった…", 3)
    gone(boss)
  end
  boss = nil
  ui_remove("boss_hp")
  ui_remove("boss_name")
  poison_pools = []
  for n in npcs() do
    if n.kind == "oni" and n.minion then gone(n) end
  end
end

func boss_targets(n, range)
  return filter(players(), func(p) return ready(p) and p.alive and p.visible and distance(n, p) < range end)
end

func boss_area(n, center, r, amount, effect, power)
  for p in players() do
    if ready(p) and p.alive and distance(center, p) <= r then oni_hit(n, p, amount, effect, power) end
  end
end

func boss_minions()
  return filter(npcs(), func(c) return c.kind == "oni" and c.minion end)
end

-- MARK: 技

func boss_skill(n)
  let targets = boss_targets(n, 40)
  if len(targets) == 0 then return end
  let t = random(targets)
  let b = boss_data_for(nights)
  n.skill_i = n.skill_i % len(b.skills) + 1
  let skill = b.skills[n.skill_i]
  let d = n.dmg
  if skill == "web" then
    n.say("からめとってやる…")
    let spot = t.position
    let from = n.position + {x: 0, y: 2, z: 0}
    fx_beam(from, normalize(spot - from), distance(from, spot), "#F5F5F4", 0.3)
    after(0.4, func()
      if kit_here(n) and n.alive then
        fx_ring(spot, 3.5, "#E7E5E4", 1.5)
        boss_area(n, spot, 3.5, d * 0.6, "slow", 4)
      end
    end)
  elif skill == "leap" then
    n.say("キシャアア！")
    let dir = normalize({x: t.x - n.x, y: 0, z: t.z - n.z})
    let dist = min(26, distance(n, t))
    n.launch(dir.x * dist * 1.1, 13, dir.z * dist * 1.1)
    fx_warning(t.position, 6, 1)
    after(1, func()
      if kit_here(n) and n.alive then
        fx_ring(n.position, 6, b.head, 0.4)
        boss_area(n, n.position, 6, d * 1.2, "lift", 10)
      end
    end)
  elif skill == "spawn" or skill == "summon" then
    if len(boss_minions()) < 6 then
      if skill == "spawn" then n.say("子らよ、喰らえ") else n.say("者ども、かかれ！") end
      for k in 1 to 3 do
        let a = k * 120
        let pos = n.position + {x: cos(a) * 4, y: 0, z: sin(a) * 4}
        let m = nil
        if skill == "spawn" then m = spawn_oni("fast", pos, {name: "子蜘蛛", size: 0.7}) else m = spawn_oni(random(["basic", "armor"]), pos, nil) end
        m.minion = true
      end
    end
  elif skill == "poison" or skill == "mist" then
    if skill == "poison" then n.say("毒に沈め") else n.say("酒の霧に酔え…") end
    let count = 2
    if skill == "mist" then count = 3 end
    for k in 1 to count do
      let spot = random(targets).position + {x: random(-2, 2), y: 0, z: random(-2, 2)}
      if skill == "mist" then spot = n.position + {x: random(-8, 8), y: 0, z: random(-8, 8)} end
      let ring_b = fx_ring(spot, 4, "#65A30D", 6)
      append(poison_pools, {pos: spot, until: time() + 6, owner: n, dmg: d * 0.25})
    end
  elif skill == "bolt" then
    n.say("ゴロゴロ…")
    let k = 0
    for p in boss_targets(n, 35) do
      k = k + 1
      let spot = p.position
      let delay = 0.9 + k * 0.1
      fx_warning(spot, 3, delay)
      after(delay, func()
        if kit_here(n) and n.alive then
          let col = create_block({name: "FX", shape: "cylinder", position: spot + {x: 0, y: 10, z: 0}, size: {x: 1, y: 20, z: 1},
                                  color: "#FEF08A", material: "neon", solid: false, opacity: 0.8})
          after(0.25, func() gone(col) end)
          boss_area(n, spot, 3, d * 1.3, "stun", 0.6)
        end
      end)
    end
  elif skill == "dash" then
    n.say("ガアッ！")
    let from = n.position + {x: 0, y: 1, z: 0}
    let dir = normalize({x: t.x - n.x, y: 0, z: t.z - n.z})
    fx_beam(from, dir, 24, "#FDE047", 1.2)
    after(0.5, func()
      if kit_here(n) and n.alive then
        n.launch(dir.x * 34, 3, dir.z * 34)
        for p in players() do
          if ready(p) and p.alive and beam_distance(p.position + {x: 0, y: 1, z: 0}, from, dir, 24) < 2.5 then oni_hit(n, p, d * 1.2, "knock", 18) end
        end
      end
    end)
  elif skill == "roar" then
    n.say("オオオオオ！！")
    fx_ring(n.position, 12, b.head, 0.6)
    for p in boss_targets(n, 12) do oni_hit(n, p, d * 0.3, "stun", 1.2) end
    n.guard_until = time() + 3
  elif skill == "swipe" then
    n.say("なぎはらえ！")
    n.look_at(t)
    let dir = normalize({x: t.x - n.x, y: 0, z: t.z - n.z})
    let center = n.position + dir * 4
    fx_warning(center, 4.5, 0.7)
    after(0.7, func()
      if kit_here(n) and n.alive then
        fx_ring(center, 4.5, "#B91C1C", 0.3)
        boss_area(n, center, 4.5, d * 1.5, "knock", 18)
      end
    end)
  elif skill == "slam" then
    n.say("つぶれろ！")
    let spot = n.position
    fx_warning(spot, 7, 1)
    after(1, func()
      if kit_here(n) and n.alive then
        fx_ring(spot, 7, b.head, 0.4)
        boss_area(n, spot, 7, d * 1.8, "lift", 12)
        shake(0.3, 0.4)
      end
    end)
  elif skill == "grab" then
    let near = nil
    for p in boss_targets(n, 9) do
      if near == nil or distance(n, p) < distance(n, near) then near = p end
    end
    if near != nil then
      n.say("つかまえた…")
      near.frozen = true
      near.message("👺 つかまれた！（仲間が大将を攻撃するとはなす）", 1.5)
      let hp_then = n.health
      for k in 1 to 3 do
        after(k * 0.6, func()
          if kit_here(n) and n.alive and kit_here(near) and near.alive and n.health > hp_then - n.max_hp * 0.02 then
            oni_hit(n, near, d * 0.8, nil, 0)
          end
        end)
      end
      after(2, func() if kit_here(near) then near.frozen = false end end)
    end
  elif skill == "breath" then
    n.say("燃えろ！")
    n.look_at(t)
    let from = n.position + {x: 0, y: 2.5, z: 0}
    let dir = normalize(t.position + {x: 0, y: 1, z: 0} - from)
    fx_beam(from, dir, 20, "#FDBA74", 0.4)
    after(0.7, func()
      if kit_here(n) and n.alive then
        fx_beam(from, dir, 20, "#EA580C", 3)
        for p in players() do
          if ready(p) and p.alive and beam_distance(p.position + {x: 0, y: 1, z: 0}, from, dir, 20) < 2.5 then oni_hit(n, p, d * 1.6, "poison", 3) end
        end
      end
    end)
  end
end

func boss_step(n)
  let t = nil
  for p in boss_targets(n, 45) do
    if distance(p, n.home) < 45 and (t == nil or distance(n, p) < distance(n, t)) then t = p end
  end
  if t != nil then
    n.follow(t)
    if distance(n, t) < 2.5 + n.size * 0.7 and time() > n.next_hit then
      oni_hit(n, t, n.dmg, "knock", 14)
      n.next_hit = time() + 1.3
    end
  elif distance(n, n.home) > 6 then
    n.move_to(n.home)
  else
    n.stop()
  end
  if kit_here(n) and n.alive and not n.angry and n.health < n.max_hp / 2 then
    n.angry = true
    n.speed = 1.05
    announce("🔥 " + n.name + " が怒りくるった！ 技が速くなる！", 3)
  end
  if kit_here(n) and n.alive and time() >= n.next_skill then
    boss_skill(n)
    if kit_here(n) then
      if n.angry then n.next_skill = time() + 3 else n.next_skill = time() + 4.5 end
    end
  end
end

on tick(dt)
  boss_clock = boss_clock + dt
  if boss_clock < 0.25 then return end
  boss_clock = 0
  -- 毒だまり
  if len(poison_pools) > 0 then
    poison_pools = filter(poison_pools, func(pp) return pp.until > time() end)
    for pp in poison_pools do
      if kit_here(pp.owner) and pp.owner.alive then
        for p in players() do
          if ready(p) and p.alive and distance(pp.pos, p) < 4 and quiet_ready(p, "pool", 0.5) then oni_hit(pp.owner, p, pp.dmg, "poison", 2) end
        end
      end
    end
  end
  if boss == nil or not kit_here(boss) then
    boss = nil
    return
  end
  if not boss.frozen then boss_step(boss) end
  if boss != nil and kit_here(boss) then
    ui_bar("boss_hp", {at: "top", dy: 74, w: 380, h: 16, value: max(0, boss.health), max: boss.max_hp, color: "#DC2626", bg: "#00000099"})
    ui_text("boss_name", boss.name, {at: "top", dy: 56, size: 14, bold: true, color: "#FCA5A5"})
  end
end

on death(victim, killer)
  if not victim.is_npc or victim.kind != "boss" then return end
  let total = 0
  for id in keys(victim.dmg_by) do total = total + victim.dmg_by[id] end
  let best = nil
  let best_d = 0
  let stones = 1
  if victim.bid == "ibaraki" or victim.bid == "shuten" then stones = 2 end
  for p in players() do
    let d = victim.dmg_by[p.id] or 0
    if d > 0 and total > 0 and ready(p) then
      let share = d / total
      reward(p, 300 + floor(1500 * share), 250 + floor(1500 * share), "⛩ 大将討伐")
      p.stones = p.stones + stones
      p.boss_kills = (p.boss_kills or 0) + 1
      p.kills = p.kills + 5
      kit_quest_progress(p, "boss", 1)
      if p.boss_kills == 1 then p.message("🌙 月影流派を学べるようになった（道場のマット）", 3) end
      if d > best_d then
        best = p
        best_d = d
      end
      hud(p)
    end
  end
  fx_ball(victim.position + {x: 0, y: 2, z: 0}, 16, "#DC2626", 0.8)
  if best != nil then
    announce("⚔️ " + victim.name + " を討ちとった！ 一番手柄: " + best.name + "（" + floor(best_d) + " ダメージ）・みんなに💎" + stones, 5)
    kit_badge(best, "boss_" + victim.bid, victim.name + "討ち")
  else
    announce("⚔️ " + victim.name + " を討ちとった！", 4)
  end
  boss = nil
  ui_remove("boss_hp")
  ui_remove("boss_name")
  for m in boss_minions() do gone(m) end
end
