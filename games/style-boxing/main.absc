-- Style Boxing — スタイルを集めて殴り合う
-- スタイル12種（スピンで集める）。当てると必殺ゲージ、4回つづけて当てると「フロー」。
-- リングA: ランク戦（先に3回KO・レーティング）/ リングB: キング・オブ・リング / 外: 自由に練習。
--
-- ファイル:
--   data.absc     表（スタイル12）
--   common.absc   小さな道具・画面
--   moves.absc    パンチ・ガード・ステップ・必殺技・フロー
--   modes.absc    ランク戦・キング・オブ・リング・KO
--   styles.absc   スピンとスタイルえらび
--   main.absc     このファイル

kit_setup("Style Boxing", "スタイルと必殺技で勝ち上がれ", [
  "🎰 むらさきのパッドでスタイルのスピン（12種類・レア度つき）",
  "🥊 ジャブ・フック・アッパー・ガード・ステップ",
  "💥 当てると必殺ゲージ。MAXでスタイルごとの必殺技",
  "🌊 3びょう以内に4回当てると「フロー」（ダメージ ×1.2）",
  "🔔 リングA: ランク戦（先に3回KO）。🟠 パッドで順番待ち",
  "👑 リングB: 1人だけ残っているあいだ点が入るキング・オブ・リング"
])

kit_quest("ko5", "5回KO", 5, 150)
kit_quest("special", "必殺技を3回使う", 3, 100)
kit_quest("counter", "カウンターを5回決める", 5, 120)
kit_quest("flow", "フローに入る", 1, 60)
kit_quest("duel", "ランク戦で勝つ", 1, 200)
kit_quest("king", "キングで10点", 10, 150)
kit_quest("spin", "スピンを5回", 5, 100)

on start()
  game.respawn_time = 3
  every(8, func() kit_leaderboard("🥊 KO") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_show_money(p)
  p.owned = ["basic"]
  p.style = "basic"
  p.spins = 2
  p.rating = 1000
  p.meter = 0
  p.combo = 0
  apply_style(p)
  let moves = [["jab", "ジャブ", "#F59E0B"], ["hook", "フック", "#EF4444"], ["upper", "アッパー", "#8B5CF6"], ["guard", "ガード", "#475569"], ["step", "ステップ", "#0EA5E9"]]
  let i = 0
  for m in moves do
    i = i + 1
    p.ui_button(m[1], m[2], {at: "bottom_right", dx: -110 - ((i - 1) % 3) * 104, dy: -150 - floor((i - 1) / 3) * 62, w: 98, h: 54, size: 15, bg: m[3], radius: 14})
  end
  p.ui_button("spin", "🎰 スタイル", {at: "right", dy: -60, w: 130, h: 46, size: 15, bg: "#7C3AED"})
  p.ui_button("duel", "🔔 ランク戦", {at: "right", dy: 0, w: 130, h: 46, size: 15, bg: "#B45309"})
  show_meter(p)
end
