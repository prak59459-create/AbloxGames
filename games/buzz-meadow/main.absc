-- Buzz Meadow — ハチを集めて花粉をハチミツに。花畑・虫・くまさんのクエスト。
--
-- ファイル:
--   data.absc    ハチ・花畑・道具とバッグ・たまご・クエスト・トークン
--   common.absc  ハチの力・画面
--   bears.absc   くまさんのクエスト
--   fields.absc  花粉あつめ・トークン・道具屋
--   hive.absc    巣・ハチミツ・たまご・おやつ・ロイヤルゼリー・ついてくるハチ
--   mobs.absc    虫とカブトムシの王
--   main.absc    このファイル

kit_setup("Buzz Meadow", "ハチをふやして、ハチミツ長者に", [
  "🍯 オレンジのパッドがあなたの巣。花粉を持って巣に立つとハチミツ（お金）になる",
  "🌼 花畑に立つとハチが花粉を集める。赤・青の花畑は同じ色のハチが得意（×1.5）",
  "🥚 たまご屋でハチをふやす（銀・金のたまごはレアが出やすい）。巣の部屋もふやせる",
  "🍓 おやつでハチをレベルアップ。👑 ロイヤルゼリーでいちばん弱いハチを別のハチに",
  "🧰 道具屋で道具とバッグ。花畑に落ちるトークン（⚡ブースト・💨はやさ・🍓おやつ）も拾おう",
  "🐻 くまさんのクエスト、🐞 虫たいじ、洞くつのカブトムシの王！"
])
kit_currency = "ハチミツ"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["bees", "slots", "pollen", "tool", "bag", "treats", "jelly", "honey_made", "bear_i", "bear_count", "bear_done"])


kit_shop_title = "服"
kit_shop_add("antenna", "📡 ハチのしょっかく", 300, func(p) p.hat = "antenna" end)
kit_shop_add("bee_suit", "🐝 ハチの服", 800, func(p)
  p.color = "#FACC15"
  p.leg_color = "#111827"
end)
kit_shop_add("crown", "👑 女王バチの冠", 20000, func(p) p.hat = "crown" end)

kit_quest("pollen", "花粉を5000集める", 5000, 300)
kit_quest("bees", "ハチを10ぴきふやす", 10, 400)
kit_quest("bugs", "虫を10ぴきたおす", 10, 300)
kit_quest("feed", "おやつを10回あげる", 10, 200)
kit_quest("token", "トークンを20こ拾う", 20, 200)
kit_quest("gear", "道具かバッグを3回買う", 3, 300)
kit_quest("bear", "くまさんのクエストを3つ", 3, 500)

on start()
  every(10, func() kit_leaderboard("🍯") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.bees = [{id: "basic", level: 1}, {id: "basic", level: 1}]
  p.slots = 5
  p.pollen = 0
  p.tool = "scooper"
  p.bag = "pouch"
  p.treats = 2
  p.jelly = 0
  p.honey_made = 0
  p.bear_i = 1
  p.bear_count = 0
  p.bear_done = false
  kit_give(p, 100)
  auto_hive(p)
  p.ui_button("bees", "🐝 ハチ", {at: "right", dy: 180, w: 150, h: 46, size: 16, bg: "#CA8A04"})
  refresh_followers(p)
  hud(p)
  bear_hud(p)
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  refresh_followers(p)
end
