-- Club Hangout — 家族をつくって家を建てて、クラブでおどる
-- 建築（20パーツ・1〜3階・色・回す・家族で共同）、いいねとハウスツアー、
-- クラブ（DJ・5ジャンル・リズムで♪タップ・ドロップ・花火・オートパーティー）、ジュースバー、役割6つ。
--
-- ファイル:
--   data.absc     表（パーツ・色・ジャンル・ジュース・役割）
--   common.absc   小さな道具・画面の左上
--   build.absc    空き地・建てる・いいね・ハウスツアー
--   club.absc     パーティー・DJ・リズム・ジュースバー・エモート
--   family.absc   役割・家族
--   main.absc     このファイル

kit_setup("Club Hangout", "建てて、おどって、なかよく", [
  "🏗 黄色い看板で空き地。「🧱 建てる」でかべ・ゆか・家具など20種類",
  "⬆ 1〜3階をえらべる。「↻ 回す」「🎨 ぬる」「↩ こわす」は最後のパーツに",
  "👪 親は近くの人を家族にさそえる。家族はいっしょに建てられる",
  "🎧 クラブのDJブースに乗るとDJ。ジャンルで床の色が変わる",
  "♪ ダンスフロアで出てくる♪をすぐタップ → ダンスポイントとコイン",
  "👍 よその家でいいね。🏡 ハウスツアーの家を見に行くとコイン"
])

kit_quest("lot", "空き地を手に入れる", 1, 20)
kit_quest("build", "20個建てる", 20, 100)
kit_quest("build100", "100個建てる", 100, 400)
kit_quest("second", "2階に建てる", 1, 60)
kit_quest("paint", "パーツをぬる", 3, 40)
kit_quest("family", "家族になる", 1, 60)
kit_quest("role", "役割をえらぶ", 1, 20)
kit_quest("dance", "パーティーで3回コインをもらう", 3, 60)
kit_quest("notes", "♪を50回タップ", 50, 150)
kit_quest("combo30", "30コンボ", 1, 200)
kit_quest("dj", "DJでみんなをおどらせる", 3, 150)
kit_quest("dj_drop", "ドロップを決める", 1, 60)
kit_quest("juice", "ジュースを飲む", 1, 20)
kit_quest("likes", "いいねを5つもらう", 5, 150)
kit_quest("tour", "ハウスツアーにえらばれる", 1, 200)

on start()
  for n in npcs() do n.destroy() end
  every(10, func() kit_leaderboard("🕺") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.likes = 0
  p.dance_pts = 0
  p.combo = 0
  p.floor_level = 1
  p.note_on = false
  kit_give(p, 150)
  p.ui_button("open_build", "🧱 建てる", {at: "right", dy: -180, w: 150, h: 46, size: 16, bg: "#0EA5E9"})
  p.ui_button("undo", "↩ こわす", {at: "right", dy: -128, w: 150, h: 46, size: 15, bg: "#6B7280"})
  p.ui_button("like", "👍 いいね", {at: "right", dy: -76, w: 150, h: 46, size: 16, bg: "#F472B6"})
  p.ui_button("open_roles", "🎭 役割", {at: "right", dy: -24, w: 150, h: 46, size: 16, bg: "#DB2777"})
  p.ui_button("invite", "👪 家族", {at: "right", dy: 28, w: 150, h: 46, size: 16, bg: "#16A34A"})
  p.ui_button("emote_spin", "💃", {at: "bottom_left", dx: 90, dy: -170, w: 56, h: 56, size: 24, bg: "#00000088", radius: 28})
  p.ui_button("emote_jump", "🙌", {at: "bottom_left", dx: 154, dy: -170, w: 56, h: 56, size: 24, bg: "#00000088", radius: 28})
  hud(p)
end

on leave(p)
  if p.lot != nil then clear_lot(p.lot) end
  for q in players() do
    if q.family == p.id then
      q.family = nil
      q.message("👪 " + p.name + " がいなくなった", 1.5)
      hud(q)
    end
  end
  if party != nil and party.dj == p.id then party.dj = nil end
end
