-- common.absc — 小さな道具・画面の左上

func ready(p)
  return p.likes != nil
end

func active_until(v)
  return v != nil and v > time()
end

func still(x)
  return x != nil and x.destroy != nil
end

func gone(x)
  if still(x) then x.destroy() end
end

func quiet_ready(p, key, seconds)
  if p.cds == nil then p.cds = {} end
  let last = p.cds[key]
  if last != nil and time() - last < seconds then return false end
  p.cds[key] = time()
  return true
end

func player_by_id(id)
  for p in players() do
    if p.id == id then return p end
  end
  return nil
end

func piece_info(id)
  for x in PIECES do
    if x.id == id then return x end
  end
  return nil
end

func fx_ball(pos, size, color, seconds)
  let b = create_block({name: "FX", shape: "sphere", position: pos, size: size, color: color, material: "neon", solid: false, opacity: 0.55})
  after(seconds or 0.5, func() gone(b) end)
  return b
end

func hud(p)
  if not ready(p) then return end
  let line = ""
  if p.role != nil then line = ROLES[p.role].name + "  " end
  let lot = my_lot(p)
  if lot != nil then line = line + "🏗 空き地 " + lot + "（" + lot_pieces(lot) + "/" + MAX_PIECES + "・価値 " + lot_value(lot) + "）" end
  line = line + "   👍 " + p.likes
  p.ui_text("hud", line, {at: "top_left", dy: 34, size: 14, bold: true, color: "#FDE68A"})
  p.ui_text("hud2", "🕺 ダンス " + p.dance_pts + "   🏠 " + p.floor_level + "階に建てる", {at: "top_left", dy: 54, size: 13, color: "#F9A8D4"})
end
