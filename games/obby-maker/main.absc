-- Obby Maker — 自分のアスレチックコースを作って公開し、みんなのコースに挑戦する。
--
-- ファイル:
--   data.absc     パーツ・区画
--   common.absc   コースの記録・画面
--   build.absc    土地・置く・消す・グリッド・回転・高さ・名前
--   courses.absc  テストして公開・コースえらび・タイム・いいね
--   motion.absc   動く床・回る溶岩バー・加速・ワープ・コイン
--   main.absc     このファイル

kit_setup("Obby Maker", "作って、遊んで、いいねをもらおう", [
  "🗺 白いパッドにさわると、その先の土地があなたのコースに",
  "🧩 パーツをえらんで 🔨 置く。⬆⬇ 高さ・↻ 回転・📐 グリッド・🗑 見ている先を消す・↩ もどす",
  "🔒 動く床・回る溶岩バー・加速パッド・ワープ・コインはコインで解放",
  "🏁 ゴールを置いたら 🧪 テスト。自分でクリアできたら公開される！",
  "▶ 遊ぶ でみんなのコースへ。クリアしたら 👍。作った人にもコインが入る"
])

kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["unlocked"])

kit_shop_title = "服"
kit_shop_add("cap", "🧢 ビルダー帽", 40, func(p) p.hat = "cap" end)
kit_shop_add("crown", "👑 コース王", 300, func(p) p.hat = "crown" end)

kit_quest("build", "パーツを40こ置く", 40, 80)
kit_quest("publish", "コースを公開する", 1, 150)
kit_quest("play", "ほかの人のコースを3つクリア", 3, 150)
kit_quest("likes", "いいねを3つもらう", 3, 200)
kit_quest("unlock", "パーツを2つ解放", 2, 80)
kit_quest("coin", "コースのコインを10まい", 10, 80)

on start()
  -- 最初から遊べるお手本コース
  courses["9"] = {owner: "", owner_name: "Ablox", name: "お手本コース", verified: true, likes: 0, plays: 0, clears: 0, best: 0, best_name: ""}
  every(10, func() kit_leaderboard("👍") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 40)
  p.unlocked = {}
  for pt in PARTS do
    if pt.unlock == 0 then p.unlocked[pt.id] = true end
  end
  p.part = "block"
  p.lift = 0
  p.turn = 0
  p.snap = false
  p.liked = {}
  p.coins_taken = {}
  p.run_start = 0
  p.ui_button("open_tools", "🧩 パーツ", {at: "right", dy: -170, w: 150, h: 46, size: 16, bg: "#7C3AED"})
  p.ui_button("test", "🧪 テスト", {at: "right", dy: -118, w: 150, h: 46, size: 16, bg: "#0E7490"})
  p.ui_button("play", "▶ 遊ぶ", {at: "right", dy: -66, w: 150, h: 46, size: 16, bg: "#16A34A"})
  p.ui_button("hub", "🏠 もどる", {at: "right", dy: -14, w: 150, h: 46, size: 15, bg: "#475569"})
  p.ui_button("rename", "🏷 名前", {at: "right", dy: 180, w: 150, h: 40, size: 14, bg: "#334155"})
  p.ui_button("clear_course", "🧹 まっさら", {at: "right", dy: 226, w: 150, h: 40, size: 14, bg: "#7F1D1D"})
  p.ui_button("place", "🔨 置く", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 64, size: 18, bg: "#0EA5E9", radius: 16})
  p.ui_button("delete", "🗑", {at: "bottom_right", dx: -236, dy: -160, w: 66, h: 64, size: 22, bg: "#B91C1C", radius: 16})
  p.ui_button("undo", "↩", {at: "bottom_right", dx: -306, dy: -160, w: 60, h: 64, size: 22, bg: "#6B7280", radius: 16})
  p.ui_button("up", "⬆", {at: "bottom_right", dx: -120, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  p.ui_button("down", "⬇", {at: "bottom_right", dx: -182, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  p.ui_button("turn", "↻", {at: "bottom_right", dx: -244, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  p.ui_button("snap", "📐", {at: "bottom_right", dx: -306, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  hud(p)
end
