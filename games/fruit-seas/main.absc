-- Fruit Seas Adventure — 果実の力で海を冒険するアクションRPG
-- 8つの島・14種類の敵・7体のボス・12種類の果実（技は3つずつ）・剣6本・銃4丁・拳法4つ。
--
-- ファイル:
--   data.absc     表（島・敵・ボス・果実と技・剣・銃・拳法・称号・宝箱）
--   common.absc   人さがし・島・画面の表示・光の効果
--   combat.absc   ステータス・ダメージ・技の形・やけど/こおり/しびれ・ソル・闘気・レベル
--   enemies.absc  敵のうごき・ボスの技・ごほうび
--   fruits.absc   果実（拾う・買う・くじ・食べる・覚醒）と技ボタン
--   gear.absc     剣・銃・拳法・道場・店
--   islands.absc  船・島のクエスト・拠点・宝箱・海王類・地図
--   pvp.absc      海賊と海軍・PvP・賞金
--   main.absc     このファイル（はじめの準備とクエスト）

kit_setup("Fruit Seas", "果実の力で島から島へ。最強の海賊（または海軍）になろう", [
  "📜 黄色い人（クエスト）に話しかけて敵をたおすとレベルアップ",
  "⬆️ レベルが上がったら 📊 でステータス（体術・防御・剣術・果実）を割りふる",
  "🍎 光る果実を拾う・果実屋・くじの井戸。🎒で食べると Z の技",
  "🍎 技を使うと熟練度が上がり、X・C の技も使えるようになる",
  "⚔️ 剣の技・👊 拳法の技・💨 ソル・🛡 闘気（道場で覚える）",
  "⛵ 港の水色パッドで島へ。強い島ほど敵もボスも強い",
  "👑 ボスはみんなでたおすと全員ごほうび。🐉 海王類にも注意",
  "⚔️ PvP を ON にすると、ちがう陣営の人と戦える（賞金・名声）"
])
kit_currency = "ベリー"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["level", "xp", "points", "stats", "mastery", "awakened", "bag", "swords", "sword", "guns", "styles", "style", "abilities", "visited", "bounty", "honor", "fruit"])


-- MARK: クエスト（📜ボタン: 目標）

kit_quest("lv10", "レベル10になる", 9, 500)
kit_quest("lv50", "レベル50になる", 49, 5000)
kit_quest("lv120", "レベル120になる", 119, 30000)
kit_quest("eat", "果実を食べる", 1, 200)
kit_quest("eat5", "5種類の果実を食べる", 5, 5000)
kit_quest("cmove", "Cの技を使う", 1, 1500)
kit_quest("find", "落ちている果実を拾う", 1, 300)
kit_quest("kill50", "敵を50体たおす", 50, 1500)
kit_quest("iquest", "島のクエストを10回", 10, 3000)
kit_quest("boss", "ボスをたおす", 1, 800)
kit_quest("beast", "海王類をたおす", 1, 5000)
kit_quest("visit", "島を全部おとずれる", 8, 4000)
kit_quest("chest", "宝箱を20こ開ける", 20, 2000)
kit_quest("sword", "新しい剣を手に入れる", 1, 300)
kit_quest("style", "拳法を覚える", 1, 500)
kit_quest("awaken", "果実を覚醒させる", 1, 20000)
kit_quest("pvp", "PvPで勝つ", 1, 1000)

-- MARK: 右のボタン

func menu_refresh(p)
  if not kit_here(p) then return end
  let stats = "📊 ステータス"
  if p.points > 0 then stats = "📊 ステ ❗" + p.points end
  set_btn(p, "open_stats", stats, {at: "right", dy: -180, w: 160, h: 50, size: 16, bg: "#4F46E5"})
  set_btn(p, "open_bag", "🎒 持ち物", {at: "right", dy: -120, w: 160, h: 50, size: 17, bg: "#0F766E"})
  set_btn(p, "open_map", "🗺 地図", {at: "right", dy: -60, w: 160, h: 50, size: 17, bg: "#0369A1"})
  let pvp = "⚔️ PvP: OFF"
  let bg = "#475569"
  if p.pvp then
    pvp = "⚔️ PvP: ON"
    bg = "#DC2626"
  end
  set_btn(p, "pvp_toggle", pvp, {at: "right", dy: 0, w: 160, h: 50, size: 16, bg: bg})
end

-- MARK: 入ってきた人

on join(p)
  p.level = 1
  p.xp = 0
  p.points = 0
  p.stats = {melee: 0, defense: 0, sword: 0, fruit: 0}
  p.mastery = {}
  p.awakened = []
  p.bag = []
  p.swords = ["katana"]
  p.sword = "katana"
  p.guns = []
  p.styles = ["basic"]
  p.style = "basic"
  p.abilities = []
  p.visited = []
  p.bounty = 0
  p.honor = 0
  p.pvp = false
  p.base = "start"
  p.fruit = nil

  kit_welcome(p)
  kit_give(p, 200)
  refresh_max_health(p)
  p.heal(p.max_health)
  hold_sword(p)
  kit_quest_button(p)
  kit_camera_button(p)
  menu_refresh(p)
  hud(p)
  move_buttons(p)
  -- 最初の果実: はじめだけ、コモンの実を1つプレゼント
  bag_add(p, random(["flame", "rubber", "smoke", "spring"]))
  kit_later(p, 4.5, func()
    choose_side(p)
    p.message("🎁 かばんに果実が入っています！🎒で食べよう", 3)
  end)
  -- えらばないままなら海賊に
  kit_later(p, 25, func()
    if p.team == nil then set_side(p, "pirate") end
  end)
end

on start()
  every(10, func()
    kit_leaderboard("⭐ レベル")
  end)
end
