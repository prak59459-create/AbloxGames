-- Color Chart Obby — 色で進む難しさチャートのオビー
-- 12段階（らくらく → だいさいがい）×5ステージ＝60ステージ。ゾーンをこえるとバッジとボーナス。
-- コイル（スピード・重力・フュージョン）はアイテムバーでオン・オフ。⏱ ゾーンタイムアタックも。
--
-- ファイル:
--   ../../lib/kit_obby.absc  オビーの共通エンジン（ステージ・落ちたら戻る・スキップ・ステージ選択）
--   data.absc    ゾーン12・コイル3
--   chart.absc   ゾーンのバッジ・落ちた回数・成績・ランキング
--   coils.absc   コイル
--   trial.absc   ゾーンタイムアタック
--   main.absc    このファイル

kit_setup("Color Chart Obby", "色が変わるほどむずかしくなる60ステージ！", [
  "🟩 緑の らくらく から ⬜ 白の だいさいがい まで、12のゾーン",
  "🚩 光るパッドがチェックポイント。落ちてもそこから",
  "🎖 ゾーンをこえるとバッジとコイン。📋 で行ったステージへワープ",
  "⚡🌀 コイルはショップで買って、アイテムバーでオン・オフ",
  "⏱ 青いパッドで、1つのゾーンのタイムアタック（コイルなし）",
  "⏭ スキップは 💰40。↩ でチェックポイントにもどる"
])
kit_keep(["tiers_done", "tier_falls", "trial_best", "coils"])

obby_setup({stages: 60, fall: -8, coins: 3, finish_coins: 500, skip: 40, board: "chart_time"})
obby_zones = []
for i in 1 to len(TIERS) do
  append(obby_zones, {from: tier_start(i), last: tier_start(i) + STAGES_PER_TIER - 1, name: TIERS[i].name, color: TIERS[i].color})
end
obby_on_stage = func(p, n) chart_stage(p, n) end
obby_on_finish = func(p, secs) chart_finish(p, secs) end
obby_on_back = func(p) chart_fell(p) end

obby_perks_basic()
for c in COILS do
  let coil = c
  kit_shop_add("coil_" + coil.id, coil.item + "（" + coil.text + "）", coil.price, func(p) coil_buy(p, coil.id) end)
end

kit_quest("tiers", "ゾーンを3つこえる", 3, 150)
kit_quest("tiers6", "ゾーンを6つこえる", 6, 400)
kit_quest("finish", "60ステージをぜんぶクリア", 1, 1000)
kit_quest("trial", "ゾーンタイムアタックを走りきる", 1, 120)
kit_quest("coil", "コイルを買う", 1, 60)
kit_quest("falls", "50回落ちる（それでもがんばる！）", 50, 100)

kit_on_load = func(p) coil_give_items(p) end

on join(p)
  kit_welcome(p)
  kit_show_money(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.coil_on = nil
  p.in_trial = false
  p.ui_button("stats", "📊", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  p.ui_button("ranking", "🏆", {at: "top_right", dy: 240, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  p.ui_button("trial", "⏱", {at: "top_right", dy: 300, w: 52, h: 52, size: 22, bg: "#0369A1", radius: 26})
end

on start()
  world.music = "adventure"
  every(12, func() kit_leaderboard("🏁 最高ステージ") end)
end

on tick(dt)
  -- ランキングの「score」は最高ステージ
  for p in players() do
    if (p.obby_best or 0) != p.score then p.score = p.obby_best or 0 end
  end
end
