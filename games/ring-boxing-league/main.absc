-- Ring Boxing League — リングで1対1のボクシング
-- 緑のパッドで順番待ち → 2つのリングで試合（3ラウンド）。オレンジのドアでAIとのキャリアモード。
-- ジムで練習するとずっと強くなる。観客はむらさきのパッドで応援（かけ）。
--
-- ファイル:
--   data.absc     表（パンチ・リング・ランク・キャリア8人・ジム）
--   common.absc   倍率と画面
--   fight.absc    試合の流れ・ラウンド・ダウン・判定・順番待ち
--   punches.absc  パンチ・ガード・ウィービング・必殺ブロー
--   ai.absc       キャリアモードとAIのボクサー
--   gym.absc      ジムの練習・パッド
--   bets.absc     応援
--   main.absc     このファイル

kit_setup("Ring Boxing League", "スタミナを読んで、打ち勝て", [
  "🟢 緑のパッドで順番待ち。2人そろうとあいているリングへ",
  "🥊 ジャブ・ストレート・フック（ガードの上から通る）・アッパー",
  "🛡 ガードと 💨 ウィービング（0.5びょうかわす）。どれもスタミナを使う",
  "💥 当てると必殺ゲージ。MAXで必殺ブロー",
  "🔔 3ラウンド。3回ダウンでTKO、最後まで行けば判定",
  "🟠 キャリア: AIのボクサー8人を倒して世界王者へ。🏋 ジムで練習",
  "🟣 観客は応援（💰50）。当たると2倍"
])

kit_quest("fight", "1試合する", 1, 50)
kit_quest("win", "3勝する", 3, 200)
kit_quest("ko", "KO・TKOで勝つ", 1, 150)
kit_quest("knockdown", "5回ダウンを奪う", 5, 150)
kit_quest("land", "パンチを100発当てる", 100, 200)
kit_quest("career", "キャリアで3勝", 3, 300)
kit_quest("champion", "世界王者になる", 1, 2000)
kit_quest("gym", "ジムで50回練習", 50, 100)
kit_quest("train_up", "練習のレベルを5回上げる", 5, 300)
kit_quest("bet", "応援を当てる", 1, 50)

on start()
  every(10, func() kit_leaderboard("🥊 pt") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_show_money(p)
  p.rp = 0
  p.career = 0
  p.train = {}
  p.train_hits = {}
  p.stamina = 100
  p.meter = 0
  p.ui_button("career", "🥊 キャリア", {at: "right", dy: -60, w: 130, h: 46, size: 15, bg: "#B45309"})
  p.ui_button("gym", "🏋 ジム", {at: "right", dy: 0, w: 130, h: 46, size: 15, bg: "#334155"})
  hud(p)
  show_queue()
end
