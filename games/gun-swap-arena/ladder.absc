-- ladder.absc — 武器のならび・キル・ナイフ・連続キルのごほうび

func arm(p)
  if len(ladder) == 0 then return end
  let name = ladder[p.tier]
  p.give(name)
  let color = "#FFFFFF"
  if p.tier == len(ladder) then color = "gold" end
  p.ui_text("tier", "🔫 " + p.tier + "/" + len(ladder) + "  " + name, {at: "top_left", dy: 34, size: 20, bold: true, color: color})
  p.score = p.tier - 1
  if p.tier == len(ladder) then
    kit_quest_progress(p, "knife", 1)
    announce("⚠️ " + p.name + " が黄金ナイフに到達！", 3)
  end
end

func leader_line()
  let best = nil
  for p in players() do
    if ready(p) and p.in_match and (best == nil or p.tier > best.tier) then best = p end
  end
  if best != nil then
    ui_text("lead", "👑 トップ: " + best.name + "（" + best.tier + "/" + len(ladder) + "）", {at: "top", dy: 26, size: 18})
  end
end

func damage_mult(p)
  if active_until(p.hunter_until) then return 1.25 end
  return 1
end

-- スポーン直後の2びょうは無敵。ヘッドハンターは1.25倍
on hit(victim, attacker, damage)
  if victim.is_npc or attacker == nil or attacker.is_npc then return damage end
  if active_until(victim.protect_until) then return 0 end
  -- 撃ったら無敵はおしまい
  attacker.protect_until = 0
  return damage * damage_mult(attacker)
end

func knife(p)
  if phase != "match" or not p.alive or not kit_ready(p, "knife", 1.5) then return end
  for q in players() do
    if q.id != p.id and q.alive and distance(p, q) < 3.2 and dot(normalize(q.position - p.position), p.look) > 0.4 then
      if active_until(q.protect_until) then return end
      q.knifed = true
      q.damage(q.health + 100, p)
      return
    end
  end
end

func streak_reward(p)
  for s in STREAKS do
    if p.streak == s.kills then
      announce("🔥 " + p.name + " が " + s.kills + " 連続キル！ " + s.name, 3)
      if s.kills == 3 then
        p.speed_until = time() + 20
        p.speed = 1.3
        kit_later(p, 20, func() p.speed = 1 end)
      elif s.kills == 5 then
        p.max_health = 150
        p.heal(150)
      else
        p.hunter_until = time() + 30
      end
      kit_quest_progress(p, "streak", 1)
    end
  end
end

on death(victim, killer)
  if victim.is_npc or phase != "match" then return end
  victim.streak = 0
  victim.match_deaths = (victim.match_deaths or 0) + 1
  victim.deaths = (victim.deaths or 0) + 1
  victim.max_health = 100
  if killer == nil or killer.id == victim.id then return end
  killer.match_kills = (killer.match_kills or 0) + 1
  killer.kills = (killer.kills or 0) + 1
  killer.streak = (killer.streak or 0) + 1
  killer.best_streak = max(killer.best_streak or 0, killer.streak)
  killer.xp = (killer.xp or 0) + 10
  kit_quest_progress(killer, "k5", 1)
  kit_quest_progress(killer, "k50", 1)
  let how = "🔫"
  if victim.knifed then how = "🔪" end
  chat(how + " " + killer.name + " → " + victim.name + "（" + (killer.weapon or "") + "）")
  if killer.weapon == "黄金ナイフ" then
    killer.golden = (killer.golden or 0) + 1
    kit_badge(killer, "winner", "ゴールデンナイフ")
    end_match(killer, "🏆 " + killer.name + " の勝ち！ 黄金ナイフで決めた！")
    return
  end
  -- ナイフでやられたら1段階ダウン（屈辱）
  if victim.knifed then
    victim.knifed = false
    victim.tier = max(1, victim.tier - 1)
    victim.message("🔪 ナイフでやられて1段階ダウン…", 2)
    kit_quest_progress(killer, "knifer", 1)
  end
  killer.tier = min(len(ladder), killer.tier + 1)
  arm(killer)
  killer.message("⬆️ " + ladder[killer.tier], 1.5)
  streak_reward(killer)
end

on button(p, id)
  if id == "knife" then knife(p) end
end
