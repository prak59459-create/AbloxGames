-- Gun Swap Arena — たおすたびに武器が変わるFPS

kit_setup("Gun Swap Arena", "12の武器をクリアして、黄金ナイフで決めろ", [
  "1キルごとに次の武器へ（全部で12段階）",
  "最後の黄金ナイフでキルした人の勝ち",
  "ナイフでたおされると、1段階もどされる！",
  "たおされても2秒で復活",
  "🔪ボタン: 目の前の相手を一撃。やられた相手は1段階ダウン",
  "屋根の上は有利。階段を探そう"
])

let ladder = [
  {name: "ライフル", model: "rifle", damage: 45, rate: 2, range: 140, ammo: 6, reload: 1.8, spread: 0.2},
  {name: "ブラスター", model: "blaster", damage: 22, rate: 5, range: 60, ammo: 20, reload: 1.4, spread: 1.5},
  {name: "ショットガン", model: "shotgun", damage: 70, rate: 1.2, range: 16, ammo: 4, reload: 2, spread: 5},
  {name: "マシンピストル", model: "pistol", damage: 14, rate: 10, range: 40, ammo: 30, reload: 1.5, spread: 3},
  {name: "スナイパー", model: "rifle", damage: 120, rate: 0.7, range: 300, ammo: 3, reload: 2.5, spread: 0},
  {name: "レーザー", model: "blaster", damage: 30, rate: 4, range: 90, ammo: 15, reload: 1.6, spread: 0.3},
  {name: "ダブルバレル", model: "shotgun", damage: 110, rate: 0.8, range: 12, ammo: 2, reload: 2, spread: 6},
  {name: "リボルバー", model: "pistol", damage: 55, rate: 1.6, range: 60, ammo: 6, reload: 2.2, spread: 0.5},
  {name: "ミニガン", model: "blaster", damage: 10, rate: 16, range: 50, ammo: 100, reload: 4, spread: 4},
  {name: "マグナム", model: "pistol", damage: 80, rate: 1, range: 80, ammo: 5, reload: 2, spread: 0.3},
  {name: "ビームライフル", model: "rifle", damage: 60, rate: 1.5, range: 200, ammo: 8, reload: 2, spread: 0},
  {name: "黄金ナイフ", model: "pistol", damage: 200, rate: 2, range: 5, ammo: 1000, reload: 0, spread: 3}
]
for w in ladder do
  weapon(w.name, {model: w.model, damage: w.damage, rate: w.rate, range: w.range, ammo: w.ammo, reload: w.reload, spread: w.spread})
end
let over = false

kit_quest("k5", "5キル", 5, 50)
kit_quest("knife", "黄金ナイフまで行く", 1, 100)
kit_quest("win", "1回優勝", 1, 300)

func arm(p)
  let w = ladder[p.tier]
  p.give(w.name)
  p.ui_text("tier", "🔫 " + p.tier + "/" + len(ladder) + "  " + w.name, {at: "top_left", dy: 34, size: 20, bold: true, color: p.tier == len(ladder) and "gold" or "#FFFFFF"})
  p.score = p.tier - 1
  if p.tier == len(ladder) then
    kit_quest_progress(p, "knife", 1)
    announce("⚠️ " + p.name + " が黄金ナイフに到達！", 3)
  end
end

func leader_line()
  let best = kit_top(1)
  if len(best) > 0 then
    ui_text("lead", "👑 トップ: " + best[1].name + "（" + (best[1].score + 1) + "/" + len(ladder) + "）", {at: "top", dy: 26, size: 18})
  end
end

on start()
  game.respawn_time = 2
  every(3, func() leader_line() end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.camera = "first"
  p.tier = 1
  p.streak = 0
  p.ui_button("knife", "🔪", {at: "bottom_right", dx: -120, dy: -160, w: 80, h: 70, size: 26, bg: "#57534E", radius: 35})
  arm(p)
end

on button(p, id)
  if id == "knife" and p.alive and kit_ready(p, "knife", 1.5) then
    for q in players() do
      if q.id != p.id and q.alive and distance(p, q) < 3.2 and dot(normalize(q.position - p.position), p.look) > 0.4 then
        q.knifed = true
        q.kill(p)
        return
      end
    end
  end
end

on death(victim, killer)
  if over then return end
  victim.streak = 0
  if killer == nil or killer.id == victim.id then return end
  kit_quest_progress(killer, "k5", 1)
  killer.streak = killer.streak + 1
  if killer.streak == 5 then kit_badge(killer, "streak5", "5連続キル") end
  if killer.weapon == "黄金ナイフ" then
    over = true
    killer.score = len(ladder)
    kit_quest_progress(killer, "win", 1)
    kit_badge(killer, "winner", "ゴールデンナイフ")
    kit_finish("🏆 " + killer.name + " の勝ち！黄金ナイフで決めた！", 8)
    return
  end
  -- ナイフでやられたら1段階ダウン（屈辱）
  if victim.knifed then
    victim.knifed = false
    victim.tier = max(1, victim.tier - 1)
    victim.message("🔪 ナイフでやられて1段階ダウン…", 2)
  end
  killer.tier = min(len(ladder), killer.tier + 1)
  arm(killer)
  killer.message("⬆️ " + ladder[killer.tier].name, 1.5)
end

on respawn(p)
  p.teleport(block("Spawn " + random(1, 10)))
  arm(p)
end
