-- Gun Swap Arena — たおすたびに武器が変わるFPS
-- ロビーで投票（アリーナ3つ × 武器のならび4つ）→ 6分の試合。
-- 1キルごとに次の武器へ。最後の黄金ナイフでキルした人の勝ち。ナイフでやられると1段階ダウン。
--
-- ファイル:
--   data.absc     表（武器18・ならび4・アリーナ3・連続キル・スキン）
--   common.absc   武器を作る・小さな道具
--   match.absc    投票・試合・時間切れ
--   ladder.absc   武器のならび・キル・ナイフ・連続キルのごほうび
--   arena.absc    スポーン・無敵・回復キット
--   locker.absc   スキン・成績・結果
--   main.absc     このファイル

kit_setup("Gun Swap Arena", "武器をクリアして、黄金ナイフで決めろ", [
  "🗳 ロビーのパッドで投票: アリーナ（ストリート・倉庫・屋上）と武器のならび",
  "🔫 1キルごとに次の武器へ。最後の黄金ナイフでキルした人の勝ち",
  "🔪 ナイフでたおされると1段階もどされる！",
  "🛡 スポーン直後の2びょうは無敵。💚 緑のキットで回復",
  "🔥 3・5・7連続キルでごほうび（スピード・体力・ダメージ）",
  "⏱ 6分で時間切れ。いちばん進んだ人の勝ち。🎟 クレジットでスキン"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["credits", "skins", "skin", "tier"])

kit_quest("k5", "5キル", 5, 50)
kit_quest("k50", "50キル", 50, 500)
kit_quest("knife", "黄金ナイフまで行く", 1, 100)
kit_quest("knifer", "ナイフで1段階下げる", 1, 80)
kit_quest("streak", "連続キルのごほうび", 1, 120)
kit_quest("win", "1回優勝", 1, 300)

on start()
  game.respawn_time = 2
  start_vote()
  every(8, func() kit_leaderboard("🔫") end)
end

on join(p)
  kit_welcome(p)
  p.credits = 0
  p.skins = ["own"]
  p.skin = "own"
  own_colors(p)
  p.tier = 1
  p.streak = 0
  p.in_match = false
  kit_quest_button(p)
  kit_camera_button(p)
  p.camera = "first"
  p.ui_button("knife", "🔪", {at: "bottom_right", dx: -120, dy: -160, w: 80, h: 70, size: 26, bg: "#57534E", radius: 35})
  p.ui_button("locker", "🎽", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  p.ui_button("stats", "📊", {at: "top_right", dy: 180, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  hud(p)
  if phase == "match" then
    -- 途中から: いちばん下の人と同じ段階から
    let low = len(ladder)
    for q in players() do
      if q.id != p.id and ready(q) and q.in_match then low = min(low, q.tier) end
    end
    p.tier = max(1, min(low, len(ladder) - 1))
    p.in_match = true
    p.match_kills = 0
    p.match_deaths = 0
    spawn_in_arena(p)
    arm(p)
  else
    vote_ui(p)
  end
end

-- クエストのごほうび（kit のコイン）はクレジットとして受けとる
let coin_clock = 0
on tick(dt)
  coin_clock = coin_clock + dt
  if coin_clock < 1 then return end
  coin_clock = 0
  for p in players() do
    if ready(p) and (p.coins or 0) > 0 then
      p.credits = p.credits + floor(p.coins / 10)
      p.coins = 0
      hud(p)
    end
  end
end
