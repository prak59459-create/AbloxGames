-- Porky's House — 品物を探してドアを開け、ブタの怪物から逃げて脱出するなぞ解きホラー
-- 毎章ランダムな品物の場所と暗号、5つの扉、玄関（カギ＋暗号）と車（3つの部品）の2つの出口、
-- 見回って追いかけ、わなを置くポーキー、クローゼット、命と幽霊のささやき、お店の道具。
--
-- ファイル:
--   data.absc      表（品物・扉・部屋・道具）
--   common.absc    道具・ラウンドの状態・画面
--   items.absc     品物を置く・拾う・使う・車・懐中電灯
--   keypad.absc    玄関の暗号
--   porky.absc     ポーキーとわな
--   round.absc     章の流れ・クローゼット・幽霊・脱出
--   main.absc      このファイル

kit_setup("Porky's House", "カギを見つけて、にげ出せ！", [
  "🔑 家のどこかに品物がある（毎章ちがう場所）。さわると拾う。持てるのは1つだけ",
  "✋「使う」で近くの扉に。赤い扉=赤いカギ、青い扉=青いカギ、木の板=ハンマー、車庫の格子=レンチ",
  "🚪 玄関: 出口のカギ＋暗号（📝暗号メモを読んだ人だけが番号を知っている→水色のキーパッド）",
  "🚗 車庫の車: 車のカギ・ガソリン缶・バッテリーを入れたら、オレンジのパッドで脱出",
  "🐷 ポーキーに見つかったら逃げろ！ わなに注意。灰色のパッドはクローゼット。命がなくなると👻幽霊"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["perks"])

kit_shop_title = "こっそりショップ"
func add_perk_item(perk)
  kit_shop_add(perk.id, perk.name + "（" + perk.text + "）", perk.price, func(p)
    if not contains(p.perks, perk.id) then append(p.perks, perk.id) end
    if perk.id == "shoes" and not p.ghost then p.speed = 1.15 end
    p.message("🛒 " + perk.name + "！", 1.5)
    kit_quest_progress(p, "perk", 1)
  end)
end
for perk in PERKS do add_perk_item(perk) end
kit_shop_add("hat_cap", "🧢 ぼうし", 30, func(p) p.hat = "cap" end)
kit_shop_add("hat_crown", "👑 脱出王の冠", 400, func(p) p.hat = "crown" end)

kit_quest("pickup", "品物を5回拾う", 5, 60)
kit_quest("doors", "扉や車に品物を5回使う", 5, 150)
kit_quest("note", "暗号メモを見つける", 1, 60)
kit_quest("code", "暗号を入力する", 1, 100)
kit_quest("escape", "脱出する", 1, 200)
kit_quest("front", "玄関から脱出", 1, 150)
kit_quest("car", "車で脱出", 1, 200)
kit_quest("hide", "クローゼットに3回隠れる", 3, 60)
kit_quest("trap", "わなにかかる", 1, 20)
kit_quest("caught", "ポーキーにつかまる", 1, 20)
kit_quest("whisper", "幽霊になってささやく", 1, 60)
kit_quest("perk", "道具を2つ買う", 2, 80)

on start()
  game.respawn_time = 3
  after(4, func() start_round() end)
  every(10, func() kit_leaderboard("🏆") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 20)
  p.perks = []
  p.max_lives = LIVES
  p.lives = LIVES
  p.item = nil
  p.ghost = false
  p.escaped = false
  p.closet = nil
  p.ui_button("use", "✋ 使う", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 64, size: 20, bg: "#B45309", radius: 16})
  p.ui_button("drop", "⬇ 置く", {at: "bottom_right", dx: -250, dy: -160, w: 100, h: 50, size: 15, bg: "#57534E", radius: 14})
  p.ui_button("light", "🔦", {at: "right", dy: 240, w: 70, h: 50, size: 20, bg: "#1F2937"})
  -- 途中から来た人は幽霊で見学（章の途中で品物を持ちこめないように）
  if phase == "hunt" then become_ghost(p) end
  hud(p)
  team_hud()
end

on leave(p)
  drop_item(p)
  after(0.5, func() check_round_over() end)
end
