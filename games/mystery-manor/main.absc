-- Mystery Manor — 市民・保安官・犯人の推理サバイバル
-- マップ3つ（投票）・能力7種・ナイフ投げ・落ちた銃でヒーロー・観戦・コイン・ミステリーボックス・
-- ナイフ9種と銃5種の見た目（レアはたおした時に光る）・レベル。
--
-- ファイル:
--   data.absc        表（マップ・能力・ナイフと銃・効果・ボックス）
--   common.absc      人さがし・画面・レベル
--   round.absc       ロビーと投票・役・勝ち負け・コイン・観戦
--   roles.absc       ナイフ投げ・能力・落ちた銃・わな・たおした時の効果
--   collection.absc  ミステリーボックスと武器ラック
--   main.absc        このファイル

kit_setup("Mystery Manor", "犯人を見つけろ。犯人は正体をかくせ", [
  "🏠 ロビーで次のマップに投票。ラウンドの始めに自分だけに役が知らされる",
  "🔪 犯人: ナイフと 🗡投げナイフで全員をたおせば勝ち",
  "🔫 保安官: 犯人を撃てば市民の勝ち（市民を撃つと自分もアウト）",
  "🙂 市民: 3分生きのこれば勝ち。コインも集めよう",
  "🔫 保安官がたおれると銃が落ちる。市民が拾うと保安官に（ヒーロー！）",
  "✨ 犯人と保安官は ラウンドの始めに能力を1つえらべる",
  "🎁 コインで ミステリーボックス（紫）→ ナイフや銃の見た目",
  "👁 たおされたら観戦できる。3人以上で遊ぶのがおすすめ"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["level", "xp", "wins", "knives", "guns", "knife", "gun"])


kit_quest("win", "ラウンドで勝つ", 1, 20)
kit_quest("survive", "市民として生きのこる", 3, 40)
kit_quest("catch", "保安官で犯人をたおす", 1, 60)
kit_quest("hero", "落ちた銃を拾う", 1, 50)
kit_quest("murderwin", "犯人として勝つ", 1, 60)
kit_quest("knife", "犯人で5人たおす", 5, 60)
kit_quest("throw", "ナイフを投げる", 1, 10)
kit_quest("perk", "能力を使う", 3, 20)
kit_quest("coins", "コインを100まい拾う", 100, 50)
kit_quest("collect", "ボックスで3つ当てる", 3, 80)
kit_quest("lv5", "レベル5", 4, 100)

on join(p)
  p.level = 1
  p.xp = 0
  p.wins = 0
  p.knives = ["default"]
  p.guns = ["default"]
  p.knife = "default"
  p.gun = "default"
  kit_welcome(p)
  kit_show_money(p)
  p.ui_button("open_rack", "🗄 武器ラック", {at: "right", dy: -120, w: 160, h: 50, size: 16, bg: "#0369A1"})
  p.ui_button("open_boxes", "🎁 ボックス", {at: "right", dy: -60, w: 160, h: 50, size: 16, bg: "#7E22CE"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end
