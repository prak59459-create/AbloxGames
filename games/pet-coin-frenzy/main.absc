-- Pet Coin Frenzy — コインの山をこわしてペットを集めるクリッカー
-- ワールド8つ・ペット48種（Huge つき）・ゴールド/レインボー/合成マシン・ペットが自動でこわす・
-- 強化7種・転生・イベント3種（コインラッシュ・ラッキーアワー・ボス宝箱）・プレゼント・図鑑。
--
-- ファイル:
--   data.absc    表（ワールド・ペット・強化・イベント）
--   common.absc  人さがし・画面・ワールドの番号
--   pets.absc    ペット・たまご・マシン・図鑑
--   world.absc   山・門・強化・転生・イベント・プレゼント
--   main.absc    このファイル

kit_setup("Pet Coin Frenzy", "タップでこわして、ペットで強くなれ", [
  "👆 コインの山や宝箱をタップするとダメージ。こわれるとコイン",
  "🐾 連れているペットが 近くの山を自動でこわしてくれる",
  "🥚 光るたまごにさわるとペット。強いペットから連れて歩く（枠の数まで）",
  "✨ 同じペット5ひき → ゴールド、ゴールド5ひき → レインボー（広場のマシン）",
  "🟣 紫の門はコインで開く。先のワールドほど もうかる",
  "♻️ 「ぎんが」まで行ったら転生。コインはリセット、ずっと稼ぎアップ",
  "🌟 Huge ペットは1000分の1！"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["pets", "index", "up", "world", "rebirths"])


kit_quest("tap", "100回タップ", 100, 100)
kit_quest("break", "山を50こ こわす", 50, 300)
kit_quest("chest", "宝箱をこわす", 5, 800)
kit_quest("hatch", "たまごを10こ", 10, 500)
kit_quest("index", "図鑑を10うめる", 10, 3000)
kit_quest("golden", "ゴールドペットを作る", 1, 5000)
kit_quest("rainbow", "レインボーペットを作る", 1, 50000)
kit_quest("fuse", "合成する", 1, 2000)
kit_quest("world", "新しいワールドへ", 3, 20000)
kit_quest("upgrade", "強化を5回", 5, 3000)
kit_quest("boss", "ボス宝箱をこわす", 1, 10000)
kit_quest("huge", "Hugeペットを出す", 1, 100000)
kit_quest("gift", "ペットをプレゼント", 1, 500)
kit_quest("rebirth", "転生する", 1, 50000)

on join(p)
  p.pets = []
  p.index = []
  p.up = {}
  p.world = 1
  p.rebirths = 0
  kit_welcome(p)
  kit_give(p, 100)
  p.ui_button("open_pets", "🐾 ペット", {at: "right", dy: -180, w: 150, h: 50, size: 17, bg: "#7C3AED"})
  p.ui_button("open_shop", "⬆️ 強化", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#0369A1"})
  p.ui_button("rebirth", "♻️ 転生", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#DB2777"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end
