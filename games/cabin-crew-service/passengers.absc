-- passengers.absc — お客さん: 乗ってきて席にすわり、🔔でたのむ。乗務員が運ぶ。着いたら おりる（ゴミをのこして）。

let pax = []          -- {n, seat, want, until}
let trash_blocks = []
let req_clock = 0

func tag_num(b, key)
  for t in b.tags do
    if starts_with(t, key + "=") then return num(replace(t, key + "=", "")) end
  end
  return nil
end

func seat_pos(n)
  return block("Seat " + n).position
end

func light(n, color)
  let b = block("Call " + n)
  if b != nil and b.color != color then b.color = color end
end

func pax_at(n)
  return find(pax, func(x) return x.seat == n end)
end

func spawn_passengers()
  for x in pax do kit_gone(x.n) end
  pax = []
  let count = min(28, 14 + 2 * len(crew()))
  let seats = slice(shuffle(range(1, SEATS)), 1, count)
  let door = block("Board Point").position
  let i = 0
  for s in seats do
    i = i + 1
    after(i * 0.9, func() board_one(s, door) end)
  end
end

func board_one(seat, door)
  if phase().id != "board" and phase().id != "demo" then return end
  let n = create_npc({name: "お客さん", position: door + {x: 0, y: 0.3, z: 0}, color: random_color(),
                      head_color: random(["#FDE68A", "#FCD34D", "#D6A77A", "#8D5524"]), speed: 0.8, health: 100000,
                      hat: random(["none", "none", "cap", "beanie", "top_hat", "flower_crown", "bow", "headphones"])})
  let x = {n: n, seat: seat, want: nil, until: 0}
  if chance(45) then
    x.want = "bag"
    x.until = time() + 60
  end
  append(pax, x)
  let sp = seat_pos(seat)
  n.move_to({x: 0, y: sp.y, z: sp.z})
  after(4.5, func()
    if kit_here(n) then n.move_to(sp) end
  end)
  after(6.5, func()
    if kit_here(n) then
      n.frozen = true
      n.yaw = 180
      if x.want == "bag" then
        light(seat, "#F59E0B")
        n.say("🧳 荷物を上にお願いします")
      end
    end
  end)
end

func passengers_leave()
  let door = block("Board Point").position
  for x in pax do
    light(x.seat, "#475569")
    if kit_here(x.n) then
      x.n.frozen = false
      x.n.say(random(["ありがとう！", "たのしかった〜", "また乗ります！", "ごちそうさま！"]))
      x.n.move_to({x: 0, y: door.y, z: seat_pos(x.seat).z})
      let n = x.n
      after(3, func()
        if kit_here(n) then n.move_to(door) end
      end)
      after(9, func() kit_gone(n) end)
    end
    -- 床のゴミ
    if chance(50) then
      let sp = seat_pos(x.seat)
      let side = 0.9
      if sp.x > 0 then side = -0.9 end
      append(trash_blocks, create_block({name: "Trash", position: {x: sp.x + side, y: 0.5, z: sp.z}, size: {x: 0.5, y: 0.3, z: 0.5},
                                         color: random(["#E7E5E4", "#FDE68A", "#A8A29E"]), behavior: "trigger", solid: false, tags: ["trash"]}))
    end
  end
  pax = []
end

func clear_trash()
  for b in trash_blocks do kit_gone(b) end
  trash_blocks = []
end

-- 搭乗がおわったら、のこった荷物は しまったことに（ランプを消す）
func stow_all_bags()
  for x in pax do
    if x.want == "bag" then
      x.want = nil
      light(x.seat, "#475569")
    end
  end
end

func stop_requests()
  for x in pax do
    if x.want != nil and x.want != "bag" then
      x.want = nil
      light(x.seat, "#475569")
    end
  end
end

-- 機内サービス中: ときどき だれかが🔔
func request_step()
  if phase().id != "cruise" then return end
  let now = time()
  for x in pax do
    if x.want != nil and now > x.until then
      if x.want != "bag" then
        stats.missed = stats.missed + 1
        if kit_here(x.n) then x.n.say("もういいです…") end
      end
      x.want = nil
      light(x.seat, "#475569")
    end
  end
  let busy = len(filter(pax, func(x) return x.want != nil and x.want != "bag" end))
  let limit = 2 + len(crew()) * 2
  if busy < limit and chance(55) then
    let idle = filter(pax, func(x) return x.want == nil and kit_here(x.n) end)
    if len(idle) > 0 then
      let x = random(idle)
      x.want = random(ITEM_KEYS)
      x.until = now + WANT_SECS
      stats.asked = stats.asked + 1
      light(x.seat, "#FACC15")
      x.n.say("🔔 " + ITEMS[x.want].icon + " " + ITEMS[x.want].name + " ください")
    end
  end
end

func carrying(p)
  let n = 0
  for k in ITEM_KEYS do
    let items = p.items or {}
    n = n + (items[ITEMS[k].name] or 0)
  end
  return n
end

func take_from_galley(p, key)
  let it = ITEMS[key]
  if carrying(p) >= CARRY_MAX then
    p.message("🙌 もう持てない（" + CARRY_MAX + "こまで）", 1)
    return
  end
  p.give_item(it.name, 1, it.icon)
  p.message(it.icon + " " + it.name + " を持った", 0.8)
  p.sound("pop")
end

func serve_seat(p, n)
  let x = pax_at(n)
  if x == nil or x.want == nil or not kit_here(x.n) then return end
  if x.want == "bag" then
    x.want = nil
    light(n, "#475569")
    stats.bags = stats.bags + 1
    kit_give(p, 8)
    add_xp(p, 2)
    x.n.say("ありがとう！")
    p.sound("click")
    kit_quest_progress(p, "bag", 1)
    return
  end
  let it = ITEMS[x.want]
  if not p.has_item(it.name) then
    if kit_ready(p, "need" + n, 3) then p.message("この お客さんは " + it.icon + " " + it.name + "。うしろのギャレーで取ってきて", 1.5) end
    return
  end
  p.take_item(it.name)
  let left = max(0, x.until - time()) / WANT_SECS
  let pay = it.pay + floor(it.pay * left)
  kit_give(p, pay)
  add_xp(p, 3)
  p.served = (p.served or 0) + 1
  stats.served = stats.served + 1
  x.want = nil
  light(n, "#475569")
  x.n.say(random(["ありがとう！", "わあ、うれしい！", "サービス最高！", "いただきます！"]))
  particles("hearts", x.n, {amount: 8})
  p.sound("coin")
  p.message(it.icon + " おまたせしました！ 💰" + pay, 1)
  kit_quest_progress(p, "serve", 1)
end

func pick_trash(p, b)
  if not contains(trash_blocks, b) then return end
  remove(trash_blocks, index_of(trash_blocks, b))
  kit_gone(b)
  p.give_item(TRASH.name, 1, TRASH.icon)
  p.sound("pop")
end

func empty_bin(p)
  let n = (p.items or {})[TRASH.name] or 0
  if n <= 0 then return end
  p.take_item(TRASH.name, n)
  kit_give(p, n * 5)
  add_xp(p, n)
  stats.trash = stats.trash + n
  p.message("🗑 ゴミを " + n + "こ すてた 💰" + n * 5, 1.2)
  kit_quest_progress(p, "clean", n)
end

on tick(dt)
  req_clock = req_clock + dt
  if req_clock < 2 then return end
  req_clock = 0
  request_step()
end

on touch(p, b)
  if p.is_npc then return end
  if contains(b.tags, "seat") then serve_seat(p, tag_num(b, "n"))
  elif contains(b.tags, "galley") and kit_ready(p, "galley", 0.6) then
    for t in b.tags do
      if starts_with(t, "item=") then take_from_galley(p, replace(t, "item=", "")) end
    end
  elif contains(b.tags, "trash") then pick_trash(p, b)
  elif contains(b.tags, "bin") then empty_bin(p)
  elif contains(b.tags, "captain") and kit_ready(p, "captain", 8) then
    let lines = ["こちら機長です。ただいま 雲の上を 気もちよく飛んでいます", "左の窓から 大きな雲が見えます", "もうすぐ " + dest + " です。すてきな旅を！",
                 "乗務員のみなさん、いつも ありがとう"]
    announce("🧑‍✈️ " + random(lines), 3)
    add_xp(p, 1)
  end
end
