-- Runway Star — お題に合わせてコーデしてランウェイを歩くファッションショー
-- お題24種・色パレット5つ・帽子5種・アクセサリー14種（体についてくる）・ポーズ4種・
-- 審査員NPC・NPCモデル（ひとりでも遊べる）・表しょう台・ブティック・クローゼット。
--
-- ファイル:
--   data.absc      表（パレット・帽子・アクセサリー・お題・ポーズ・NPCの名前）
--   common.absc    人さがし・画面・レベルとジェム
--   wardrobe.absc  着がえパネル・アクセサリー・ブティック・クローゼット
--   show.absc      ショーの流れ・ランウェイ・投票・審査員・表しょう台
--   main.absc      このファイル

kit_setup("Runway Star", "お題に合わせてコーデ → ランウェイ → 星で投票", [
  "✨ お題が出たら75秒でコーデ（左のパネル: 服・頭・足・帽子・小物）",
  "🎨 お題に合う色・帽子・小物をえらぶと 審査員の点が上がる",
  "👠 ランウェイでは ポーズボタンでアピール（いろんなポーズで加点）",
  "⭐ ほかの人が歩いているときに ⭐1〜5 で投票",
  "🏆 星の平均（6割）＋ 審査員（4割）で順位。上位3人は表しょう台へ",
  "🛍 ピンクのパッドのブティックで 💎 を使って色や小物を買う",
  "💾 紫のパッドのクローゼットでコーデを3つまで保存"
])
kit_currency = "ジェム"

kit_quest("show", "ショーに出る", 1, 30)
kit_quest("top3", "3位以内に入る", 1, 80)
kit_quest("win", "優勝する", 1, 200)
kit_quest("vote", "10回投票する", 10, 60)
kit_quest("pose", "ポーズを10回", 10, 60)
kit_quest("buy", "ブティックで買い物", 1, 50)
kit_quest("save", "コーデを保存", 1, 30)
kit_quest("lv5", "レベル5", 4, 300)
kit_quest("lv10", "レベル10", 9, 800)

on join(p)
  p.level = 1
  p.xp = 0
  p.wins = 0
  p.palettes = ["basic"]
  p.palette = "basic"
  p.accs = ["wings", "cape"]
  p.saved = {}
  p.outfit = {color: "#EC4899", head: "#FBCFE8", legs: "#111111", hat: "none", size: 1, acc: []}
  apply_outfit(p, p.outfit)
  kit_welcome(p)
  kit_give(p, 100)
  p.ui_button("open_dress", "👗 着がえ", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#C026D3"})
  p.ui_button("open_shop", "🛍 ブティック", {at: "right", dy: -60, w: 150, h: 50, size: 16, bg: "#BE185D"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end

on start()
  every(10, func() kit_leaderboard("⭐ 星の合計") end)
end
