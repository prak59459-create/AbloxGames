-- Crystal Wars — 浮島のクリスタル防衛チーム戦
-- 自分のクリスタルを守りながら、ブロックで橋をかけて相手のクリスタルをこわす。
-- クリスタルがあるうちは何度でも復活。こわされたら最後の1回。最後まで残ったチームの勝ち。
--
-- ファイル:
--   data.absc      表（チーム・お金・ブロック・品物・強化・わな・流れ・称号）
--   common.absc    お金・画面・薬の効き目
--   teams.absc     チーム分け・クリスタル・勝ち負け
--   gens.absc      ジェネレーター（鉄・金・ダイヤ・エメラルド）
--   build.absc     ブロックを置く・こわす
--   shop.absc      お店・武器の持ちかえ
--   upgrades.absc  チーム強化・わな・回復の泉
--   items.absc     どうぐ（火の玉・TNT・パール・たまご・砦・薬・ゴーレム）
--   combat.absc    ダメージ・キル・復活・奈落
--   timeline.absc  試合の流れ（生成アップ・クリスタル全滅・時間切れ）
--   stats.absc     成績・まとめ・レベル・称号
--   main.absc      このファイル

kit_setup("Crystal Wars", "自分のクリスタルを守り、相手のをこわせ", [
  "⬜ 島の灰色のパッド（ジェネレーター）に乗ると鉄と金が拾える",
  "💎 ななめの島でダイヤ、🟩 真ん中の島でエメラルド",
  "🛒 チーム色のパッドでお店。💜 むらさきのパッドでチーム強化とわな",
  "🧱 足場＝前に橋、かべ＝目の前、⬆積む＝上へ。🔄でブロックのしゅるい",
  "🔨 ブロックやクリスタルはタップでこわす（ツルハシで早くなる）",
  "💀 クリスタルがあるうちは5びょうで復活。なくなったら最後！",
  "⏰ 20分でクリスタルが全部くだける。最後まで残ったチームの勝ち"
])
kit_currency = "スター"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["titles", "title", "level", "xp"])
kit_on_load = func(p)
  if p.level != nil then kit_show_level(p) end
end


kit_quest("kill", "敵を10人たおす", 10, 30)
kit_quest("final", "ファイナルキルを3回", 3, 40)
kit_quest("crystal", "クリスタルをこわす", 1, 50)
kit_quest("build", "ブロックを100こ置く", 100, 25)
kit_quest("break", "ブロックを30こわす", 30, 20)
kit_quest("res", "資源を300こ集める", 300, 25)
kit_quest("shop", "お店で10回買う", 10, 15)
kit_quest("upgrade", "チーム強化かわなを3回", 3, 25)
kit_quest("item", "どうぐを5回使う", 5, 15)
kit_quest("win", "試合に勝つ", 1, 60)
kit_quest("title", "称号を手に入れる", 1, 10)

func new_life(p)
  money_reset(p)
  p.blocks = {wool: 16}
  p.block_kind = "wool"
  p.items = {}
  p.sword = 1
  p.armor = 1
  p.pick = 1
  p.bow = 1
  p.has_kb = false
  p.out = false
  p.respawning = false
  p.speed_until = 0
  p.leap_until = 0
  p.slow_until = 0
  p.rally_until = 0
  p.invis_until = 0
  p.fatigue_until = 0
  p.last_hitter = nil
  p.move_state = ""
  if p.own_legs != nil then p.leg_color = p.own_legs end
  if p.team != nil then p.color = TEAM_COLOR[p.team] end
  reset_round_stats(p)
  update_score(p)
end

func controls(p)
  p.ui_button("place_below", "🧱 足場", {at: "right", dy: -150, w: 150, h: 54, size: 17, bg: "#1D4ED8", radius: 14})
  p.ui_button("place_wall", "🧱 かべ", {at: "right", dy: -90, w: 150, h: 50, size: 16, bg: "#1E40AF", radius: 14})
  p.ui_button("place_up", "⬆ 積む", {at: "right", dy: -34, w: 150, h: 46, size: 16, bg: "#1E3A8A", radius: 14})
  p.ui_button("stats", "📊", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  kit_quest_button(p)
  kit_camera_button(p)
end

on start()
  game.respawn_time = -1
  clear_golems()
  block_hp = {}
  setup_teams()
  setup_upgrades()
  setup_gens()
  setup_timeline()
  for p in players() do
    p.ui_remove("sum_box")
    p.ui_remove("respawn_t")
    new_life(p)
    if not p.alive then p.respawn() end
    home(p)
    equip_default(p)
    p.message("🛡 " + TEAM_JP[p.team] + "チーム！ クリスタルを守れ", 3)
  end
  announce("💎 Crystal Wars スタート！ " + len(active) + " チーム", 3)
end

on join(p)
  p.own_legs = p.leg_color
  p.titles = ["none"]
  p.title = "none"
  kit_welcome(p)
  pick_team(p)
  new_life(p)
  controls(p)
  equip_default(p)
  home(p)
  show_crystals()
  if crystal_hp[p.team] != nil and not crystal_alive(p.team) and len(players()) > 1 then
    p.message("⚠ " + TEAM_JP[p.team] + "チームのクリスタルはもうない…（たおされたら観戦）", 3)
  end
end

on leave(p)
  after(0.2, func() check_winner() end)
end
