-- Tower of Chaos — 毎回ちがう、チェックポイントなしのタワー
-- 階のしゅるい14（回るバー・点めつレーザー・見えない床・横風・ふき上げる風…）・特殊ルール9（2つ重なることも）・
-- 上がってくる溶岩・コイン・道具屋（コイル・旗・ジャンプ台）・スキップ投票。
--
-- ファイル:
--   data.absc    表（階のしゅるい・特殊ルール・道具）
--   tower.absc   タワーを組み立てる・動く足場・レーザー・風
--   round.absc   ラウンド・特殊ルール・溶岩・ゴール・スキップ
--   shop.absc    道具屋
--   events.absc  カオスイベント（コインの雨・足場ちぢみ・月面タイム…）
--   style.absc   スキン・最速記録・成績
--   main.absc    このファイル

kit_setup("Tower of Chaos", "チェックポイントなし。落ちたら下から", [
  "🗼 タワーは毎ラウンドちがう形。上の階ほどむずかしい",
  "🟥 赤く光るもの（溶岩・レーザー・回るバー）にさわると下にもどされる",
  "🟩 緑はジャンプ台、黄色い床はすぐ消える、白い床は近づくと見える",
  "🌬 横風の階では横にふきとばされる。水色の風の台で上へ",
  "🪙 コインを拾って 🛒 道具屋でコイルやチェックポイント旗を買える",
  "⚠ ときどきカオスイベント！ コインの雨・足場ちぢみ・月面タイムなど",
  "🎨 コインでスキンを買える。📊 で自分の成績、左上に最速記録",
  "🏆 てっぺんの金色のパッドでクリア！ ⏭ みんなでスキップもできる"
])
kit_currency = "コイン"

kit_quest("floors", "20階ぶん登る", 20, 30)
kit_quest("top", "てっぺんに着く", 1, 80)
kit_quest("nogear", "道具なしでクリア", 1, 150)
kit_quest("coin", "コインを10まい拾う", 10, 20)
kit_quest("gear", "道具を買う", 1, 10)
kit_quest("skin", "スキンを買う", 1, 20)
kit_quest("fast", "3分以内にクリア", 1, 100)

on join(p)
  p.best = 0
  p.gear = []
  p.wins = 0
  p.skins = ["own"]
  p.skin = "own"
  own_colors(p)
  show_record()
  kit_welcome(p)
  apply_mods(p)
  p.ui_button("open_shop", "🛒 道具屋", {at: "right", dy: -120, w: 140, h: 50, size: 17, bg: "#4338CA"})
  p.ui_button("skip", "⏭ スキップ", {at: "right", dy: -60, w: 140, h: 50, size: 16, bg: "#475569"})
  p.ui_button("skins", "🎨 スキン", {at: "right", dy: 0, w: 140, h: 50, size: 16, bg: "#0F766E"})
  p.ui_button("stats", "📊 成績", {at: "right", dy: 60, w: 140, h: 50, size: 16, bg: "#334155"})
  kit_quest_button(p)
  kit_camera_button(p)
  shop_buttons(p)
end
