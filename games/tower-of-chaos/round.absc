-- round.absc — ラウンド
-- ラウンドごとに新しいタワーと特殊ルール（1つか2つ）。制限時間内にてっぺんへ。
-- 上がってくる溶岩ルールでは、下から溶岩がせまってくる。みんなで「スキップ」投票もできる。

let floors = 12
let ends_at = 0
let finished = 0
let mods = []
let lava = nil
let lava_y = -2
let skips = []
let tower_kinds = []
let round_clock = 0
let round_started = 0

func has_mod(id) return contains(mods, id) end

func mod_names()
  let names = []
  for id in mods do
    for m in MODIFIERS do
      if m.id == id then append(names, m.name) end
    end
  end
  return join(names, " ＋ ")
end

func pick_mods()
  mods = []
  let first = kit_pick(MODIFIERS, 1).id
  append(mods, first)
  if first != "none" and random() < 0.3 then
    let second = kit_pick(MODIFIERS, 1).id
    if second != "none" and second != first then append(mods, second) end
  end
end

func apply_mods(p)
  let speed = 1
  let jump = 1
  let gravity = 1
  let size = 1
  if has_mod("fast") then speed = 1.3 end
  if has_mod("jump") then jump = 1.25 end
  if has_mod("tiny") then size = 0.7 end
  if has_mod("lowgrav") then gravity = 0.6 end
  if has_mod("highgrav") then gravity = 1.35 end
  -- カオスイベント
  if event_is("moon") then gravity = gravity * 0.55 end
  if event_is("turbo") then speed = speed * 1.4 end
  if event_is("giant") then size = size * 1.5 end
  -- 道具
  if contains(p.gear, "speed") or contains(p.gear, "fusion") then speed = speed * 1.25 end
  if contains(p.gear, "gravity") or contains(p.gear, "fusion") then gravity = gravity * 0.75 end
  p.speed = speed
  p.jump = jump
  p.gravity = gravity
  p.size = size
end

on start()
  finished = 0
  skips = []
  pick_mods()
  floors = random(10, 13)
  if has_mod("long") then floors = floors + 4 end
  tower_kinds = build_tower(floors)
  ends_at = time() + ROUND_TIME
  round_started = time()
  if has_mod("dark") then world.light = 0.2 else world.light = 0.7 end
  lava = nil
  lava_y = -2
  if has_mod("lava") then
    lava = create_block({name: "Rising Lava", position: {x: 0, y: -2, z: 0}, size: {x: 40, y: 0.6, z: 40}, color: "#EA580C",
                         material: "neon", behavior: "hazard", solid: false, opacity: 0.85})
  end
  announce("🗼 新しいタワー（" + floors + "階）！ 特殊ルール: " + mod_names(), 4)
  ui_text("mod", "特殊ルール: " + mod_names(), {at: "top_right", dy: 120, dx: -10, size: 14})
  for p in players() do
    p.done = false
    p.best = 0
    p.falls_round = 0
    p.gear = []
    p.flag = nil
    p.flag_used = false
    p.pad_used = false
    apply_mods(p)
    shop_buttons(p)
  end
  every(3, func() animate_tower() end)
  every(1.5, func() blink_lasers() end)
end

on tick(dt)
  round_clock = round_clock + dt
  if round_clock < 1 then return end
  round_clock = 0
  let left = ends_at - time()
  ui_text("timer", "⏱ " + kit_clock(left), {at: "top", dy: 26, size: 26, bold: true})
  for p in players() do
    let floor_now = clamp(floor(p.y / HEIGHT), 0, floors)
    if floor_now > (p.best or 0) then
      p.best = floor_now
      if floor_now > (p.top_floor or 0) then p.top_floor = floor_now end
      if floor_now > 0 and floor_now % 4 == 0 then kit_give(p, 5) end
      kit_quest_progress(p, "floors", 1)
    end
    let kind_name = ""
    if floor_now >= 1 and floor_now <= len(tower_kinds) then
      for sct in SECTIONS do
        if sct.id == tower_kinds[floor_now] then kind_name = "「" + sct.name + "」" end
      end
    end
    p.ui_text("height", "🧗 " + floor_now + " / " + floors + " 階 " + kind_name + "（最高 " + p.best + "）", {at: "top", dy: 62, size: 16})
  end
  -- 上がってくる溶岩
  if lava != nil then
    lava_y = lava_y + floors * HEIGHT / ROUND_TIME * 1.3
    lava.position = {x: 0, y: lava_y, z: 0}
  end
  if left <= 0 then kit_finish("⏰ 時間切れ！ 新しいタワーを作ります", 5) end
end

-- MARK: ゴールとスキップ

func goal(p)
  if p.done then return end
  p.done = true
  finished = finished + 1
  let reward = max(20, 100 - finished * 20)
  if event_is("double") then reward = reward * 2 end
  kit_give(p, reward)
  p.wins = (p.wins or 0) + 1
  p.score = p.wins
  announce("🏆 " + p.name + " がてっぺんに到着！（" + finished + " 位・🪙+" + reward + "）", 4)
  p.sound("goal")
  kit_quest_progress(p, "top", 1)
  if len(p.gear) == 0 then kit_quest_progress(p, "nogear", 1) end
  record_clear(p, time() - round_started)
  kit_later(p, 3, func() p.teleport(block("Spawn 1")) end)
  if finished >= len(players()) then kit_finish("🎉 全員クリア！ 新しいタワーへ", 6) end
end

func vote_skip(p)
  if contains(skips, p.id) then return end
  append(skips, p.id)
  let need = max(1, ceil(len(players()) * 0.6))
  announce("⏭ スキップ投票 " + len(skips) + " / " + need, 2)
  if len(skips) >= need then kit_finish("⏭ スキップ！ 新しいタワーへ", 3) end
end

on touch(p, b)
  if p.is_npc then return end
  if contains(b.tags, "goal") then
    goal(p)
  elif contains(b.tags, "coin") then
    kit_gone(b)
    kit_give(p, 3)
    p.sound("collect")
    kit_quest_progress(p, "coin", 1)
    p.coins_picked = (p.coins_picked or 0) + 1
  elif contains(b.tags, "fan") then
    p.launch(0, 22, 0)
  end
end

on death(victim, killer)
  if victim.is_npc then return end
  victim.falls = (victim.falls or 0) + 1
  victim.falls_round = (victim.falls_round or 0) + 1
end

on respawn(p)
  if p.is_npc then return end
  -- 旗があれば旗の場所へ
  if p.flag != nil then
    p.teleport(p.flag)
    p.message("🚩 チェックポイント旗にもどった（もう使えない）", 2)
    p.flag = nil
    kit_gone(p.flag_block)
  end
  apply_mods(p)
end

on button(p, id)
  if id == "skip" then vote_skip(p) end
end
