  {id: "allergy", name: "アレルギー", say: "くしゃみが止まらない", temp: 36.6, pulse: 78, bp: "ふつう",
   clue: "目が赤くてかゆい・花粉の季節", triage: 1, med: "allergy_med"},
  {id: "asthma", name: "ぜんそく", say: "息が苦しい…", temp: 36.9, pulse: 118, bp: "ふつう",
   clue: "ゼーゼーという音がする", triage: 2, med: "inhaler"},
  {id: "heatstroke", name: "熱中症", say: "頭がくらくらする…", temp: 39.1, pulse: 124, bp: "低め",
