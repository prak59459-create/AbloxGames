  {id: "stomach", name: "胃腸炎", say: "おなかがいたい…", temp: 37.8, pulse: 92, bp: "低め",
   clue: "おなか全体がいたい・はきけ", triage: 2, med: "stomach_med"},
  {id: "appendix", name: "盲腸", say: "おなかがいたい…", temp: 38.4, pulse: 112, bp: "ふつう",
   clue: "右下をおすと強くいたむ", triage: 3, op: "appendix"},
  {id: "fracture", name: "骨折", say: "腕が…動かせない！", temp: 36.7, pulse: 104, bp: "高め",
