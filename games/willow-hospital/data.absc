  {id: "cut", name: "深い切り傷", say: "手から血が止まらない！", temp: 36.8, pulse: 100, bp: "低め",
   clue: "深い傷・ぬう必要がある", triage: 3, op: "stitch"},
  {id: "heart", name: "心臓発作", say: "息が苦しい…胸が！", temp: 36.8, pulse: 132, bp: "高め",
   clue: "胸をしめつけられるいたみ", triage: 3, op: "heart"}
]
