-- Willow Hospital RP — 病院のお仕事RP
-- 6つの役割、トリアージ、バイタル、12の病気の診断、薬の調合、手術、救急車、病院の設備、1日の目標、できごと。
--
-- ファイル:
--   data.absc       表（病気・薬・手術・役割・設備・できごと）
--   common.absc     道具・ランクとお給料・資金と評判・画面
--   ambulance.absc  救急要請と搬送
--   care.absc       🩺ボタン・バイタル・診察・急変・医学書
--   hospital.absc   設備・1日の流れ・できごと
--   patients.absc   来院・受付・ベッド・機嫌・退院
--   pharmacy.absc   薬局の調合と配達
--   roles.absc      役割とプレイヤーの患者さん
--   surgery.absc    手術室
--   main.absc       このファイル

kit_setup("Willow Hospital", "チームで患者さんを元気に", [
  "🎭 役割をえらぶ: 医者・看護師・外科医・薬剤師・救急隊・患者（自分の役割の仕事は⭐1.5倍）",
  "📋 受付（緑）でトリアージ → 🛏 ベッドの横で🩺: バイタル → 診察（📖医学書で見分ける）",
  "💊 薬局（紫）で調合してベッドへ / 🔪 手術が必要なら手術台へ運んで手順どおりに",
  "🚑 救急要請が来たら救急車（入口の右）で出動。けが人を🩺 → 🚑で搬送",
  "🏥 治すと病院の資金。スタッフルーム（青）でベッドや設備を買おう。🎯 1日の目標も！"
])

kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["role_pts"])

kit_shop_title = "売店"
kit_shop_add("c_white", "まっ白な白衣", 60, func(p) p.color = "#F8FAFC" end)
kit_shop_add("c_blue", "スクラブ（ブルー）", 60, func(p)
  p.color = "#2563EB"
  p.leg_color = "#1E40AF"
end)
kit_shop_add("c_pink", "スクラブ（ピンク）", 60, func(p)
  p.color = "#F472B6"
  p.leg_color = "#BE185D"
end)
kit_shop_add("c_mint", "スクラブ（ミント）", 60, func(p)
  p.color = "#5EEAD4"
  p.leg_color = "#0F766E"
end)
kit_shop_add("h_cap", "手術帽", 50, func(p)
  p.own_hat = "cap"
  p.hat = "cap"
end)
kit_shop_add("h_halo", "天使の輪（名医のしるし）", 400, func(p)
  p.own_hat = "halo"
  p.hat = "halo"
end)
kit_shop_add("donate", "病院に寄付（資金 +100）", 100, func(p)
  add_funds(100)
  rate_up(0.05)
  announce("💝 " + p.name + " が病院に寄付！ 資金 +100", 2.5)
  kit_quest_progress(p, "donate", 1)
end)

kit_quest("role", "役割をえらぶ", 1, 30)
kit_quest("triage", "トリアージを5回正解", 5, 100)
kit_quest("vitals", "バイタルを10回測る", 10, 120)
kit_quest("diagnose", "正しい診断を10回", 10, 200)
kit_quest("mix", "薬を10回調合", 10, 150)
kit_quest("deliver", "薬を10回とどける", 10, 120)
kit_quest("surgery", "手術を3回成功", 3, 250)
kit_quest("heart", "心臓の緊急処置を成功", 1, 300)
kit_quest("stabilize", "急変した患者さんを安定させる", 1, 120)
kit_quest("rescue", "救急車で5人運ぶ", 5, 250)
kit_quest("cure", "患者さんを20人治す（手伝いでもOK）", 20, 400)
kit_quest("vip", "VIPを時間内に治す", 1, 300)
kit_quest("upgrade", "病院の設備を5つ買う", 5, 200)
kit_quest("day", "1日の目標を達成", 1, 150)
kit_quest("patient", "患者として治してもらう", 1, 60)
kit_quest("allroles", "5つの役割でお仕事", 5, 250)
kit_quest("rank", "昇進を3回", 3, 300)
kit_quest("donate", "病院に寄付する", 1, 50)

on start()
  game.respawn_time = 2
  after(3, func() new_patient(ill_by_id("cold"), false) end)
  after(9, func() new_patient(nil, false) end)
  every(10, func() kit_leaderboard("🏥") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 30)
  p.role_pts = {}
  p.role = nil
  p.ui_button("open_roles", "🎭 役割", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  p.ui_button("book", "📖 医学書", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#334155"})
  p.ui_button("upgrades", "🏥 設備", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#0369A1"})
  p.ui_button("care", "🩺", {at: "bottom_right", dx: -120, dy: -160, w: 110, h: 70, size: 30, bg: "#16A34A", radius: 18})
  p.ui_button("amb", "🚑", {at: "bottom_right", dx: -240, dy: -160, w: 90, h: 60, size: 26, bg: "#DC2626", radius: 18})
  hud(p)
  hospital_hud()
  kit_later(p, 4.2, func() role_panel(p) end)
end

on leave(p)
  leave_role(p)
end
