-- Life Ville — 5つのゲージを気にしながらくらすライフシム
-- ゲージ（おなか・元気・楽しさ・清潔・つながり）と気分、4つの仕事（ミニゲーム・昇進）、
-- スキル4つ、家具3段階、絵を描いて売る、昼夜と睡眠、光熱費、お祭り。
--
-- ファイル:
--   data.absc     表（ゲージ・仕事・スキル・家具・料理・マーク）
--   common.absc   小さな道具・気分・スキル・画面
--   jobs.absc     仕事のシフトとミニゲーム・昇進
--   life.absc     ゲージ・家・スキル・会話・昼夜・光熱費・お祭り
--   main.absc     このファイル

kit_setup("Life Ville", "くらしを整えて、キャリアを上げよう", [
  "🍔⚡🎈🧼💬 5つのゲージが減っていく。平均が「気分」になり、お給料にひびく",
  "🏠 黄色い看板で家。冷蔵庫・ベッド・テレビ・シャワーの上に立つと回復",
  "💼 仕事のパッドで出勤: オフィス・ダイナー・公園・ジム。12回うまくいくと昇進",
  "💪 ジムのマシン・♟ 公園のチェス・🎨 家のイーゼルでスキル。絵は売れる",
  "🌙 夜はベッドで元気が2倍。🧾 3分ごとに光熱費",
  "🎪 5分ごとに公園でお祭り。💬 近くの人と話そう"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["skills", "job_xp", "furniture", "earned"])

for key in keys(FURNITURE) do
  let f = FURNITURE[key]
  for t in 2 to len(f.tiers) do
    let tier = f.tiers[t]
    let fk = key
    let tn = t
    kit_shop_add(key + "_" + t, tier.name, tier.price, func(p)
      if p.furniture[fk] >= tn then
        p.message("もう持っている", 1)
        kit_give(p, tier.price)
        return
      end
      p.furniture[fk] = tn
      p.message("🛋 " + tier.name + "！ 回復が速くなった", 2)
      kit_quest_progress(p, "furniture", 1)
    end)
  end
end
kit_shop_add("coffee", "☕ コーヒー（元気+30）", 20, func(p) add_need(p, "energy", 30) end)
kit_shop_add("snack", "🍙 おにぎり（おなか+25）", 15, func(p) add_need(p, "hunger", 25) end)

kit_quest("home", "家を手に入れる", 1, 30)
kit_quest("jobs", "仕事をはじめる", 1, 30)
kit_quest("tasks", "仕事を30回こなす", 30, 200)
kit_quest("shifts", "シフトを5回", 5, 150)
kit_quest("promo", "昇進する", 1, 200)
kit_quest("skill", "スキルのレベルを上げる", 3, 150)
kit_quest("skill5", "スキルをLv.5に", 1, 400)
kit_quest("gym", "ジムで30びょう走る", 30, 100)
kit_quest("paint", "絵を3まい売る", 3, 150)
kit_quest("furniture", "家具をグレードアップ", 1, 100)
kit_quest("talk", "5回おしゃべり", 5, 100)
kit_quest("happy", "ごきげん（平均80）で過ごす", 3, 150)
kit_quest("festival", "お祭りに行く", 1, 80)

let owners = {}

on start()
  every(10, func() kit_leaderboard("💰") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.needs = {hunger: 80, energy: 80, fun: 80, hygiene: 80, social: 60}
  p.skills = {}
  p.job_xp = {}
  p.furniture = {hunger: 1, energy: 1, fun: 1, hygiene: 1}
  p.earned = 0
  kit_give(p, 60)
  p.ui_button("talk", "💬 話す", {at: "right", dy: 0, w: 150, h: 46, size: 16, bg: "#0EA5E9"})
  show(p)
end

on leave(p)
  if p.home != nil then owners[p.home] = nil end
  for b in blocks("litter_" + p.id) do gone(b) end
end

on touch(p, b)
  if p.is_npc or not ready(p) then return end
  if contains(b.tags, "claim") then
    let n = split(b.name, " ")[2]
    if owners[n] == nil and p.home == nil then
      owners[n] = p.id
      p.home = n
      p.message("🏠 Home " + n + " があなたの家に！ 家具の上に立つとゲージが回復", 3)
      kit_quest_progress(p, "home", 1)
    end
  elif contains(b.tags, "need") and not contains(b.tags, "public") and p.home == nil and quiet_ready(p, "home_hint", 5) then
    p.message("自分の家を手に入れよう（黄色い看板）", 1.5)
  end
end
