-- common.absc — Maple Bay のみんなで使う道具
-- お金の入り方、目的地の矢印、ボタンの出し入れ、ニュース、人さがし。
-- ほかのファイル（homes / jobs / phone / town / vehicles / main）がここを使う。

-- MARK: 人さがし

func player_by_id(id)
  if id == nil then return nil end
  for p in players() do
    if p.id == id then return p end
  end
  return nil
end

-- いちばん近い場所の名前（ニュースや目的地の説明に使う）
func place_name(pos)
  let best = "街"
  let best_d = 0
  for place in PLACES do
    let b = block(place.block)
    if b != nil then
      let d = distance(pos, b)
      if best == "街" or d < best_d then
        best = place.name
        best_d = d
      end
    end
  end
  for n in 1 to 8 do
    let door = block("House " + n + " Door")
    if door != nil and distance(pos, door) < best_d then
      best = "🏠 House " + n
      best_d = distance(pos, door)
    end
  end
  return best
end

-- 人のいない「Town Spot」を1つ（avoid からは min_d 以上はなれた所）
func random_spot(avoid, min_d)
  let spots = []
  for i in 1 to 12 do
    let b = block("Town Spot " + i)
    if b != nil then
      if avoid == nil or distance(avoid, b) >= min_d then append(spots, b) end
    end
  end
  if len(spots) == 0 then return block("Town Spot 1") end
  return random(spots)
end

-- MARK: お金

-- お金をあげる。仕事・ボーナス・おこづかいは全部ここを通る
func earn(p, amount, why)
  if not kit_here(p) or amount == 0 then return end
  let n = floor(amount)
  kit_give(p, n)
  p.earned = (p.earned or 0) + max(0, n)
  update_score(p)
  if why != nil and n > 0 then p.message("💰 +" + kit_short(n) + "  " + why, 1.8) end
  if kit_money(p) + (p.bank or 0) >= 5000 then kit_badge(p, "rich", BADGES.rich) end
end

-- ランキングの点数は「持っているお金 + 銀行」
func update_score(p)
  p.score = floor(kit_money(p) + (p.bank or 0))
end

func spend(p, price)
  if not kit_pay(p, price) then return false end
  update_score(p)
  return true
end

-- MARK: ニュース（スマホで読める）

let NEWS = []
func news(text)
  let stamp = clock_text()
  insert(NEWS, 1, stamp + "  " + text)
  while len(NEWS) > 10 do remove(NEWS) end
  chat("📰 " + text)
end

-- MARK: ボタンの出し入れ（同じものを何度も送らない）

-- slot: "job" / "talk" / "car" など。label が nil ならボタンを消す
func set_action(p, slot, label, color)
  let key = "act_" + slot
  if p.actions == nil then p.actions = {} end
  if p.actions[slot] == label then return end
  p.actions[slot] = label
  if label == nil then
    p.ui_remove(key)
    return
  end
  let dx = 0
  if slot == "talk" then dx = -170 end
  if slot == "job" then dx = 0 end
  if slot == "job2" then dx = 170 end
  p.ui_button(key, label, {at: "bottom", dx: dx, dy: -96, w: 160, h: 52, size: 16, bg: color or "#0EA5E9", radius: 16})
end

-- 1行の表示。同じ文なら送らない
func set_line(p, id, text, options)
  if p.lines == nil then p.lines = {} end
  if p.lines[id] == text then return end
  p.lines[id] = text
  if text == nil then
    p.ui_remove(id)
  else
    p.ui_text(id, text, options)
  end
end

-- MARK: 目的地（光の柱と矢印）

let ARROWS = ["⬆️", "↗️", "➡️", "↘️", "⬇️", "↙️", "⬅️", "↖️"]

func arrow_to(p, pos)
  let dx = pos.x - p.x
  let dz = pos.z - p.z
  let bearing = atan2(dx, 0 - dz)
  let rel = bearing - p.yaw
  while rel < -180 do rel = rel + 360 end
  while rel >= 180 do rel = rel - 360 end
  let i = floor(((rel + 360 + 22.5) % 360) / 45) + 1
  return ARROWS[i]
end

-- 目的地をセット。target は位置・ブロック・キャラクター
func set_goal(p, target, text, color)
  clear_goal(p)
  if target == nil then return end
  p.goal = target
  p.goal_text = text
  let pos = target
  if type(target) != "map" then pos = target.position end
  if pos == nil then return end
  p.goal_beam = create_block({name: "Goal " + p.name, shape: "cylinder", position: {x: pos.x, y: 8, z: pos.z},
                              size: {x: 0.7, y: 16, z: 0.7}, color: color or "#FDE047", material: "neon",
                              solid: false, opacity: 0.55, tags: ["goal_beam"]})
end

func clear_goal(p)
  gone(p.goal_beam)
  p.goal_beam = nil
  p.goal = nil
  p.goal_text = nil
  set_line(p, "goal", nil, nil)
end

func goal_position(p)
  let g = p.goal
  if g == nil then return nil end
  let t = type(g)
  if t == "map" then return g end
  if (t == "npc" or t == "player") and not kit_here(g) then return nil end
  return g.position
end

func goal_distance(p)
  let pos = goal_position(p)
  if pos == nil then return 99999 end
  return distance(p, pos)
end

-- 目的地が動く（人を追う）ときは柱もついていく
func refresh_goal(p)
  let pos = goal_position(p)
  if pos == nil then
    if p.goal != nil then clear_goal(p) end
    return
  end
  if p.goal_beam != nil and type(p.goal) != "map" and distance(p.goal_beam, {x: pos.x, y: 8, z: pos.z}) > 2 then
    p.goal_beam.position = {x: pos.x, y: 8, z: pos.z}
  end
  let d = floor(distance(p, pos))
  if d > 30 then d = floor(d / 5) * 5 end
  set_line(p, "goal", arrow_to(p, pos) + " " + p.goal_text + "  " + d + "m",
           {at: "top", dy: 92, size: 17, bold: true, color: "#FDE047"})
end

let goal_clock = 0
on tick(dt)
  -- 0.3秒ごと（毎回送ると通信が多すぎる）
  goal_clock = goal_clock + dt
  if goal_clock < 0.3 then return end
  goal_clock = 0
  for p in players() do
    if p.goal != nil then refresh_goal(p) end
  end
end

on leave(p)
  clear_goal(p)
end

-- MARK: 小さな道具

-- ブロックを消す（もう消えていても大丈夫）
func gone(b)
  if b != nil and b.destroy != nil then b.destroy() end
end

func cooldown_ok(p, key, seconds)
  if p.cool == nil then p.cool = {} end
  let last = p.cool[key]
  if last != nil and time() - last < seconds then return false end
  p.cool[key] = time()
  return true
end

func pick_other(list, not_this)
  let others = filter(list, func(x) return x != not_this end)
  if len(others) == 0 then return not_this end
  return random(others)
end

-- 花火を1発（光る玉が上がって消える）
func firework(pos)
  let colors = ["#F43F5E", "#F59E0B", "#22D3EE", "#A3E635", "#E879F9", "#FDE047"]
  let b = create_block({name: "Firework", shape: "sphere", position: {x: pos.x, y: pos.y + 1, z: pos.z}, size: 0.6,
                        color: random(colors), material: "neon", solid: false})
  b.move(random(-3, 3), 14 + random(0, 6), random(-3, 3), 1.2)
  after(1.3, func()
    b.size = 4
    b.opacity = 0.6
  end)
  after(1.9, func() gone(b) end)
end
