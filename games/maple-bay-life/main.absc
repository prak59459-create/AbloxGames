-- Maple Bay Life RP — 街でくらすロールプレイ
-- 家を買う・8つの仕事・車・スマホ・住人・天気・イベント・市長選挙。勝ち負けはなし。
--
-- ファイル:
--   data.absc      表（仕事・家・家具・乗り物・料理・クイズ・場所・天気）
--   common.absc    お金・目的地の矢印・ボタン・ニュース
--   homes.absc     家・カギ・ペンキ・家具・合いかぎ・パーティー
--   jobs.absc      8つの仕事（警察・医者・シェフ・消防・先生・配達・タクシー・市民）
--   phone.absc     📱スマホ（地図・送金・銀行・ニュース・実績・通報・タクシー・出前）
--   town.absc      時計と天気・住人NPC・イベント・市長選挙・市場・噴水
--   vehicles.absc  乗り物・ガソリン・クラクション・ニトロ
--   main.absc      このファイル。はじめの準備とクエスト

kit_setup("Maple Bay Life", "家・仕事・車・スマホ。好きなように街でくらそう", [
  "💼 仕事: 職場のパッドをふむか💼ボタン。黄色い光の柱が次の目的地",
  "👮 警察はどろぼう逮捕 / 🩺 医者は病人を治療 / 🍳 シェフは料理を届ける",
  "🚒 消防士は火事を消す / 📚 先生は授業 / 📦 配達 / 🚕 タクシー",
  "🏠 家のドアに入ると買える。🏠ボタンでカギ・ペンキ・家具・パーティー",
  "🚗 車屋（オレンジ）で車を買って🚗ボタンで乗る。ガソリンは緑のパッド",
  "📱 スマホ: ワープ・送金・銀行・ニュース・通報・タクシー・出前・選挙",
  "💬 住人のそばで「話す」。なかよくなると お使いやプレゼント",
  "🏛 市長選挙で選ばれると、お祭りやボーナスを出せる",
  "チャット: /home /job /phone /car"
])
kit_currency = "コイン"
kit_level_base = 40

-- MARK: クエスト（📜ボタン）

kit_quest("job", "仕事につく", 1, 50)
kit_quest("work", "仕事を20回こなす", 20, 300)
kit_quest("house", "家を買う", 1, 100)
kit_quest("furniture", "家具を5つ置く", 5, 150)
kit_quest("car", "乗り物を買う", 1, 100)
kit_quest("gas", "ガソリンを入れる", 1, 30)
kit_quest("thief", "どろぼうを逮捕", 1, 150)
kit_quest("fire", "火事を3回消す", 3, 200)
kit_quest("cure", "住人を3人治療", 3, 150)
kit_quest("cook", "料理を5回届ける", 5, 200)
kit_quest("parcel", "荷物を10こ届ける", 10, 200)
kit_quest("taxi", "お客さんを5人運ぶ", 5, 200)
kit_quest("class", "授業を2回する", 2, 150)
kit_quest("quiz", "クイズに5問正解", 5, 100)
kit_quest("talk", "住人と10回話す", 10, 100)
kit_quest("errand", "お使いを3回", 3, 150)
kit_quest("snack", "市場で3回買い物", 3, 60)
kit_quest("party", "パーティーを開く/行く", 1, 80)
kit_quest("festival", "お祭りに参加", 1, 80)
kit_quest("vote", "選挙で投票", 1, 30)
kit_quest("bank", "銀行に合計1000あずける", 1000, 200)

-- レベルが上がるとおこづかい
kit_on_level = func(p)
  earn(p, 30 * p.level, "レベル " + p.level + " のおいわい")
end

-- MARK: 入ってきた人

on join(p)
  -- 持ち物と記録
  p.job_xp = {}
  p.jobs_tried = []
  p.parcels = []
  p.inventory = []
  p.garage = ["walk", "bike"]
  p.vehicle = "walk"
  p.fuel = 100
  p.bank = 0
  p.friend = {}
  p.base_legs = p.leg_color
  p.level = 1
  p.xp = 0

  kit_welcome(p)
  kit_give(p, 300)
  update_score(p)
  kit_show_level(p)
  set_job(p, "citizen")
  vehicle_hud(p)

  -- 右のボタン列
  p.ui_button("open_jobs", "💼 仕事", {at: "right", dy: -180, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  p.ui_button("home", "🏠 家", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#16A34A"})
  p.ui_button("phone", "📱 スマホ", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#334155"})
  p.ui_button("car_menu", "🚗 乗り物", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#EA580C"})
  kit_shop_button(p)
  kit_quest_button(p)
  kit_camera_button(p)
  if mayor_id != nil then p.message("🏛 いまの市長は " + mayor_name + " です", 3) end
end

-- MARK: ショップ（見た目）

kit_shop_title = "おしゃれショップ"
kit_shop_add("crown", "👑 王冠（市長みたい）", 800, func(p) p.hat = "crown" end)
kit_shop_add("halo", "😇 天使の輪", 150, func(p) p.hat = "halo" end)
kit_shop_add("antenna", "📡 アンテナ", 80, func(p) p.hat = "antenna" end)
kit_shop_add("cap", "🧢 キャップ", 50, func(p) p.hat = "cap" end)
kit_shop_add("red", "❤️ 赤い服", 60, func(p) p.color = "#DC2626" end)
kit_shop_add("mint", "💚 ミントの服", 60, func(p) p.color = "#34D399" end)
kit_shop_add("tall", "📏 背が高くなる", 200, func(p) p.size = 1.25 end)
kit_shop_add("small", "🐭 小さくなる", 200, func(p) p.size = 0.75 end)

-- MARK: チャットのコマンド

on chat(p, text)
  if text == "/home" then
    if p.home != nil then
      p.position = home_inside(p.home)
    else
      home_menu(p)
    end
  elif text == "/job" then
    jobs_menu(p)
  elif text == "/phone" then
    phone_open(p)
  elif text == "/car" then
    garage_menu(p)
  end
end
