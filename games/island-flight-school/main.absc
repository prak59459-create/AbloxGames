-- Island Flight School — 島の空港でパイロット
-- 出発ロビーでフライトをえらぶと、飛行機に乗って滑走路へ。➕➖ でスロットル、⬆⬇ で上がる・下がる。
-- 行き先の島の滑走路に ふんわり着陸するとお金とXP。ランクが上がると大きな飛行機に乗れる。
--
-- ファイル:
--   ../../lib/kit_ride.absc  飛行機の見た目
--   data.absc      飛行機5機・ランク・空港
--   flight.absc    飛行機の動き・離陸・着陸・海
--   missions.absc  フライト・ランク・格納庫
--   main.absc      このファイル

kit_setup("Island Flight School", "島から島へ。きみは今日から パイロット！", [
  "🛫 水色のパッド（出発ロビー）か 📋 ボタンでフライトをえらぶ",
  "➕ でスロットルを上げて速く。速くなったら ⬆ で離陸",
  "⬆⬇ は2段階。⏺ で水平。おそすぎると失速して落ちる",
  "🛬 行き先の滑走路に ⬇1段目で ふんわり おりると「バター着陸」でボーナス",
  "🌊 海におちると救助ボートで空港へ（お仕事はやりなおし）",
  "🛩 オレンジのパッド（格納庫）で飛行機。ランクが上がると大きな飛行機に"
])
kit_keep(["planes", "plane", "paint", "pxp", "trips", "landings", "earned", "at_airport"])

kit_quest("takeoff", "離陸する", 1, 50)
kit_quest("land", "滑走路に着陸", 1, 100)
kit_quest("trip", "お客さんを3回 はこぶ", 3, 250)
kit_quest("butter", "バター着陸を3回", 3, 300)
kit_quest("plane", "飛行機を買う", 1, 150)

on join(p)
  kit_welcome(p)
  kit_show_money(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.planes = ["cub"]
  p.plane = "cub"
  p.at_airport = 1
  p.camera_distance = 12
  p.ui_button("flights", "📋 フライト", {at: "right", dy: -110, w: 140, h: 46, size: 15, bg: "#0369A1"})
  p.ui_button("hangar", "🛩 格納庫", {at: "right", dy: -58, w: 140, h: 46, size: 15, bg: "#B45309"})
end

kit_on_load = func(p)
  if p.fs == nil and (p.at_airport or 1) != 1 then
    let gate = block("Gate " + p.at_airport)
    if gate != nil then p.teleport(gate.position + {x: 3, y: 1, z: 0}) end
  end
end

on leave(p)
  p.fs = nil
end

on start()
  world.music = "adventure"
  every(12, func() kit_leaderboard("✈️ フライト") end)
end

let score_clock = 0
on tick(dt)
  score_clock = score_clock + dt
  if score_clock < 1 then return end
  score_clock = 0
  for p in players() do
    if (p.trips or 0) != p.score then p.score = p.trips or 0 end
  end
end
