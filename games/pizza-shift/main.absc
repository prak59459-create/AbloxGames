-- Pizza Shift — みんなでピザ屋を回すお仕事ゲーム
-- レジ → 生地 → ソース → チーズ → 具 → オーブン（こげに注意）→ 箱 → 手わたし / 配達。
-- 材料はトラックから運ぶ。店の評価（★）とお客さんの数、店のお金で強化、階級で給料アップ。
--
-- ファイル:
--   data.absc     表（ピザ・具・強化・階級・給料）
--   common.absc   小さな道具・給料・手に持っているもの
--   shop.absc     営業日・評価・お客さん・配達注文・強化・1日のまとめ
--   kitchen.absc  持ち場（レジ・キッチン・オーブン・箱・材料・事務所・ロッカー・スクーター）
--   main.absc     このファイル

kit_setup("Pizza Shift", "チームワークでピザを届けよう", [
  "🧾 レジ（緑）: お客さんの吹き出しと同じピザを注文に入れる",
  "🍕 生地 → ソース → チーズ → 具（レシピどおり）の順にさわる",
  "🔥 オーブン: 入れて焼けたら、こげる前に取り出す（✅の数字がこげるまで）",
  "📦 箱の台で箱に入れて、店内のお客さんに近づくとわたせる",
  "🚚 配達（電話の注文）は House の玄関へ。🛵 スクーターが速い",
  "📦 材料が減ったら、裏のトラック（青）→ 奥の棚へ運ぶ",
  "🏢 事務所（むらさき）で店のお金を使って強化。★が高いほどお客さんが来る"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["job_xp"])

kit_quest("orders", "注文を10受ける", 10, 100)
kit_quest("bake", "ピザを10枚焼く", 10, 120)
kit_quest("serve", "店内で5回わたす", 5, 100)
kit_quest("deliver", "5回配達する", 5, 200)
kit_quest("supply", "材料を3回運ぶ", 3, 80)
kit_quest("upgrade", "店を強化する", 1, 150)
kit_quest("rank", "昇進する", 1, 100)
kit_quest("days", "3日働く", 3, 300)
kit_quest("mvp", "1日のMVPになる", 1, 200)
kit_quest("stars5", "★5の日をむかえる", 1, 400)

let worker_clock = 0

on start()
  for n in npcs() do n.destroy() end
  every(10, func() kit_leaderboard("💰") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.job_xp = 0
  p.day_pay = 0
  p.crate = false
  p.riding = false
  kit_show_money(p)
  p.ui_button("drop", "🗑 手ばなす", {at: "right", dy: 0, w: 150, h: 46, size: 16, bg: "#6B7280"})
  p.color = "#DC2626"
  p.hat = "cap"
  hud(p)
end

on tick(dt)
  worker_clock = worker_clock + dt
  if worker_clock < 0.5 then return end
  worker_clock = 0
  for p in players() do
    if ready(p) and p.box != nil then carry_step(p) end
  end
  ui_text("oven", oven_line(), {at: "top", dy: 72, size: 13, color: "#FDBA74"})
end
