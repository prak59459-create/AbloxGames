-- Lawn Mower Kings — 芝かりキング
-- 芝の上を走ると、芝かり機のまわりの草がかれて お金が入り、草がバッグにたまる。
-- バッグがいっぱいになったら たい肥場で お金にかえる。刃・エンジン・バッグを強くして、大きな庭へ。
--
-- ファイル:
--   ../../lib/kit_ride.absc  芝かり機の見た目と速さ
--   data.absc   庭5つ・改造・草の色
--   mow.absc    芝かり・草がのびる・たい肥
--   shop.absc   芝かり機屋さん・庭のリスト
--   main.absc   このファイル

kit_setup("Lawn Mower Kings", "ぼうぼうの草を、ピカピカの芝生に！", [
  "🌱 こい緑の草の上を走ると かれる。のびている草ほど お金になる",
  "🧺 バッグがいっぱいになったら 茶色のパッド（たい肥場）で お金に",
  "🚜 黄緑のパッドで 刃・エンジン・バッグを強く（刃Lv2で のる芝かり機）",
  "🗺 青いパッドか 🗺 ボタンで 新しい庭をかりる・行く",
  "✨ 庭をぜんぶかると ボーナス！ 金の草は おたから",
  "🌿 草は少しずつ のびてくる。何回でも かれる"
])
kit_keep(["ups", "yards", "bag", "tiles", "paint"])

kit_quest("mow", "100マス かる", 100, 150)
kit_quest("compost", "たい肥にする", 1, 50)
kit_quest("upgrade", "改造を3回", 3, 200)
kit_quest("yard", "新しい庭をかりる", 1, 150)
kit_quest("perfect", "庭をピカピカにする", 1, 300)
kit_quest("gold", "金の草をかる", 1, 200)

kit_on_load = func(p) mower_look(p) end

on join(p)
  kit_welcome(p)
  kit_show_money(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.yards = [1]
  p.ups = {}
  p.bag = 0
  p.camera_distance = 11
  mower_look(p)
  p.ui_button("yards", "🗺 庭", {at: "right", dy: -110, w: 130, h: 46, size: 15, bg: "#0369A1"})
  p.ui_button("shop", "🚜 お店", {at: "right", dy: -58, w: 130, h: 46, size: 15, bg: "#4D7C0F"})
  p.ui_button("home", "🏠 もどる", {at: "right", dy: -6, w: 130, h: 46, size: 15, bg: "#78350F"})
end

on start()
  world.music = "calm"
  every(12, func() kit_leaderboard("🌱 かったマス") end)
end

let score_clock = 0
on tick(dt)
  score_clock = score_clock + dt
  if score_clock < 1 then return end
  score_clock = 0
  for p in players() do
    if (p.tiles or 0) != p.score then p.score = p.tiles or 0 end
  end
end
