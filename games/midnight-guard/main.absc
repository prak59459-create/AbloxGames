-- Midnight Guard — 発電機を守り、懐中電灯で怪異を追い払う

kit_setup("Midnight Guard", "明かりを消すな。朝まで見回れ", [
  "4つの部屋に発電機（黄色）がある。燃料は少しずつ減る",
  "発電機にさわると燃料満タン。0になるとその部屋が暗くなる",
  "暗い部屋からは怪異が出てきやすい",
  "「🔦 ライト」を怪異に向けると追い払える",
  "怪異にふれるとダメージ。朝まで（3分）耐えよう"
])

let rooms = ["Lab", "Archive", "Ward", "Boiler"]
let fuel = {Lab: 100, Archive: 100, Ward: 100, Boiler: 100}
let ends_at = 0
let banished = 0

kit_quest("refuel", "発電機を10回動かす", 10, 80)
kit_quest("banish", "怪異を8体追い払う", 8, 150)
kit_quest("dawn", "朝をむかえる", 1, 300)

func show()
  let line = ""
  for r in rooms do
    let f = floor(fuel[r])
    line = line + r + (f > 0 and (" " + f + "%") or " 🔴") + "   "
  end
  ui_text("gens", "⚡ " + line, {at: "top", dy: 58, size: 14})
  ui_text("clock", "🌙 朝まで " + kit_clock(ends_at - time()), {at: "top", dy: 26, size: 22, bold: true})
end

func spawn_entity()
  let dark = filter(rooms, func(r) return fuel[r] <= 0 end)
  let spot = nil
  if len(dark) > 0 and random() < 0.7 then
    spot = block(random(dark) + " Floor")
  else
    spot = block("Entity Spot " + random(1, 6))
  end
  let n = create_npc({name: "影", position: spot.position + {x: random(-3, 3), y: 1, z: random(-3, 3)}, color: "#020617",
                      head_color: "#7F1D1D", size: 1.5, health: 999999, speed: 0.6})
  n.scared_until = 0
end

on start()
  game.respawn_time = 8
  ends_at = time() + 180
  every(1, func()
    for r in rooms do
      fuel[r] = max(0, fuel[r] - (1 + random() * 1.5))
      let light = block(r + " Light")
      if light != nil then light.visible = fuel[r] > 0 end
    end
    show()
    if time() >= ends_at then
      for p in players() do
        p.score = p.score + 5
        kit_quest_progress(p, "dawn", 1)
      end
      kit_finish("🌅 朝が来た！見回り完了", 8)
    end
  end)
  every(7, func()
    if len(npcs()) < 12 then spawn_entity() end
  end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.ui_button("light", "🔦 ライト", {at: "bottom_right", dx: -120, dy: -160, w: 130, h: 64, size: 18, bg: "#CA8A04", radius: 16})
end

on tick(dt)
  for n in npcs() do
    if time() < n.scared_until then
      let away = kit_nearest_player(n)
      if away != nil then n.move_to(n.position + normalize(n.position - away.position) * 10) end
    else
      kit_chase(n, 30, 12, dt)
    end
  end
end

on touch(p, b)
  if p.is_npc then return end
  if contains(b.tags, "generator") then
    let r = split(b.name, " ")[1]
    if fuel[r] < 90 and kit_ready(p, "gen_" + r, 2) then
      fuel[r] = 100
      kit_quest_progress(p, "refuel", 1)
      p.message("⚡ " + r + " の発電機を動かした", 1.2)
      show()
    end
  end
end

on button(p, id)
  if id == "light" and p.alive and kit_ready(p, "light", 1.5) then
    let hit = 0
    for n in npcs() do
      let dir = normalize(n.position - p.position)
      if distance(p, n) < 22 and dot(dir, p.look) > 0.85 then
        hit = hit + 1
        banished = banished + 1
        p.score = p.score + 1
        kit_quest_progress(p, "banish", 1)
        n.destroy()
      end
    end
    p.message(hit > 0 and ("🔦 " + hit + " 体を追い払った！") or "🔦 …", 1)
  end
end
