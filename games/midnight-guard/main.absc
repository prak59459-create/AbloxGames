-- Midnight Guard — 真夜中の施設の警備員。巡回・発電機・ライトで3つの夜を守る。
--
-- ファイル:
--   data.absc       夜ごとの設定・棟・怪異・ロッカー
--   common.absc     夜の状態・画面
--   anomalies.absc  ライト・影・見張る者・迷子・停電の王
--   patrol.absc     巡回リスト・チェックポイント・無線（ニセもの）・信頼・夜の流れ
--   power.absc      発電機と燃料缶・明かり・充電・ロッカー
--   main.absc       このファイル

kit_setup("Midnight Guard", "明かりを消すな。朝6時まで見回れ", [
  "📋 1時間ごとに所長から巡回リスト。その棟の🟦チェックポイントにさわってスキャン。できないと信頼がへる",
  "⚡ 6つの棟に発電機。燃料が0だと真っ暗でスキャンできず、影が出る。⛽ 警備室の燃料缶を運ぼう",
  "🔦 ライトを当てつづけると影が消える。🔋 電池は警備室で充電",
  "👁 見張る者は見ているあいだ動けない。🧒 迷子は警備室まで連れていく",
  "📻 ザザッとまじった無線はニセもの！ 画面の巡回リストを信じて",
  "🗄 警備室のロッカーで装備を買える。3日目の最後に何かが来る…"
])

kit_currency = "給料"
kit_shop_title = "制服"
kit_shop_add("cap", "🧢 警備帽", 50, func(p)
  p.hat = "cap"
  p.color = "#1E3A8A"
end)
kit_shop_add("halo", "✨ 夜の守り神", 300, func(p) p.hat = "halo" end)

kit_quest("scan", "チェックポイントを15回スキャン", 15, 150)
kit_quest("refuel", "発電機に燃料を10回入れる", 10, 120)
kit_quest("banish", "影を10体消す", 10, 150)
kit_quest("child", "迷子を警備室へ送る", 1, 100)
kit_quest("gear", "装備を2つ買う", 2, 80)
kit_quest("nights", "夜を3回のりきる", 3, 400)
kit_quest("king", "停電の王を追い返す", 1, 300)
kit_quest("dex", "怪異を5つ記録する", 5, 200)

on start()
  game.respawn_time = 8
  after(3, func() start_night(1) end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 20)
  p.battery = 100
  p.cans = 0
  p.light_on = false
  p.gear = {}
  p.dex = {}
  hud(p)
  shift_hud()
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Spawn " + random(1, 8)).position + {x: 0, y: 1, z: 0})
  if phase == "shift" then
    trust = trust - 5
    p.message("🚑 警備室で目をさました（信頼 -5）", 2)
  end
  p.battery = max(p.battery, 40)
  p.light_on = false
  if has_gear(p, "shoes") then p.speed = 1.2 end
  hud(p)
end
