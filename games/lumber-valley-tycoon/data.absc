-- data.absc — Lumber Valley Tycoon の表

ty_setup({plots: 6, word: "土地", rebirth: 0.5})

-- 土地に建てるもの（じゅんばんに あらわれる）: income は 1秒のもうけ（小屋など）
ty_items = [
  {id: "saw1", name: "🪚 小さなのこぎり", price: 60, income: 0},
  {id: "fence", name: "🪵 木のさく", price: 120, income: 1, after: "saw1"},
  {id: "cabin1", name: "🏠 小屋のゆか", price: 300, income: 3, after: "fence"},
  {id: "saw2", name: "🪚 ベルトのこぎり", price: 700, income: 0, after: "cabin1"},
  {id: "cabin2", name: "🏠 小屋のかべ", price: 1500, income: 8, after: "saw2"},
  {id: "kiln", name: "🔥 かま（板が2ばいのねだん）", price: 3000, income: 0, after: "cabin2"},
  {id: "cabin3", name: "🏠 小屋のやね", price: 6000, income: 20, after: "kiln"},
  {id: "saw3", name: "🏭 大きな製材所", price: 12000, income: 0, after: "cabin3"},
  {id: "porch", name: "🪑 ポーチとランプ", price: 25000, income: 50, after: "saw3"},
  {id: "shop", name: "🪑 家具工房（3ばいのねだん）", price: 50000, income: 0, after: "porch"},
  {id: "saw4", name: "⚡ レーザー製材機", price: 120000, income: 0, after: "shop"}
]

-- 製材: rate は 1秒に板にできる丸太、kiln と shop で ねだんが かけざん
