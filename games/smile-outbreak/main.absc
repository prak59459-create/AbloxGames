-- Smile Outbreak — 笑顔がうつる学校の鬼ごっこ。3つのモードを投票で。
--
-- ファイル:
--   data.absc       モード・役割・笑顔の技・ショップ
--   common.absc     ラウンドの状態・見た目・画面
--   abilities.absc  役割の技・笑顔の技・ロッカー・ドア・バリケード
--   infection.absc  感染と治療・ワクチン銃・薬のかけらと特効薬
--   round.absc      投票・役割えらび・ラウンド・勝ち負け
--   main.absc       このファイル

kit_setup("Smile Outbreak", "笑顔に感染するな！", [
  "😁 最初に1〜2人が笑顔。笑顔にふれられると感染して、今度は追う側に",
  "🗳 ラウンドの前にモードを投票: アウトブレイク・さいごの一人・特効薬ラッシュ",
  "🎭 役割: 🏃 ダッシュ / 🔦 フラッシュ / 🧪 弾が多い / 🛡 バリケード（投票画面でえらぶ）",
  "💉 光るワクチンを拾うとワクチン銃。笑顔を撃つと元にもどせる",
  "🗄 ロッカーにかくれられる（笑顔がさわると見つかる）。🚪 教室のドアのスイッチで6秒閉められる",
  "😁 笑顔は 🦘 とびかかる・😂 高笑い（みんなの場所がわかる）が使える"
])

weapon("ワクチン銃", {model: "pistol", damage: 1, rate: 1.5, range: 35, ammo: 8, reload: 40, spread: 0.5})

kit_currency = "スマイル"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["perks"])

kit_shop_title = "ショップ"
func add_perk(perk)
  kit_shop_add(perk.id, perk.name + "（" + perk.text + "）", perk.price, func(p) p.perks[perk.id] = true end)
end
for perk in PERKS do add_perk(perk) end
kit_shop_add("cap", "🧢 キャップ", 50, func(p)
  p.hat = "cap"
  p.own_hat = "cap"
end)
kit_shop_add("crown", "👑 王冠", 500, func(p)
  p.hat = "crown"
  p.own_hat = "crown"
end)

kit_quest("survive", "無事なまま勝つ", 3, 200)
kit_quest("infect", "10人に感染させる", 10, 150)
kit_quest("cure", "3人を元にもどす", 3, 150)
kit_quest("parts", "薬のかけらを5こ運ぶ", 5, 150)
kit_quest("hide", "ロッカーにかくれる", 3, 60)
kit_quest("skill", "役割の技を10回使う", 10, 80)

on start()
  every(10, func() kit_leaderboard("😁") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 20)
  p.perks = {}
  p.role = random(ROLE_ORDER)
  p.in_round = false
  p.infected = false
  p.parts = 0
  p.hidden_until = 0
  look_healthy(p)
  if phase == "vote" then vote_panel(p) end
  hud(p)
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Spawn " + random(1, 12)).position + {x: 0, y: 1, z: 0})
end
