-- data.absc — 5つのゲーム・参加者・賞金・NPCの性格

-- arena: そのゲームの場所（"<arena> Gallery" が観客席）/ time: 制限時間（0 = なし）
let GAMES = [
  {id: "field", name: "だるまさんがころんだ", emoji: "🎎", arena: "Field", time: 75,
   rule: "人形が「ころんだ！」でふり向いたら止まれ。見られている間に動いたら失格。岩や人のかげなら見えない"},
  {id: "tug", name: "つなひき", emoji: "🪢", arena: "Tug", time: 45,
   rule: "メーターが緑のときに「引く！」でパワー3倍。負けたチームは床ごと落ちる"},
  {id: "huddle", name: "なかま集め", emoji: "🚪", arena: "Huddle", time: 0,
   rule: "よばれた人数ぴったりで部屋に入れ。ランプが黄色なら、あと1人足りない部屋"},
  {id: "bridge", name: "ガラスの橋", emoji: "🌉", arena: "Bridge", time: 110,
   rule: "左右どちらかは割れるガラス。前の人をよく見て、安全な道をおぼえろ"},
  {id: "final", name: "最後のタイル", emoji: "🟥", arena: "Final", time: 0,
   rule: "黄色→オレンジに光ったタイルは落ちる。最後の1人になるまで立っていろ"}
]

