-- data.absc — ゲーム・参加者・賞金・NPCの性格

-- arena: そのゲームの場所（"<arena> Gallery" が観客席）/ time: 制限時間（0 = なし）
-- turn: "first" = いつも最初 / "middle" = まん中のステージ / "extra" = 決勝の前に人が多すぎるときだけ /
--       "last" = いつも最後（残りが FINAL_AT 人より少なくなったら すぐ）
let GAMES = [
  {id: "field", name: "だるまさんがころんだ", emoji: "🎎", arena: "Field", time: 75, turn: "first",
   rule: "人形が「ころんだ！」でふり向いたら止まれ。見られている間に動いたら失格。岩や人のかげなら見えない"},
  {id: "tug", name: "つなひき", emoji: "🪢", arena: "Tug", time: 45, turn: "middle",
   rule: "メーターが緑のときに「引く！」でパワー3倍。負けたチームは床ごと落ちる"},
  {id: "huddle", name: "なかま集め", emoji: "🚪", arena: "Huddle", time: 0, turn: "middle",
   rule: "よばれた人数ぴったりで部屋に入れ。ランプが黄色なら、あと1人足りない部屋"},
  {id: "bridge", name: "ガラスの橋", emoji: "🌉", arena: "Bridge", time: 110, turn: "middle",
   rule: "左右どちらかは割れるガラス。前の人をよく見て、安全な道をおぼえろ"},
  {id: "final", name: "最後のタイル", emoji: "🟥", arena: "Final", time: 0, turn: "extra",
   rule: "黄色→オレンジに光ったタイルは落ちる。半分の人が落ちるまで立っていろ"},
  {id: "candy", name: "型ぬき", emoji: "🍪", arena: "Candy", time: 60, turn: "middle",
   rule: "4つの箱から1つえらぶと、中は ⚪・🔺・⭐・☂️ のどれか。メーターが緑のときに「けずる」。3回ひびが入ると割れて失格"},
  {id: "marbles", name: "ビー玉あて", emoji: "🔮", arena: "Marbles", time: 0, turn: "middle",
   rule: "2人1組。かくす人は手の中のビー玉の数を、あてる人は「奇数か偶数か」をえらぶ。5回戦って、ビー玉が少ない方が失格"},
  {id: "ring", name: "決戦リング", emoji: "🥊", arena: "Ring", time: 100, turn: "last",
   rule: "「ドン！」で相手をおし出せ。「ふんばる」でおされにくくなる。リングは外からだんだん小さくなる。最後に立っていた1人が優勝"},
  {id: "relay", name: "5人6脚", emoji: "👣", arena: "Relay", time: 68, turn: "middle",
   rule: "5人で足をむすんで 110m。「いち」「に」の かけ声に あわせて ボタン。足がそろうほど 速い。時間内に ゴールできないチームは 全員失格"},
  {id: "hide", name: "かくれんぼ", emoji: "🙈", arena: "Hide", time: 200, turn: "middle",
   rule: "半分が 鬼🔴、半分が かくれる人🔵。3分 にげきるか 🔑3つで 🚪脱出。鬼は 3回タッチで つかまえる。だれも つかまえられない鬼は 失格"},
  {id: "rope", name: "大なわとびの橋", emoji: "🪢", arena: "Rope", time: 70, turn: "middle",
   rule: "50mの橋を わたれ。両はしの 大きな人形が まわす なわが 3秒ごとに 来る。下に来たら ジャンプ！ 1か所 あなが あいている"},
  {id: "towers", name: "空のタワー", emoji: "🗼", arena: "Towers", time: 150, turn: "last",
   rule: "空に 3つのタワー。「ドン！」で おしあい、だれか1人 落ちたら 次のタワーへ。3つ目では 最後の1人になるまで"}
]

-- ショーの順番。ステージごとに、games のどれか1つをランダムに遊ぶ
-- 第1: だるまさんがころんだ / 第2: 型ぬき か 5人6脚 / 第3: つなひき か なかま集め /
-- 第4: ビー玉あて か かくれんぼ / 第5: ガラスの橋 か 大なわとびの橋 / 第6（最終）: 決戦リング か 空のタワー
let STAGES = [
  ["field"],
  ["candy", "relay"],
  ["tug", "huddle"],
  ["marbles", "hide"],
  ["bridge", "rope"],
  ["ring", "towers"]
]

let CAST_SIZE = 100         -- 1回のショーの参加者。足りない分はNPC（NPCの上限も100）
let NPC_BATCH = 10          -- 開幕のとき、NPCを何人ずつ入れるか
let NPC_BATCH_GAP = 0.3     -- その間の秒数（99人で 約3秒。開幕の5秒のうちに そろう）
let GM_PRICE = 50000        -- 👑 ゲームマスターになる コイン
let GM_DOLL_WAIT = 1.2      -- かけ声が始まってから「ころんだ！」を言えるまでの秒数
let GM_HEAVE_WAIT = 2.5     -- 「せーの！」を もう一度 言えるまでの秒数
let FINAL_AT = 5            -- 残りがこれより少なくなったら、最終ゲームへ
let FINAL_CROWD = 16        -- 最終ゲームの前にこれより多く残っていたら、先に「最後のタイル」で半分にする
let MAX_ROUNDS = 14         -- これだけ遊んでもまだ多いときも、最終ゲームへ
let PRIZE_PER_OUT = 100     -- 1人脱落するごとに賞金がふえる
let LOBBY_WAIT = 20         -- 寮で待つ秒数
let BREAK_TIME = 10         -- ゲームとゲームの間

let JERSEY = "#2563EB"
let SKINS = ["#FDE68A", "#FCD34D", "#F5D0A9", "#D6A77A", "#A0785A", "#FBCFE8"]

