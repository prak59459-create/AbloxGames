-- Last Survivor Games — 24人で挑む5つのゲーム。最後の1人になれ
--
-- ファイル:
--   data.absc    ゲーム5つ・人数・賞金・NPCの性格
--   common.absc  ショーの状態・番号・脱落・賞金の玉・画面
--   bridge.absc  第4ゲーム ガラスの橋
--   field.absc   第1ゲーム だるまさんがころんだ
--   final.absc   第5ゲーム 最後のタイル
--   huddle.absc  第3ゲーム なかま集め
--   show.absc    ショーの流れ（寮 → ゲーム → 優勝）
--   tug.absc     第2ゲーム つなひき
--   main.absc    このファイル

kit_setup("Last Survivor Games", "動くな。まちがえるな。生き残れ", [
  "🎬 寮で待つとショー開幕。人が足りない分はNPCが参加して、いつも24人",
  "🎎 だるまさんがころんだ: ふり向いたら止まれ。岩や人のかげなら動いてもバレない",
  "🪢 つなひき: 緑のときに「引く！」で3倍。負けたら床ごと落ちる",
  "🚪 なかま集め: よばれた人数ぴったりで部屋へ。黄色いランプは「あと1人」",
  "🌉 ガラスの橋: 前の人をよく見ろ。🟥 最後のタイル: 光ったら逃げろ",
  "💰 1人脱落するごとに賞金+100。優勝者が全部もらう（出なければ次の回へ持ちこし）"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["wins", "shows", "cleared", "best_ever", "charms", "gloves"])


kit_quest("field", "だるまさんがころんだをクリア", 1, 150)
kit_quest("tug", "つなひきで勝つ", 1, 200)
kit_quest("huddle", "なかま集めを生きのこる", 2, 250)
kit_quest("bridge", "ガラスの橋をわたりきる", 1, 400)
kit_quest("final", "最後のタイルまで残る", 1, 400)
kit_quest("champion", "優勝する", 1, 1000)
kit_quest("shows", "ショーに5回出る", 5, 300)
kit_quest("hidden", "かげにかくれて人形をやりすごす", 5, 200)
kit_quest("nice", "つなひきで「ナイス」30回", 30, 150)

kit_shop_title = "寮の売店"
kit_shop_add("charm", "🍀 お守り（橋の安全な側が1回わかる）", 250, func(p)
  p.charms = (p.charms or 0) + 1
  p.message("🍀 お守り ×" + p.charms + "（ガラスの橋で使える）", 2)
end)
kit_shop_add("gloves", "🧤 軍手（次のつなひきで力1.5倍）", 200, func(p)
  p.gloves = (p.gloves or 0) + 1
  p.message("🧤 軍手 ×" + p.gloves, 2)
end)
kit_shop_add("cap", "🧢 キャップ", 150, func(p) p.hat = "cap" end)
kit_shop_add("halo", "😇 天使の輪", 1200, func(p) p.hat = "halo" end)
kit_shop_add("mint", "🟩 ミントのジャージ", 400, func(p)
  p.color = "#34D399"
  p.leg_color = "#F8FAFC"
end)
kit_shop_add("rose", "🌹 ローズのジャージ", 400, func(p)
  p.color = "#F43F5E"
  p.leg_color = "#1F2937"
end)

func open_stats(p)
  p.ui_remove("stats")
  p.ui_panel("stats", {at: "center", w: 420, h: 250, bg: "#0F172AF0", radius: 20, layer: 40})
  p.ui_text("stats_t", "📊 " + p.name + " の記録", {parent: "stats", y: 0.13, size: 20, bold: true, color: "gold"})
  let best = "まだ"
  if (p.best_ever or 0) > 0 then best = GAMES[p.best_ever].emoji + " " + GAMES[p.best_ever].name end
  let lines = [
    "🎬 出たショー: " + p.shows + " 回",
    "🏆 優勝: " + p.wins + " 回",
    "✅ クリアしたゲーム: " + (p.cleared or 0),
    "🚩 いちばん進んだ: " + best,
    "🍀 お守り ×" + (p.charms or 0) + "   🧤 軍手 ×" + (p.gloves or 0)
  ]
  let i = 0
  for line in lines do
    i = i + 1
    p.ui_text("stats_" + i, line, {parent: "stats", y: 0.22 + i * 0.12, size: 15, color: "#E5E7EB"})
  end
  p.ui_button("stats_close", "閉じる", {parent: "stats", y: 0.9, w: 120, h: 32, size: 14, bg: "gray"})
end

on start()
  every(10, func() kit_leaderboard("🏆 優勝") end)
  every(2, func()
    for p in humans() do
      if (p.best_game or 0) > (p.best_ever or 0) then p.best_ever = p.best_game end
      p.score = p.wins
    end
  end)
end

on join(p)
  p.wins = 0
  p.shows = 0
  p.cleared = 0
  p.best_ever = 0
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.ui_button("stats_open", "📊 記録", {at: "right", dy: 180, w: 150, h: 50, size: 17, bg: "#0F766E"})
  kit_give(p, 30)
  if phase == "lobby" then
    p.out = false
    p.teleport(dorm_spot())
    lobby_buttons(p)
  else
    p.out = true
    let g = game()
    if phase == "play" and g != nil then p.teleport(gallery_spot(g.arena)) else p.teleport(dorm_spot()) end
    p.message("🎬 ショーの最中！ 観客席から見て、次の回から参加しよう", 3)
    spectator_ui(p)
  end
end

on button(p, id)
  if id == "stats_open" then
    open_stats(p)
  elif id == "stats_close" then
    p.ui_remove("stats")
  end
end
