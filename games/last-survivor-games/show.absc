-- show.absc — ショーの流れ: 寮で待つ → STAGES の順に第1〜第6ゲーム（ステージごとに2つのうちどちらか）
-- → 優勝 → また寮へ。残りが FINAL_AT 人より少なくなったら、とちゅうでも最終ゲームへ。
-- 最終ゲームの前に FINAL_CROWD 人より多く残っていたら、延長の「最後のタイル」で半分にする

let break_until = 0
let next_i = 0            -- 休けいのあとに遊ぶゲーム（GAMES の番号）
let stage_no = 0          -- いま遊んでいる／さっき遊んだステージ（STAGES の番号）
let extra_done = false    -- このショーで延長の「最後のタイル」を遊んだか（1回だけ）

func is_spectator(p)
  return not in_cast(p) or p.out
end

func lobby_buttons(p)
  if phase == "lobby" then
    p.ui_button("go_now", "▶ すぐ始める", {at: "bottom", dy: -40, w: 200, h: 56, size: 18, bg: "#DB2777", radius: 16})
  else
    p.ui_remove("go_now")
  end
  gm_lobby_button(p)
end

func begin_show()
  if phase != "lobby" then return end
  let hs = humans()
  if len(hs) == 0 then return end
  show_no = show_no + 1
  phase = "intro"
  game_i = 0
  round_no = 0
  next_i = 0
  stage_no = 0
  extra_done = false
  cast = []
  used_numbers = {}
  clear_feed()
  clear_npcs()
  pot = carry
  carry = 0
  gm_begin()
  let players_in = filter(hs, func(p) return not is_gm(p) end)
  for p in hs do p.ui_remove("go_now") end
  for p in players_in do
    p.out = false
    p.num = fresh_number()
    p.lost_at = 0
    p.ui_remove("spec")
    p.ui_remove("go_now")
    append(cast, p)
    number_ui(p)
    p.shows = p.shows + 1
    kit_quest_progress(p, "shows", 1)
    p.message("あなたの番号は " + tag_of(p) + " — 生きのこれ", 3)
  end
  let show = show_no
  add_npcs(show, CAST_SIZE - len(cast))
  if gm != nil then gm.teleport(gallery_spot("Field")) end
  update_orb()
  sound("goal")
  announce("🎬 第" + show_no + "回 Last Survivor Games 開幕！ 参加者 " + max(CAST_SIZE, len(players_in)) + " 人 — 賞金は脱落者1人につき 💰" + PRIZE_PER_OUT, 5)
  after(5, func() if show == show_no then next_game() end end)
end

-- 足りない分のNPCを NPC_BATCH 人ずつ入れる。100人を一度に作ると iPad が止まっていた
func add_npcs(show, left)
  if show != show_no or phase != "intro" or left <= 0 then return end
  let batch = min(left, NPC_BATCH)
  for k in 1 to batch do append(cast, make_npc(k)) end
  after(NPC_BATCH_GAP, func() add_npcs(show, left - batch) end)
end

func game_index(id)
  for k in 1 to len(GAMES) do
    if GAMES[k].id == id then return k end
  end
  return 0
end

-- そのゲームが入っているステージ（延長のゲームは 0）
func stage_of(id)
  for s in 1 to len(STAGES) do
    for gid in STAGES[s] do
      if gid == id then return s end
    end
  end
  return 0
end

-- ステージの中から1つ、ランダムに
func pick_in_stage(s)
  let options = []
  for gid in STAGES[s] do
    let k = game_index(gid)
    if k != 0 then append(options, k) end
  end
  return options[random(1, len(options))]
end

-- 画面に出す「第◯ゲーム」
func stage_label(g)
  let s = stage_of(g.id)
  if s == 0 then return "延長ゲーム" end
  if s == len(STAGES) then return "第" + s + "（最終）ゲーム" end
  return "第" + s + "ゲーム"
end

-- 次のゲーム: STAGES の順に1つずつ。残りが FINAL_AT 人より少ないか、MAX_ROUNDS 回遊んだら最終ゲーム。
-- 最終ゲームの前にまだ多すぎたら、1回だけ延長の「最後のタイル」
func pick_game()
  let last = len(STAGES)
  if round_no == 0 then return pick_in_stage(1) end
  if len(alive_cast()) < FINAL_AT or round_no >= MAX_ROUNDS then return pick_in_stage(last) end
  let next_stage = min(stage_no + 1, last)
  if next_stage == last and len(alive_cast()) > FINAL_CROWD and not extra_done then
    return game_index("final")
  end
  return pick_in_stage(next_stage)
end

func next_game()
  if phase == "lobby" or phase == "ending" then return end
  if len(alive_cast()) <= 1 or (game() != nil and game().turn == "last") then
    finish_show()
    return
  end
  if next_i == 0 then next_i = pick_game() end
  game_i = next_i
  next_i = 0
  round_no = round_no + 1
  let g = GAMES[game_i]
  let s = stage_of(g.id)
  if s == 0 then extra_done = true else stage_no = s end
  phase = "play"
  outs_now = 0
  game_ends = 0
  update_orb()
  for p in humans() do
    rule_card(p, g)
    if is_spectator(p) then p.teleport(gallery_spot(g.arena)) end
  end
  if g.id == "field" then
    field_start()
  elif g.id == "tug" then
    tug_start()
  elif g.id == "huddle" then
    huddle_start()
  elif g.id == "bridge" then
    bridge_start()
  elif g.id == "candy" then
    candy_start()
  elif g.id == "marbles" then
    marbles_start()
  elif g.id == "ring" then
    ring_start()
  elif g.id == "relay" then
    relay_start()
  elif g.id == "hide" then
    hide_start()
  elif g.id == "rope" then
    rope_start()
  elif g.id == "towers" then
    towers_start()
  else
    final_start()
  end
  refresh_hud()
end

-- 各ゲームが終わったらこれをよぶ
func game_over()
  if phase != "play" then return end
  phase = "between"
  game_ends = 0
  let g = game()
  let left = alive_cast()
  for c in left do
    if not c.is_npc then
      c.cleared = (c.cleared or 0) + 1
      c.best_game = max(c.best_game or 0, round_no)
      kit_give(c, 20 * min(round_no, 8))
    end
  end
  update_orb()
  announce("✅ " + g.emoji + " " + g.name + " 終了 — " + outs_now + " 人脱落。残り " + len(left) + " 人  💰賞金 " + kit_short(pot), 4)
  let show = show_no
  after(4, func() if show == show_no and phase == "between" then back_to_dorm() end end)
end

func back_to_dorm()
  for c in alive_cast() do
    c.frozen = false
    c.teleport(dorm_spot())
    if c.is_npc then c.stop() end
  end
  for p in humans() do
    if is_spectator(p) then p.teleport(dorm_spot()) end
  end
  let show = show_no
  if len(alive_cast()) <= 1 or game().turn == "last" then
    after(2, func() if show == show_no then finish_show() end end)
    return
  end
  break_until = time() + BREAK_TIME
  next_i = pick_game()
  let upcoming = GAMES[next_i]
  let line = "☕ 休けい " + BREAK_TIME + " 秒 — 次は " + stage_label(upcoming) + " " + upcoming.emoji + " " + upcoming.name
  if upcoming.turn == "last" then line = line + "！ 残り " + len(alive_cast()) + " 人の決戦だ" end
  announce(line, 3)
  after(BREAK_TIME, func() if show == show_no and phase == "between" then next_game() end end)
end

func finish_show()
  if phase == "ending" or phase == "lobby" then return end
  phase = "ending"
  game_ends = 0
  ui_remove("doll")
  ui_remove("huddle_call")
  ui_remove("huddle_left")
  let left = alive_cast()
  let show = show_no
  let pedestal = block("Crown Pedestal").position + {x: 0, y: 2, z: 0}
  if len(left) == 1 then
    let w = left[1]
    w.frozen = false
    w.teleport(pedestal)
    if w.is_npc then
      w.say("やった…！ 賞金はもらった")
      announce("🏆 第" + show_no + "回の優勝は " + tag_of(w) + "（NPC）… 賞金 💰" + kit_short(pot) + " は持っていかれた！", 7)
    else
      w.wins = w.wins + 1
      kit_give(w, pot)
      kit_quest_progress(w, "champion", 1)
      kit_badge(w, "survivor", "最後の生存者")
      if w.wins >= 3 then kit_badge(w, "legend", "伝説のサバイバー") end
      w.hat = "crown"
      w.message("🏆 優勝！ 賞金 💰" + kit_short(pot), 5)
      announce("🏆 第" + show_no + "回の優勝は " + label_of(w) + "！ 賞金 💰" + kit_short(pot) + " を獲得！", 8)
    end
    sound("goal")
  else
    carry = pot
    announce("💀 生存者なし… 賞金 💰" + kit_short(pot) + " は次の回へ持ちこし！", 6)
  end
  for p in humans() do
    if in_cast(p) then
      p.message("📊 この回: " + (p.best_game or 0) + " ゲーム生きのこった", 3)
    end
  end
  after(9, func() if show == show_no then reset_to_lobby() end end)
end

func reset_to_lobby()
  clear_npcs()
  cast = []
  game_i = 0
  round_no = 0
  next_i = 0
  stage_no = 0
  extra_done = false
  phase = "lobby"
  pot = carry
  gm_end()
  update_orb()
  clear_feed()
  for p in humans() do
    p.out = false
    p.num = nil
    p.best_game = 0
    number_ui(p)
    p.ui_remove("spec")
    p.frozen = false
    p.teleport(dorm_spot())
    lobby_buttons(p)
  end
  lobby_until = time() + LOBBY_WAIT
end

func show_clock()
  if phase == "lobby" then
    if len(humans()) > 0 then
      if lobby_until == 0 then lobby_until = time() + LOBBY_WAIT end
      if time() >= lobby_until then begin_show() end
    else
      lobby_until = 0
    end
  elif phase == "between" then
    -- 休けい中、寮のNPCはぶらぶら歩く
    for n in alive_npcs() do
      if random() < 0.15 then n.move_to(dorm_spot()) end
    end
  end
  refresh_hud()
end

on start()
  update_orb()
  every(1, func() show_clock() end)
end

on button(p, id)
  if id == "go_now" and phase == "lobby" then
    if lobby_until == 0 or lobby_until - time() > 3 then lobby_until = time() + 3 end
    announce("▶ " + p.name + " がスタートをおした！ 3秒後に開幕", 2)
  end
end
