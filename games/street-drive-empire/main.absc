-- Street Drive Empire — 車を集めて走るドライブゲーム
-- 16台の車（5クラス）、塗装とチューニング、ガソリンとニトロ、4つのレースとライバル、
-- 配達とタクシー、スピードカメラ、ジャンプ台、カーミート、ライセンス、街の車の流れ、できごと。
--
-- ファイル:
--   data.absc      表（車・クラス・ライセンス・塗装・チューニング・コース・できごと）
--   common.absc    道具・ライセンスとお金・車の速さ・画面
--   driving.absc   走るとお金・ガソリン・ニトロ・スピードカメラ・ジャンプ台・カーミート
--   garage.absc    乗る/降りる・ディーラー・ガレージ・塗装・チューニング
--   jobs.absc      配達とタクシー
--   race.absc      4つのレース
--   world.absc     街を走る車とできごと
--   main.absc      このファイル

kit_setup("Street Drive Empire", "走ってかせいで、夢の車へ", [
  "🚗「乗る」で車に。走るとお金と経験値。ガソリンが減ったらスタンド（緑）へ",
  "🚘 ディーラー（黄色）で車を買う。ライセンスが上がると上のクラスへ",
  "🎨 塗装（ピンク）🔧 チューニング（水色）🅿 ガレージ（オレンジ）",
  "🏁 緑のスタートでレース（サーキット・ドラッグ・市街地・ラリー）。🔥 ニトロで加速",
  "📦 デポ（オレンジ）で配達、🚕 黄色い乗り場でタクシー。📸 スピードカメラ、🦘 ジャンプ台、🤝 カーミートも！"
])

kit_shop_title = "カーショップ"
kit_shop_add("jerrycan", "⛽ 携行缶（その場で満タン）", 120, func(p)
  let car = car_now(p)
  p.fuel = tank_size(p, car)
  apply_move(p)
  hud(p)
end)
kit_shop_add("nitro_can", "🔥 ニトロ缶（満タン）", 90, func(p)
  p.nitro = nitro_size(p, car_now(p))
  hud(p)
end)
kit_shop_add("cap", "🧢 レーサーキャップ", 60, func(p) p.hat = "cap" end)
kit_shop_add("crown", "👑 チャンピオンの冠", 1500, func(p) p.hat = "crown" end)
kit_shop_add("suit_red", "🔴 レーシングスーツ（赤）", 150, func(p)
  p.color = "#DC2626"
  p.leg_color = "#111827"
end)
kit_shop_add("suit_blue", "🔵 レーシングスーツ（青）", 150, func(p)
  p.color = "#1D4ED8"
  p.leg_color = "#F8FAFC"
end)

kit_quest("drive", "10km 走る", 10000, 300)
kit_quest("cars", "車を3台買う", 3, 300)
kit_quest("paint", "車を塗りかえる", 1, 60)
kit_quest("tune", "チューニングを5回", 5, 250)
kit_quest("refuel", "給油する", 1, 40)
kit_quest("race", "レースを完走", 1, 150)
kit_quest("win", "レースで1位", 1, 300)
kit_quest("alltracks", "4つのコースを完走", 4, 600)
kit_quest("drag", "ドラッグでパーフェクトスタート", 1, 150)
kit_quest("deliver", "配達を5回", 5, 250)
kit_quest("taxi", "タクシーで3人運ぶ", 3, 250)
kit_quest("cam", "スピードカメラで 120km/h", 1, 200)
kit_quest("stunt", "ジャンプ台で3びょう飛ぶ", 1, 200)
kit_quest("meet", "カーミートで5台の写真", 5, 350)
kit_quest("golden", "ゴールデンカーをつかまえる", 1, 400)
kit_quest("license", "ライセンスを3つ上げる", 3, 500)
kit_quest("xclass", "Xクラスの車を手に入れる", 1, 1500)

on start()
  every(10, func() kit_leaderboard("🏁") end)
  after(1, func() show_records() end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 80)
  p.garage = ["mini"]
  p.car = "mini"
  p.paints = {}
  p.tunes = {}
  p.photos = []
  p.tracks_done = []
  p.pb = {}
  p.xp = 0
  p.meters = 0
  p.carry = 0
  p.fuel = TANK
  p.nitro = NITRO / 2
  p.driving = false
  p.beacons = []
  p.camera_distance = 10
  p.ui_button("drive", "🚗 乗る", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  p.ui_button("open_garage", "🅿 ガレージ", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#B45309"})
  p.ui_button("nitro", "🔥", {at: "bottom_right", dx: -120, dy: -160, w: 100, h: 70, size: 30, bg: "#EA580C", radius: 18})
  apply_move(p)
  hud(p)
  kit_later(p, 4.2, func() p.message("🚗 右の「乗る」で出発！", 2) end)
end

on leave(p)
  if p.job != nil and p.job.kind == "taxi" then gone(p.job.npc) end
  clear_beacons(p)
end
