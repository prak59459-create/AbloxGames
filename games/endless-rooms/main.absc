-- Endless Rooms — 黄色い部屋から始まる、終わらない部屋の脱出
-- ひとりひとりが自分のペースでレベルを進む。しかけはみんなで共有。
--
-- ファイル:
--   data.absc      レベル・メモ・自動販売機
--   common.absc    しかけの状態・正気度・画面
--   entities.absc  レベルごとの「何か」・正気度のへり方・まぼろし
--   levels.absc    出口・ヒューズ・バルブ・蒸気・ブレーカー・アイテム・メモ・自販機・脱出
--   main.absc      このファイル

kit_setup("Endless Rooms", "出口を見つけて、外の世界へ", [
  "🟨 Level 0 の迷路のどこかに白く光る出口。見つけたら次のレベルへ（ひとりずつ進める）",
  "🔌 Level 1 はヒューズ3つ、♨️ Level 2 はバルブ3つ、💡 Level 3 はブレーカー3つで出口が開く（みんなで共有）",
  "🧠 正気度は暗やみや「何か」のそばでへる。💧 アーモンド水をボタンで飲むと回復。0になると Level 0 へ…",
  "🥤 Level 4 は安全。記憶のかけら（紫）で自動販売機の道具を買える",
  "📄 各レベルにメモが1枚。Level 5 では、ふりかえらずに走れ！"
])

kit_currency = "かけら"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["best", "noclips"])

kit_shop_title = "服"
kit_shop_add("hazmat", "🦺 防護服", 60, func(p)
  p.color = "#FACC15"
  p.leg_color = "#1C1917"
end)
kit_shop_add("halo", "✨ 光の輪", 150, func(p) p.hat = "halo" end)

kit_quest("levels", "レベルを3つ進む", 3, 120)
kit_quest("water", "アーモンド水を5本飲む", 5, 60)
kit_quest("fragment", "記憶のかけらを10こ集める", 10, 80)
kit_quest("notes", "メモを6枚読む", 6, 150)
kit_quest("fuse", "ヒューズを入れる", 1, 60)
kit_quest("valve", "バルブを回す", 2, 60)
kit_quest("breaker", "ブレーカーを入れる", 2, 60)
kit_quest("vending", "自動販売機で買う", 1, 40)
kit_quest("escape", "外の世界に出る", 1, 400)

on start()
  game.respawn_time = 6
  setup_exits()
  setup_notes()
  spawn_items()
  spawn_all_entities()
  steam_step()
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.level = 0
  p.best = 0
  p.sanity = 100
  p.water = 1
  p.fuses = 0
  p.items = {}
  p.notes = [false, false, false, false, false, false]
  p.noclips = 0
  p.ui_button("drink", "💧 飲む", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 60, size: 18, bg: "#0284C7", radius: 16})
  hud(p)
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(start_pos(p.level))
  p.sanity = max(40, p.sanity - 20)
  if has_item(p, "sneakers") then p.speed = 1.15 end
  p.message("💀 " + LEVELS[p.level + 1].name + " の入口で目をさました", 2)
  if p.level == 5 then start_chase(p) end
  hud(p)
end

on leave(p)
  after(0.5, func() check_all_out() end)
end
