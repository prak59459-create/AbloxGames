-- Speed Worlds — 8つのワールドを超スピードで走るスピードラン。メダルとゴーストとレース大会
--
-- ファイル:
--   data.absc    ワールド8つ・強化
--   common.absc  メダルの目安・画面
--   run.absc     走る・タイム・チェックポイント・ゴール・ゴースト・しかけ
--   race.absc    レース大会・お店
--   main.absc    このファイル

kit_setup("Speed Worlds", "最速タイムでゴールへ！", [
  "🌀 ハブの光るパッドでワールドへ。ゴールすると次のワールドが開く",
  "⏱ 3・2・1・GO! でタイムスタート。🥇🥈🥉 のメダルをねらおう",
  "🟩 緑のパッドはチェックポイント。落ちてもそこから",
  "🟨 黄色い加速床でビュン！ 🟣 トランポリンで大ジャンプ",
  "🌌 宇宙はふわっと、🏜 砂漠は動く足場、🌋 溶岩は踏まないで",
  "👻 ゴーストをONにすると、自分のベストの走りがいっしょに走る",
  "🏁 ときどきレース大会！ 🛒 お店でシューズ・ブーツ・グライダー"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["best", "medals", "ups", "ghost_on"])


kit_quest("finish", "ゴールを5回", 5, 200)
kit_quest("worlds", "4つのワールドをクリア", 4, 800)
kit_quest("gold", "金メダルを3こ", 3, 1000)
kit_quest("race", "レース大会に出る", 1, 300)
kit_quest("upgrade", "3回強化する", 3, 500)

on start()
  every(10, func() kit_leaderboard("🏅") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.best = []
  p.medals = []
  p.ghost_paths = []
  for n in 1 to len(WORLDS) do
    append(p.best, nil)
    append(p.medals, "")
    append(p.ghost_paths, nil)
  end
  p.ups = {}
  p.ghost_on = true
  p.glide = false
  p.world = nil
  p.rec = []
  p.speed = run_speed(p)
  p.jump = run_jump(p)
  kit_give(p, 20)
  p.ui_button("restart", "↺ やり直す", {at: "right", dy: -60, w: 130, h: 44, size: 15, bg: "#57534E"})
  p.ui_button("hub", "🏠 ハブ", {at: "right", dy: -10, w: 130, h: 44, size: 15, bg: "#0369A1"})
  p.ui_button("ghost", "👻 ゴースト", {at: "right", dy: 40, w: 130, h: 44, size: 15, bg: "#6366F1"})
  p.ui_button("open_shop", "🛒 お店", {at: "right", dy: 90, w: 130, h: 44, size: 15, bg: "#B45309"})
  hud(p)
end
