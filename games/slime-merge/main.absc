-- Slime Merge — スライムをすいこんで、牧場の台で合体させて、かせいで、もっと遠くのバイオームへ
--
-- ファイル:
--   data.absc    スライム8種・レベル・バイオーム・強化
--   common.absc  スライムの強さ・図鑑・画面
--   ranch.absc   牧場の台・置く・合体・かせぎ
--   wild.absc    野生のスライム・すいこむ・ゲート・スライムの雨
--   shop.absc    たまご屋・市場・強化・図鑑
--   main.absc    このファイル

kit_setup("Slime Merge", "すいこんで、合体して、レジェンドスライムを", [
  "🌀 野生のスライムに近づいて「すいこむ」",
  "🏡 黄色いパッドで牧場をもらって、台にのるとスライムを置ける",
  "✨ 同じ種類・同じレベルのスライムを重ねると合体してレベルアップ（最大 Lv.10）",
  "💰 台のスライムは2秒ごとにコインをかせぐ。レベルが高いほどたくさん",
  "🔓 ゲートでバイオームを開けると、もっとかせぐスライムに会える",
  "🌧 ときどきスライムの雨。にじいろスライムはにげ足が速い！",
  "下のボタンで持っているスライムをえらぶ。台の上のスライムをもう一度さわると拾える"
])
kit_currency = "コイン"

kit_quest("catch", "スライムを10ぴきすいこむ", 10, 60)
kit_quest("merge", "10回合体する", 10, 200)
kit_quest("merge100", "100回合体する", 100, 20000)
kit_quest("lv5", "Lv.5 のスライムを作る", 1, 500)
kit_quest("biomes", "バイオームを3つ開ける", 3, 5000)
kit_quest("upgrade", "10回強化する", 10, 2000)
kit_quest("pedia", "図鑑を30こうめる", 30, 30000)

on start()
  every(10, func() kit_leaderboard("💰/2秒") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.hand = [{type: "pink", level: 1}]
  p.sel = 1
  p.ups = {}
  p.biomes = ["meadow"]
  p.pedia = {}
  p.best = 1
  p.merges = 0
  p.catches = 0
  p.earned = 0
  discover(p, p.hand[1])
  kit_give(p, 30)
  p.ui_button("vacuum", "🌀 すいこむ", {at: "bottom_right", dx: -110, dy: -170, w: 160, h: 64, size: 18, bg: "#10B981", radius: 16})
  p.ui_button("open_pedia", "📖 図鑑", {at: "right", dy: -40, w: 130, h: 44, size: 15, bg: "#4338CA"})
  hand_ui(p)
  hud(p)
  for n in 1 to PLOT_COUNT do
    if p.plot == nil and plots["" + n].owner == nil then claim_plot(p, "" + n) end
  end
end
