-- Shark Attack Bay — サメ1匹 vs ボートの人間たち
--
-- ファイル:
--   data.absc    サメの種類・時間・ボート・ごほうび
--   common.absc  状態・役わり・海とボートの道具・画面
--   boats.absc   ボートの体力・沈没・修理・補給物資
--   humans.absc  泳ぎ・武器・ダイナマイト・救急キット・灯台からの応援
--   round.absc   ラウンドの流れ（立候補 → 戦い → 結果）
--   shark.absc   サメの技・CPUのサメ・背びれ・えさ
--   main.absc    このファイル

kit_setup("Shark Attack Bay", "サメを撃退するか、全員を海へ", [
  "🦈 ラウンドごとに1人がサメ（立候補できる）。1人で遊ぶときはCPUのサメ",
  "🧍 人間: 桟橋からボートへ。ライフルやハープーンでサメを撃て。3分生きのこれば勝ち",
  "🌊 海は浅いけど、歩くのがおそい。ボートや桟橋のはしごから上がれる",
  "⛵ ボートは体当たりでこわれて沈む。🔧 修理キットで直せる。📦 補給物資もひろおう",
  "🦈 サメ: かみつく・突進・もぐる（見えない）・体当たり。🍖 えさで回復",
  "🗼 やられた人は灯台から「📣 応援」で仲間を回復できる"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["sharks", "pick", "harpoon", "ring", "dynamite", "medkits", "repairs", "human_wins", "shark_wins", "dealt", "kills_total"])


kit_quest("hunt", "サメにとどめをさす", 1, 300)
kit_quest("damage", "サメに合計1500ダメージ", 1500, 300)
kit_quest("survive", "人間で3回生きのこる", 3, 300)
kit_quest("bite", "サメで8回かみつく", 8, 300)
kit_quest("sink", "サメでボートを3そう沈める", 3, 250)
kit_quest("repair", "ボートを5回修理", 5, 150)
kit_quest("crate", "補給物資を3回ひろう", 3, 150)
kit_quest("cheer", "灯台から10回応援", 10, 100)

kit_shop_title = "港の売店"
kit_shop_add("harpoon", "🔱 ハープーン（強い・弾3発）", 600, func(p)
  p.harpoon = true
  p.use_harpoon = true
  if p.role == "human" and phase == "play" then loadout(p) else item_buttons(p) end
  p.message("🔱 ハープーンを手に入れた！ 🔫/🔱 ボタンで持ちかえ", 2.5)
end)
kit_shop_add("ring", "🛟 浮き輪（海で速く動ける）", 300, func(p)
  p.ring = true
  p.message("🛟 浮き輪をつけた", 1.5)
end)
kit_shop_add("dynamite", "🧨 ダイナマイト", 150, func(p)
  p.dynamite = (p.dynamite or 0) + 1
  item_buttons(p)
end)
kit_shop_add("medkit", "🩹 救急キット（+50）", 100, func(p)
  p.medkits = (p.medkits or 0) + 1
  item_buttons(p)
end)
kit_shop_add("repair", "🔧 修理キット（ボート+40）", 120, func(p)
  p.repairs = (p.repairs or 0) + 1
  p.message("🔧 修理キット ×" + p.repairs + "（ボートの上で使う）", 1.5)
end)
kit_shop_add("hammer", "🔨 シュモクザメを解放", 800, func(p) unlock_shark(p, "hammer") end)
kit_shop_add("mega", "🐋 メガロドンを解放", 2000, func(p) unlock_shark(p, "mega") end)
kit_shop_add("captain", "🧢 船長の帽子", 150, func(p) p.hat = "cap" end)
kit_shop_add("lifeguard", "🟥 ライフガードの服", 300, func(p)
  p.color = "#DC2626"
  p.leg_color = "#FDE047"
  p.my_color = "#DC2626"
end)

func unlock_shark(p, id)
  if p.sharks == nil then p.sharks = [] end
  if not contains(p.sharks, id) then append(p.sharks, id) end
  p.pick = id
  p.message("🦈 " + shark_of(id).name + " を解放！ サメになったらこの種類で出る", 2.5)
end

-- MARK: サメの種類をえらぶ

func open_picker(p)
  let list = SHARKS
  let h = 90 + len(list) * 58
  p.ui_remove("picker")
  p.ui_panel("picker", {at: "center", w: 480, h: h, bg: "#0C4A6EF0", radius: 20, layer: 35})
  p.ui_text("picker_t", "🦈 サメになったときの種類", {parent: "picker", y: 26 / h, size: 18, bold: true, color: "gold"})
  let i = 0
  for k in list do
    i = i + 1
    let owned = k.price == 0 or contains(p.sharks or [], k.id)
    let label = k.name + " — " + k.text
    let bg = "#0369A1"
    if not owned then
      label = "🔒 " + k.name + "（売店で 💰" + k.price + "）"
      bg = "#374151"
    elif (p.pick or "white") == k.id then
      label = "✅ " + label
      bg = "#15803D"
    end
    p.ui_button("pick_" + k.id, label, {parent: "picker", y: (30 + i * 58) / h, w: 440, h: 48, size: 13, bg: bg})
  end
  p.ui_button("picker_close", "閉じる", {parent: "picker", y: (h - 22) / h, w: 120, h: 30, size: 13, bg: "gray"})
end

func open_stats(p)
  p.ui_remove("stats")
  p.ui_panel("stats", {at: "center", w: 400, h: 220, bg: "#0F172AF0", radius: 18, layer: 35})
  p.ui_text("stats_t", "📊 " + p.name + " の記録", {parent: "stats", y: 0.14, size: 18, bold: true, color: "gold"})
  let lines = [
    "🧍 人間で勝った: " + (p.human_wins or 0) + " 回",
    "🦈 サメで勝った: " + (p.shark_wins or 0) + " 回",
    "🎯 サメに与えたダメージ: " + floor(p.dealt or 0),
    "🦷 サメでたおした人間: " + (p.kills_total or 0)
  ]
  let i = 0
  for line in lines do
    i = i + 1
    p.ui_text("stats_" + i, line, {parent: "stats", y: 0.22 + i * 0.14, size: 14, color: "#E5E7EB"})
  end
  p.ui_button("stats_close", "閉じる", {parent: "stats", y: 0.9, w: 110, h: 28, size: 13, bg: "gray"})
end

on start()
  every(10, func() kit_leaderboard("💰") end)
  every(3, func()
    for p in players() do
      if ready(p) then p.score = (p.human_wins or 0) + (p.shark_wins or 0) end
    end
  end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.ui_button("picker_open", "🦈 種類", {at: "right", dy: 180, w: 150, h: 50, size: 17, bg: "#0E7490"})
  p.ui_button("stats_open", "📊 記録", {at: "right", dy: 240, w: 150, h: 50, size: 17, bg: "#334155"})
  p.my_color = p.color
  p.my_head = p.head_color
  p.sharks = []
  p.pick = "white"
  p.dynamite = 1
  p.medkits = 1
  p.repairs = 1
  kit_give(p, 40)
  if phase == "play" then
    p.role = "ghost"
    p.team = "human"
    to_ghost(p)
    p.message("🌊 ラウンドの最中！ 灯台から応援して、次のラウンドから参加", 3)
  else
    p.role = "human"
    p.team = "human"
    p.teleport(dock_spot())
    wait_buttons(p)
    item_buttons(p)
  end
end

on button(p, id)
  if id == "picker_open" then
    open_picker(p)
  elif id == "picker_close" then
    p.ui_remove("picker")
  elif starts_with(id, "pick_") then
    let key = replace(id, "pick_", "")
    let k = shark_of(key)
    if k.price == 0 or contains(p.sharks or [], k.id) then
      p.pick = k.id
      p.message("🦈 " + k.name + " にした", 1.2)
      open_picker(p)
    else
      p.message("🔒 売店で解放しよう（💰" + k.price + "）", 1.5)
    end
  elif id == "stats_open" then
    open_stats(p)
  elif id == "stats_close" then
    p.ui_remove("stats")
  end
end
