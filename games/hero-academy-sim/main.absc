-- Hero Academy Sim — ヒーローかヴィランか、個性で戦う
-- 個性16種（ガチャ・レア度・熟練度・技3つ）、レベルとステータス、サポートアイテム。
-- ヒーロー: 事件（強盗・火事・人質）・パトロールと戦う・昇格試験・懸賞金。
-- ヴィラン: 金庫やぶり・発電所をこわして停電・ヒーローをたおす。
-- ときどき改造怪人ゴウラがあらわれ、みんなで戦う。
--
-- ファイル:
--   data.absc       表（個性・ステータス・ランク・試験・金庫・アイテム）
--   common.absc     小さな道具・エフェクト・画面の左上
--   combat.absc     ダメージ・熟練度・気力・経験値・PvP
--   quirks.absc     個性の技（16 × 3）とボタン
--   incidents.absc  事件（ヒーローの仕事）
--   villains.absc   金庫やぶり・停電・パトロール（ヴィランの仕事）
--   kaijin.absc     改造怪人（みんなで戦うボス）
--   exam.absc       昇格試験
--   npcs.absc       NPCの動き
--   menus.absc      陣営・ガチャ・ステータス・アイテムの画面
--   main.absc       このファイル

kit_setup("Hero Academy Sim", "個性をみがいて、街を守るか、ねらうか", [
  "🦸 ヒーロー（青）か 🦹 ヴィラン（赤）を選ぶ。最初の個性ガチャは無料",
  "⚡ 右下の3つの技: すぐ使える技・強い技・🔥限界突破（ゲージMAX＋熟練度2）",
  "🚨 ヒーロー: 赤い光の柱の事件へ。火事は近づいて消し、市民は緑の安全地帯へ",
  "💰 ヴィラン: 金庫のパッドにいつづける。発電所の3台をこわすと停電",
  "📝 学園うらの黄色いパッドで昇格試験（Lv5・15・30）。合格で報酬アップ",
  "👹 ときどき改造怪人ゴウラが出る。みんなで戦えばごほうび",
  "📊 レベルアップでポイント。🛡 装備でさらに強く"
])

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["level", "xp", "points", "stats", "gear", "mxp", "owned", "tickets", "hero_pts", "fame", "license"])

kit_melee("パンチ", 10, 3, 5)
kit_level_base = 40

kit_quest("save1", "事件を1つ解決", 1, 100)
kit_quest("save10", "事件を10解決", 10, 800)
kit_quest("rescue5", "市民を5人救助", 5, 250)
kit_quest("fire10", "火を10個消す", 10, 200)
kit_quest("crooks", "悪党を20人たおす", 20, 250)
kit_quest("rob3", "金庫を3回やぶる", 3, 300)
kit_quest("rob15", "金庫を15回やぶる", 15, 1200)
kit_quest("blackout", "停電を起こす", 1, 500)
kit_quest("kaijin", "改造怪人をたおす", 1, 600)
kit_quest("exam1", "仮免許試験に合格", 1, 300)
kit_quest("exam3", "特級試験に合格", 1, 2000)
kit_quest("lv10", "レベル10になる", 9, 300)
kit_quest("lv30", "レベル30になる", 29, 1500)
kit_quest("mastery3", "熟練度を3回上げる", 3, 250)
kit_quest("collect5", "個性を5種類集める", 5, 500)
kit_quest("pvp10", "相手の陣営を10人たおす", 10, 400)
kit_quest("ult10", "限界突破を10回使う", 10, 300)
kit_quest("heal", "仲間を合計500回復", 500, 250)
kit_quest("rank", "ランクを上げる", 1, 200)
kit_quest("gear", "サポートアイテムを3回強化", 3, 200)

kit_shop_title = "コスチューム"
kit_shop_add("c_gold", "金のスーツ", 300, func(p) set_costume(p, "#F59E0B") end)
kit_shop_add("c_green", "みどりのスーツ", 300, func(p) set_costume(p, "#16A34A") end)
kit_shop_add("c_white", "白のスーツ", 300, func(p) set_costume(p, "#F8FAFC") end)
kit_shop_add("c_black", "黒のスーツ", 300, func(p) set_costume(p, "#111827") end)
kit_shop_add("c_pink", "ピンクのスーツ", 300, func(p) set_costume(p, "#EC4899") end)
kit_shop_add("h_cap", "ぼうし", 200, func(p) set_hat(p, "cap") end)
kit_shop_add("h_ant", "アンテナ", 500, func(p) set_hat(p, "antenna") end)

func set_costume(p, color)
  if p.team == "villain" then p.villain_color = color else p.hero_color = color end
  p.own_color = color
  p.color = color
  p.leg_color = color
end

func set_hat(p, hat)
  p.own_hat = hat
  if p.hat != "crown" and p.hat != "halo" then p.hat = hat end
end

-- MARK: No.1ヒーローと最重要指名手配

let no1_hero = nil
let most_wanted = nil

func update_titles()
  let best_h = nil
  let best_v = nil
  for p in players() do
    if ready(p) and p.team == "hero" and (p.hero_pts or 0) >= 400 and (best_h == nil or p.hero_pts > best_h.hero_pts) then best_h = p end
    if ready(p) and p.team == "villain" and (p.fame or 0) >= 100 and (best_v == nil or p.fame > best_v.fame) then best_v = p end
  end
  let new_h = nil
  if best_h != nil then new_h = best_h.id end
  if new_h != no1_hero then
    let old = nil
    if no1_hero != nil then old = player_by_id(no1_hero) end
    if old != nil then restore_hat(old) end
    no1_hero = new_h
    if best_h != nil then
      best_h.hat = "crown"
      announce("👑 " + best_h.name + " が No.1ヒーロー になった！", 3.5)
    end
  end
  let new_v = nil
  if best_v != nil then new_v = best_v.id end
  if new_v != most_wanted then
    most_wanted = new_v
    if best_v != nil then announce("💀 " + best_v.name + " が最重要指名手配に！ 懸賞金 🪙" + bounty_of(best_v), 3.5) end
  end
  let line = ""
  if best_h != nil then line = "👑 No.1: " + best_h.name end
  if best_v != nil then
    if line != "" then line = line + "   " end
    line = line + "💀 指名手配: " + best_v.name + "（🪙" + bounty_of(best_v) + "）"
  end
  if line == "" then ui_remove("titles") else ui_text("titles", line, {at: "top_right", dx: -70, dy: 130, size: 13, bold: true, color: "#FDE68A"}) end
end

func restore_hat(p)
  if (p.license or 0) >= 3 then p.hat = "halo" else p.hat = p.own_hat or "none" end
end

on start()
  game.respawn_time = 4
  incident_next = time() + 20
  kaijin_next = time() + KAIJIN_FIRST
  reset_generators()
  -- 前のラウンドのNPCは消す
  for n in npcs() do n.destroy() end
  every(10, func()
    update_titles()
    kit_leaderboard("⭐")
  end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.level = 1
  p.xp = 0
  p.points = 0
  p.stats = {}
  p.gear = {}
  p.mxp = {}
  p.owned = []
  p.tickets = 0
  p.energy = 100
  p.limit = 0
  p.hero_pts = 0
  p.fame = 0
  p.license = 0
  p.cd = {}
  p.btn = {}
  p.own_color = p.color
  kit_show_level(p)
  kit_show_money(p)
  p.give("パンチ")
  p.ui_button("open_gacha", "🎰 個性", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#7C3AED"})
  p.ui_button("open_stats", "📊 ステータス", {at: "right", dy: -60, w: 150, h: 50, size: 16, bg: "#0F766E"})
  p.ui_button("open_gear", "🛡 装備", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#0E7490"})
  side_panel(p)
  hud(p)
end

on respawn(p)
  if not ready(p) then return end
  p.energy = max_energy(p)
  p.frozen = false
  p.visible = true
  refresh_body(p)
  p.heal(p.max_health)
  if p.team == "villain" then
    let s = block("Villain Spawn " + random(1, 6))
    if s != nil then p.teleport(s) end
  end
  if p.own_color != nil then p.color = p.own_color end
  show_bars(p)
end

on leave(p)
  for n in npcs() do
    if n.kind == "clone" and n.owner == p.id then gone(n) end
    if n.kind == "civ" and n.rescuer == p.id then n.rescuer = nil end
  end
  if no1_hero == p.id then no1_hero = nil end
  if most_wanted == p.id then most_wanted = nil end
end
