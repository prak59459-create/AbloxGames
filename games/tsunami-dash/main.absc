-- Tsunami Dash — うしろからせまる津波からにげて、ゴールまで走りぬけろ
-- 3つのコースから投票 → カウントダウン → レース。ミームを集めて、ショップでずっと使える強化。
--
-- ファイル:
--   data.absc    表（コース・パワーアップ・強化・スキン）
--   common.absc  小さな道具・速さ・画面の左上
--   race.absc    投票・カウントダウン・津波・ゴール・のまれる
--   track.absc   ミーム・ブースト・パワーアップ・溶岩の点めつ・ゲート
--   shop.absc    ミームショップとスキン
--   stats.absc   最速記録・結果・成績
--   main.absc    このファイル

kit_setup("Tsunami Dash", "止まったら、のまれる！", [
  "🗳 パッドにのってコースを投票（🏖ビーチ・🏙シティ・🌋かざん）",
  "🌊 GO! で走り出そう。津波はだんだん速くなる（走るボタンで速く）",
  "✨ ミーム（光る玉）を集める。🔥 オレンジの床でブースト",
  "📦 光る箱はパワーアップ: ⚡スピード 🛡シールド 🦘ジャンプ ❄津波ストップ 🧲マグネット",
  "🌋 かざんの溶岩は点めつ、🏙 シティの赤いゲートは開いたり閉じたり",
  "🛒 ミームショップでずっと使える強化、🎨 スキンも買える",
  "⚠ ときどきメガ津波！ 速いけれどミーム2倍"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["ups", "memes", "skins", "skin"])

kit_quest("races", "10レース走る", 10, 10)
kit_quest("finish", "ゴールする", 1, 5)
kit_quest("win", "1位になる", 1, 15)
kit_quest("volcano", "かざんコースでゴール", 1, 25)
kit_quest("memes", "ミームを100こ集める", 100, 20)
kit_quest("power", "パワーアップを10回使う", 10, 10)
kit_quest("upgrade", "強化を買う", 1, 5)
kit_quest("skin", "スキンを買う", 1, 5)

let money_clock = 0

on start()
  start_vote()
  show_records()
  every(10, func() kit_leaderboard("🏁") end)
end

on join(p)
  kit_welcome(p)
  p.ups = {}
  p.memes = 0
  p.skins = ["own"]
  p.skin = "own"
  own_colors(p)
  p.racing = false
  p.out = false
  p.done = false
  p.ui_button("shop", "🛒 ショップ", {at: "right", dy: -60, w: 140, h: 48, size: 16, bg: "#CA8A04"})
  p.ui_button("stats", "📊", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  kit_quest_button(p)
  kit_camera_button(p)
  apply_move(p)
  hud(p)
  if phase == "vote" then
    vote_ui(p)
  else
    p.message("レース中！ 次のレースから参加できるよ", 2.5)
  end
end

-- クエストのごほうび（kit のコイン）はミームとして受けとる
on tick(dt)
  money_clock = money_clock + dt
  if money_clock < 1 then return end
  money_clock = 0
  for p in players() do
    if ready(p) and (p.coins or 0) > 0 then
      p.memes = p.memes + p.coins
      p.coins = 0
      hud(p)
    end
  end
end
