-- Metro Response — 警察・消防・救急・市民・犯罪者の街RP
-- 出動指令（火事・けが人・強盗・交通事故）、消防の水と消火栓・延焼・救助、救急の手当てと搬送・蘇生、
-- 警察のテーザーと手錠・留置所、市民の配達とタクシー、犯罪者の金庫とATM、チームごとの階級と車。
--
-- ファイル:
--   data.absc      表（チーム・階級・出動・消防/救急/警察の数字）
--   common.absc    小さな道具・階級・画面
--   dispatch.absc  出動指令
--   fire.absc      消防
--   medic.absc     救急・たおれたプレイヤー
--   police.absc    警察・犯罪者・留置所
--   civil.absc     配達・タクシー・ATM
--   main.absc      このファイル

kit_setup("Metro Response", "緊急出動！街を守れ", [
  "署の前のパッドでチーム: 🚓警察・🚒消防・🚑救急・🧑市民・🦹犯罪者（北東）",
  "📻 画面の上に出動指令。早く解決するとボーナス、階級も上がる",
  "🚒 火の近くで「💦 放水」。水は消防署の赤い消火栓で補給",
  "🚑 けが人の近くで「🩺 手当て」3回 → 病院のベッドへ。たおれた人も復活させられる",
  "🚓 テーザーでしびれさせて「🔗 手錠」。🦹 市役所の金庫やATMをねらえ",
  "🧑 市民は配達や🚕タクシー。「🚗 車」でのりおり"
])

kit_quest("calls", "出動を3回解決", 3, 200)
kit_quest("fires", "火を10個消す", 10, 250)
kit_quest("rescue", "逃げおくれた人を助ける", 1, 150)
kit_quest("patients", "けが人を3人運ぶ", 3, 200)
kit_quest("revive", "たおれた人を復活させる", 1, 150)
kit_quest("arrests", "3人確保", 3, 250)
kit_quest("deliver", "配達を5回", 5, 150)
kit_quest("taxi", "タクシーで3回運ぶ", 3, 150)
kit_quest("heist", "金庫かATMをやぶる", 1, 150)
kit_quest("stash", "アジトで山分け", 1, 150)
kit_quest("rank", "階級を上げる", 1, 200)

func set_team(p, id)
  if active_until(p.jailed_until) then return end
  let t = TEAMS[id]
  p.team = id
  p.color = t.color
  p.hat = t.hat
  p.take()
  p.driving = false
  p.speed = 1
  p.rob = nil
  if p.fare != nil then
    gone(p.fare.beam)
    p.fare = nil
  end
  if p.drop != nil then
    gone(p.drop)
    p.drop = nil
  end
  for id2 in ["spray", "treat", "cuff"] do p.ui_remove(id2) end
  if id == "police" then
    p.give("taser")
    p.ui_button("cuff", "🔗 手錠", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 60, size: 17, bg: "#1D4ED8", radius: 16})
  elif id == "fire" then
    p.water = tank_max(p)
    p.ui_button("spray", "💦 放水", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 64, size: 18, bg: "#0EA5E9", radius: 16})
  elif id == "medic" then
    p.ui_button("treat", "🩺 手当て", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 64, size: 18, bg: "#F472B6", radius: 16})
  elif id == "civilian" then
    new_delivery(p)
  elif id == "criminal" then
    p.give("crook_gun")
  end
  p.message(t.name + "「" + rank_name(p) + "」として出動！", 2)
  hud(p)
end

on start()
  game.respawn_time = DOWNED_SECS
  for n in npcs() do n.destroy() end
  every(10, func() kit_leaderboard("⭐") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_show_money(p)
  p.pts = {}
  p.water = 0
  p.loot = 0
  p.wanted = 0
  p.ui_button("drive", "🚗 車", {at: "right", dy: 0, w: 150, h: 46, size: 16, bg: "#0EA5E9"})
  hud(p)
end

on leave(p)
  if p.fare != nil then gone(p.fare.beam) end
  if p.drop != nil then gone(p.drop) end
end

on touch(p, b)
  if p.is_npc or not ready(p) then return end
  if contains(b.tags, "team") then
    for id in TEAM_ORDER do
      if TEAMS[id].pad == b.name and p.team != id and quiet_ready(p, "team_pad", 2) then set_team(p, id) end
    end
  end
end

on button(p, id)
  if not ready(p) then return end
  if id == "cuff" then cuff(p)
  elif id == "drive" then
    if p.team == nil then return end
    p.driving = not p.driving
    if p.driving then
      p.speed = TEAMS[p.team].speed
      p.message(TEAMS[p.team].car + " に乗った", 1)
    else
      p.speed = 1
    end
  end
end
