-- Neo City Life — 未来都市でくらすRP
-- 仕事6種類（仕事レベルで給料アップ）、指名手配と刑務所、乗り物5種、
-- 空の家（スマートホームで家賃収入）、スマホ、ネオンナイト、空のドローンレース。
--
-- ファイル:
--   data.absc     表（仕事・仕事レベル・乗り物・家・レースのコース）
--   common.absc   小さな道具・画面の左上
--   jobs.absc     仕事（修理・手当て・確保・料理・空の配達・ハック）
--   crime.absc    指名手配・逮捕・刑務所・保釈
--   city.absc     乗り物・空の家・スマホ・ネオンナイト
--   race.absc     ドローンレース
--   main.absc     このファイル

kit_setup("Neo City Life", "未来の街で働いて、空の家へ", [
  "💼 光るパッドで仕事: エンジニア・メディック・オフィサー・シェフ・パイロット・ハッカー",
  "🔧🩺 こわれた機械やけが人のそばにいると仕事が進む。🚓 逃げるロボを追いかけろ",
  "💻 ハッカーはかせげるけど指名手配⭐。オフィサーに逮捕されると刑務所",
  "🚗 オレンジのベイで乗り物。🚀 飛べる乗り物で空の配達やレース",
  "🏙 ピンクのリフトで空の家。📱 スマホで強化すると家賃収入",
  "🏁 ときどきドローンレース、🌃 ネオンナイトは給料2倍！"
])
kit_currency = "クレジット"
kit_shop_title = "ネオンショップ"
kit_shop_add("paint", "ネオンカラーに光る", 80, func(p)
  p.color = random(["#22D3EE", "#F472B6", "#A3E635", "#FACC15", "#A78BFA"])
end)
kit_shop_add("visor", "ホロバイザー", 200, func(p) p.hat = "antenna" end)
kit_shop_add("halo", "ネオンヘイロー", 600, func(p) p.hat = "halo" end)

kit_quest("jobs3", "3種類の仕事をする", 3, 150)
kit_quest("job10", "仕事を10回こなす", 10, 200)
kit_quest("job50", "仕事を50回こなす", 50, 1000)
kit_quest("job_rank", "仕事レベルを上げる", 1, 150)
kit_quest("arrest", "指名手配の人を逮捕", 1, 200)
kit_quest("home", "空の家を手に入れる", 1, 100)
kit_quest("smart", "家を強化する", 1, 150)
kit_quest("vehicle", "乗り物を買う", 1, 100)
kit_quest("race", "レースに出る", 1, 80)
kit_quest("race_win", "レースで1位", 1, 400)

on start()
  for n in npcs() do n.destroy() end
  every(12, func() kit_leaderboard("💎") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_shop_button(p)
  p.owned = ["walk", "hover"]
  p.tried = []
  p.job_count = {}
  p.wanted = 0
  p.wanted_at = 0
  p.home_lv = 0
  p.vehicle = "walk"
  kit_give(p, 100)
  p.ui_button("open_phone", "📱 スマホ", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#4F46E5"})
  p.ui_button("vehicles", "🚗 乗り物", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#F97316"})
  p.ui_button("drone", "🛸 ドローン", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#7C3AED"})
  hud(p)
end

on respawn(p)
  if not ready(p) then return end
  ride(p, p.vehicle)
  if active_until(p.jailed_until) then
    let cell = block("Jail Cell 1")
    if cell != nil then p.teleport(cell) end
  end
end

on leave(p)
  clear_task(p)
  for key in keys(homes) do
    if homes[key] == p.id then homes[key] = nil end
  end
  if race != nil then remove(race.racers, p.id) end
end
