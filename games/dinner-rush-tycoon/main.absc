-- Dinner Rush Tycoon — レストラン経営タイクーン
-- 設備19（テーブル8・料理の設備5・かざり）、料理6品、スタッフ（シェフ・ウェイター）、
-- 評判（★）と料理評論家、2号店（リバース）で売上アップ。
--
-- ファイル:
--   data.absc     表（設備・料理・スタッフ・2号店）
--   common.absc   小さな道具・画面
--   shop.absc     区画・設備を買う・スタッフ・2号店
--   service.absc  お客さん・注文・作る・出す・スタッフの動き・評論家
--   main.absc     このファイル

kit_setup("Dinner Rush Tycoon", "店を大きくして、人気レストランに", [
  "🏁 色のついたパッドで区画があなたの店に（コンロは無料）",
  "🟢 緑のパッドで設備を順番に買う。料理の設備でメニューがふえる",
  "🍳 お客さんが注文したら、その料理の設備の緑パッドで作る",
  "🍽 できた料理をそのテーブルの緑パッドへ（受け渡し台にも置ける）",
  "👥 むらさきのパッド: シェフとウェイターをやとうと自動で回る",
  "🧐 料理評論家には早く出そう。⭐が高いほどお客さんが来る",
  "🏪 設備コンプリート＋売上で2号店。売上がずっと増える"
])

kit_quest("items", "設備を5つ買う", 5, 150)
kit_quest("tables", "テーブルを4つにする", 1, 300)
kit_quest("serve", "10人に料理を出す", 10, 200)
kit_quest("sales", "売上1万", 10000, 1000)
kit_quest("staff", "スタッフをやとう", 1, 200)
kit_quest("critic", "料理評論家をうならせる", 1, 500)
kit_quest("full", "設備をコンプリート", 1, 2000)
kit_quest("rebirth", "2号店を出す", 1, 3000)

on start()
  for n in npcs() do n.destroy() end
  every(10, func() kit_leaderboard("🍽 売上") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_give(p, 100)
  p.sales = 0
  p.rebirths = 0
  hud(p)
end

on leave(p)
  release_plot(p)
end

on touch(p, b)
  if p.is_npc or not ready(p) then return end
  let parts = split(b.name, " ")
  if contains(b.tags, "claim") then claim(p, parts[2])
  elif contains(b.tags, "staff") then
    if p.plot == parts[2] and quiet_ready(p, "staff_pad", 3) then staff_menu(p) end
  elif contains(b.tags, "buy") then
    let plot = parts[2]
    let k = num(parts[4])
    if p.plot != plot then return end
    let pl = plot_of(p)
    if not has(pl, k) then
      if quiet_ready(p, "buy_" + k, 1) then buy(p, k) end
      return
    end
    let kind = ITEMS[k].kind
    if kind == "table" then serve(p, k)
    elif kind == "pass" then
      if quiet_ready(p, "pass", 1) then pass_dish(p) end
    elif kind != "decor" then cook(p, k)
    end
  end
end

on button(p, id)
  if not ready(p) then return end
  if id == "staff_chef" then
    hire(p, "chef")
    staff_menu(p)
  elif id == "staff_waiter" then
    hire(p, "waiter")
    staff_menu(p)
  elif id == "rebirth" then rebirth(p)
  elif id == "staff_close" then p.ui_remove("staff")
  end
end
