-- Chaos Golf — ボールの物理でころがる、みんな同時のへんてこミニゴルフ。9ホールとアイテムでカオスに！
--
-- ファイル:
--   data.absc     9ホール・アイテム・ボールの色
--   physics.absc  ボールの物理（まさつ・反射・坂・砂・氷・加速床・水・ワープ・動くじゃま・カップ）
--   golf.absc     ゲームの流れ・ねらい・打つ・スコア
--   items.absc    ？の箱とアイテム・ボールの色
--   main.absc     このファイル

kit_setup("Chaos Golf", "少ない打数でカップイン！", [
  "🎯 黄色い点がねらいの方向。◀ ▶ で向きを変える（👀 でカメラの向き）",
  "💪 ＋ − でパワー（1〜10）を決めて「⛳ 打つ」",
  "🏌 ボールはころがって、かべではねる。止まったら次のショット",
  "🟡 砂はとまりやすい、🧊 氷はすべる、🔵 加速床はビュン、💧 水と場外は1打ペナルティ",
  "🌀 紫のワープゲート、🟥 動くじゃまものに注意",
  "🎁 黄色い箱にボールを通すとアイテム（ほかの人のじゃまもできる！）",
  "9ホールの合計打数が少ない人の優勝！"
])
kit_currency = "コイン"

kit_quest("par", "パー以下で5回カップイン", 5, 300)
kit_quest("ace", "ホールインワン", 1, 1000)
kit_quest("finish", "9ホールを回る", 1, 300)
kit_quest("win", "大会で優勝する", 1, 800)
kit_quest("items", "アイテムを5こ拾う", 5, 200)
kit_quest("use", "アイテムを5回使う", 5, 200)

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.card = []
  p.playing = false
  p.power = 5
  p.aim = 0
  p.strokes = 0
  p.shots = 0
  p.sunk = false
  p.colors = ["white"]
  p.ball_color = "white"
  kit_give(p, 20)
  p.camera = "third"
  p.camera_distance = 9
  p.ui_button("swing", "⛳ 打つ", {at: "bottom_right", dx: -110, dy: -170, w: 140, h: 66, size: 20, bg: "#F59E0B", radius: 18})
  p.ui_button("aim_ll", "⏪", {at: "bottom", dx: -170, dy: -100, w: 56, h: 48, size: 18, bg: "#16A34A", radius: 12})
  p.ui_button("aim_l", "◀", {at: "bottom", dx: -108, dy: -100, w: 56, h: 48, size: 18, bg: "#22C55E", radius: 12})
  p.ui_button("aim_look", "👀", {at: "bottom", dx: -46, dy: -100, w: 56, h: 48, size: 18, bg: "#0EA5E9", radius: 12})
  p.ui_button("aim_r", "▶", {at: "bottom", dx: 16, dy: -100, w: 56, h: 48, size: 18, bg: "#22C55E", radius: 12})
  p.ui_button("aim_rr", "⏩", {at: "bottom", dx: 78, dy: -100, w: 56, h: 48, size: 18, bg: "#16A34A", radius: 12})
  p.ui_button("pow_down", "−", {at: "bottom", dx: 150, dy: -100, w: 48, h: 48, size: 22, bg: "#B91C1C", radius: 12})
  p.ui_button("pow_up", "＋", {at: "bottom", dx: 204, dy: -100, w: 48, h: 48, size: 22, bg: "#DC2626", radius: 12})
  p.ui_button("use_item", "🎁 使う", {at: "right", dy: -60, w: 130, h: 44, size: 15, bg: "#A855F7"})
  p.ui_button("open_card", "📋 スコア", {at: "right", dy: -10, w: 130, h: 44, size: 15, bg: "#15803D"})
  p.ui_button("open_colors", "🎨 ボール", {at: "right", dy: 40, w: 130, h: 44, size: 15, bg: "#57534E"})
  -- 大会の途中なら、次のホールから参加（出られなかったホールはパー+3）
  if phase == "play" or phase == "between" then
    p.playing = true
    if hole > 1 then
      for i in 1 to hole - 1 do append(p.card, HOLES[i].par + 3) end
    end
    if phase == "between" then
      append(p.card, HOLES[hole].par + 3)
    else
      p.strokes = HOLES[hole].par + 3
      p.sunk = true
    end
    p.message("⛳ 大会の途中から参加！ 次のホールからプレイ", 3)
  end
  hud(p)
end
