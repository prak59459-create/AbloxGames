-- Sprout Garden — 畑でタネを育てて売るゲーム
-- タネ22種（6段階のめずらしさ・5分ごとに入荷）・何度も実る植物・実の重さ・変異8種（天気・雷・虹・月光）・
-- じょうろ・スプリンクラー・肥料・畑の拡張・ペット6種・庭師レベル。
--
-- ファイル:
--   data.absc     表（タネ・めずらしさ・変異・道具・たまごとペット・天気）
--   common.absc   人さがし・画面・実の値段・レベル
--   garden.absc   畑・植える・育つ・収穫・変異・じょうろ・スプリンクラー
--   shop.absc     タネ屋（入荷）・手に持つタネ・かご・市場・道具屋
--   weather.absc  天気と昼夜（変異がつく）
--   pets.absc     たまご屋とペットの手伝い
--   main.absc     このファイル

kit_setup("Sprout Garden", "タネをまいて、育てて、売って、夢の庭へ", [
  "🟨 黄色いパッドにさわると、その畑があなたのもの",
  "🌱 タネ屋（緑）でタネを買う。5分ごとに入荷。レアなタネは売り切れやすい",
  "✋ タネを持って自分の土にさわると植える。実ったら さわって収穫",
  "🍓 いちごやトマトは何度も実る。スイカやかぼちゃは1回だけ（高い！）",
  "🌧 天気で実に変異: ぬれた×2・ひえた×2・こおった×10・しびれた×50・虹×50・金×20",
  "🧺 市場（オレンジ）で売る。⭐お気に入りは売らない",
  "🧰 道具屋: じょうろ・スプリンクラー・肥料・畑を広げる",
  "🥚 たまご屋のペットが畑を手伝ってくれる"
])
kit_currency = "シェケル"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["level", "xp", "seeds", "hand", "basket_size", "gear", "items", "fert", "soil_open", "pets"])


-- MARK: クエスト

kit_quest("plant", "タネを植える", 1, 20)
kit_quest("harvest", "10こ収穫", 10, 100)
kit_quest("harvest100", "100こ収穫", 100, 5000)
kit_quest("kinds", "5しゅるい植える", 5, 1000)
kit_quest("buyseed", "タネを10こ買う", 10, 200)
kit_quest("sell", "合計10万シェケル売る", 100000, 20000)
kit_quest("golden", "ゴールドの実を収穫", 1, 5000)
kit_quest("rainbow", "レインボーの実を収穫", 1, 50000)
kit_quest("rare_mut", "こおった/しびれた実を収穫", 1, 10000)
kit_quest("weather", "天気のイベントを3回見る", 3, 300)
kit_quest("sprinkler", "スプリンクラーを置く", 1, 2000)
kit_quest("expand", "畑を広げる", 1, 3000)
kit_quest("pet", "ペットをかえす", 1, 10000)
kit_quest("lv10", "庭師レベル10", 9, 8000)

on join(p)
  p.level = 1
  p.xp = 0
  p.seeds = {carrot: 3, strawberry: 1}
  p.hand = "carrot"
  p.basket = []
  p.basket_size = 200
  p.gear = []
  p.items = {}
  p.fert = 0
  p.use_fert = false
  p.soil_open = 8
  p.pets = []
  p.pet = nil
  restock(p)
  kit_welcome(p)
  kit_give(p, 20)
  p.ui_button("open_seeds", "🌱 タネ", {at: "right", dy: -180, w: 150, h: 50, size: 17, bg: "#15803D"})
  p.ui_button("open_basket", "🧺 かご", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#C2410C"})
  p.ui_button("open_pets", "🐾 ペット", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#A16207"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end

on start()
  every(10, func() kit_leaderboard("💰 かせいだ額") end)
end
