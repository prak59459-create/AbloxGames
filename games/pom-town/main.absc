-- Pom Town — 家を家具でかざって、ペットのポムとくらす街
-- 家（家具24種・★・かべの色・いいね・パーティー・おうちコンテスト）、
-- ポム（タマゴ3種・15種類・お世話で5段階に育つ・交換）、
-- お仕事（釣り図鑑・配達・水やり・おこづかい）。
--
-- ファイル:
--   data.absc     表（家具・ポム・タマゴ・年れい・お世話・魚）
--   common.absc   小さな道具・画面の上
--   homes.absc    家・家具・いいね・パーティー・コンテスト
--   poms.absc     ポム（タマゴ・お世話・成長・交換）
--   jobs.absc     釣り・配達・水やり・おこづかい
--   menus.absc    おうち・ポム・タマゴ屋・交換の画面
--   main.absc     このファイル

kit_setup("Pom Town", "家をかざって、ポムとなかよく", [
  "🏠 黄色い看板にさわると、その家があなたの家に",
  "🛒 家具屋で買って「🏠 おうち」から置く。インテリア点で★が増える",
  "🥚 ポム屋（むらさき）でタマゴ。かえったポムのお世話をすると育つ",
  "🍖🎾💤🛁 ポムのお願いは画面の上に出る。その場所へ連れて行こう",
  "📦 郵便局で配達・🌷 小屋で水やり・🎣 池で釣り → スター",
  "👍 よその家で「いいね」。5分ごとにおうちコンテスト！",
  "🎉 パーティーを開いたら、みんなはチャットで /party"
])
kit_currency = "スター"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["bag", "likes", "fishdex", "job_xp", "poms", "egg"])

kit_shop_title = "家具屋"

for f in FURNITURE do
  kit_shop_add(f.id, f.name, f.price, func(p)
    append(p.bag, f.id)
    kit_quest_progress(p, "buy", 1)
    hud(p)
    if p.home_open then home_menu(p) end
  end)
end

kit_quest("home", "家を手に入れる", 1, 30)
kit_quest("buy", "家具を5つ買う", 5, 50)
kit_quest("decor10", "家具を10個置く", 10, 120)
kit_quest("decor300", "インテリア300点", 300, 400)
kit_quest("paint", "かべの色をぬる", 1, 30)
kit_quest("buy_egg", "タマゴを買う", 1, 30)
kit_quest("hatch", "タマゴをかえす", 1, 60)
kit_quest("poms3", "ポムを3匹にする", 3, 200)
kit_quest("needs20", "ポムのお願いを20回かなえる", 20, 250)
kit_quest("grow", "ポムを「大人」に育てる", 1, 300)
kit_quest("legend", "ポムを「伝説」に育てる", 1, 800)
kit_quest("trade", "ポムを交換する", 1, 100)
kit_quest("fish10", "10回つる", 10, 80)
kit_quest("dex", "魚図鑑を8種類そろえる", 8, 500)
kit_quest("parcel10", "荷物を10回届ける", 10, 200)
kit_quest("garden10", "花だんに10回水やり", 10, 150)
kit_quest("party", "パーティーを開く", 1, 50)
kit_quest("guest", "パーティーに参加する", 3, 60)
kit_quest("give_like", "よその家に3回いいね", 3, 40)
kit_quest("like5", "いいねを5つもらう", 5, 200)
kit_quest("contest", "おうちコンテストで優勝", 1, 500)

on start()
  for n in npcs() do n.destroy() end
  setup_beds()
  every(10, func() kit_leaderboard("🏠") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  p.bag = ["chair", "table", "lamp"]
  p.placed = []
  p.decor = 0
  p.likes = 0
  p.poms = []
  p.active = nil
  p.fishdex = {}
  p.job_xp = 0
  kit_give(p, 150)
  p.ui_button("open_home", "🏠 おうち", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#EC4899"})
  p.ui_button("open_poms", "🐾 ポム", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#7C3AED"})
  p.ui_button("like", "👍 いいね", {at: "right", dy: 0, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  -- はじめてのポム（ふつうのタマゴを1つプレゼント）
  p.egg = {id: "basic", left: 20}
  p.message("🥚 ようこそ！ ふつうのタマゴをプレゼント。20びょうでかえるよ", 3)
  hud(p)
end

on leave(p)
  despawn_pom(p)
  let t = trade_of(p)
  if t != nil then close_trade(t) end
  if p.parcel != nil then gone(p.parcel.beam) end
  free_home(p)
end
