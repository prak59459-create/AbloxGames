-- Power Roulette — ルーレットで能力が決まるバトル
-- ラウンドのはじめにルーレット。能力は21種類・5つのレア度。ラウンドごとにイベントもある。
-- 90びょうでいちばんたおした人の勝ち。まんなかのジャックポットは1ラウンド1回。
--
-- ファイル:
--   data.absc    表（レア度・能力21・イベント・ショップ）
--   common.absc  小さな道具・ダメージ
--   powers.absc  能力を使う・毒の沼・分身
--   round.absc   ルーレット・ラウンド・イベント・ジャックポット
--   shop.absc    チケット・運の薬・図鑑
--   main.absc    このファイル

kit_setup("Power Roulette", "運命のルーレットで戦え", [
  "🎰 ラウンドのはじめにルーレットで能力が1つ決まる（ダブルなら2つ）",
  "⭐ レア度はコモン〜ミシック。使うほど熟練して強くなる",
  "🎪 ラウンドごとにイベント: 低重力・巨人の日・回復なし・溶岩…",
  "🎯 まんなかの赤いパッドはジャックポット（1ラウンド1回）",
  "🎲 引き直しチケットで能力を変えられる。🍀 運の薬でレアが出やすく",
  "🏆 90びょうでいちばんたおした人の勝ち"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["tickets", "index", "mastery"])

kit_quest("win", "1ラウンド勝つ", 1, 150)
kit_quest("ko", "10人たおす", 10, 150)
kit_quest("use", "能力を50回使う", 50, 150)
kit_quest("collect", "10種類の能力を見つける", 10, 300)
kit_quest("jackpot", "ジャックポットを回す", 1, 30)
kit_quest("reroll", "引き直しを使う", 1, 20)

on start()
  game.respawn_time = 5
  after(4, func() start_round() end)
  every(10, func() kit_leaderboard("🏆") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_show_money(p)
  p.tickets = 1
  p.index = []
  p.mastery = {}
  p.give("パンチ")
  shop_buttons(p)
  p.ui_button("booth", "🎟 売り場", {at: "right", dy: 0, w: 130, h: 44, size: 15, bg: "#6D28D9"})
  p.ui_button("index", "📖 図鑑", {at: "right", dy: 54, w: 130, h: 44, size: 15, bg: "#0E7490"})
  if live then spin(p, 1) end
end
