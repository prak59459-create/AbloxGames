-- Island Drama Show — 無人島のサバイバル番組。チャレンジで勝ちぬいて、授与式を生きのこれ！
--
-- ファイル:
--   data.absc        チャレンジ9つ・クイズ40問・司会のセリフ
--   common.absc      番組の状態・画面
--   challenges.absc  9つのチャレンジのしくみ
--   show.absc        シーズン・授与式（投票）・決勝・チャンピオン
--   main.absc        このファイル

kit_setup("Island Drama Show", "勝ちぬけ！ 最後の1人はだれだ", [
  "🎬 毎回ちがうチャレンジ（9種類）。順位でポイントがもらえる",
  "🛡 1位はイミュニティ。授与式で安全",
  "🍡 マシュマロ授与式: ポイントの低い2人から、みんなの投票で1人が脱落",
  "😢 脱落した人は観客席から投票で参加。次のシーズンで復活",
  "🔥 2人になったら決勝戦！ 勝ったほうがチャンピオン",
  "🪵 丸太わたり・⚽ 玉よけ・❓ クイズ・👑 山の王さま・🗼 タワー・🪙 コイン・🎨 色の床・🧊 氷のゆか・🧠 記憶の道"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["wins"])


kit_quest("challenge", "チャレンジで1位", 1, 150)
kit_quest("win", "チャンピオンになる", 1, 1000)
kit_quest("season", "シーズンに3回出る", 3, 300)
kit_quest("vote", "授与式で5回投票する", 5, 150)

kit_shop_title = "衣装"
kit_shop_add("cap", "🧢 キャップ", 100, func(p) p.hat = "cap" end)
kit_shop_add("antenna", "📡 アンテナ", 200, func(p) p.hat = "antenna" end)
kit_shop_add("halo", "😇 天使の輪", 500, func(p) p.hat = "halo" end)
kit_shop_add("red", "🔴 赤チームの服", 150, func(p) p.color = "#DC2626" end)
kit_shop_add("blue", "🔵 青チームの服", 150, func(p) p.color = "#2563EB" end)

on start()
  every(10, func() kit_leaderboard("🏆") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.points = 0
  p.wins = 0
  p.in_show = false
  p.out = false
  p.immune = false
  p.in_challenge = false
  kit_give(p, 20)
  if phase == "lobby" then
    p.message("🎬 もうすぐ新シーズン！", 2)
  else
    p.message("🎬 いま放送中。観客席から見て、授与式では投票できるよ！", 3)
    to_audience(p)
  end
end
