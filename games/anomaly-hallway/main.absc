-- Anomaly Hallway — 異変があれば引き返し、なければ進む
-- 32の異変（目立つ・よく見るとわかる・小さい）、歩いてくるおじさん、せまってくる異変、
-- 異変図鑑、ふつうの廊下のチェックリスト、最速記録、裏モード。
--
-- ファイル:
--   common.absc     状態・道具・画面
--   anomalies.absc  32の異変
--   loop.absc       1周の流れ・出口・図鑑・チェックリスト
--   man.absc        歩いてくるおじさん
--   main.absc       このファイル

kit_setup("Anomaly Hallway", "異変を見のがすな", [
  "この廊下をよーく覚えよう（📋 チェックリストで確認できる）",
  "異変がなければ、奥の緑のパッドへ進む。異変があったら、うしろの赤いパッドへ引き返す",
  "正解すると出口の番号が1つ進む。まちがえると0にもどる。8番まで進めば脱出！",
  "🚶 おじさんがむこうから歩いてくる。おじさんにも異変があるかも",
  "⚠️ せまってくる異変もある。気づいたらすぐ引き返せ！ 📖 見つけた異変は図鑑に"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["found"])

kit_quest("right5", "5番まで進む", 1, 150)
kit_quest("escape", "8番出口から脱出", 1, 500)
kit_quest("hard", "裏の8番出口から脱出", 1, 1000)
kit_quest("dex", "異変を10種類見つける", 10, 300)
kit_quest("dex20", "異変を20種類見つける", 20, 600)

on start()
  run_start = time()
  after(1, func() next_loop() end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.found = []
  p.ui_button("checklist", "📋 チェック", {at: "right", dy: -60, w: 150, h: 46, size: 16, bg: "#0E7490"})
  p.ui_button("dex", "📖 図鑑", {at: "right", dy: 0, w: 150, h: 46, size: 16, bg: "#6D28D9"})
  show()
  show_me(p)
end
