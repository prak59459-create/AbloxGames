    end, revert: func() reset_man() end},
  {name: "赤い波がせまる", level: 1, danger: true, apply: func() start_wave() end, revert: func()
      wave = nil
      clear_anom_blocks()
    end},

  -- よく見るとわかる異変
  {name: "紫の植物", level: 2, apply: func() tint("Plant", "#7E22CE") end, revert: func() tint("Plant", "#16A34A") end},
  {name: "赤い出口サイン", level: 2, apply: func() tint("Exit Sign", "#DC2626") end, revert: func() tint("Exit Sign", "#22C55E") end},
  {name: "明かりが1つ消えている", level: 2, apply: func() show_block("Ceiling Lamp 3", false) end,
   revert: func() show_block("Ceiling Lamp 3", true) end},
  {name: "消火器がない", level: 2, apply: func() show_block("Fire Extinguisher", false) end,
   revert: func() show_block("Fire Extinguisher", true) end},
  {name: "ドアの位置がちがう", level: 2, apply: func() block("Door B").z = 12 end, revert: func() block("Door B").z = 6 end},
  {name: "時計が大きい", level: 2, apply: func() block("Clock").size = {x: 0.05, y: 1.6, z: 1.6} end,
   revert: func() block("Clock").size = {x: 0.05, y: 0.7, z: 0.7} end},
  {name: "おじさんが大きい", level: 2, apply: func()
      let n = first_man()
      if n != nil then n.size = 1.7 end
    end, revert: func() reset_man() end},
  {name: "おじさんがこっちを見る", level: 2, apply: func()
      let n = first_man()
      if n != nil then n.mode = "stare" end
    end, revert: func() reset_man() end},
  {name: "おじさんが2人", level: 2, apply: func() make_man(1.6) end, revert: func() reset_man() end},
  {name: "おじさんがいない", level: 2, apply: func() clear_men() end, revert: func() reset_man() end},
  {name: "ゴミ箱が倒れている", level: 2, apply: func()
      let b = block("Trash Can")
      b.rotation = {x: 0, y: 0, z: 90}
