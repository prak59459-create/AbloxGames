  {name: "防犯カメラがこっちを向く", level: 3, apply: func() block("Camera").rotation = {x: 20, y: 60, z: 0} end,
   revert: func() block("Camera").rotation = {x: 0, y: 0, z: 0} end},
  {name: "床の線が1本多い", level: 3, apply: func()
      add_anom_block({name: "Extra Stripe", position: {x: 0, y: 0.01, z: 1}, size: {x: 7.6, y: 0.02, z: 0.3}, color: "#9CA3AF", solid: false})
    end, revert: func() clear_anom_blocks() end}
]

-- この周回に出せる異変（最近出たものは避ける）
func anomaly_pool()
  let max_level = 2
  if hard or count >= 5 then max_level = 3 end
  let pool = filter(ANOMALIES, func(a) return a.level <= max_level and not contains(recent, a.name) end)
  if len(pool) == 0 then pool = ANOMALIES end
  return pool
end
