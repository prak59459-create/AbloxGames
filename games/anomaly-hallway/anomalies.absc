-- anomalies.absc — 32の異変
-- level 1: 目立つ / 2: よく見るとわかる / 3: 小さい（裏モードと後半だけ）
-- danger: せまってくる異変。引き返すのがおそいと失敗

let anom_blocks = []       -- 異変で作ったブロック（もとにもどすとき消す）
let flicker_timer = nil
let wave = nil             -- {block, t0, secs}

func tint(name, color)
  let b = block(name)
  if b != nil then b.color = color end
end

func show_block(name, shown)
  let b = block(name)
  if b != nil then b.visible = shown end
end

func add_anom_block(spec)
  let b = create_block(spec)
  append(anom_blocks, b)
  return b
end

func clear_anom_blocks()
  for b in anom_blocks do gone(b) end
  anom_blocks = []
end

func lamps(color)
  for i in 1 to 6 do tint("Ceiling Lamp " + i, color) end
end

func start_wave()
  let b = add_anom_block({name: "Red Wave", position: {x: 0, y: 1.8, z: 31}, size: {x: 7.6, y: 3.6, z: 1}, color: "#B91C1C",
                          material: "neon", solid: false, opacity: 0.75})
  b.move_to({x: 0, y: 1.8, z: -31}, 16)
  wave = {t0: time(), secs: 16}
end

-- 波がいまどこにいるか（動いているあいだ、ブロックの位置は行き先になっているので計算で）
func wave_z()
  if wave == nil then return 99 end
  let t = min(1, (time() - wave.t0) / wave.secs)
  return 31 - 62 * t
end

let ANOMALIES = [
  -- 目立つ異変
  {name: "赤いドア", level: 1, apply: func() tint("Door A", "#DC2626") end, revert: func() tint("Door A", "#60A5FA") end},
  {name: "ポスターがない", level: 1, apply: func() show_block("Poster 1", false) end, revert: func() show_block("Poster 1", true) end},
  {name: "大きなベンチ", level: 1, apply: func() block("Bench").size = {x: 1.2, y: 1.6, z: 5} end,
   revert: func() block("Bench").size = {x: 1.2, y: 0.7, z: 3} end},
  {name: "黒い人が立っている", level: 1, apply: func()
      let n = create_npc({name: "…", position: block("Anomaly Spot").position, color: "#0A0A0A", head_color: "#0A0A0A",
                          leg_color: "#0A0A0A", health: 999999, speed: 0})
      n.frozen = true
      append(anom_blocks, n)
    end, revert: func() clear_anom_blocks() end},
  {name: "暗い廊下", level: 1, apply: func() world.light = 0.15 end, revert: func() world.light = 0.6 end},
  {name: "天井が低い", level: 1, apply: func() block("Hall Ceiling").y = 3.35 end, revert: func() block("Hall Ceiling").y = 4.15 end},
  {name: "床の赤いボール", level: 1, apply: func()
      add_anom_block({name: "Red Ball", shape: "sphere", position: {x: random(-2, 2), y: 0.4, z: random(-12, 18)}, size: 0.8,
                      color: "#991B1B"})
    end, revert: func() clear_anom_blocks() end},
  {name: "天井の明かりが赤い", level: 1, apply: func() lamps("#EF4444") end, revert: func() lamps("#F8FAFC") end},
  {name: "自販機がない", level: 1, apply: func()
      show_block("Vending Machine", false)
      show_block("Vending Light", false)
    end, revert: func()
      show_block("Vending Machine", true)
      show_block("Vending Light", true)
