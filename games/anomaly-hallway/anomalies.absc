      show_block("Ceiling Lamp 2", true)
    end},
  {name: "ドアがもう1つ", level: 2, apply: func()
      add_anom_block({name: "Door C", position: {x: -3.8, y: 1.3, z: 14}, size: {x: 0.2, y: 2.6, z: 1.6}, color: "#60A5FA", solid: false})
    end, revert: func() clear_anom_blocks() end},
  {name: "壁の手形", level: 2, apply: func()
      for k in 1 to 3 do
        add_anom_block({name: "Hand", position: {x: -3.78, y: 1.2 + k * 0.4, z: -6 + k * 1.1}, size: {x: 0.05, y: 0.3, z: 0.25},
                        color: "#7F1D1D", solid: false})
