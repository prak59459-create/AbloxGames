    end, revert: func() clear_anom_blocks() end},

  -- 小さな異変
  {name: "ポスターの色が少しちがう", level: 3, apply: func() tint("Poster 2", "#818CF8") end, revert: func() tint("Poster 2", "#38BDF8") end},
  {name: "自販機の明かりが消えている", level: 3, apply: func() tint("Vending Light", "#44403C") end,
   revert: func() tint("Vending Light", "#FEF9C3") end},
  {name: "ドアノブがない", level: 3, apply: func() show_block("Door A Knob", false) end, revert: func() show_block("Door A Knob", true) end},
  {name: "壁がほんのりピンク", level: 3, apply: func() tint("Hall Wall L", "#F9D7DE") end, revert: func() tint("Hall Wall L", "#E5E7EB") end},
