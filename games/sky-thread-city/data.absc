-- data.absc — スカイスレッド・シティの 数字と リスト
--
-- 糸のヒーロー「スレッドランナー」になって 大都会を 動きまわる。
-- 🕸 スイング: 前の上のほうの ビルに 糸をつけて ふりこのように ゆれる（もう一度おすと 手をはなす）
-- 🧗 かべのぼり: ビルに向かって 歩きつづけると のぼる。後ろを向くと はなれる
-- ⚡ ジップ: 前のビルへ 一気に とんでいく

let ROPE_MIN = 9
let ROPE_MAX = 40          -- 強化で のびる
let SWING_G = 17           -- ふりこの はやさ（大きいほど 速くゆれる）
let SWING_PUMP = 22        -- 前へ こぐ力（度/秒²）
let SWING_TIME = 3.4       -- 1回のスイングの 長さの上限
let RELEASE_ANGLE = 62     -- ここまで ふれたら 自動で 手をはなす
let RELEASE_BOOST = 1.12
let CLIMB_SPEED = 6.5
let CLIMB_WAIT = 0.3       -- かべの前に これだけいると のぼりはじめる
let ZIP_SPEED = 36
let ZIP_COOLDOWN = 2.5

let ROBBER_MAX = 5
let ROBBER_EVERY = 25
