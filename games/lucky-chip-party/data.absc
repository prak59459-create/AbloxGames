-- data.absc — ルール・イベント・BOT の性格
--
-- ラッキーチップ・パーティー: 4人でテーブルをかこむ、運と読みあいのゲームショー。
-- チップは このゲームの中だけのもので、ほかのゲームのコインとも 本物のお金とも 関係ありません。

let START_CHIPS = 100     -- 1回のショーで はじめに持つチップ
let MIN_BET = 5           -- いちばん少ない かけ金
let SEATS = 4             -- テーブルの席（人がたりない席には BOT がすわる）
let ROUNDS = 8            -- 1回のショーのラウンド数
let LOBBY_WAIT = 15       -- ショーが始まるまで
let INTRO_TIME = 4        -- ラウンドの説明
let BET_TIME = 16         -- かけ金とえらぶ時間
let STEP_TIME = 8         -- つづける／やめる、コール／おりる を決める時間
let RESULT_TIME = 6       -- 結果を見る時間
let FINAL_TIME = 14       -- 優勝のあと、次のショーまで
let FINAL_BONUS = 1.5     -- 最後のラウンドは 配当がこの倍

let SEAT_COLORS = ["#EF4444", "#3B82F6", "#22C55E", "#F59E0B"]
let SEAT_NAMES = ["レッド", "ブルー", "グリーン", "イエロー"]

-- どのイベントも同じ形: id・絵文字・名前・ルール（1行）
let EVENTS = [
  {id: "dice", emoji: "🎲", name: "サイコロ ハイ＆ロー",
   rule: "2つのサイコロの合計は？ 8以上・6以下は ×2.3、ぴったり7・ゾロ目は ×5.5"},
  {id: "card", emoji: "🃏", name: "つぎのカード",
   rule: "つぎのカード（1〜13）は 今のより 上？ 下？ 同じ？ 当たりにくいほど 倍率が高い"},
  {id: "wheel", emoji: "🎡", name: "ラッキールーレット",
   rule: "光が止まる色をあてろ。赤・青は ×2.3、めったに来ない 金・虹は ×11"},
  {id: "race", emoji: "🐢", name: "どうぶつレース",
   rule: "1着をあてろ。人気のない子ほど 倍率が高い"},
  {id: "coin", emoji: "🪙", name: "コイン ダブルアップ",
   rule: "表か裏か。あたれば倍！ つづけるか やめるか（4回まで）。はずれたら 0"},
  {id: "bluff", emoji: "🤫", name: "ブラフ・カード",
   rule: "自分だけに見えるカード（1〜10）。レイズで おどかすか、おりるか。いちばん大きい人が ポットを取る"},
  {id: "box", emoji: "🎁", name: "ミステリーボックス",
   rule: "3つの箱の中身は ×0〜×3。だれかが ひみつのヒントを もらっているかも"},
  {id: "bomb", emoji: "💣", name: "ばくだんカード",
   rule: "1まい出るごとに 倍率アップ。💣が出たら かけたチップは なくなる。どこでやめる？"},
  {id: "share", emoji: "🤝", name: "わける？ ひとりじめ？",
   rule: "2人1組で ボーナス30。2人とも「わける」なら 15ずつ。かたほうだけ「ひとりじめ」なら その人が30"},
  {id: "cups", emoji: "🥤", name: "カップ シャッフル",
   rule: "ボールの入ったカップを 目で おいかけろ。まぜたあと 何ばんにある？ あたれば ×2.7"},
  {id: "keys", emoji: "🗝", name: "たからばこの カギ",
   rule: "5本のカギのうち ほんものは 1本だけ。えらんだカギで 宝箱が あけば ×4.6"},
  {id: "weather", emoji: "🌦", name: "あしたの 天気よほう",
   rule: "よほうの％を見て あしたの天気を あてろ。めずらしい天気ほど 倍率が高い"},
  {id: "balloon", emoji: "🎈", name: "ふうせん ふくらまし",
   rule: "ひと押しごとに 倍率アップ。われる前に「やめる」で もらえる。われたら 0"},
  {id: "amida", emoji: "🪜", name: "あみだくじ",
   rule: "4本の線の下に ×0・×0.5・×1.5・×2。線をたどって ついたところが 倍率"},
  {id: "reels", emoji: "🍒", name: "フルーツ リール",
   rule: "3つのリールが止まると？ ぜんぶちがう・2つそろう は ×1.9、3つそろう は ×12"},
  {id: "meter", emoji: "🎯", name: "ストップ・メーター",
   rule: "行ったり来たりする 🔴 を まん中の ⭐ で 🛑 ストップ！ 近いほど 倍率アップ（×3まで）"},
  {id: "watch", emoji: "⏱", name: "ぴったり 5びょう",
   rule: "時計は 2びょうで 見えなくなる。心の中で数えて ぴったり 5.00びょうで 🛑！"},
  {id: "fish", emoji: "🎣", name: "つり大会",
   rule: "あさい池は 小さな魚が よくつれる。ふかい海は 長ぐつか 大物か！ つれた魚で 倍率が決まる"},
  {id: "duck", emoji: "🦆", name: "アヒル ながし（びりは だれ？）",
   rule: "4わの アヒルが 川をくだる。いちばん おそい「びり」を あてれば ×3.7"},
  {id: "vote", emoji: "🗳", name: "みんなで 多数決",
   rule: "2つのうち みんなが 多くえらぶほうを えらべ。多いほうは +15、同じ数なら みんな +5"},
  {id: "minority", emoji: "🦄", name: "すくないほうが 勝ち",
   rule: "3つから 1つ。えらんだ人が いちばん すくないものが 勝ち！ ボーナス40を 山分け"},
  {id: "rps", emoji: "✊", name: "じゃんけん バトル",
   rule: "ほかの みんなと 1回ずつ じゃんけん。勝つたびに +50%、負けるたびに −50%"},
  {id: "auction", emoji: "💰", name: "ひみつの 入札",
   rule: "なぞの おたから（🪙 30〜90）。いちばん高く 入札した人が はらって もらえる。同じ金額なら だれも もらえない"},
  {id: "number", emoji: "🔢", name: "ひみつの数 1〜100",
   rule: "ひみつの数は？ 50以下・51以上 は ×1.8、ゾロ目（11・22…）・1けた は ×10"},
  {id: "bag", emoji: "👜", name: "ふくろの ボールびき",
   rule: "ふくろの中の ボールの数は 毎回ちがう。引く1この色を あてろ。少ない色ほど 倍率が高い"}
]

