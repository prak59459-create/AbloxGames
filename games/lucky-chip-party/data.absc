-- data.absc — ルール・イベント・BOT の性格
--
-- ラッキーチップ・パーティー: 4人でテーブルをかこむ、運と読みあいのゲームショー。
-- チップは このゲームの中だけのもので、ほかのゲームのコインとも 本物のお金とも 関係ありません。

let START_CHIPS = 100     -- 1回のショーで はじめに持つチップ
let MIN_BET = 5           -- いちばん少ない かけ金
let SEATS = 4             -- テーブルの席（人がたりない席には BOT がすわる）
let ROUNDS = 8            -- 1回のショーのラウンド数
let LOBBY_WAIT = 15       -- ショーが始まるまで
let INTRO_TIME = 4        -- ラウンドの説明
let BET_TIME = 16         -- かけ金とえらぶ時間
let STEP_TIME = 8         -- つづける／やめる、コール／おりる を決める時間
let RESULT_TIME = 6       -- 結果を見る時間
let FINAL_TIME = 14       -- 優勝のあと、次のショーまで
let FINAL_BONUS = 1.5     -- 最後のラウンドは 配当がこの倍

let SEAT_COLORS = ["#EF4444", "#3B82F6", "#22C55E", "#F59E0B"]
let SEAT_NAMES = ["レッド", "ブルー", "グリーン", "イエロー"]

-- どのイベントも同じ形: id・絵文字・名前・ルール（1行）
let EVENTS = [
  {id: "dice", emoji: "🎲", name: "サイコロ ハイ＆ロー",
   rule: "2つのサイコロの合計は？ 8以上・6以下は ×2.3、ぴったり7・ゾロ目は ×5.5"},
  {id: "card", emoji: "🃏", name: "つぎのカード",
   rule: "つぎのカード（1〜13）は 今のより 上？ 下？ 同じ？ 当たりにくいほど 倍率が高い"},
  {id: "wheel", emoji: "🎡", name: "ラッキールーレット",
   rule: "光が止まる色をあてろ。赤・青は ×2.3、めったに来ない 金・虹は ×11"},
  {id: "race", emoji: "🐢", name: "どうぶつレース",
   rule: "1着をあてろ。人気のない子ほど 倍率が高い"},
  {id: "coin", emoji: "🪙", name: "コイン ダブルアップ",
   rule: "表か裏か。あたれば倍！ つづけるか やめるか（4回まで）。はずれたら 0"},
  {id: "bluff", emoji: "🤫", name: "ブラフ・カード",
   rule: "自分だけに見えるカード（1〜10）。レイズで おどかすか、おりるか。いちばん大きい人が ポットを取る"},
  {id: "box", emoji: "🎁", name: "ミステリーボックス",
   rule: "3つの箱の中身は ×0〜×3。だれかが ひみつのヒントを もらっているかも"},
  {id: "bomb", emoji: "💣", name: "ばくだんカード",
   rule: "1まい出るごとに 倍率アップ。💣が出たら かけたチップは なくなる。どこでやめる？"},
  {id: "share", emoji: "🤝", name: "わける？ ひとりじめ？",
   rule: "2人1組で ボーナス30。2人とも「わける」なら 15ずつ。かたほうだけ「ひとりじめ」なら その人が30"}
]

-- サイコロの目
let DIE_FACES = ["⚀", "⚁", "⚂", "⚃", "⚄", "⚅"]

-- ルーレットのマス（12こ）: 赤5・青5・金1・虹1
let WHEEL = ["red", "blue", "red", "blue", "red", "blue", "red", "blue", "red", "blue", "gold", "rainbow"]
let WHEEL_COLORS = {red: "#DC2626", blue: "#2563EB", gold: "#FACC15", rainbow: "#E879F9"}
let WHEEL_NAMES = {red: "🔴 赤", blue: "🔵 青", gold: "🟡 金", rainbow: "🌈 虹"}

-- レースに出る4ひき。強さ（勝ちやすさ）はラウンドごとに入れかわる
let RACERS = [
  {name: "カメ", emoji: "🐢", color: "#16A34A"},
  {name: "ウサギ", emoji: "🐰", color: "#F9A8D4"},
  {name: "カタツムリ", emoji: "🐌", color: "#A16207"},
  {name: "ロボ", emoji: "🤖", color: "#94A3B8"}
]
let RACE_WEIGHTS = [40, 28, 20, 12]
let RACE_LENGTH = 22

-- ミステリーボックスの中身（どの組も 平均すると ×1）
let BOX_SETS = [[0, 1, 2], [0, 0.5, 2.5], [0, 1.5, 1.5], [0.5, 0.5, 2], [0, 0, 3]]

-- ばくだんカード: 10まいのうち 💣 が2まい。安全なカードが出るたびに倍率がこう上がる
let BOMB_DECK = 10
let BOMB_COUNT = 2
let BOMB_STEPS = [1.3, 1.7, 2.2, 3, 4, 5.5]

-- わける？ひとりじめ？
let SHARE_POT = 30
let SHARE_BOTH_STEAL = 5   -- 2人ともひとりじめなら、2人ともこれだけへる

-- BOT の性格。risk: 1回にかける わりあい / bluff: 弱いカードでレイズする確率 / brave: つづける気持ち
let BOT_TYPES = [
  {tag: "しんちょう", risk: 0.12, bluff: 0.05, brave: 0.25, greed: 0.2},
  {tag: "ふつう", risk: 0.25, bluff: 0.15, brave: 0.45, greed: 0.4},
  {tag: "だいたん", risk: 0.45, bluff: 0.3, brave: 0.7, greed: 0.6},
  {tag: "ブラフ名人", risk: 0.3, bluff: 0.6, brave: 0.5, greed: 0.5}
]
let BOT_NAMES = ["ラッキー", "ダイス", "ジョーカー", "スペード", "ハート", "クラブ", "ダイヤ", "エース"]

let BOT_LINES = {
  hello: ["よろしく！", "今日はツイてる気がする", "まけないよ〜", "チップを ふやすぞ！"],
  allin: ["オールイン！", "ぜんぶ いっちゃう！", "勝負だ！"],
  raise: ["レイズ！", "ふふ…いいカードだ", "おりるなら 今のうちだよ？", "どうかな〜？"],
  fold: ["おりる…", "今回は パス", "あぶないあぶない"],
  win: ["やった！", "ツイてる〜！", "見たか！", "ラッキー！"],
  lose: ["うそ〜", "つぎは勝つ…", "あちゃー", "くやしい！"],
  share: ["なかよく わけよう！", "しんじてるよ？", "わけようね！"],
