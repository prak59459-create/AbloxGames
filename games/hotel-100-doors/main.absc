-- Hotel 100 Doors — 100の部屋を進むホラー
-- 出てくるもの8種（ダッシャー・リバウンダー・ギョロメ・シャウト・フィギュア・追跡者・ニセドア・ジャック）・
-- カギとピッキング・図書館の暗号・引き出し・道具6種・受付のお店・図鑑。
--
-- ファイル:
--   data.absc      表（道具・引き出しの中身・出てくるもの）
--   common.absc    部屋の番号・かくれる・やられる
--   doors.absc     ドア・カギ・引き出し・暗号・ニセドア・出口
--   entities.absc  出てくるもの
--   items.absc     道具・お店・図鑑
--   main.absc      このファイル

kit_setup("Hotel 100 Doors", "明かりがチカチカしたら、クローゼットへ", [
  "🚪 ドアをタップすると開く（5の倍数の部屋はカギ。ピッキングでも開く）",
  "🗄 引き出しにさわると ノブ（お金）や道具が見つかる",
  "💡 明かりがチカチカ → 何かが来る！クローゼット（黒い箱）にかくれて",
  "👁 紫の目を見つめるとダメージ。🗣 暗い部屋で「シッ」→ そっちを向け",
  "📕 50番は図書館。4冊の本で暗号を集めて 📝 で入力",
  "🌫 かべに目が出たら追跡者が来る。前へ全力で走れ",
  "🏁 100番のドアの先の出口にたどりつけば勝ち！"
])
kit_currency = "ノブ"

kit_quest("doors", "ドアを20まい開ける", 20, 30)
kit_quest("search", "引き出しを10こ調べる", 10, 20)
kit_quest("key", "カギを見つける", 1, 15)
kit_quest("book", "図書館の本を読む", 4, 30)
kit_quest("code", "図書館の暗号を解く", 1, 80)
kit_quest("shout", "シャウトを見つける", 1, 30)
kit_quest("chase", "追跡者からにげきる", 1, 80)
kit_quest("meet", "図鑑を5つうめる", 5, 60)
kit_quest("escape", "ホテルから脱出", 1, 200)

on start()
  game.respawn_time = 5
  for p in players() do
    p.escaped = false
    p.items = []
    p.clues = {}
    p.shout_at = nil
    item_buttons(p)
  end
end

on join(p)
  p.items = []
  p.met = []
  p.escaped = false
  kit_welcome(p)
  kit_show_money(p)
  p.ui_button("open_book", "📖 図鑑", {at: "right", dy: -60, w: 150, h: 50, size: 16, bg: "#44403C"})
  kit_quest_button(p)
  kit_camera_button(p)
  item_buttons(p)
end
