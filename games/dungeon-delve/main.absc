-- Dungeon Delve — 4つの職業で挑む協力ハクスラ。部屋をこえて、ボスをたおして、もっと深い階へ。
--
-- ファイル:
--   data.absc     職業・武器・レア度・特性・敵・ボス・テーマ・遺物・お店・部屋の種類
--   common.absc   みんなで使う状態・強さの計算・画面
--   boss.absc     ボスの技・赤い円の予告・溶岩だまり・HPバー
--   camp.absc     鍛冶屋・お店・記録の板・かかし
--   classes.absc  職業えらび・スキル・ポーションと爆弾
--   combat.absc   当たったときのダメージ（クリティカル・特性・遺物）
--   dungeon.absc  冒険の流れと8つの部屋
--   enemies.absc  敵の動き（8種類）とごほうび
--   loot.absc     武器・装備・バッグ
--   main.absc     このファイル

kit_setup("Dungeon Delve", "部屋をこえて、もっと深く", [
  "🏕 キャンプの祭壇で職業をえらぶ（⚔️戦士・🏹狩人・🔮魔法使い・✨僧侶）",
  "🟣 紫のゲートにのると、キャンプのみんなでダンジョンへ",
  "🚪 部屋は8つ。戦い・⭐強敵・💰宝物庫・✨祭壇（遺物）・⚠️ワナ・🔥休けい所、最後は👑ボス",
  "🔴 赤い円はボスの技の予告。すぐにげよう！",
  "⚔️ 敵や宝箱から武器。🎒バッグで装備と売るのができる",
  "⚒ 鍛冶屋で武器を+10まで強化、よろいもレベルアップ",
  "🧪 ポーション・💣 爆弾・🪽 復活の羽はお店で",
  "🎯 かかしをたたくとダメージが見える"
])
kit_currency = "ゴールド"

kit_quest("clear", "ダンジョンを1回クリア", 1, 300)
kit_quest("deep", "ボスを4回たおす", 4, 1500)
kit_quest("kill", "敵を100体たおす", 100, 400)
kit_quest("elite", "強敵を5体たおす", 5, 300)
kit_quest("legend", "伝説以上の武器を手に入れる", 1, 400)
kit_quest("chest", "宝箱を10こあける", 10, 250)
kit_quest("relic", "遺物を5つ選ぶ", 5, 250)
kit_quest("heal", "仲間を20回回復する（僧侶）", 20, 250)
kit_quest("upgrade", "武器を5回強化する", 5, 300)

kit_on_level = func(p)
  apply_stats(p)
  p.heal(p.max_health)
  hud(p)
end

on start()
  game.respawn_time = 6
  every(10, func() kit_leaderboard("⚔️") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.level = 1
  p.xp = 0
  kit_show_level(p)
  p.armor_lv = 0
  p.bag = []
  p.relics = []
  p.potions = 2
  p.bombs = 1
  p.revives = 0
  p.slain = 0
  p.found = 0
  p.floors = 0
  p.best_floor = 0
  p.in_run = false
  kit_give(p, 50)
  choose_class(p, "warrior")
  action_buttons(p)
  hud(p)
  p.message("🏕 左の祭壇で職業をえらんで、紫のゲートへ！", 3)
  if run_active then p.message("⚔️ いま冒険中。紫のゲートにのると仲間のところへ行ける", 3) end
end
