-- Night Lockdown — 昼は町で集め、夜は家に立てこもる。5日間、家族を守れ。
--
-- ファイル:
--   data.absc    日ごとの設定・お店と物資・開口部・侵入者・家族・工作・通販
--   common.absc  町と家の状態・持ち物・画面
--   day.absc     昼: 物資の箱・家にしまう・通販・サイレン
--   house.absc   板と鉄板・わな・作業場・発電機と明かり・電気・家族
--   night.absc   夜: 侵入者・夜の影・夜明け・救助ヘリ
--   main.absc    このファイル

kit_setup("Night Lockdown", "昼は集めて、夜は立てこもる。5日間、家族を守れ", [
  "☀️ 昼: 町のお店（材木置き場・スーパー・ホームセンター・薬局・ガソリンスタンド・空き家）で箱をあけて物資を集める",
  "📦 家の物資箱か作業場にさわると、持ち物が家にしまわれる（みんなのもの）",
  "🪵 窓とドアの内側の茶色いパッドで板を打つ（鉄板と釘があれば鉄板）。🪤 わなは作業場で作って窓の外へ",
  "🌙 夜: 侵入者が板をはがしにくる。バットで追い払え！ 👧 妹が来た方角を教えてくれる",
  "🍞 夜のはじめにみんなでごはん。⛽ 発電機の燃料があると明かりがつき、侵入者の手がおそくなる",
  "🚁 5日目の夜が明けたら救助ヘリ！ 家族を連れて公園のヘリポートへ"
])

kit_melee("バット", 30, 1.6, 5)
kit_melee("くぎバット", 45, 1.6, 5)
kit_melee("金属バット", 55, 1.5, 5.5)
weapon("くぎ打ち機", {model: "pistol", damage: 24, rate: 3, range: 40, ammo: 12, reload: 2, spread: 2})

kit_currency = "円"
kit_shop_title = "服屋"
kit_shop_add("cap", "🧢 キャップ", 40, func(p) p.hat = "cap" end)
kit_shop_add("hero", "🦸 ヒーローの服", 120, func(p)
  p.color = "#1D4ED8"
  p.leg_color = "#DC2626"
end)
kit_shop_add("crown", "👑 家の王さま", 400, func(p) p.hat = "crown" end)

kit_quest("loot", "物資の箱を20こあける", 20, 120)
kit_quest("deposit", "物資を30こ家にしまう", 30, 150)
kit_quest("board", "板を20枚打つ", 20, 150)
kit_quest("trap", "わなを3つしかける", 3, 100)
kit_quest("craft", "作業場で3回作る", 3, 100)
kit_quest("defend", "侵入者を10人たおす", 10, 200)
kit_quest("power", "停電を直す", 1, 60)
kit_quest("care", "救急箱で家族を手当てする", 1, 80)
kit_quest("order", "通販で買いものをする", 1, 40)
kit_quest("nights", "夜を5回のりこえる", 5, 400)
kit_quest("rescue", "救助ヘリに乗る", 1, 300)

on start()
  game.respawn_time = 8
  for o in OPENINGS do layers[o.id] = [] end
  spawn_family()
  start_day()
  every(10, func() kit_leaderboard("🏠") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 30)
  p.pack = []
  p.medkits = 1
  p.traps_held = 0
  p.beartraps = 0
  p.orders = {}
  p.nailbat = false
  p.using_gun = false
  p.outside_since = 0
  p.hunted = false
  p.boarded = false
  p.healed_by_grandma = false
  equip_bat(p)
  hud(p)
  house_hud()
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Spawn " + random(1, 6)).position + {x: 0, y: 1, z: 0})
  if p.using_gun then p.give("くぎ打ち機") else p.give(p.bat) end
  p.hunted = false
  p.outside_since = 0
  hud(p)
end
