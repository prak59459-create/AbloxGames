-- Rhythm Battle — 落ちてくるノーツに合わせて押すリズムゲーム。ステージで対戦、ブースで練習
--
-- ファイル:
--   data.absc   曲8つ・難易度・レーン・判定
--   play.absc   譜面・ノーツ・判定・コンボ・フィーバー・おじゃま攻撃・結果
--   stage.absc  曲えらび・対戦エントリー・練習ブース・照明とダンサー
--   main.absc   このファイル

kit_setup("Rhythm Battle", "リズムに乗って、相手に勝て！", [
  "🎤 ステージのパッドで対戦（12秒相手が来なければCPUと）。🎧 まわりの練習ブースでひとりで",
  "⬇️ ノーツが白い線に来たら、同じ色のボタンを押す！",
  "PERFECT / GREAT / GOOD / MISS。コンボがつづくほど高得点",
  "🔥 30コンボでフィーバー（点数2倍）",
  "💥 対戦中は25コンボごとに相手へおじゃま攻撃（スピードアップ・かくれノーツ）",
  "⭐ ファンがふえると新しい曲が解放。全部でSランクをめざそう"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["fans", "best"])


kit_quest("perfect", "PERFECTを50回", 50, 200)
kit_quest("combo", "50コンボ", 1, 300)
kit_quest("songs", "10曲あそぶ", 10, 300)
kit_quest("practice", "練習ブースで3曲", 3, 150)
kit_quest("win", "対戦で3回勝つ", 3, 500)
kit_quest("rank_s", "Sランクをとる", 1, 800)

kit_shop_title = "ステージ衣装"
kit_shop_add("antenna", "📡 アンテナ", 150, func(p) p.hat = "antenna" end)
kit_shop_add("crown", "👑 スターの冠", 2000, func(p) p.hat = "crown" end)
kit_shop_add("neon", "💜 ネオンの服", 300, func(p)
  p.color = "#A855F7"
  p.leg_color = "#22D3EE"
end)
kit_shop_add("gold", "✨ ゴールドの服", 1000, func(p)
  p.color = "#FACC15"
  p.leg_color = "#111827"
end)

on start()
  every(10, func() kit_leaderboard("⭐ ファン") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.fans = 0
  p.best = {}
  p.sess = nil
  kit_give(p, 20)
end
