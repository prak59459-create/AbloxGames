-- Sand Treasure Hunt — 砂の宝さがし
-- ⛏ をタップすると 目の前の砂をほる（3回ぶんで底）。砂はリュックへ → 黄色いパッドで売る。
-- 🔎 たんちきが ピピピ と鳴る所の下に 宝がうまっている。底までほると宝箱！ ジャングル・さばくは もっとお宝。
--
-- ファイル:
--   ../../lib/kit_sim.absc  ほる・リュック・ショップ・たまご・ペット・生まれかわり・ゲート
--   data.absc   スコップ・リュック・たまご・場所・宝箱・たんちき
--   dig.absc    ほる・宝箱・たんちき・穴がうまる
--   main.absc   このファイル

kit_setup("Sand Treasure Hunt", "ほって、さがして、伝説の宝箱を！", [
  "⛏ 砂の上で ⛏ ほる をタップ（向いている方の砂をほる）",
  "🔎 上の ピピピ が速いほど 宝が近い。「この下だ！」の所を 底までほる",
  "🧰 出てきた宝箱に さわると お金（💎レア・👑伝説も）",
  "🎒 砂がいっぱいになったら 黄色いパッドで売る",
  "🌴 ジャングル（×4）・🏜 さばく（×15）は 売った砂の合計で行ける",
  "🛒 スコップ・リュック、🔎 たんちき を強くしよう"
])
kit_keep(["detector", "detectors", "chests_found"])

kit_quest("dig", "砂を20回 ほる", 20, 80)
kit_quest("chest", "宝箱を3こ あける", 3, 200)
kit_quest("sim_tool", "スコップを買う", 1, 60)
kit_quest("sim_hatch", "たまごをかえす", 1, 100)

on join(p)
  kit_welcome(p)
  kit_show_money(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.camera_distance = 8
  p.detector = "d0"
  p.detectors = ["d0"]
  p.hat = "pirate"
  p.ui_button("detectors", "🔎 たんちき", {at: "right", dy: 90, w: 150, h: 44, size: 15, bg: "#0369A1"})
end

on start()
  world.music = "adventure"
  every(12, func() kit_leaderboard("⏳ 売った砂") end)
end
