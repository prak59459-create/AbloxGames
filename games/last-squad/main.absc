-- Last Squad vs Horde — 人間 vs ゾンビ。やられた人間はゾンビになる
-- 15びょうの準備（クラスと補給）→ ゾンビのウェーブ → のこり30びょうでヘリ。ヘリポートで脱出。
--
-- ファイル:
--   data.absc     表（クラス4・補給・ゾンビ4＋ボス）
--   common.absc   武器・小さな道具・画面
--   classes.absc  クラスとスキル・プレイヤーのゾンビ
--   horde.absc    ゾンビのウェーブとAI・バリケード
--   supply.absc   補給・手りゅう弾・補給箱
--   round.absc    準備・生きのこり・脱出・勝ち負け
--   main.absc     このファイル

kit_setup("Last Squad vs Horde", "3分生きのびて、ヘリで脱出せよ", [
  "🛠 最初の15びょうでクラス（ライフル・ヘビー・メディック・エンジニア）をえらぶ",
  "📦 緑のパッドで補給。ゾンビをたおすと 💰 スクラップ",
  "🧟 ランナー・タンク・スピッター… 5ウェーブ目に巨大ゾンビ",
  "✨ クラスごとのスキル。💣 手りゅう弾でまとめて",
  "🪂 ときどき空から補給箱。強い武器が入っている",
  "🧟 やられたらゾンビに！ とびかかる・さけぶで人間をつかまえよう",
  "🚁 のこり30びょうでヘリ。ヘリポート（黄色）に立っていれば脱出"
])

kit_quest("survive", "脱出に成功する", 1, 300)
kit_quest("zkill", "ゾンビを25体たおす", 25, 150)
kit_quest("boss", "巨大ゾンビをたおす", 1, 300)
kit_quest("infect", "ゾンビとして3人つかまえる", 3, 150)
kit_quest("zwin", "最初のゾンビとして勝つ", 1, 200)
kit_quest("heal", "メディックで仲間を10回回復", 10, 100)
kit_quest("build", "バリケードを5つ作る", 5, 80)
kit_quest("buy", "補給で3回買う", 3, 60)
kit_quest("airdrop", "補給箱を開ける", 1, 100)

on start()
  game.respawn_time = 4
  clear_horde()
  heli = false
  phase = "prep"
  ends_at = time() + ROUND_SECS
  drop = nil
  announce("🛠 " + PREP_SECS + "びょうで準備！ クラスをえらんで補給へ", 4)
  for p in players() do
    if ready(p) then
      p.class_locked = false
      p.was_zombie_start = false
      p.round_kills = 0
      p.infects = 0
      p.grenades = 0
      p.armor_until = 0
      make_human(p)
      grenade_button(p)
    end
  end
  every(10, func() kit_leaderboard("🧟") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.class = "rifle"
  p.scrap = 20
  p.own_color = p.color
  p.own_head = p.head_color
  p.ui_button("classes", "🧑 クラス", {at: "right", dy: -60, w: 130, h: 46, size: 15, bg: "#1E3A8A"})
  p.ui_button("supplies", "📦 補給", {at: "right", dy: 0, w: 130, h: 46, size: 15, bg: "#166534"})
  if phase == "play" then
    make_zombie(p)
    p.teleport(block("Horde Spawn " + random(1, 8)))
  else
    make_human(p)
    class_menu(p)
  end
end
