-- Reel Legends — つりのアドベンチャー
-- 8つのつり場・54種類の魚（7段階のめずらしさ）・変異・ロッド10本・えさ6種・昼夜と天気・
-- 大物イベント・つり人のたのみごと・宝の地図・カニかご・図鑑。
--
-- ファイル:
--   data.absc     表（つり場・魚・めずらしさ・変異・ロッド・えさ・天気・大物イベント）
--   common.absc   人さがし・画面・魚の値段・レベル
--   fishing.absc  なげる・かかる・リールのミニゲーム
--   bag.absc      バッグ・魚市場・お気に入り・図鑑
--   shops.absc    ロッド屋・えさ屋・バッグ強化・カニかご
--   world.absc    昼と夜・天気・大物イベント・たのみごと・宝の地図
--   main.absc     このファイル

kit_setup("Reel Legends", "うまく巻いて、伝説の魚をつり上げろ", [
  "🎣 桟橋の先の光るパッドに立って「なげる」。「！」でミニゲーム",
  "🐟 「巻く！」で緑のバーを上げ、動く🐟をバーの中に入れておく",
  "📈 黄色のゲージが100%でつり上げ。0%になると逃げられる",
  "💰 魚市場（黄色のパッド）で売る。⭐お気に入りは売らない",
  "🗺 遠くのつり場はつり券が必要（レベルとお金）。レアな魚がいる",
  "🌙 夜だけ・☀️ 昼だけ・🌧 雨だけの魚もいる",
  "🧑‍🌾 オレンジのパッドのつり人のたのみごとで ボーナス",
  "🗺 宝の地図をつったら、光の柱の場所で「ほる」"
])
kit_currency = "コイン"

-- MARK: クエスト

kit_quest("catch", "魚を1匹つる", 1, 30)
kit_quest("catch100", "魚を100匹つる", 100, 3000)
kit_quest("lv10", "つりレベル10", 9, 1500)
kit_quest("lv30", "つりレベル30", 29, 20000)
kit_quest("ticket", "つり券を買う", 1, 200)
kit_quest("epic", "エピック以上をつる", 1, 800)
kit_quest("mythic", "ミシック以上をつる", 1, 10000)
kit_quest("mutant", "変異した魚をつる", 1, 500)
kit_quest("complete", "つり場の図鑑をコンプリート", 1, 3000)
kit_quest("rod", "新しいロッドを買う", 1, 200)
kit_quest("bait", "えさを買う", 1, 50)
kit_quest("sell", "合計10000コイン売る", 10000, 2000)
kit_quest("angler", "たのみごとを3回", 3, 1000)
kit_quest("cage", "カニかごを上げる", 1, 300)
kit_quest("treasure", "宝をほり当てる", 1, 1500)

-- MARK: 入ってきた人

on join(p)
  p.level = 1
  p.xp = 0
  p.bag = []
  p.bag_size = 20
  p.caught = {}
  p.zones_done = []
  p.tickets = ["Pond"]
  p.rods = ["wood"]
  p.rod = "wood"
  p.baits = {worm: 10}
  p.bait = "worm"
  kit_welcome(p)
  kit_give(p, 50)
  p.ui_button("open_bag", "🐟 バッグ", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#0369A1"})
  p.ui_button("open_book", "📖 図鑑", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0F766E"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
  kit_later(p, 5, func() new_angler_quest(p) end)
end
