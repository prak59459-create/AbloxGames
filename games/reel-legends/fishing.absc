-- fishing.absc — つる
-- つり場のパッドに立つ →「なげる」→ しばらく待つと「！」→ リールのミニゲーム。
-- ミニゲーム: 緑のバーを「巻く！」で持ち上げ（はなすと下がる）、動く🐟をバーの中に入れておく。
-- 中にいる間はゲージがたまり、外だと減る。100%でつり上げ、0%で逃げられる。
-- レアな魚ほど🐟の動きが速い。ロッドでバーの大きさ・ゲージの速さ・運が変わる。

let reel_clock = 0
let hunt = nil        -- 大物イベント {zone, boost, until, name}

-- MARK: どの魚がかかるか

func fish_allowed(f)
  if f.when == "any" then return true end
  if f.when == "night" then return is_night end
  if f.when == "day" then return not is_night end
  if f.when == "rain" then return weather_now == "rain" end
  return true
end

func roll_fish(p, zone)
  let rod = current_rod(p)
  let luck = rod.luck
  let bait = current_bait(p)
  if bait != nil then
    luck = luck * bait.luck
    if bait.id == "glowworm" and is_night then luck = luck * 1.4 end
  end
  if weather_now == "fog" then luck = luck * 1.15 end
  let list = []
  for f in fish_of_zone(zone) do
    if fish_allowed(f) then
      let w = RARITY[f.rarity].weight
      if hunt != nil and hunt.zone == zone and hunt.boost == f.rarity then w = w * 8 end
      append(list, {fish: f, weight: w})
    end
  end
  let pick = kit_pick(list, luck).fish
  let kg = pick.kg[1] + random() * (pick.kg[2] - pick.kg[1])
  let mut = kit_pick(MUTATIONS, 1 + (luck - 1) * 0.5).id
  if mut == "giant" then kg = kg * 2 end
  return {name: pick.name, kg: kg, mut: mut, zone: zone}
end

-- MARK: なげる

func can_fish_here(p)
  if p.spot == nil then return false end
  let z = zone_by_id(p.spot)
  if contains(p.tickets, z.id) then return true end
  if p.level < z.level then
    p.message("🔒 " + z.name + " はつりレベル " + z.level + " から", 2)
    return false
  end
  if not kit_pay(p, z.ticket) then
    p.message(z.name + " のつり券が必要（💰" + kit_short(z.ticket) + "）", 2)
    return false
  end
  append(p.tickets, z.id)
  p.message("🎫 " + z.name + " のつり券を買った！ずっと使えます", 2.5)
  kit_quest_progress(p, "ticket", 1)
  return true
end

func cast(p)
  if p.state != nil then return end
  if len(p.bag) >= p.bag_size then
    p.message("🐟 バッグがいっぱい！魚市場（黄色）で売ろう", 2)
    return
  end
  if not can_fish_here(p) then return end
  let rod = current_rod(p)
  let bait = current_bait(p)
  let lure = rod.lure
  if bait != nil then lure = lure * bait.lure end
  if weather_now == "rain" then lure = lure * 1.2 end
  p.state = "waiting"
  p.frozen = true
  set_btn(p, "cast", nil, nil)
  set_btn(p, "cancel", "やめる", {at: "bottom_right", dx: -110, dy: -240, w: 110, h: 44, size: 15, bg: "gray", radius: 14})
  p.message("🎣 ポチャン…（" + zone_by_id(p.spot).name + "）", 1.2)
  let wait = (2 + random() * 5) / lure
  kit_later(p, wait, func()
    if p.state != "waiting" then return end
    bite(p)
  end)
end

func bite(p)
  -- えさを1つ使う
  let bait = current_bait(p)
  let treasure_chance = 0.015
  if bait != nil then
    p.baits[bait.id] = p.baits[bait.id] - 1
    if bait.id == "magnet" then treasure_chance = 0.3 end
  end
  if p.treasure == nil and random() < treasure_chance then
    stop_fishing(p)
    found_map(p)
    return
  end
  let hook = roll_fish(p, p.spot)
  let f = fish_by_name(hook.name)
  let r = RARITY[f.rarity]
  let rod = current_rod(p)
  p.hook = hook
  p.state = "reeling"
  p.progress = 25
  p.bar_w = rod.control
  p.bar_x = 50 - p.bar_w / 2
  p.bar_v = 0
  p.fish_x = random(10, 90)
  p.fish_to = p.fish_x
  p.fish_next = 0
  p.fish_speed = 22 * r.speed
  p.sound("tick")
  p.message("❗ かかった！「巻く！」でバーを🐟に合わせろ", 1.5)
  reel_ui(p)
end

-- MARK: リールのミニゲーム

func reel_ui(p)
  let f = fish_by_name(p.hook.name)
  let r = RARITY[f.rarity]
  p.ui_panel("reel", {at: "bottom", dy: -190, w: 460, h: 110, bg: "#000000B8", radius: 16, layer: 20})
  p.ui_text("reel_t", "？？？（" + r.name + "）", {parent: "reel", y: 0.14, size: 15, bold: true, color: r.color})
  p.ui_panel("reel_track", {parent: "reel", y: 0.45, w: 420, h: 26, bg: "#FFFFFF22", radius: 8})
  p.ui_panel("reel_bar", {parent: "reel", x: bar_center(p), y: 0.45, w: 4.2 * p.bar_w, h: 26, bg: "#22C55E99", radius: 8, layer: 2})
  p.ui_text("reel_fish", "🐟", {parent: "reel", x: fish_center(p), y: 0.45, size: 22, layer: 3})
  p.ui_bar("reel_prog", p.progress, 100, {parent: "reel", y: 0.82, w: 420, h: 10, color: "#FACC15"})
  set_btn(p, "reel_up", "巻く！", {at: "bottom_right", dx: -110, dy: -150, w: 130, h: 80, size: 26, bg: "#EF4444", radius: 20})
end

func bar_center(p) return (20 + 4.2 * (p.bar_x + p.bar_w / 2)) / 460 end
func fish_center(p) return (20 + 4.2 * p.fish_x) / 460 end

func reel_tick(p, dt)
  -- 🐟: ときどき行き先を変えて、そこへ泳ぐ
  if time() >= p.fish_next then
    p.fish_to = random(4, 96)
    p.fish_next = time() + 0.4 + random() * 1.1
  end
  let swim = p.fish_speed * dt
  if abs(p.fish_to - p.fish_x) <= swim then
    p.fish_x = p.fish_to
  elif p.fish_to > p.fish_x then
    p.fish_x = p.fish_x + swim
  else
    p.fish_x = p.fish_x - swim
  end
  -- バー: 重さで下がる
  p.bar_v = p.bar_v - 110 * dt
  p.bar_x = p.bar_x + p.bar_v * dt
  if p.bar_x < 0 then
    p.bar_x = 0
    p.bar_v = 0
  end
  if p.bar_x > 100 - p.bar_w then
    p.bar_x = 100 - p.bar_w
    p.bar_v = 0
  end
  let inside = p.fish_x >= p.bar_x and p.fish_x <= p.bar_x + p.bar_w
  let rod = current_rod(p)
  if inside then
    p.progress = p.progress + dt * 24 * rod.resilience
  else
    p.progress = p.progress - dt * 15
  end
  p.ui_set("reel_bar", {x: bar_center(p)})
  p.ui_set("reel_fish", {x: fish_center(p)})
  p.ui_bar("reel_prog", clamp(p.progress, 0, 100), 100, {parent: "reel", y: 0.82, w: 420, h: 10, color: "#FACC15"})
  if p.progress >= 100 then
    landed(p)
  elif p.progress <= 0 then
    p.message("💨 にげられた…", 1.5)
    p.lost = (p.lost or 0) + 1
    stop_fishing(p)
  end
end

func reel_up(p)
  if p.state != "reeling" then return end
  p.bar_v = min(80, p.bar_v + 48)
end

func stop_fishing(p)
  p.state = nil
  p.hook = nil
  p.frozen = false
  p.ui_remove("reel")
  set_btn(p, "reel_up", nil, nil)
  set_btn(p, "cancel", nil, nil)
  if p.spot != nil then show_cast(p) end
end

func show_cast(p)
  set_btn(p, "cast", "なげる 🎣", {at: "bottom_right", dx: -110, dy: -150, w: 130, h: 70, size: 20, bg: "#0EA5E9", radius: 18})
end

-- MARK: つり上げた！

func landed(p)
  let c = p.hook
  stop_fishing(p)
  add_catch(p, c)
end

on tick(dt)
  for p in players() do
    if p.state == "reeling" and p.hook != nil then reel_tick(p, dt) end
  end
  reel_clock = reel_clock + dt
  if reel_clock < 0.5 then return end
  reel_clock = 0
  -- つり場から離れたら終わり
  for p in players() do
    if p.spot != nil and p.spot_block != nil then
      let b = block(p.spot_block)
      if b != nil and distance(p, b) > 3.5 then
        if p.state != nil then stop_fishing(p) end
        p.spot = nil
        set_btn(p, "cast", nil, nil)
        set_btn(p, "cage", nil, nil)
      end
    end
  end
end

on touch(p, b)
  if p.is_npc then return end
  if contains(b.tags, "spot") and p.state == nil then
    let zone = b.tags[2]
    if p.spot != zone or p.spot_block != b.name then
      p.spot = zone
      p.spot_block = b.name
      let z = zone_by_id(zone)
      let info = z.name + " でつりができます"
      if not contains(p.tickets, z.id) and z.ticket > 0 then info = z.name + "（つり券 💰" + kit_short(z.ticket) + "・Lv." + z.level + "）" end
      p.message(info, 1.8)
      show_cast(p)
      cage_button(p)
    end
  end
end

on button(p, id)
  if id == "cast" then cast(p)
  elif id == "reel_up" then reel_up(p)
  elif id == "cancel" then
    if p.state == "waiting" then stop_fishing(p) end
  end
end
