-- Watch The House — 5日間の留守番。窓に来るもの、玄関の来客、家のしごと。
--
-- ファイル:
--   data.absc       夜ごとの設定・窓・ご近所さん・家のしごと・通販
--   common.absc     夜の状態・画面
--   creatures.absc  窓に来るもの・ライト・ガムテープ
--   house.absc      家のしごと・猫・停電・窓のカメラ・充電・通販
--   nights.absc     夜の流れ・つかまったとき・朝
--   visitors.absc   玄関の来客・ご近所リスト・入れる／ことわる
--   main.absc       このファイル

kit_setup("Watch The House", "近づくものを、見のがすな", [
  "🏠 田中さん一家の留守番。22時から4時まで、5つの夜を守る",
  "🪟 何かが窓に来てひびを入れる。📷 カメラで探して、窓のそばで 🔦 ライトを当てると逃げる。ひびは 🩹 テープで直せる",
  "🔔 玄関に来客。👁 のぞいて 📋 ご近所リストとくらべる。服の色・帽子がちがったら ✋ ことわる！",
  "📝 家のしごと（猫のえさ・かぎ・水やり…）をやるとおこづかいアップ",
  "⚡ 停電したら物置のブレーカー。🐱 タマが窓に鳴いたら何かいる",
  "📱 スマホの通販でテープ・強いライト・ドアカメラ・窓センサーを買える"
])

kit_currency = "おこづかい"
kit_shop_title = "服"
kit_shop_add("pajama", "🛌 パジャマ", 40, func(p)
  p.color = "#93C5FD"
  p.leg_color = "#93C5FD"
end)
kit_shop_add("cap", "🧢 キャップ", 40, func(p) p.hat = "cap" end)

kit_quest("repel", "窓のものを10回追い払う", 10, 150)
kit_quest("fake", "ニセものを3回見やぶる", 3, 150)
kit_quest("neighbor", "本物のご近所さんを入れる", 2, 80)
kit_quest("chores", "家のしごとを9こやる", 9, 150)
kit_quest("tape", "窓をテープで直す", 2, 60)
kit_quest("breaker", "ブレーカーを上げる", 1, 50)
kit_quest("shop", "通販で買う", 1, 40)
kit_quest("nights", "5つの夜を守る", 5, 500)

on start()
  game.respawn_time = 4
  tape_rolls = 2
  after(3, func() start_night(1) end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 20)
  p.battery = 100
  p.cam_i = 0
  p.carrying_trash = false
  p.ui_button("flash", "🔦 ライト", {at: "bottom_right", dx: -120, dy: -160, w: 130, h: 64, size: 18, bg: "#CA8A04", radius: 16})
  p.ui_button("cam", "📷 カメラ", {at: "bottom", dy: -100, w: 150, h: 52, size: 17, bg: "#1D4ED8", radius: 14})
  p.ui_button("list", "📋 リスト", {at: "right", dy: 180, w: 150, h: 44, size: 15, bg: "#B45309"})
  p.ui_button("phone", "📱 スマホ", {at: "right", dy: 232, w: 150, h: 44, size: 15, bg: "#0E7490"})
  decision_buttons(p)
  hud(p)
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Spawn " + random(1, 6)).position + {x: 0, y: 1, z: 0})
end
