-- Warrior Brawl — 10の武器で戦う近接バトル
-- ふつうのこうげき・重い一撃（武器ごとの技）・はじく・回避。スタミナを考えて戦おう。
-- キルでクレジット。武器庫で武器、補給テントで道具（2つまで）。5連続キルには賞金がかかる。
--
-- ファイル:
--   data.absc     表（武器10・道具6・スタミナ）
--   common.absc   武器を作る・スタミナ・画面
--   combat.absc   はじく・回避・重い一撃・キル・賞金・2倍タイム
--   items.absc    道具（包帯・救急箱・爆弾・投げナイフ・けむり玉・トラバサミ）
--   armory.absc   武器庫と補給テント・噴水
--   main.absc     このファイル

kit_setup("Warrior Brawl", "はじいて、かわして、斬りこめ", [
  "⚔ ふつうのこうげき + 💥 重い一撃（武器ごとにちがう技・スタミナを使う）",
  "✨ 「はじく」: 0.4びょうだけ攻撃をはね返し、相手をよろめかせる",
  "💨 「回避」: 横にステップ。どれも黄色いスタミナを使う",
  "🎒 道具は2つまで: 包帯・救急箱・爆弾・投げナイフ・けむり玉・トラバサミ",
  "🔴 武器庫（赤）で武器、🟢 補給テント（緑）で道具。⛲ 噴水で少し回復",
  "🔥 5連続キルで賞金首に。💰 ときどきクレジット2倍タイム"
])
kit_currency = "クレジット"

kit_quest("kill3", "3人たおす", 3, 60)
kit_quest("kill50", "50人たおす", 50, 800)
kit_quest("parry5", "5回はじき成功", 5, 100)
kit_quest("art", "重い一撃を20回", 20, 150)
kit_quest("bomb", "爆弾で2人たおす", 2, 120)
kit_quest("items", "道具を10回使う", 10, 100)
kit_quest("buy", "新しい武器を買う", 1, 50)
kit_quest("streak", "5連続キル", 1, 300)

on start()
  game.respawn_time = 3
  double_next = time() + DOUBLE_EVERY
  every(8, func() kit_leaderboard("⚔️ キル") end)
end

on join(p)
  kit_welcome(p)
  p.owned = ["katana"]
  p.main = "katana"
  p.loadout = ["bandage"]
  p.uses = {bandage: 2}
  p.mastery = {}
  p.streak = 0
  p.stamina = STAMINA_MAX
  p.protect_until = time() + SPAWN_PROTECT
  kit_give(p, 0)
  kit_quest_button(p)
  kit_camera_button(p)
  p.give(weapon_info("katana").name)
  let buttons = [["parry", "はじく", "#F59E0B"], ["dodge", "回避", "#0EA5E9"]]
  let i = 0
  for b in buttons do
    i = i + 1
    p.ui_button(b[1], b[2], {at: "bottom_right", dx: -120 - (i - 1) * 100, dy: -160, w: 92, h: 56, size: 16, bg: b[3], radius: 14})
  end
  p.ui_button("open_armory", "⚔ 武器庫", {at: "right", dy: -60, w: 130, h: 46, size: 15, bg: "#7F1D1D"})
  p.ui_button("open_supplies", "🎒 補給", {at: "right", dy: 0, w: 130, h: 46, size: 15, bg: "#166534"})
  heavy_button(p)
  item_buttons(p)
  stamina_bar(p)
  hud(p)
end
