-- Toy Army Tycoon — おもちゃの軍隊の基地を大きくし、敵軍の襲撃からコアを守る。
--
-- ファイル:
--   data.absc    設備・部隊・研究・襲撃の敵
--   common.absc  基地の状態・画面
--   army.absc    兵隊と戦車・タレット・狙撃塔・迫撃砲・空爆
--   base.absc    土地・設備を買う・研究所・銀行・昇進
--   raids.absc   襲撃の予告・部隊・コア・将軍
--   main.absc    このファイル

kit_setup("Toy Army Tycoon", "兵隊を増やして、コアを守れ", [
  "🟥 色のパッドで基地を手に入れ、🟩 緑のパッドで16の設備を順番に建てる",
  "💰 設備がふえるほど2秒ごとのお金がふえる。🏦 銀行は持っているお金に利子",
  "🪖 兵舎で兵隊、🚜 ガレージで戦車。🔫 タレット・🎯 狙撃塔・💥 迫撃砲は自動で戦う",
  "🚨 襲撃の前に予告。敵は 敵兵・偵察兵・重装兵・戦車。5回ごとにおもちゃ将軍！",
  "🔬 研究所で強化、🚁 ヘリポートで空爆。🗽 記念碑まで建てたら 🎖 昇進（お金 +50%）"
])

kit_currency = "コイン"
kit_shop_title = "武器屋"
kit_shop_add("shotgun", "💥 ショットガン", 300, func(p) p.give("shotgun") end)
kit_shop_add("rifle", "🎯 ライフル", 800, func(p) p.give("rifle") end)
kit_shop_add("blaster", "⚡ ブラスター", 2500, func(p) p.give("blaster") end)
kit_shop_add("cap", "🪖 ヘルメット", 150, func(p) p.hat = "cap" end)

kit_quest("buy", "設備を8つ建てる", 8, 300)
kit_quest("soldier", "兵隊を5人よぶ", 5, 150)
kit_quest("tank", "戦車を1台", 1, 200)
kit_quest("defend", "襲撃を3回守りきる", 3, 400)
kit_quest("kills", "敵を20人たおす", 20, 250)
kit_quest("research", "研究を3回", 3, 200)
kit_quest("airstrike", "空爆をよぶ", 1, 100)
kit_quest("rebirth", "昇進する", 1, 1000)

on start()
  next_raid = time() + RAID_EVERY
  every(10, func() kit_leaderboard("💰") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 100)
  p.weapon_level = 1
  p.rebirths = 0
  p.give("pistol")
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.give("pistol")
  if p.plot != nil then p.teleport(core_block(p.plot).position + {x: 0, y: 1, z: 6}) end
end
