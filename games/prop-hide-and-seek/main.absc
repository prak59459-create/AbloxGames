-- Prop Hide & Seek — 家具になりきってかくれんぼ。見つかった人は鬼の仲間に
--
-- ファイル:
--   game.absc   ラウンドの流れ・役わけ・見つけた・結果
--   tools.absc  そっくり変身・回す・固定・挑発・懐中電灯・探知機
--   main.absc   このファイル

kit_setup("Prop Hide & Seek", "家具になりきって、見つかるな！", [
  "🙈 隠れる人: 家具の近くで「🎭 そっくり変身」。「↻」で向きを合わせて「🔒 固定」",
  "📢 挑発でポイント。でも鬼に音が聞こえちゃう",
  "👀 鬼: 30秒待ってから、ビームで怪しい家具を撃つ。ふつうの家具を撃つとダメージ",
  "🔦 懐中電灯で前の方の変身が光る。📡 探知機で近いか遠いかわかる",
  "見つかった人は鬼の仲間になる。2分30秒、最後まで残れば隠れる人の勝ち",
  "リビング・キッチン・寝室・子ども部屋・ろうか・ガレージ・庭、部屋ごとに家具がちがう"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["pts", "wins", "found", "survived"])


kit_quest("hide", "最後まで見つからない", 1, 200)
kit_quest("find", "鬼で5人見つける", 5, 300)
kit_quest("disguise", "10回変身する", 10, 100)
kit_quest("taunt", "挑発を5回", 5, 150)

kit_shop_title = "衣装"
kit_shop_add("cap", "🧢 キャップ", 100, func(p) p.hat = "cap" end)
kit_shop_add("antenna", "📡 アンテナ", 200, func(p) p.hat = "antenna" end)
kit_shop_add("halo", "😇 天使の輪", 500, func(p) p.hat = "halo" end)
kit_shop_add("green", "🟢 みどりの服", 150, func(p)
  p.own_color = "#16A34A"
  if p.role != "seeker" then p.color = p.own_color end
end)
kit_shop_add("purple", "🟣 むらさきの服", 150, func(p)
  p.own_color = "#7C3AED"
  if p.role != "seeker" then p.color = p.own_color end
end)

on start()
  every(10, func() kit_leaderboard("⭐") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.pts = 0
  p.wins = 0
  p.role = "watcher"
  p.found = 0
  p.survived = 0
  p.own_color = p.color
  kit_give(p, 20)
  if phase == "hide" then
    make_hider(p)
    p.message("🙈 まだ間に合う！ 家具に変身して隠れよう", 3)
  elif phase == "seek" then
    make_seeker(p, false)
    p.message("👀 途中参加は鬼から！", 3)
  end
end
