-- Raft to Treasure — ブロックで橋やいかだを作って、10のステージをこえ、宝島の宝箱へ。
--
-- ファイル:
--   data.absc    材料・ステージ・宝箱の中身
--   common.absc  小さな道具・画面
--   build.absc   置く・高さと回転・取り消し・材料の解放・大洪水
--   extras.absc  設計図・空の金貨
--   river.absc   ステージ・丸太・うずしお・ワニ・宝箱・タイム
--   main.absc    このファイル

kit_setup("Raft to Treasure", "作って、わたって、宝をつかめ", [
  "🔨 下のボタンで材料をえらんで「置く」。⬆⬇ で高さ、↻ で向き、↩ で取り消し",
  "🌊 川の水や岩・うずしお・溶岩にふれるとスタートにもどる。橋をかけて進もう",
  "🪵 流れてくる丸太は、木やガラスのブロックをこわす。🔩 鉄やかべは平気",
  "🐊 ワニの沼では足元に注意。🏁 ステージに着くたびにゴールド",
  "🔒 ゴールドで新しい材料を解放。🌊 8分ごとの大洪水で置いたものは流される",
  "📐 設計図で橋や階段をまとめて置ける。🪙 川の上の空の金貨はブロックを積んで取ろう",
  "💰 宝島の宝箱には、ゴールド・宝石・王冠・伝説の地図！ タイムもきそおう"
])
kit_currency = "ゴールド"

kit_quest("build", "ブロックを30こ置く", 30, 80)
kit_quest("stage3", "ステージ3に着く", 1, 100)
kit_quest("stage6", "ステージ6に着く", 1, 250)
kit_quest("unlock", "材料を3つ解放する", 3, 150)
kit_quest("chest", "宝箱をあける", 1, 500)
kit_quest("blueprint", "設計図で置く", 3, 120)
kit_quest("coins", "空の金貨を5まい取る", 5, 100)

on start()
  flood_at = time() + FLOOD_EVERY
  spawn_crocs()
  every(10, func() kit_leaderboard("🏁") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_give(p, 60)
  p.unlocked = {wood: true, long: true}
  p.mat = "wood"
  p.lift = 0
  p.turn = 0
  p.stage = 0
  p.best = 0
  p.run_start = 0
  p.best_run = 0
  p.blueprints = {}
  material_bar(p)
  p.ui_button("bp_open", "📐 設計図", {at: "right", dy: 232, w: 170, h: 44, size: 14, bg: "#0369A1"})
  p.ui_button("place", "🔨 置く", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 64, size: 18, bg: "#0EA5E9", radius: 16})
  p.ui_button("undo", "↩", {at: "bottom_right", dx: -236, dy: -160, w: 66, h: 64, size: 22, bg: "#6B7280", radius: 16})
  p.ui_button("up", "⬆", {at: "bottom_right", dx: -120, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  p.ui_button("down", "⬇", {at: "bottom_right", dx: -182, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  p.ui_button("turn", "↻", {at: "bottom_right", dx: -244, dy: -236, w: 56, h: 50, size: 20, bg: "#334155", radius: 12})
  p.ui_button("clear", "🧹 全部かたづける", {at: "right", dy: 180, w: 170, h: 44, size: 14, bg: "#7F1D1D"})
  hud(p)
  flood_hud()
end
