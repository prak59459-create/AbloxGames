-- guests.absc — お客さん（NPC）
-- 入口から来て入場料をはらう。楽しさ・空腹・のど・トイレがあり、足りないところへ行く。
-- 乗り物に乗ると楽しさアップ（料金は持ち主に）。屋台で食べ・飲み、トイレへ。こわれた乗り物やゴミでごきげんが下がる。
-- お金がなくなるか、いっぱい遊ぶか、ごきげんが下がりすぎると帰る。帰るときの気分で★が動く。

let guest_clock = 0
let spawn_clock = 0
let NAMES = ["ハル", "ミナト", "ユナ", "ソラ", "リコ", "カイト", "メイ", "タクミ", "アオ", "ヒナ"]

func fee_factor(pk)
  let fee = ENTRY_FEES[pk.fee_i]
  -- 入場料が高いほど来にくい（評判が高ければ気にしない）
  return max(0.3, 1.3 - fee / 50 * (1.2 - pk.rating * 0.15))
end

func spawn_guest(plot, pk)
  let gate = block("Plot " + plot + " Gate")
  if gate == nil then return end
  let owner = player_by_id(pk.owner)
  if owner == nil then return end
  let n = create_npc({name: random(NAMES), position: gate.position + {x: random(-2, 2), y: 1, z: 1},
                      color: random(["#F97316", "#3B82F6", "#22C55E", "#EC4899", "#FACC15", "#A855F7"]), head_color: "#F5D0A9",
                      health: 100000, speed: 0.8, team: "guests"})
  n.kind = "guest"
  n.park = plot
  n.fun = 60
  n.hunger = random(0, 30)
  n.thirst = random(0, 30)
  n.toilet = random(0, 30)
  n.happy = 70
  n.cash = random(40, 120)
  n.rides = 0
  n.target = nil
  n.busy_until = 0
  let fee = ENTRY_FEES[pk.fee_i]
  if fee > 0 then
    n.cash = n.cash - fee
    kit_give(owner, fee)
    owner.score = owner.score + fee
  end
  pk.guests_total = pk.guests_total + 1
  kit_quest_progress(owner, "guests", 1)
end

func can_pay(n, k)
  return ITEMS[k].fare <= n.cash
end

func pick_target(n, pk)
  let toilet = owned_items(pk, "toilet")
  let food = filter(owned_items(pk, "food"), func(k) return can_pay(n, k) end)
  let drink = filter(owned_items(pk, "drink"), func(k) return can_pay(n, k) end)
  if n.toilet > 70 and len(toilet) > 0 then return toilet[1] end
  if n.hunger > 60 and len(food) > 0 then return food[1] end
  if n.thirst > 60 and len(drink) > 0 then return drink[1] end
  let rides = filter(owned_items(pk, "ride"), func(k) return pk.broken["" + k] == nil end)
  let affordable = filter(rides, func(k) return ITEMS[k].fare <= n.cash end)
  if len(affordable) == 0 then return nil end
  return random(affordable)
end

func use_item(n, pk, k, owner)
  let it = ITEMS[k]
  if pk.broken["" + k] != nil then
    n.happy = n.happy - 12
    n.say("こわれてる…")
    return
  end
  if it.fare > n.cash then return end
  n.cash = n.cash - it.fare
  if it.fare > 0 then
    kit_give(owner, it.fare)
    owner.score = owner.score + it.fare
    kit_quest_progress(owner, "income", it.fare)
  end
  if it.kind == "ride" then
    n.fun = min(100, n.fun + it.fun)
    n.happy = min(100, n.happy + it.fun / 3)
    n.rides = n.rides + 1
    n.busy_until = time() + 3
    n.say(random(["たのしい！", "キャー！", "もう1回！", "さいこう！"]))
    fx_ball(item_block(n.park, k).position + {x: 0, y: 3, z: 0}, 1.4, "#FDE68A", 0.3)
  elif it.kind == "food" then
    n.hunger = 0
    n.happy = min(100, n.happy + 5)
    if random() < 0.35 then drop_trash(n, pk) end
  elif it.kind == "drink" then
    n.thirst = 0
    n.happy = min(100, n.happy + 5)
    if random() < 0.35 then drop_trash(n, pk) end
  elif it.kind == "toilet" then
    n.toilet = 0
  end
end

func drop_trash(n, pk)
  if len(pk.trash) >= 20 then return end
  let t = create_block({name: "Trash", shape: "box", position: n.position + {x: random(-1, 1), y: 0.15, z: random(-1, 1)},
                        size: 0.35, color: random(["#FBBF24", "#E5E7EB", "#F87171"]), solid: false, behavior: "trigger", tags: ["trash"]})
  append(pk.trash, t)
end

func guest_leave(n, pk, owner, why)
  -- 帰るときの気分で★が動く
  let d = (n.happy - 50) / 250
  pk.rating = min(5, max(1, pk.rating + d))
  if n.happy >= 70 then
    kit_quest_progress(owner, "happy", 1)
    n.say("また来るね！")
  else
    n.say(why)
  end
  let nn = n
  n.kind = "leaving"
  n.move_to(block("Plot " + n.park + " Gate").position + {x: 0, y: 0, z: 6})
  after(3, func() gone(nn) end)
end

func guest_step(n, pk, owner)
  if time() < n.busy_until then return end
  n.hunger = min(100, n.hunger + 2)
  n.thirst = min(100, n.thirst + 2.5)
  n.toilet = min(100, n.toilet + 1.5)
  n.fun = max(0, n.fun - 1)
  -- 困っていることがあるとごきげんが下がる
  if n.hunger > 85 or n.thirst > 85 or n.toilet > 90 then n.happy = n.happy - 3 end
  if n.fun < 20 then n.happy = n.happy - 1 end
  let dirty = 0
  for t in pk.trash do
    if still(t) and distance(n, t.position) < 5 then dirty = dirty + 1 end
  end
  if dirty > 0 then n.happy = n.happy - dirty end
  if pk.staff.mascot != nil and kit_here(pk.staff.mascot) and distance(n, pk.staff.mascot) < 10 then n.happy = min(100, n.happy + 2) end
  if n.happy < 15 then
    guest_leave(n, pk, owner, "もう帰る…")
    return
  end
  if n.rides >= 8 then
    guest_leave(n, pk, owner, "つかれた〜")
    return
  end
  -- もう何も買えない（乗れない）なら、おこづかいを使い切って帰る
  let cheapest = 1000
  for k in owned_items(pk, "ride") do cheapest = min(cheapest, ITEMS[k].fare) end
  if n.cash < cheapest and n.hunger < 85 and n.thirst < 85 then
    guest_leave(n, pk, owner, "おこづかいを使い切った！")
    return
  end
  if n.target == nil then
    n.target = pick_target(n, pk)
    if n.target == nil then
      guest_leave(n, pk, owner, "乗れるものがない…")
      return
    end
    let pad = buy_pad(n.park, n.target)
    if pad != nil then n.move_to(pad.position + {x: random(-1, 1), y: 0, z: random(0, 1)}) end
  else
    let pad = buy_pad(n.park, n.target)
    if pad != nil and distance(n, pad.position) < 3.5 then
      use_item(n, pk, n.target, owner)
      n.target = nil
    elif pad != nil and random() < 0.1 then
      n.move_to(pad.position)
    end
  end
end

on tick(dt)
  guest_clock = guest_clock + dt
  spawn_clock = spawn_clock + dt
  if spawn_clock >= 3 then
    spawn_clock = 0
    for plot in keys(parks) do
      let pk = parks[plot]
      let rides = ride_count(pk)
      if rides > 0 then
        let here = len(filter(npcs(), func(n) return n.park == plot and n.kind == "guest" end))
        let cap = min(GUEST_CAP, rides * GUEST_CAP_PER_RIDE + 2)
        let chance = (0.25 + rides * 0.05) * (0.5 + pk.rating * 0.2) * fee_factor(pk)
        if here < cap and random() < chance then spawn_guest(plot, pk) end
      end
    end
  end
  if guest_clock < 1 then return end
  guest_clock = 0
  for n in npcs() do
    if n.kind == "guest" and kit_here(n) then
      let pk = parks[n.park]
      let owner = nil
      if pk != nil then owner = player_by_id(pk.owner) end
      if pk == nil or owner == nil then gone(n) else guest_step(n, pk, owner) end
    end
  end
  for p in players() do hud(p) end
end
