-- Coaster Park Tycoon — 遊園地をつくって、お客さんを楽しませる
-- アトラクションと屋台14、お客さんの欲求（楽しさ・空腹・のど・トイレ）と気分で★が動く、
-- 入場料、故障と修理、ゴミ、スタッフ（整備士・清掃員・マスコット）、花火、ベストパーク賞。
--
-- ファイル:
--   data.absc     表（アトラクション・スタッフ・入場料）
--   common.absc   小さな道具・パーク・画面
--   guests.absc   お客さん
--   park.absc     買う・故障と修理・ゴミ・スタッフ・事務所・賞・花火
--   rides.absc    自分で乗る
--   main.absc     このファイル

kit_setup("Coaster Park Tycoon", "夢の遊園地をつくろう", [
  "🏁 色のパッドで区画を手に入れて、自分の遊園地に",
  "🟢 緑のパッドでアトラクション・屋台・トイレを順番に買う",
  "🙂 お客さんは楽しさ・おなか・のど・トイレを気にする。ぜんぶそろえよう",
  "🔧 乗り物はときどきこわれる。緑のパッドのそばに3びょうで修理",
  "🗑 ゴミが落ちるとごきげんダウン。さわって拾える",
  "🏢 むらさきのパッド: 入場料・スタッフ・花火。★が高いほど人が来る",
  "🎢 買ったアトラクションには自分でも乗れる！"
])

kit_quest("build", "5つ建てる", 5, 150)
kit_quest("rides", "乗り物を4つにする", 1, 300)
kit_quest("guests", "お客さんを30人むかえる", 30, 300)
kit_quest("happy", "ごきげんで帰ったお客さん10人", 10, 300)
kit_quest("income", "乗り物の売上1000", 1000, 400)
kit_quest("repair", "乗り物を3回直す", 3, 150)
kit_quest("clean", "ゴミを10こ拾う", 10, 100)
kit_quest("staff", "スタッフをやとう", 1, 150)
kit_quest("rider", "乗り物に5回乗る", 5, 80)
kit_quest("coaster", "ジェットコースターに乗る", 1, 200)
kit_quest("fireworks", "花火を上げる", 1, 400)
kit_quest("award", "ベストパーク賞をとる", 1, 800)

on start()
  for n in npcs() do n.destroy() end
  every(0.5, func()
    for plot in keys(parks) do
      let pk = parks[plot]
      if has(pk, 2) and pk.broken["2"] == nil then
        let b = item_block(plot, 2)
        if b != nil then b.rotate(0, 15, 0) end
      end
    end
  end)
  every(10, func() kit_leaderboard("🎡") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  kit_give(p, 150)
  p.guests = 0
  hud(p)
end

on leave(p)
  release_park(p)
end

on touch(p, b)
  if p.is_npc or not ready(p) then return end
  let parts = split(b.name, " ")
  if contains(b.tags, "claim") then claim(p, parts[2])
  elif contains(b.tags, "buy") then
    let plot = parts[2]
    let k = num(parts[4])
    let pk = parks[plot]
    if pk == nil then return end
    if has(pk, k) then ride(p, plot, k)
    elif p.plot == plot and quiet_ready(p, "buy_" + k, 1) then buy(p, k)
    end
  end
end
