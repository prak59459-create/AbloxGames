-- Clash Duels — 短い試合で勝負するFPS
-- ロビーからモードをえらぶ: 🤺タイマン（BOT対戦も）/ ⚔️チーム戦 / 💥乱戦 / 🎯練習場。
-- 武器13種（主・副・近接）・投げ物6種・見た目8種。勝つと🔑カギとレベル。
--
-- ファイル:
--   data.absc     表（武器・投げ物・見た目・連続キル・ルール）
--   common.absc   人さがし・画面・レベルとカギ・キルログ
--   loadout.absc  武器の用意・装備・武器屋・投げ物・持ちかえ
--   lobby.absc    ロビーとモードの出入り
--   combat.absc   当たり判定・たおした時・連続キル
--   team.absc     チーム戦（赤vs青、先に5ラウンド）
--   duel.absc     タイマン（先に5ラウンド、BOTとも）
--   ffa.absc      乱戦（先に15キル）と練習場
--   main.absc     このファイル

kit_setup("Clash Duels", "タイマン・チーム戦・乱戦。うでをみがいて🔑を集めよう", [
  "🏠 ロビーのパッド: 赤=タイマン / オレンジ=チーム戦 / 紫=乱戦 / 緑=練習場",
  "🎒 水色のパッドで装備（主武器・副武器・近接・投げ物）をえらぶ",
  "🔑 黄色のパッドの武器屋で新しい武器・投げ物・見た目を買う",
  "⌨️ 右下の 1 2 3 で武器を持ちかえ、💣 で投げ物",
  "⚔️ チーム戦とタイマンは先に5ラウンド。乱戦は先に15キル",
  "🔥 連続でたおすとボーナス（3・5・8・12キル）",
  "🤖 タイマン待ちで10秒ひとりなら BOT と練習できる"
])
kit_currency = "カギ"

-- MARK: クエスト

kit_quest("kill", "相手をたおす", 1, 20)
kit_quest("kill50", "50人たおす", 50, 400)
kit_quest("streak5", "5連続キル", 1, 150)
kit_quest("duelwin", "タイマンで勝つ", 1, 100)
kit_quest("teamwin", "チーム戦で勝つ", 1, 100)
kit_quest("ffawin", "乱戦で優勝", 1, 200)
kit_quest("queue", "試合を待つ", 1, 10)
kit_quest("training", "練習場に行く", 1, 10)
kit_quest("util", "投げ物を10回使う", 10, 60)
kit_quest("unlock", "新しい武器を手に入れる", 1, 50)
kit_quest("wrap", "見た目を買う", 1, 50)
kit_quest("lv5", "レベル5", 4, 150)
kit_quest("lv15", "レベル15", 14, 600)

-- MARK: 入ってきた人

on start()
  game.respawn_time = -1
  every(10, func() kit_leaderboard("⭐ レベル") end)
end

on join(p)
  p.level = 1
  p.xp = 0
  p.kills = 0
  p.deaths = 0
  p.wins = 0
  p.streak = 0
  p.owned = ["ar", "pistol", "knife", "grenade"]
  p.load = {primary: "ar", secondary: "pistol", melee: "knife", utility: "grenade"}
  p.wrap = "default"
  p.base_color = p.color
  p.mode = "lobby"
  p.team = "lobby"
  kit_welcome(p)
  kit_give(p, 100)
  p.ui_button("open_load", "🎒 装備", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#0369A1"})
  p.ui_button("open_shop", "🔑 武器屋", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#A16207"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end

on leave(p)
  leave_mode(p)
end
