-- Academy Days — 寮対抗の学園ゲーム
-- 4つの寮、6教科のミニゲーム、宿題、放課後の部活、寮杯、生徒会選挙、ランク、制服。
--
-- ファイル:
--   data.absc      表（寮・時間割・ランク・色・音・ポーション）
--   common.absc    成績・寮ポイント・画面
--   classes.absc   時間割と授業のミニゲーム
--   campus.absc    寮・宿題・体育・部活・寮杯・選挙
--   main.absc      このファイル

kit_setup("Academy Days", "寮のために、学園のスターに", [
  "🏠 ろうかの両はしの旗で寮をえらぶ（🔥ブレイズ・🌊タイド・🌿フォレスト・⚡ボルト）",
  "🔔 チャイムのあと15びょうで教室の色つきの床へ。授業のミニゲームで成績と寮ポイント",
  "📐算数・🎨美術・🎵音楽・🏃体育（ハードル走）・🧪ポーション学・📚図書館",
  "📝 宿題が出たら、その教室の床へ。🏫 放課後は好きな教室で部活",
  "🏆 1学期（8コマ）ごとに寮杯。🗳 そのあと生徒会選挙（投票箱）"
])

kit_shop_title = "購買部"
kit_shop_add("u_blazer", "ブレザー", 60, func(p) p.color = "#1E3A8A" end)
kit_shop_add("u_sailor", "セーラー服", 60, func(p) p.color = "#F8FAFC" end)
kit_shop_add("u_sweater", "カーディガン", 80, func(p) p.color = "#FDE68A" end)
kit_shop_add("h_cap", "学生帽", 50, func(p)
  p.own_hat = "cap"
  if p.hat != "crown" then p.hat = "cap" end
end)
kit_shop_add("h_halo", "天使の輪（優等生）", 300, func(p)
  p.own_hat = "halo"
  if p.hat != "crown" then p.hat = "halo" end
end)

kit_quest("dorm", "寮に入る", 1, 30)
kit_quest("attend", "10回授業に出る", 10, 150)
kit_quest("math", "算数で10問正解", 10, 120)
kit_quest("music", "音楽で完ぺき", 1, 80)
kit_quest("potion", "ポーションを5つ作る", 5, 150)
kit_quest("library", "図書館で本を3冊", 1, 80)
kit_quest("race", "体育で1位", 1, 120)
kit_quest("homework", "宿題を3回出す", 3, 120)
kit_quest("club", "部活に3回出る", 3, 100)
kit_quest("cup", "寮杯をとる", 1, 400)
kit_quest("vote", "選挙で投票する", 1, 30)
kit_quest("president", "生徒会長になる", 1, 800)
kit_quest("rank", "ランクを上げる", 2, 200)

on start()
  every(10, func() kit_leaderboard("🎓") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 50)
  p.gpa = 0
  p.club_done = false
  show(p)
  p.message("🏠 まずはろうかの両はしの旗で寮をえらぼう", 3)
end

on leave(p)
  if president == p.id then president = nil end
end
