-- Cherry Lane RP — 学校と家族とお仕事のロールプレイ
-- 1日の時間割（朝の会・算数・図工・昼休み・音楽・理科・体育・放課後・夜）と授業のミニゲーム、
-- 通知表と進級・卒業。家と家族（赤ちゃんのお世話）、カフェ店員と美容師のお仕事、
-- 服12種ときょうのテーマ、乗り物、友だち（ハイタッチ）。
--
-- ファイル:
--   data.absc     表（役割・時間割・問題・学年・服・ドリンク・乗り物）
--   common.absc   小さな道具・画面の左上
--   school.absc   時間割・授業（クイズ・音楽・体育）・通知表・進級
--   family.absc   役割・家・家族・赤ちゃん・友だち・夜
--   work.absc     カフェ店員・美容師・ドリンク・おこづかい・乗り物
--   style.absc    ブティックときょうのテーマ
--   main.absc     このファイル

kit_setup("Cherry Lane RP", "役割を選んで、街でくらそう", [
  "🎭「役割」で 生徒・先生・親・赤ちゃん・カフェ店員・美容師 をえらぶ",
  "🔔 チャイムが鳴ったら教室へ。授業はクイズ・音楽のリズム・体育のかけっこ",
  "📄 1日の終わりに通知表。成績で進級して、6年生の次は卒業！",
  "🏠 黄色い看板で家。親は「👪 家族」で近くの人を家族にさそえる",
  "🍼 赤ちゃんのお願いは家族が「お世話」。夜に家でねるとボーナス",
  "☕ カフェ店員・💇 美容師はお客さんの注文にこたえてお給料",
  "🚗 カーショップ（水色）で乗り物。/home で家へ"
])

kit_quest("roles", "役割を3回かえる", 3, 40)
kit_quest("attend", "朝の会に3回出る", 3, 60)
kit_quest("class", "授業に5回出る", 5, 100)
kit_quest("perfect", "クイズで全問正解", 1, 80)
kit_quest("grade_a", "通知表でAをとる", 1, 150)
kit_quest("grade", "進級する", 1, 100)
kit_quest("teach", "先生として授業する", 3, 150)
kit_quest("home", "家を手に入れる", 1, 30)
kit_quest("family", "家族をつくる", 1, 80)
kit_quest("care", "赤ちゃんのお世話を5回", 5, 120)
kit_quest("sleep", "夜に家でねる", 1, 40)
kit_quest("friends", "友だちを3人つくる", 3, 100)
kit_quest("serve", "カフェで10杯出す", 10, 200)
kit_quest("style", "美容師で5人コーデ", 5, 200)
kit_quest("drink", "ドリンクを3杯飲む", 3, 30)
kit_quest("outfit", "服を5回着がえる", 5, 50)
kit_quest("buy_outfit", "服を3着買う", 3, 100)
kit_quest("theme", "テーマの服で朝の会", 1, 60)
kit_quest("car", "乗り物を買う", 1, 80)

on start()
  for n in npcs() do n.destroy() end
  period_i = 0
  period_left = 8
  every(10, func() kit_leaderboard("✏️") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.grades = {}
  p.day_points = {}
  p.friends = {}
  p.outfits = ["uniform", "casual", "pajama"]
  p.cars = ["bike"]
  p.car_name = "🚲 自転車"
  p.car_speed = 1.5
  p.driving = false
  kit_give(p, 60)
  set_role(p, "student")
  p.ui_button("open_roles", "🎭 役割", {at: "right", dy: -180, w: 150, h: 46, size: 16, bg: "#DB2777"})
  p.ui_button("open_wardrobe", "👗 服", {at: "right", dy: -128, w: 150, h: 46, size: 16, bg: "#EC4899"})
  p.ui_button("drive", "🚗 のる/おりる", {at: "right", dy: -76, w: 150, h: 46, size: 15, bg: "#0EA5E9"})
  p.ui_button("hifive", "🙌 ハイタッチ", {at: "right", dy: -24, w: 150, h: 46, size: 15, bg: "#F59E0B"})
  p.ui_button("family", "👪 家族", {at: "right", dy: 28, w: 150, h: 46, size: 16, bg: "#16A34A"})
  p.ui_button("care", "🍼 お世話", {at: "right", dy: 80, w: 150, h: 46, size: 16, bg: "#F472B6"})
  hud(p)
end

on leave(p)
  if p.home != nil then owners[p.home] = nil end
  for q in players() do
    if q.family == p.id and q.id != p.id then
      q.family = nil
      q.message("👪 " + p.name + " がいなくなったので家族は解散", 2)
      hud(q)
    end
  end
end
