-- Last Train West — 最後の列車で荒野を10km
-- 石炭と燃料、列車の耐久と修理、4つの町（木箱・保安官の店・金塊）、夜の襲撃（ならず者は撃ってくる）、
-- 4つの役割、みんなのお金で列車の強化（ボイラー・装甲・砲台・ライト）、最後の橋の防衛戦。
--
-- ファイル:
--   data.absc      表（町・物資・怪物・役割・強化）
--   common.absc    旅の状態・道具・画面
--   night.absc     夜・怪物・役割・橋
--   stations.absc  駅・木箱・保安官の店・持ち物
--   train.absc     ボイラー・走る・耐久・貨物・強化・砲台
--   main.absc      このファイル

kit_setup("Last Train West", "列車を止めるな。終点まで10km", [
  "⚫ 石炭置き場（黒）で石炭を持って、🔥 ボイラー（オレンジ）へ。燃料が多いほど速い",
  "🚉 2kmごとに駅。町の木箱で物資、⭐ 黄色いパッドは保安官の店。汽笛が鳴ったら列車へ！",
  "🟨 金塊は貨物車（黄色）へ → みんなのお金。🚂 掲示板（黄色）で列車を強化",
  "🌙 夜は怪物が列車をこわしにくる。🪵 板を作業台（青）で使うと列車を直せる",
  "🎭 紫の掲示板で役割。🩹 包帯と 💧 聖水はボタンで使う。最後は🌉 大きな橋の防衛戦！"
])

kit_currency = "金貨"
kit_shop_title = "行商人"
kit_shop_add("hat", "🤠 カウボーイハット", 40, func(p) p.hat = "cap" end)
kit_shop_add("badge", "⭐ 保安官バッジ（冠）", 300, func(p) p.hat = "crown" end)

kit_quest("coal", "石炭を30個くべる", 30, 120)
kit_quest("loot", "木箱を10個開ける", 10, 100)
kit_quest("gold", "金塊を5本しまう", 5, 200)
kit_quest("repair", "板で列車を5回直す", 5, 150)
kit_quest("kills", "怪物を15体たおす", 15, 200)
kit_quest("holy", "聖水を使う", 1, 50)
kit_quest("gun", "保安官の店で銃を買う", 1, 60)
kit_quest("role", "役割をえらぶ", 1, 30)
kit_quest("upgrade", "列車を2回強化", 2, 200)
kit_quest("stations", "3つの駅に着く", 3, 150)
kit_quest("finish", "橋をわたって終点へ", 1, 800)

on start()
  game.respawn_time = 8
  station_until = time() + STATION_SECS + 10
  show_town(1, true)
  spawn_crates(1)
  after(1, func() announce("🚉 出発の駅。" + (STATION_SECS + 10) + "びょうで準備しよう！", 4) end)
  every(10, func() kit_leaderboard("💰") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 25)
  p.pack = {}
  p.coal = 0
  p.role = nil
  p.give("pistol")
  p.ui_button("bandage", "🩹", {at: "right", dy: 180, w: 70, h: 46, size: 20, bg: "#DC2626"})
  p.ui_button("holy", "💧", {at: "right", dy: 180, dx: -80, w: 70, h: 46, size: 20, bg: "#0284C7"})
  hud(p)
  trip_hud()
  kit_later(p, 4.5, func() roles_panel(p) end)
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Passenger Car").position + {x: 0, y: 1.5, z: 0})
  p.give("pistol")
end
