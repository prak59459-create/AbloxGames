-- Yokai Shrine — 夜の神社でお札を集める和風ホラー（三つの夜）
-- お札を本殿に納めると結界がとけ、目ざめた鬼から逃げて鳥居の外へ。
-- 勇気が0になると気絶する。灯籠・仲間・手水舎で勇気をたもとう。
--
-- ファイル:
--   data.absc     夜の設定・妖怪図鑑・お守り・おみくじ
--   common.absc   夜の状態・勇気・気絶と助け合い・画面
--   nights.absc   お札・祭壇・結界・夜の流れ・脱出・夜明け
--   shrine.absc   石灯籠・手水舎・鈴・おさいせん・おみくじ・祠・お守り処・図鑑・持ち物
--   yokai.absc    のっぺらぼう・狐火・からかさ・かっぱ・ちょうちんおばけ・座敷わらし・鬼
--   main.absc     このファイル

kit_setup("Yokai Shrine", "お札を納めて、三つの夜をこえよ", [
  "📜 境内の光るお札を拾って、本殿の祭壇（金色）に納めよう。うすい赤のふちは呪いのお札！",
  "💪 暗いところでは勇気がへる。🏮 石灯籠のそば・仲間のそば・💧 手水舎でもどる。0になると気絶",
  "👤 仲間と同じ名前でも油断しない。近づくと顔がなくなる…。🔔 本殿の鈴で正体をあばけ",
  "🏮 ちょうちんボタンで狐火を散らす。消えた灯籠はさわるとまた灯る。⛩ 祠にはかくれられる",
  "👹 お札がそろうと鬼が目ざめる。鳥居の外（緑）まで逃げろ！ 気絶した仲間はそばに行くと起こせる",
  "🎋 おみくじ・🪙 おさいせん（ご加護）・⛩ お守り処（赤）もためしてみよう。📖 図鑑に妖怪を記録"
])

kit_currency = "銭"
kit_shop_title = "着せかえ"
kit_shop_add("horns", "👹 鬼のつの", 80, func(p)
  p.hat = "antenna"
  p.saved_hat = "antenna"
end)
kit_shop_add("halo", "✨ 光の輪", 150, func(p)
  p.hat = "halo"
  p.saved_hat = "halo"
end)
kit_shop_add("miko", "⛩ 巫女の赤", 60, func(p)
  p.color = "#FFFFFF"
  p.leg_color = "#DC2626"
end)

kit_quest("ofuda", "お札を10枚納める", 10, 200)
kit_quest("escape", "鳥居の外へ脱出", 1, 150)
kit_quest("nights", "三つの夜をこえる", 3, 500)
kit_quest("lanterns", "消えた灯籠を10回ともす", 10, 100)
kit_quest("wisps", "狐火を10個散らす", 10, 120)
kit_quest("bell", "本殿の鈴を鳴らす", 3, 60)
kit_quest("offer", "おさいせんを5回", 5, 80)
kit_quest("omikuji", "おみくじを引く", 3, 50)
kit_quest("tie", "悪いおみくじを結ぶ", 1, 30)
kit_quest("revive", "気絶した仲間を助ける", 3, 150)
kit_quest("hide", "祠にかくれる", 3, 60)
kit_quest("umbrella", "からかさからお札を取り返す", 1, 80)
kit_quest("kappa", "かっぱにきゅうりをあげる", 1, 60)
kit_quest("purify", "手水舎で清める", 3, 40)
kit_quest("salt", "清め塩を使う", 2, 40)
kit_quest("charm", "お守りを3つ買う", 3, 80)
kit_quest("dex", "妖怪図鑑を7体うめる", 7, 300)

on start()
  game.respawn_time = 4
  lanterns_setup()
  start_night(1)
  every(10, func() kit_leaderboard("📜") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 30)
  p.carry = 0
  p.courage = 100
  p.dex = {}
  p.fainted = false
  p.escaped = false
  p.hidden_until = 0
  p.boost_until = 0
  p.charms = {}
  p.ui_button("lantern", "🏮", {at: "bottom_right", dx: -120, dy: -160, w: 100, h: 56, size: 26, bg: "#EA580C", radius: 16})
  p.ui_button("dex", "📖 図鑑", {at: "right", dy: 180, w: 150, h: 46, size: 16, bg: "#4C1D95"})
  apply_speed(p)
  hud(p)
  night_hud()
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(spawn_pos())
  if p.fainted then wake(p, 60) end
end
