-- Color Monsters — カラフルなモンスターから隠れて任務を集める協力ホラー
-- 5つの夜（ブロック・ヒューズ・電池・ガス・ロケットの部品）、5色のモンスター、箱とロッカー、
-- 檻とレバーの救出、エサ皿、お店の道具、5夜目のロケット脱出。
--
-- ファイル:
--   data.absc      表（夜・モンスター・道具）
--   common.absc    道具・画面・ドキドキ
--   cage.absc      檻・レバー・全員つかまったとき
--   hiding.absc    箱とロッカー
--   items.absc     品物・届ける・エサ
--   monsters.absc  モンスターの動き
--   nights.absc    夜の流れとロケット脱出
--   main.absc      このファイル

kit_setup("Color Monsters", "箱をかぶって、見つからずに集めろ", [
  "🌙 夜ごとの任務の品物（光るもの）を集めて、決まった場所へ届けよう（上に表示）",
  "📦 箱ボタンで箱をかぶると、見るモンスターに見つからない。🚪 灰色のパッドはロッカー",
  "🔵見回り 🟢走る音を聞く 🟠エサ皿が空だと速い（食料庫のエサを皿へ） 🟣通気口 🩵うしろにあらわれる",
  "⛓ つかまったら檻へ。仲間が赤いレバーを引くと出られる。全員つかまるとやりなおし（❤️3つ）",
  "🚀 5夜目はロケットの部品。完成したらロケットに乗りこんで脱出！ ⭐スターでお店の道具を"
])

kit_currency = "スター"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["perks", "times_caught", "look_body", "look_head"])
kit_on_load = func(p)
  if not p.boxed then
    p.color = p.look_body
    p.head_color = p.look_head
  end
end

kit_shop_title = "おもちゃ屋さん"
-- 1つずつ関数で包む（ループの変数をそれぞれの道具に閉じこめる）
func add_perk_item(perk)
  kit_shop_add(perk.id, perk.name + "（" + perk.text + "）", perk.price, func(p)
    if not contains(p.perks, perk.id) then append(p.perks, perk.id) end
    if perk.id == "bigbox" and p.boxed then p.speed = box_speed(p) end
    p.message("🛒 " + perk.name + " を手に入れた！", 1.5)
    kit_quest_progress(p, "perk", 1)
    hud(p)
  end)
end
for perk in PERKS do add_perk_item(perk) end
kit_shop_add("look_red", "🔴 赤いパーカー", 30, func(p)
  p.look_body = "#DC2626"
  if not p.boxed then p.color = p.look_body end
end)
kit_shop_add("look_mint", "🟢 ミントのパーカー", 30, func(p)
  p.look_body = "#5EEAD4"
  if not p.boxed then p.color = p.look_body end
end)

kit_quest("items", "任務の品物を15個届ける", 15, 150)
kit_quest("night1", "1夜目をクリア", 1, 60)
kit_quest("night2", "2夜目をクリア", 1, 80)
kit_quest("night3", "3夜目をクリア", 1, 100)
kit_quest("night4", "4夜目をクリア", 1, 150)
kit_quest("escape", "ロケットで脱出", 1, 300)
kit_quest("hide", "箱で10回隠れる", 10, 60)
kit_quest("locker", "ロッカーに3回隠れる", 3, 60)
kit_quest("feed", "エサ皿を5回満たす", 5, 100)
kit_quest("rescue", "仲間を3人助ける", 3, 150)
kit_quest("spotted", "モンスターに5回見つかる", 5, 40)
kit_quest("caught", "つかまる（こわかった…）", 1, 20)
kit_quest("perk", "お店の道具を3つ買う", 3, 100)

on start()
  game.respawn_time = 3
  after(5, func() start_night() end)
  every(10, func() kit_leaderboard("⭐") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 20)
  p.perks = []
  p.carrying = 0
  p.food = 0
  p.boxed = false
  p.caged = false
  p.locker = nil
  p.times_caught = 0
  p.look_body = "#F59E0B"
  p.look_head = "#F5D0A9"
  p.color = p.look_body
  p.head_color = p.look_head
  p.ui_button("box", "📦 箱", {at: "bottom_right", dx: -120, dy: -160, w: 110, h: 64, size: 20, bg: "#A16207", radius: 16})
  hud(p)
  team_hud()
end

on leave(p)
  after(0.5, func() check_wipe() end)
end
