-- Crusher Yard — 自分のレーンで車をグシャッ！ スクラップを集めて、もっと大きな車ともっとすごい機械へ
--
-- ファイル:
--   data.absc    車12台・機械6つ・強化
--   common.absc  レーン・強さ・画面
--   cars.absc    車の組み立て・壊れ方・スクラップ・磁石
--   lanes.absc   レーン・機械の見た目・車をのせる・つぶす
--   shop.absc    ガレージ・機械屋・強化・転生・スクラップラッシュ
--   main.absc    このファイル

kit_setup("Crusher Yard", "グシャッとつぶして、スクラップを集めよう", [
  "🟡 黄色いパッドで自分のレーンをもらう",
  "🟢 レーンの緑のボタン（または「🚗 のせる」）で車がベルトにのる",
  "💥 機械が車をこわすと、スクラップがとびちる。歩いて集めるとお金に",
  "🚗 ガレージで大きな車を解放。🏭 機械屋でシュレッダー・溶岩・レーザー・鉄球・ブラックホール",
  "🔧 強化: パワー・ベルト・価値・🧲磁石・🤖自動投入",
  "🔥 ときどきスクラップラッシュ（価値×2・金の車）",
  "⭐ お金がたまったら転生して、価値をずっとアップ"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["owned", "car", "machines", "machine", "ups", "prestige", "crushed", "scraps", "total"])


kit_quest("crush", "車を20台つぶす", 20, 150)
kit_quest("crush500", "車を500台つぶす", 500, 20000)
kit_quest("scrap", "スクラップを200こ集める", 200, 500)
kit_quest("cars", "車を5台解放する", 5, 3000)
kit_quest("machines", "機械を3つ手に入れる", 3, 8000)
kit_quest("upgrade", "20回強化する", 20, 5000)
kit_quest("prestige", "転生する", 1, 50000)

on start()
  every(10, func() kit_leaderboard("💥") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.owned = ["bike", "junk"]
  p.car = "junk"
  p.machines = ["press"]
  p.machine = "press"
  p.ups = {}
  p.prestige = 0
  p.crushed = 0
  p.scraps = 0
  p.total = 0
  p.auto_on = false
  kit_give(p, 20)
  p.ui_button("load", "🚗 のせる", {at: "bottom_right", dx: -110, dy: -170, w: 150, h: 60, size: 18, bg: "#16A34A", radius: 16})
  hud(p)
  -- あいているレーンを自動でもらう
  for n in 1 to LANE_COUNT do
    if p.lane == nil and lanes["" + n].owner == nil then claim_lane(p, "" + n) end
  end
end
