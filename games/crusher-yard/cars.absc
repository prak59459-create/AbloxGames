-- cars.absc — 車を部品で組み立てる・ベルトで運ぶ・機械ごとの壊れ方・スクラップになる

let scrap_info = {}      -- スクラップのブロック id → {owner, value, until}

func part(parts, center, off, size, color, shape, material, rotation)
  let b = create_block({name: "Car Part", shape: shape or "box", position: center + off, size: size, color: color, material: material or "metal",
                        solid: false, rotation: rotation or {x: 0, y: 0, z: 0}})
  append(parts, {b: b, off: off, size: size, color: color})
end

-- 車をひとつ作る。center は車の足もと
func build_car(v, center, gold)
  let parts = []
  let s = v.size
  let color = v.color
  if gold then color = "#FACC15" end
  let lift = 0.35
  if v.extra == "bike" then
    part(parts, center, {x: 0, y: 0.9, z: 0}, {x: 0.15, y: 0.15, z: 1.4}, color, "box", "metal", nil)
    part(parts, center, {x: 0, y: 1.3, z: -0.3}, {x: 0.5, y: 0.12, z: 0.3}, "#111827", "box", "plastic", nil)
    for dz in [-0.7, 0.7] do part(parts, center, {x: 0, y: 0.45, z: dz}, {x: 0.9, y: 0.12, z: 0.9}, "#1F2937", "cylinder", "plastic", {x: 0, y: 0, z: 90}) end
    return parts
  end
  if v.extra == "ufo" then
    part(parts, center, {x: 0, y: 1.2, z: 0}, {x: s.x, y: 0.5, z: s.z}, color, "cylinder", "metal", nil)
    part(parts, center, {x: 0, y: 1.7, z: 0}, {x: 2, y: 1.2, z: 2}, "#BAE6FD", "sphere", "glass", nil)
    part(parts, center, {x: 0, y: 0.8, z: 0}, {x: 2.4, y: 0.3, z: 2.4}, "#22D3EE", "cylinder", "neon", nil)
    return parts
  end
  if v.extra == "rocket" then
    part(parts, center, {x: 0, y: 1.2, z: 0}, {x: 1.6, y: s.z * 0.7, z: 1.6}, color, "cylinder", "metal", {x: 90, y: 0, z: 0})
    part(parts, center, {x: 0, y: 1.2, z: 0 - s.z * 0.45}, {x: 1.6, y: 1.8, z: 1.6}, "#DC2626", "cone", "metal", {x: -90, y: 0, z: 0})
    for dx in [-1, 1] do part(parts, center, {x: dx * 1, y: 0.7, z: s.z * 0.3}, {x: 0.2, y: 1.2, z: 1.2}, "#DC2626", "box", "metal", nil) end
    part(parts, center, {x: 0, y: 1.2, z: s.z * 0.38}, {x: 1, y: 0.4, z: 1}, "#F97316", "cylinder", "neon", {x: 90, y: 0, z: 0})
    return parts
  end
  -- ふつうの車: 車体・屋根・タイヤ4つ・ライト
  part(parts, center, {x: 0, y: lift + s.y * 0.3, z: 0}, {x: s.x, y: s.y * 0.6, z: s.z}, color, "box", "metal", nil)
  if v.extra == "turret" then
    part(parts, center, {x: 0, y: lift + s.y * 0.8, z: 0.3}, {x: s.x * 0.6, y: s.y * 0.45, z: s.z * 0.4}, "#3F6212", "box", "metal", nil)
    part(parts, center, {x: 0, y: lift + s.y * 0.85, z: 0 - s.z * 0.35}, {x: 0.3, y: 0.3, z: s.z * 0.55}, "#1F2937", "cylinder", "metal", {x: 90, y: 0, z: 0})
  else
    let cab_z = 0 - s.z * 0.05
    let cab_len = s.z * 0.5
    if v.extra == "bed" then
      cab_z = 0 - s.z * 0.2
      cab_len = s.z * 0.35
    elif v.extra == "windows" or v.extra == "ladder" then
      cab_len = s.z * 0.9
      cab_z = 0
    end
    part(parts, center, {x: 0, y: lift + s.y * 0.8, z: cab_z}, {x: s.x * 0.9, y: s.y * 0.4, z: cab_len}, "#BAE6FD", "box", "glass", nil)
  end
  for dx in [-1, 1] do
    for dz in [-1, 1] do
      part(parts, center, {x: dx * s.x * 0.5, y: 0.4, z: dz * s.z * 0.32}, {x: 0.8, y: 0.3, z: 0.8}, "#111827", "cylinder", "plastic", {x: 0, y: 0, z: 90})
    end
  end
  part(parts, center, {x: 0, y: lift + s.y * 0.35, z: 0 - s.z / 2 - 0.02}, {x: s.x * 0.8, y: 0.15, z: 0.05}, "#FEF9C3", "box", "neon", nil)
  if v.extra == "sign" then part(parts, center, {x: 0, y: lift + s.y * 1.08, z: 0}, {x: 0.8, y: 0.25, z: 0.3}, "#FDE047", "box", "neon", nil) end
  if v.extra == "wing" then part(parts, center, {x: 0, y: lift + s.y * 1, z: s.z * 0.45}, {x: s.x, y: 0.08, z: 0.5}, "#111827", "box", "metal", nil) end
  if v.extra == "ladder" then part(parts, center, {x: 0, y: lift + s.y * 1.08, z: 0}, {x: 0.6, y: 0.15, z: s.z * 0.8}, "#D6D3D1", "box", "metal", nil) end
  if v.extra == "windows" then part(parts, center, {x: 0, y: lift + s.y * 0.1, z: 0}, {x: s.x + 0.02, y: 0.15, z: s.z * 0.95}, "#1F2937", "box", "plastic", nil) end
  return parts
end

-- 車全体を center へ secs 秒で動かす
func move_car(car, center, secs)
  car.center = center
  for pt in car.parts do
    if still(pt.b) then pt.b.move_to(center + pt.off, secs) end
  end
end

-- f: こわれぐあい（0〜1）。機械ごとに見た目を変える
func shape_car(car, mode, f)
  let i = 0
  for pt in car.parts do
    i = i + 1
    if still(pt.b) then
      let off = pt.off
      let sz = pt.size
      let pos = car.center + off
      if mode == "press" then
        let s = max(0.12, 1 - f * 0.88)
        pt.b.size = {x: sz.x * (1 + (1 - s) * 0.35), y: sz.y * s, z: sz.z * (1 + (1 - s) * 0.1)}
        pos = car.center + {x: off.x * (1 + (1 - s) * 0.3), y: off.y * s, z: off.z}
      elif mode == "shredder" then
        pos = car.center + {x: off.x, y: off.y - f * 1.6, z: off.z * (1 - f * 0.3)}
        pt.b.size = {x: sz.x * (1 - f * 0.4), y: sz.y, z: sz.z * (1 - f * 0.5)}
      elif mode == "lava" then
        pos = car.center + {x: off.x, y: off.y - f * 2.2, z: off.z}
        if f > 0.5 then pt.b.color = "#F97316" end
      elif mode == "laser" then
        let side = 1
        if i % 2 == 0 then side = -1 end
        pos = car.center + {x: off.x + side * f * 1.6, y: off.y, z: off.z}
        pt.b.rotation = {x: 0, y: 0, z: side * f * 25}
      elif mode == "ball" then
        pos = car.center + {x: off.x * (1 + f), y: off.y + random() * f, z: off.z * (1 + f * 0.4)}
        pt.b.rotation = {x: random(-30, 30) * f, y: random(-30, 30) * f, z: random(-30, 30) * f}
      else
        let s = max(0.1, 1 - f * 0.9)
        pt.b.size = {x: sz.x * s, y: sz.y * s, z: sz.z * s}
        pos = car.center + {x: off.x * s, y: off.y * s + f * 2.5, z: off.z * s}
      end
      pt.b.move_to(pos, 0.15)
    end
  end
end

-- こわれた！ スクラップに変わってとびちる
func burst(car, owner_id, value, bin)
  let count = 6 + floor(car.tier / 2)
  let each = value / count
  for pt in car.parts do gone(pt.b) end
  for i in 1 to count do
    let color = "#9CA3AF"
    if i % 3 == 0 then color = car.color end
    if car.gold then color = "#FACC15" end
    let b = create_block({name: "Scrap", shape: random(["box", "box", "cylinder", "sphere"]), position: car.center + {x: 0, y: 1.2, z: 0},
                          size: {x: 0.5 + random() * 0.4, y: 0.35, z: 0.5 + random() * 0.4}, color: color, material: "metal",
                          behavior: "trigger", solid: false, tags: ["scrap"]})
    b.move_to(bin + {x: random(-40, 40) / 10, y: 0.3, z: random(-30, 30) / 10}, 0.6)
    scrap_info[b.id] = {owner: owner_id, value: each, until: time() + SCRAP_LIFE}
  end
end

func collect_scrap(p, b)
  let info = scrap_info[b.id]
  if info == nil then return end
  if info.owner != p.id then
    if quiet_ready(p, "not_mine", 3) then p.message("これはほかの人のスクラップ", 1) end
    return
  end
  remove(scrap_info, b.id)
  gone(b)
  kit_give(p, floor(info.value))
  p.total = p.total + info.value
  p.scraps = p.scraps + 1
  kit_quest_progress(p, "scrap", 1)
end

-- 時間切れのスクラップは持ち主に半分
func scrap_expire()
  for id in keys(scrap_info) do
    let info = scrap_info[id]
    if time() >= info.until then
      remove(scrap_info, id)
      let owner = player_by_id(info.owner)
      if owner != nil then
        kit_give(owner, floor(info.value / 2))
        owner.total = owner.total + info.value / 2
      end
      for b in blocks("scrap") do
        if b.id == id then gone(b) end
      end
    end
  end
end

-- 磁石: 近くの自分のスクラップを吸いよせる
func magnet_step(p)
  let r = magnet_radius(p)
  if r <= 0 then return end
  for b in blocks("scrap") do
    let info = scrap_info[b.id]
    if info != nil and info.owner == p.id and distance(p, b) <= r then collect_scrap(p, b) end
  end
end
