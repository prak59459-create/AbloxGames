-- Infinite Store — 終わりのない家具店。昼は家具で基地を作り、夜は店員から守る。7日目に閉店…出口へ。
--
-- ファイル:
--   data.absc    家具・売り場・武器・食べ物・サービス・夜ごとの店員
--   common.absc  日と夜の状態・画面
--   build.absc   家具を拾う・置く・回す・こわれる
--   staff.absc   夜の店員と店長・ホイッスル
--   store.absc   昼と夜・食べ物・武器の箱・落とし物・サービスカウンター・閉店と出口
--   main.absc    このファイル

kit_setup("Infinite Store", "家具で基地を作って、7日目の閉店まで生きのびろ", [
  "☀️ 昼: 家具にさわって ✋ で拾い（タップでも）、🪑 で目の前に置く。↻ で回す",
  "🌙 夜: 店員が追ってくる。家具でかこんだ基地にこもろう。店員は家具をたたいてこわす",
  "🍽 おなかがへる。フードコートや売り場の食べ物を食べよう",
  "🗡 紫の箱には強い武器。💛 落とし物はフードコートの落とし物センターへ",
  "🛎 サービスカウンターでカート・ベスト・ホイッスルなど。3日目と6日目は店長が来る",
  "🚪 7日目の朝、閉店のアナウンス。緑の光の柱の出口へ走れ！"
])

for w in WEAPONS do kit_melee(w.id, w.damage, w.rate, w.reach) end

kit_currency = "クーポン"
kit_shop_title = "服"
kit_shop_add("apron", "🟦 店員のエプロン", 60, func(p)
  p.color = "#1D4ED8"
  p.leg_color = "#FACC15"
end)
kit_shop_add("cap", "🧢 キャップ", 40, func(p) p.hat = "cap" end)
kit_shop_add("crown", "👑 家具の王", 400, func(p) p.hat = "crown" end)

kit_quest("collect", "家具を20こ拾う", 20, 100)
kit_quest("place", "家具を20こ置く", 20, 120)
kit_quest("fight", "店員を10人たおす", 10, 200)
kit_quest("eat", "食べ物を10こ食べる", 10, 80)
kit_quest("weapon", "強い武器を見つける", 1, 60)
kit_quest("lost", "落とし物をとどける", 1, 80)
kit_quest("service", "サービスを2つ使う", 2, 80)
kit_quest("nights", "夜を3回生きのびる", 3, 250)
kit_quest("escape", "出口から出る", 1, 500)

on start()
  game.respawn_time = 12
  start_day()
  every(10, func() kit_leaderboard("🪑") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 20)
  p.bag = []
  p.hunger = 100
  p.services = {}
  p.weapon_name = "バット"
  p.lost_item = false
  p.escaped = false
  p.give("バット")
  p.ui_button("grab", "✋ 拾う", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#16A34A"})
  p.ui_button("place", "🪑 置く", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#2563EB"})
  p.ui_button("turn", "↻ 回す", {at: "right", dy: 0, w: 150, h: 44, size: 15, bg: "#475569"})
  hud(p)
  clock_hud()
end

on respawn(p)
  if p.is_npc or not ready(p) then return end
  p.teleport(block("Spawn " + random(1, 10)).position + {x: 0, y: 1, z: 0})
  p.give(p.weapon_name)
  p.hunger = max(p.hunger, 40)
  if has_service(p, "sneakers") then p.speed = 1.15 end
  hud(p)
end
