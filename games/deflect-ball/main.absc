-- Deflect Ball — 追いかけてくるボールを「はじく」で打ち返す
-- モード投票（ノーマル・ダブル・チーム戦・ハイスピード）→ ラウンド。最後まで残った人（チーム）の勝ち。
-- 技は1つ持っていける。剣はガチャで集める見た目。レーティングでランクが上がる。
--
-- ファイル:
--   data.absc       表（技8・剣9・モード4・ランク）
--   common.absc     小さな道具・画面の左上
--   ball.absc       ボール（ねらい・はじく・当たる）
--   round.absc      投票・ラウンド・勝ち負け
--   abilities.absc  技
--   shop.absc       技のお店・剣のガチャ
--   stats.absc      成績
--   main.absc       このファイル

kit_setup("Deflect Ball", "ギリギリで、はじけ！", [
  "⚠ ボールが赤く光って「ねらわれている」が出たら、あなたの番",
  "🔴 近づいたら「はじく」！見ている方向の相手に飛んでいく",
  "⏱ 早すぎると空ぶり（少し押せなくなる）。はじくたびにボールは速くなる",
  "💥 当たったらアウト。最後の1人（チーム）の勝ち",
  "🗳 ラウンドの前にモード投票: ノーマル・ダブル・チーム戦・ハイスピード",
  "✨ ロビーの青いパッドで技、🗡 オレンジのパッドで剣のガチャ"
])

kit_quest("win1", "1回勝つ", 1, 200)
kit_quest("win10", "10回勝つ", 10, 1000)
kit_quest("parry20", "20回はじく", 20, 150)
kit_quest("parry200", "200回はじく", 200, 800)
kit_quest("parry_fast", "時速150km以上ではじく", 1, 400)
kit_quest("elim", "5人たおす", 5, 300)
kit_quest("ability", "技を10回使う", 10, 200)
kit_quest("buy", "新しい技を買う", 1, 100)
kit_quest("crate", "剣のガチャを5回", 5, 200)

on start()
  game.respawn_time = -1
  after(2, func() start_vote() end)
  every(10, func() kit_leaderboard("🏆") end)
end

on join(p)
  kit_welcome(p)
  p.owned = ["dash"]
  p.ability = "dash"
  p.blades = ["wood"]
  p.rating = 1000
  p.in_round = false
  p.own_body = p.color
  equip_blade(p, "wood")
  kit_show_money(p)
  kit_shop_button(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.ui_button("parry", "はじく", {at: "bottom_right", dx: -110, dy: -160, w: 110, h: 90, size: 22, bg: "#DC2626", radius: 45})
  p.ui_button("abilities", "✨ 技", {at: "right", dy: -60, w: 130, h: 46, size: 16, bg: "#0369A1"})
  p.ui_button("blades", "🗡 剣", {at: "right", dy: 0, w: 130, h: 46, size: 16, bg: "#B45309"})
  p.ui_button("stats", "📊", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  ability_button(p)
  hud(p)
  if phase == "round" then
    p.teleport(lobby_spot())
    p.message("ラウンド中！ 次のラウンドから参加", 2)
  elif phase == "vote" then
    vote_ui(p)
  end
end

on leave(p)
  for b in balls do
    if b.target == p.id then mark_target(b, random_target(p)) end
  end
end
