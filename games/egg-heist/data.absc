let EGG_ICON = ["🥚", "🟢", "🔵", "🟣", "🔴", "🌈", "🌌", "❓"]

let BASES = [{x: -44, side: 1}, {x: 0, side: 1}, {x: 44, side: 1}, {x: -44, side: -1}, {x: 0, side: -1}, {x: 44, side: -1}]
let PEDESTALS = 10
let START_SLOTS = 4
let LOCK_SECS = 60          -- 🔒 ロックの長さ（生まれかわると +10秒）
let CARRY_SECS = 40         -- ぬすんだたまごを もっていられる 秒
let ROAD_EVERY = 2.5        -- たまごが 道に出てくる 秒
let ROAD_SPEED = 3.5
let THIEF_EVERY = 70        -- アライグマどろぼうが来る 秒
let REBIRTH_COST = 500000   -- × (生まれかわり回数 + 1)

func slot_price(n)
  return floor(200 * pow(4, n - START_SLOTS))
end
