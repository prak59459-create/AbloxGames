-- Power Training Sim — 4つの能力を修行できたえる育成バトル
-- 力・気・速さ・耐久。修行場（3段階）で倍率アップ、集中ボーナス、自動修行。
-- 能力で技をおぼえ、仲間ガチャで倍率、転生で永久強化。闘技場でロボ・ボス・PvP。
--
-- ファイル:
--   data.absc       表（能力・修行場12・ランク・技9・仲間11・転生ショップ・敵）
--   common.absc     計算と画面
--   train.absc      修行・修行場・集中・自動修行
--   abilities.absc  技
--   champions.absc  仲間ガチャ
--   rebirth.absc    転生と転生ショップ・技の巻物
--   enemies.absc    ロボ・山賊・ボス・宝箱・闘技場のPvP
--   main.absc       このファイル

kit_setup("Power Training Sim", "修行してランクを上げ、最強をめざせ", [
  "下の4つのボタンで修行: 💪力 🔮気 👟速さ 🛡耐久（すばやく10回で🔥集中）",
  "修行場（色つきの広場）に立つとその能力が ×5・×30・×150",
  "奥の修行場は、その能力が足りないとはじき出される",
  "力はパンチ、気は技、速さは走る速さ、耐久は体力。技は能力でおぼえる",
  "🥋 道場の金色のパッドで仲間ガチャ。🔱 むらさきのパッドで転生",
  "⚔ 闘技場ではロボ・ボス・プレイヤーと戦える（外では平和）",
  "🎁 ときどき修行の宝箱。🛒 で重りや自動修行"
])
kit_melee("拳", 5, 3, 5)
kit_shop_add("weights", "重り（修行 ×2）", 300, func(p)
  p.train_mult = p.train_mult * 2
  p.message("🏋 修行効率 ×" + p.train_mult, 2)
end)
kit_shop_add("weights2", "黄金の重り（修行 ×3）", 20000, func(p)
  p.train_mult = p.train_mult * 3
  p.message("🏋 修行効率 ×" + p.train_mult, 2)
end)
kit_shop_add("auto", "自動修行（えらんだ能力を自動で）", 2000, func(p) p.auto = true end)
kit_shop_add("potion", "回復薬（全回復）", 100, func(p) p.heal(p.max_health) end)

kit_quest("t100", "100回修行する", 100, 100)
kit_quest("t1000", "1000回修行する", 1000, 1000)
kit_quest("zone2", "2段目の修行場に入る", 1, 500)
kit_quest("zone3", "3段目の修行場に入る", 1, 10000)
kit_quest("robot", "修行ロボを10体たおす", 10, 300)
kit_quest("bandit", "山賊を5人たおす", 5, 2000)
kit_quest("rankb", "ランクBになる", 1, 2000)
kit_quest("ranks", "ランクSになる", 1, 50000)
kit_quest("boss", "ボスをたおす", 1, 3000)
kit_quest("gacha", "仲間ガチャを10回", 10, 1500)
kit_quest("ability", "技を3つおぼえる", 3, 1000)
kit_quest("use", "技を50回使う", 50, 500)
kit_quest("rebirth", "転生する", 1, 20000)
kit_quest("chest", "宝箱を開ける", 1, 500)
kit_quest("pvp", "闘技場でプレイヤーに勝つ", 1, 300)

on start()
  setup_enemies()
  every(10, func() kit_leaderboard("💪 合計") end)
end

on join(p)
  kit_welcome(p)
  p.stats = {strength: 1, chakra: 1, speed: 1, durability: 1}
  p.train_mult = 1
  p.trains = 0
  p.combo = 0
  p.rebirths = 0
  p.tokens = 0
  p.rshop = {}
  p.champions = []
  p.abilities = []
  p.give("拳")
  kit_give(p, 50)
  kit_shop_button(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.ui_button("champions", "🥋 仲間", {at: "right", dy: 0, w: 140, h: 48, size: 16, bg: "#B45309"})
  p.ui_button("rebirth", "🔱 転生", {at: "right", dy: 60, w: 140, h: 48, size: 16, bg: "#7C3AED"})
  train_buttons(p)
  unlock_abilities(p)
  apply_stats(p)
  check_rank(p)
  show(p)
end
