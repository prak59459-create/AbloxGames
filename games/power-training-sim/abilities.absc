-- abilities.absc — 技（能力が足りると使えるようになる。画面右下のボタン）

func ability_info(id)
  for a in ABILITIES do
    if a.id == id then return a end
  end
  return nil
end

func unlock_abilities(p)
  for a in ABILITIES do
    if not contains(p.abilities, a.id) and p.stats[a.stat] >= a.need then
      append(p.abilities, a.id)
      if a.need > 0 then
        p.message("✨ 新しい技「" + a.name + "」をおぼえた！", 2.5)
        kit_quest_progress(p, "ability", 1)
      end
    end
  end
  ability_buttons(p)
end

func ability_buttons(p)
  let i = 0
  for id in p.abilities do
    i = i + 1
    let a = ability_info(id)
    let st = stat_info(a.stat)
    p.ui_button("ab_" + id, a.name, {at: "bottom_right", dx: -110 - ((i - 1) % 3) * 112, dy: -150 - floor((i - 1) / 3) * 60,
                                     w: 106, h: 52, size: 13, bg: st.color, radius: 14})
  end
end

func power_of(p, stat, base, scale)
  return base + sqrt(p.stats[stat]) * scale
end

func use_ability(p, id)
  if not p.alive or not contains(p.abilities, id) then return end
  let a = ability_info(id)
  if not kit_ready(p, "ab_" + id, a.cd) then return end
  kit_quest_progress(p, "use", 1)
  if id == "quake" then
    kit_blast(p, p.position, 7, power_of(p, "strength", 20, 3), 14)
    p.shake(0.3, 0.4)
  elif id == "meteor" then
    for k in 1 to 6 do
      kit_later(p, k * 0.12, func() kit_blast(p, kit_ahead(p, 4), 3.5, power_of(p, "strength", 15, 2), 3) end)
    end
  elif id == "blast" then
    kit_blast(p, kit_ahead(p, 6), 5, power_of(p, "chakra", 10, 3), 5)
    p.shake(0.2, 0.3)
  elif id == "barrage" then
    for k in 1 to 5 do
      kit_later(p, k * 0.2, func() kit_blast(p, kit_ahead(p, 8 + k), 3, power_of(p, "chakra", 10, 2), 2) end)
    end
  elif id == "cannon" then
    for k in 1 to 8 do kit_blast(p, kit_ahead(p, k * 4), 3.5, power_of(p, "chakra", 50, 5), 6) end
    announce("🌟 " + p.name + " の超気功砲！", 2)
    shake(0.5, 0.6)
  elif id == "dash" then
    p.teleport(kit_ahead(p, 14) + {x: 0, y: 0.5, z: 0})
  elif id == "afterimage" then
    p.visible = false
    kit_later(p, 2, func() p.visible = true end)
  elif id == "iron" then
    p.iron_until = time() + 5
    p.message("🛡 鉄壁！", 1)
  elif id == "regen" then
    p.heal(p.max_health * 0.6)
    p.message("💚 再生！", 1)
  end
end

on button(p, id)
  if starts_with(id, "ab_") then use_ability(p, replace(id, "ab_", "")) end
end
