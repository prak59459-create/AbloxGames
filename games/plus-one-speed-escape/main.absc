-- +1 Speed Wall Escape — 1秒ごとにスピード+1。ラウンドごとに巨大なかべから逃げて、1500m先のゴールへ
--
-- ファイル:
--   data.absc    ゾーン・スピード強化・トレッドミル・たまごとペット
--   common.absc  スピードの計算・画面
--   round.absc   ラウンド・かべ・ゾーンのごほうび・ゴール
--   train.absc   スピード・トレッドミル・強化・ペット・転生・コースのしかけ
--   main.absc    このファイル

kit_setup("+1 Speed Wall Escape", "毎秒スピード+1！ かべから逃げきれ", [
  "⚡ 1秒ごとにスピードがふえて、どんどん速く走れる（最大10倍）",
  "🏁 ラウンドが始まるとスタートへ。うしろから巨大なかべがせまってくる",
  "🧱 かべにつかまるか、落ちたらロビーにもどる。ゾーンを越えるたびにコイン",
  "🏆 1500m先のゴールまで逃げきると大きな賞金",
  "🏃 ロビーのトレッドミルにのると、スピードのふえ方が何倍にも",
  "🥚 たまごからペット（ふえ方×）。⚡ 強化で +/秒 アップ",
  "♻️ スピードがたまったら転生。ふえ方がずっと ×1.5"
])
kit_currency = "コイン"

kit_quest("far500", "500m 逃げる", 1, 300)
kit_quest("far1000", "1000m 逃げる", 1, 1500)
kit_quest("finish", "ゴールする", 1, 3000)
kit_quest("speed1000", "スピード1000", 1, 300)
kit_quest("speed100k", "スピード10万", 1, 20000)
kit_quest("gain", "スピード強化を3回買う", 3, 1000)
kit_quest("pets", "たまごを5こかえす", 5, 1500)
kit_quest("rebirth", "転生する", 1, 2000)

on start()
  every(10, func() kit_leaderboard("🏃 最高m") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.spd = 0
  p.per_sec = 1
  p.rebirths = 0
  p.best = 0
  p.run_best = 0
  p.wins = 0
  p.pets = []
  p.treadmill = 0
  p.running = false
  p.zone = 0
  kit_give(p, 30)
  p.ui_button("open_gains", "⚡ 強化", {at: "right", dy: -40, w: 130, h: 44, size: 15, bg: "#2563EB"})
  p.ui_button("open_eggs", "🥚 たまご", {at: "right", dy: 10, w: 130, h: 44, size: 15, bg: "#A16207"})
  hud(p)
  if phase == "run" then p.message("🏁 いまラウンド中。次のラウンドまでロビーで準備しよう", 3) end
end
