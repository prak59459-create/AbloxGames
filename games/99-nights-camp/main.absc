-- 99 Nights Camp — 森で99日生きのびるサバイバル
-- 職業5つ・材料8種・作業台（レベル5）とたき火（レベル4）・14の作れるもの・おなかとあたたかさ・
-- 夜の怪物（オオカミ・アルファ・教団）・昼のクマ・影のシカ・森の王・迷子の救出・宝箱。
--
-- ファイル:
--   data.absc      表（職業・材料・作れるもの・怪物・宝箱）
--   common.absc    人さがし・画面・持ち物
--   survival.absc  昼と夜・たき火・おなか・あたたかさ・全滅
--   gather.absc    木・岩・茂み・鉄くず・宝箱・なべ
--   craft.absc     作業台・レベルアップ・置くもの・使うもの
--   monsters.absc  怪物・影のシカ・森の王
--   kids.absc      迷子の子どもたち
--   classes.absc   職業と特技
--   main.absc      このファイル

kit_setup("99 Nights Camp", "たき火を守って、99日生きのびろ", [
  "🌲 木をタップして切る → 🔥 たき火にさわって木材をくべる",
  "🌙 夜は怪物が来る！たき火の光の中はあたたかい（外は寒い）",
  "🍖 おなかがへったら 🍽 で食べる。ベリーの茂み・肉をなべで焼く",
  "🔨 黄色いパッドの作業台で オノ・やり・ランタン・コート・わな・さく・ベッド",
  "🦌 影のシカはたおせない。ランタンで照らすと止まる",
  "🧒 森の4か所に迷子。近づくとついてくる → たき火まで連れて帰ろう",
  "🌲 10日ごとに森の王。全員たおれると1日目からやり直し"
])
kit_currency = "コイン"

kit_quest("chop", "木を10本切る", 10, 30)
kit_quest("fuel", "たき火に木材を30こ", 30, 60)
kit_quest("eat", "5回食べる", 5, 30)
kit_quest("cook", "料理を3回", 3, 40)
kit_quest("craft", "何かを作る", 1, 30)
kit_quest("bench", "作業台をレベルアップ", 1, 80)
kit_quest("firelv", "たき火をレベルアップ", 1, 80)
kit_quest("hunt", "怪物を20体たおす", 20, 150)
kit_quest("bear", "クマをたおす", 1, 100)
kit_quest("deer", "影のシカを照らす", 1, 80)
kit_quest("chest", "宝箱を3つ開ける", 3, 60)
kit_quest("rescue", "迷子を助ける", 1, 150)
kit_quest("allkids", "迷子を全員助ける", 1, 500)
kit_quest("king", "森の王をたおす", 1, 500)
kit_quest("day10", "10日生きのびる", 10, 200)
kit_quest("day30", "30日生きのびる", 30, 1000)
kit_quest("win", "99日生きのびる", 1, 10000)
kit_quest("ability", "特技を使う", 3, 30)

func reset_player(p)
  p.inv = {wood: 0}
  p.axe = 1
  p.gear = []
  p.uses = []
  p.hunger = 100
  p.warmth = 100
  p.charm_used = false
  p.max_health = 100
  p.heal(100)
  p.give("こんぼう")
  inv_line(p)
end

on join(p)
  reset_player(p)
  kit_welcome(p)
  p.ui_button("eat", "🍽 食べる", {at: "right", dy: -60, w: 140, h: 50, size: 17, bg: "#B45309"})
  kit_quest_button(p)
  kit_camera_button(p)
  kit_later(p, 4.5, func()
    if p.cls == nil then class_menu(p) end
  end)
end

on start()
  -- やり直しのときは持ち物もリセット
  for p in players() do
    reset_player(p)
    if p.cls == "hunter" then p.give("木のやり") end
  end
  every(10, func() kit_leaderboard("🌙 生きのびた日") end)
end
