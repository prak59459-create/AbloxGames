-- Pet Home Paradise — ペットを育てるゲーム
-- たまご5種類・ペット27種類・年れい6段階・お願い10種類・ネオン・トレード・ペットショー。
--
-- ファイル:
--   data.absc    表（たまご・ペット・年れい・お願い・ごはん・おもちゃ・薬・トリック・イベント）
--   common.absc  人さがし・画面・お金・待ち時間
--   pets.absc    ペット帳・連れて歩く・お願い・成長・かえる・名前・トリック・乗る/飛ぶ・ネオン
--   shop.absc    ナーサリー・ペットショップ・🎒持ち物・ボーナス
--   trade.absc   トレード
--   town.absc    ペットショー・イベント・昼と夜・ランキング
--   main.absc    このファイル（はじめの準備とクエスト）

kit_setup("Pet Home Paradise", "たまごをかえして、ペットをおとなまで育てよう", [
  "🥚 ナーサリー（ピンクの建物）でたまごを買う。お願いを4回かなえるとかえる",
  "🐾 ペットのお願い（🍖💧💤…）の場所へ行って、しばらくそばにいよう",
  "💰 お世話するとバックス。ペットは赤ちゃん → おとなに育つ",
  "🎒 ごはんやおもちゃで、その場でお願いをかなえられる",
  "✨ おとな4ひきで ネオン、ネオン4ひきで メガネオン（紫の洞くつ）",
  "🤝 トレードでほかの人とペットを交換（⚖️で価値をくらべよう）",
  "🏆 4分ごとにペットショー。ステージに出場してみんなで投票",
  "🧪 薬でペットが飛んだり乗れたりする"
])
kit_currency = "バックス"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["pets", "equipped", "items", "toys", "dex"])


-- MARK: クエスト

kit_quest("egg", "たまごを買う", 1, 100)
kit_quest("hatch", "たまごをかえす", 1, 150)
kit_quest("care", "お世話を20回", 20, 300)
kit_quest("care100", "お世話を100回", 100, 1500)
kit_quest("grown", "ペットをおとなに育てる", 1, 800)
kit_quest("dex", "5しゅるいのペットに会う", 5, 1000)
kit_quest("legend", "ウルトラレア以上をかえす", 1, 1500)
kit_quest("neon", "ネオンを作る", 1, 3000)
kit_quest("trick", "トリックを10回", 10, 200)
kit_quest("shop", "お店で5回買い物", 5, 150)
kit_quest("potion", "薬を使う", 1, 300)
kit_quest("trade", "トレードする", 1, 300)
kit_quest("show", "ペットショーに出る", 1, 200)
kit_quest("showwin", "ペットショーで優勝", 1, 1000)

-- MARK: 入ってきた人

on join(p)
  p.pets = []
  p.equipped = []
  p.items = {apple: 2, juice: 2}
  p.toys = []
  p.dex = []
  kit_welcome(p)
  kit_give(p, 750)
  -- はじめてのたまごはプレゼント
  let egg = new_pet("egg", "basic")
  add_pet(p, egg)
  p.ui_button("open_book", "🐾 ペット帳", {at: "right", dy: -180, w: 160, h: 50, size: 17, bg: "#DB2777"})
  p.ui_button("open_bag", "🎒 持ち物", {at: "right", dy: -120, w: 160, h: 50, size: 17, bg: "#334155"})
  p.ui_button("open_tricks", "🎾 トリック", {at: "right", dy: -60, w: 160, h: 50, size: 17, bg: "#7E22CE"})
  p.ui_button("open_trade", "🤝 トレード", {at: "right", dy: 0, w: 160, h: 50, size: 17, bg: "#A16207"})
  p.ui_button("bonus", "🎁 ボーナス", {at: "right", dy: 60, w: 160, h: 50, size: 17, bg: "#15803D"})
  kit_quest_button(p)
  kit_camera_button(p)
  kit_later(p, 4.5, func() p.message("🥚 はじめてのたまごをプレゼント！お願いをかなえて かえそう", 3) end)
  hud(p)
end

on chat(p, text)
  if text == "/pets" then book(p) end
  if text == "/trade" then trade_pick(p) end
end
