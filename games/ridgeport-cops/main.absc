-- Ridgeport Cops & Robbers — 警察と強盗の街アクション
-- 強盗: ガソリンスタンド・銃砲店・宝石店（宝石5つ）・銀行（暗証番号）・現金輸送車 → アジトで山分け
-- 警察: テーザーでしびれさせて手錠。無線で手配⭐を追う。懸賞金。刑務所・脱獄・保釈。
-- どちらも階級（警察は逮捕数、強盗は山分けした合計）で武器が買える。車・バッグ。
--
-- ファイル:
--   data.absc     表（金庫・バッグ・階級・武器・車）
--   common.absc   小さな道具・階級・画面の左上
--   robbery.absc  強盗（金庫・宝石・銀行・輸送車・山分け）
--   police.absc   テーザー・逮捕・無線・刑務所・脱獄・保釈
--   gear.absc     武器庫・ブラックマーケット・車庫・バッグ
--   main.absc     このファイル

kit_setup("Ridgeport Cops & Robbers", "ぬすむか、つかまえるか", [
  "広場の青いパッドで警察、赤いパッドで強盗になる",
  "🦹 金庫・宝石・銀行（光った数字を順に押す）・現金輸送車 → アジトの緑のパッドで山分け",
  "🦹 バッグには上限がある。つかまると中身は没収！ 手配⭐は時間でへる",
  "👮 ⚡テーザーで撃つとしびれる → 近くで「🔗 逮捕」。📻 無線で手配⭐を追え",
  "🚔 刑務所: 「🔓 脱獄」連打 → 黄色いパッドへ。保釈金でも出られる",
  "🎖 階級が上がると強い武器。🚗 車庫で車、🎒 ブラックマーケットでバッグ"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["arrests", "loot_total", "bag", "gun_tier", "guns_police", "guns_crime", "cars"])

kit_quest("rob_any", "金庫をやぶる", 1, 100)
kit_quest("stash", "3回山分けする", 3, 300)
kit_quest("jewels", "宝石を5つぬすむ", 5, 250)
kit_quest("keypad", "銀行の暗証番号をとく", 1, 200)
kit_quest("bank", "銀行の金庫をやぶる", 1, 500)
kit_quest("truck", "現金輸送車をおそう", 1, 400)
kit_quest("escape", "刑務所から脱獄", 1, 150)
kit_quest("jailed", "刑務所に入る（…）", 1, 20)
kit_quest("arrest", "警察: 1人逮捕", 1, 100)
kit_quest("arrest10", "警察: 10人逮捕", 10, 800)
kit_quest("most_wanted", "警察: 手配⭐4以上を逮捕", 1, 400)
kit_quest("rank", "階級を上げる", 1, 200)
kit_quest("gun", "武器を買う", 1, 100)
kit_quest("car", "車を買う", 1, 100)

func set_team(p, team)
  if active_until(p.jailed_until) then return end
  p.team = team
  p.loot = 0
  p.wanted = 0
  p.rob = nil
  p.car = nil
  p.driving = false
  apply_car(p)
  p.take()
  if team == "police" then
    p.color = "#1E3A8A"
    p.hat = "cap"
    let s = block("Police Spawn " + random(1, 6))
    if s != nil then p.teleport(s) end
    p.ui_button("cuff", "🔗 逮捕", {at: "bottom_right", dx: -120, dy: -160, w: 120, h: 60, size: 17, bg: "#1D4ED8", radius: 16})
  else
    p.color = "#44403C"
    p.hat = "none"
    let s = block("Criminal Spawn " + random(1, 6))
    if s != nil then p.teleport(s) end
    p.ui_remove("cuff")
  end
  give_loadout(p)
  p.message(rank_name(p) + " として出動！", 2)
  hud(p)
end

on start()
  every(10, func() kit_leaderboard("💰") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_camera_button(p)
  p.arrests = 0
  p.loot = 0
  p.loot_total = 0
  p.wanted = 0
  p.bag = 1
  p.gun_tier = 1
  p.guns_police = ["taser"]
  p.guns_crime = ["crook_pistol"]
  p.cars = ["patrol", "sedan"]
  kit_give(p, 100)
  p.ui_button("drive", "🚗 のる/おりる", {at: "right", dy: 0, w: 150, h: 46, size: 15, bg: "#0EA5E9"})
  hud(p)
end

on touch(p, b)
  if p.is_npc or not ready(p) then return end
  if contains(b.tags, "team") then
    let t = "criminal"
    if b.name == "Team Police" then t = "police" end
    if p.team != t and quiet_ready(p, "team_pad", 2) then set_team(p, t) end
  end
end
