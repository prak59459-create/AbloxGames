-- common.absc — 小さな道具・画面の左上・階級

func ready(p)
  return p.arrests != nil
end

func active_until(v)
  return v != nil and v > time()
end

func still(x)
  return x != nil and x.destroy != nil
end

func gone(x)
  if still(x) then x.destroy() end
end

func quiet_ready(p, key, seconds)
  if p.cds == nil then p.cds = {} end
  let last = p.cds[key]
  if last != nil and time() - last < seconds then return false end
  p.cds[key] = time()
  return true
end

func player_by_id(id)
  for p in players() do
    if p.id == id then return p end
  end
  return nil
end

func fx_ball(pos, size, color, seconds)
  let b = create_block({name: "FX", shape: "sphere", position: pos, size: size, color: color, material: "neon", solid: false, opacity: 0.55})
  after(seconds or 0.5, func() gone(b) end)
  return b
end

func rank_index(p)
  let list = CRIME_RANKS
  let v = p.loot_total
  if p.team == "police" then
    list = POLICE_RANKS
    v = p.arrests
  end
  let idx = 1
  let i = 0
  for r in list do
    i = i + 1
    if v >= r.need then idx = i end
  end
  return idx
end

func rank_name(p)
  if p.team == "police" then return POLICE_RANKS[rank_index(p)].name end
  if p.team == "criminal" then return CRIME_RANKS[rank_index(p)].name end
  return ""
end

func bag_cap(p)
  return BAGS[p.bag].cap
end

func cops()
  return filter(players(), func(p) return ready(p) and p.team == "police" end)
end

func crooks()
  return filter(players(), func(p) return ready(p) and p.team == "criminal" end)
end

func hud(p)
  if not ready(p) then return end
  if p.team == "police" then
    p.ui_text("hud", "👮 " + rank_name(p) + "   逮捕 " + p.arrests, {at: "top_left", dy: 34, size: 16, bold: true, color: "#93C5FD"})
    p.ui_remove("hud2")
  elif p.team == "criminal" then
    let stars = ""
    for i in 1 to 5 do
      if i <= p.wanted then stars = stars + "⭐" end
    end
    if stars == "" then stars = "なし" end
    p.ui_text("hud", "🦹 " + rank_name(p) + "   手配 " + stars, {at: "top_left", dy: 34, size: 16, bold: true, color: "#FCA5A5"})
    p.ui_text("hud2", "💰 バッグ " + p.loot + " / " + bag_cap(p) + "（アジトの緑のパッドで山分け）", {at: "top_left", dy: 56, size: 13, bold: true, color: "#FDE68A"})
  else
    p.ui_text("hud", "広場のパッドでチームを選ぼう（青: 警察 / 赤: 強盗）", {at: "top_left", dy: 34, size: 15})
  end
end
