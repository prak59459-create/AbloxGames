-- npcs.absc — 影分身・道場の人形・特級呪霊（ボス）

let dummies = []
let boss = nil
let boss_next = 0
let npc_clock = 0

-- MARK: 影分身

func spawn_clones(p)
  for k in 1 to 2 do
    let clone = create_npc({name: p.name + "の影", position: p.position + {x: k * 2 - 3, y: 0.5, z: 0}, color: "#111827",
                            head_color: "#111827", health: 40, speed: 1.3})
    clone.owner_id = p.id
    clone.clone = true
    after(8, func() kit_gone(clone) end)
  end
end

func run_clones(dt)
  for n in npcs() do
    if n.clone and n.alive then
      let owner = find_by_id(n.owner_id)
      if owner == nil then
        kit_gone(n)
      else
        let target = nil
        for c in foes(owner) do
          if not c.clone and (target == nil or distance(n, c) < distance(n, target)) then target = c end
        end
        if target != nil and distance(n, target) < 30 then
          n.follow(target)
          if distance(n, target) < 2.2 then deal(owner, target, 14 * dt, 0) end
        else
          n.follow(owner)
        end
      end
    end
  end
end

-- MARK: 道場の人形（動かない・たおれても3びょうでもどる）

func spawn_dummy(i)
  let spot = block("Dummy Spot " + i)
  if spot == nil then return end
  let n = create_npc({name: "🎯 練習人形", position: spot.position + {x: 0, y: 1, z: 0}, color: "#D6D3D1", head_color: "#A8A29E",
                      health: 400, speed: 0, team: "dummy"})
  n.frozen = true
  n.dummy = true
  n.spot = i
end

-- MARK: 特級呪霊

func spawn_boss()
  let spot = block("Boss Spot 1")
  if spot == nil then return end
  let hp = 2500 + 900 * len(players())
  boss = create_npc({name: "👹 特級呪霊", position: spot.position + {x: 0, y: 2, z: 0}, color: "#1E1B4B", head_color: "#DC2626",
                     size: 3.2, health: hp, speed: 0.7, team: "curse"})
  boss.boss = true
  boss.hits = {}
  boss.max_hp = hp
  boss.slam_at = time() + 4
  announce("👹 特級呪霊があらわれた！ たおすと呪力ポイント！", 4)
  shake(0.6, 1)
end

func boss_bar()
  if boss == nil or not still(boss) then return end
  for p in players() do
    p.ui_bar("boss_hp", {at: "top", dy: 64, w: 360, h: 16, value: max(0, boss.health), max: boss.max_hp, color: "#DC2626", bg: "#00000099"})
    p.ui_text("boss_name", "👹 特級呪霊", {at: "top", dy: 84, size: 14, bold: true, color: "#FCA5A5"})
  end
end

func clear_boss_bar()
  for p in players() do
    p.ui_remove("boss_hp")
    p.ui_remove("boss_name")
  end
end

func run_boss(dt)
  if boss == nil then return end
  if not still(boss) or not boss.alive then
    boss = nil
    clear_boss_bar()
    return
  end
  let target = kit_nearest_player(boss)
  if target != nil then
    boss.follow(target)
    if distance(boss, target) < 3.5 then target.damage(20 * dt, boss) end
  end
  if time() >= boss.slam_at then
    boss.slam_at = time() + 5
    flash(boss.position, 14, "#7F1D1D", 0.4)
    for p in players() do
      if p.alive and distance(p, boss) < 8 then
        p.damage(defense(p, 22), boss)
        if kit_here(p) and p.alive then p.launch(0, 12, 0) end
      end
    end
  end
  boss_bar()
end

func boss_reward(victim)
  let best = nil
  let best_dmg = 0
  for p in players() do
    let dmg = victim.hits[p.id] or 0
    if dmg > 0 then
      let got = 3 + floor(dmg / victim.max_hp * 20)
      p.points = (p.points or 0) + got
      p.message("👹 特級呪霊をたおした！ 呪力ポイント +" + got, 3)
      kit_quest_progress(p, "boss", 1)
      hud(p)
      if dmg > best_dmg then
        best_dmg = dmg
        best = p
      end
    end
  end
  if best != nil then
    best.points = best.points + 10
    announce("👹 特級呪霊をはらった！ MVP は " + best.name + "（ボーナス +10）", 4)
  end
  boss = nil
  clear_boss_bar()
end

-- MARK: たおれたNPC

func npc_died(victim, killer)
  if victim.dummy then
    let i = victim.spot
    after(3, func() spawn_dummy(i) end)
    if killer != nil and not killer.is_npc then kit_quest_progress(killer, "dummy", 1) end
  elif victim.boss then
    boss_reward(victim)
  end
end

func setup_npcs()
  for n in npcs() do kit_gone(n) end
  for i in 1 to 3 do spawn_dummy(i) end
  boss = nil
  boss_next = time() + 90
end

on tick(dt)
  npc_clock = npc_clock + dt
  if npc_clock < 0.25 then return end
  let passed = npc_clock
  npc_clock = 0
  run_clones(passed)
  run_boss(passed)
  if boss == nil and time() >= boss_next and len(players()) > 0 then
    boss_next = time() + BOSS_EVERY
    spawn_boss()
  end
end
