-- Domain Clash — 術をえらんで戦い、領域展開で決める
-- 8つの術（それぞれ4つの技と、ちがう領域）。拳で当てると 1/8 で黒閃。
-- ダメージを与えると呪力ゲージ → MAX で領域展開。かさなった領域は押し合い。
-- 3分ごとに特級呪霊。KO と特級呪霊で呪力ポイント → 新しい術と称号。
--
-- ファイル:
--   data.absc     表（術・技・領域・称号）
--   common.absc   小さな道具
--   combat.absc   ダメージ・ガード・黒閃・覚醒・KO
--   moves.absc    技（術ごとに4つ）
--   domain.absc   領域展開と押し合い
--   npcs.absc     影分身・道場の人形・特級呪霊
--   styles.absc   術をえらぶ・技のボタン
--   stats.absc    画面の左上・成績・称号
--   main.absc     このファイル

kit_setup("Domain Clash", "8つの術から1つを選んで戦おう", [
  "🔥⚡🌀🌑 はじめは4つの術。❄🩸🌸👊 は呪力ポイントで解放",
  "👊 ふつうのこうげきは拳。1/8 で「黒閃」— 2.5倍ダメージ",
  "✨ 右下の4つのボタンが技。🛡 ガードでダメージをへらす",
  "🌀 ダメージを与えると呪力ゲージ。MAXで領域展開（術ごとに効果がちがう）",
  "⚔ 領域がかさなると押し合い。連続KOが多いほど強い",
  "💢 体力が1/4を切ると1回だけ覚醒。👹 3分ごとに特級呪霊",
  "⛩ 鳥居の奥で術をかえる。🎯 道場で練習。🎖 称号の板"
])
kit_melee("拳", 9, 3.5, 5)

kit_quest("ko", "10人KOする", 10, 10)
kit_quest("streak", "5連続KO", 1, 20)
kit_quest("domain", "領域展開を3回", 3, 10)
kit_quest("clash", "領域の押し合いに勝つ", 1, 15)
kit_quest("black_flash", "黒閃を出す", 1, 10)
kit_quest("casts", "技を100回使う", 100, 10)
kit_quest("boss", "特級呪霊をたおす", 1, 20)
kit_quest("dummy", "練習人形をたおす", 1, 5)
kit_quest("awaken", "覚醒する", 1, 5)
kit_quest("unlock", "新しい術を解放", 1, 10)
kit_quest("title", "称号を手に入れる", 1, 5)

-- クエストのごほうびは呪力ポイントとして受けとる
kit_currency = "呪力ポイント"

let ui_clock = 0

on start()
  setup_npcs()
  every(8, func() kit_leaderboard("💥 KO") end)
end

on join(p)
  kit_welcome(p)
  p.meter = 0
  p.points = 0
  p.owned = ["fire", "thunder", "gravity", "shadow"]
  p.titles = ["none"]
  p.title = "none"
  p.give("拳")
  p.ui_button("open_styles", "⛩ 術", {at: "right", dy: -60, w: 130, h: 48, size: 16, bg: "#6D28D9"})
  p.ui_button("stats", "📊", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  kit_quest_button(p)
  kit_camera_button(p)
  style_menu(p)
  show_meter(p)
  hud(p)
end

on leave(p)
  let d = domain_of(p.id)
  if d != nil then collapse(d, "") end
  for n in npcs() do
    if n.owner_id == p.id then kit_gone(n) end
  end
end

on tick(dt)
  ui_clock = ui_clock + dt
  if ui_clock < 0.5 then return end
  ui_clock = 0
  for p in players() do
    if ready(p) then
      cooldown_labels(p)
      -- クエストのごほうび（kit のコイン）を呪力ポイントへ
      if (p.coins or 0) > 0 then
        p.points = (p.points or 0) + p.coins
        p.coins = 0
        hud(p)
      end
    end
  end
end
