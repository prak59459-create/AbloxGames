-- stats.absc — 画面の左上・成績・称号

func hud(p)
  if not ready(p) then return end
  let style = "（術をえらぼう）"
  if p.style != nil then style = style_info(p.style).name end
  p.ui_text("hud", title_of(p) + style + "   💥 " + (p.kos or 0) + " KO   🔥 " + (p.streak or 0) + " 連続   🔮 " + (p.points or 0),
            {at: "top_left", dy: 34, size: 15, bold: true, color: "#E9D5FF"})
end

func stats(p)
  let lines = [
    "💥 KO " + (p.kos or 0) + "   💀 やられた " + (p.deaths or 0) + "   🔥 最高連続 " + (p.best_streak or 0),
    "⚔ 与えたダメージ " + kit_short(floor(p.dmg or 0)) + "   ✨ 技 " + (p.casts or 0) + " 回",
    "🌀 領域展開 " + (p.domains_used or 0) + " 回   ⚫⚡ 黒閃 " + (p.black_flashes or 0) + " 回",
    "🔮 呪力ポイント " + (p.points or 0) + "   🔓 術 " + len(p.owned) + " / " + len(STYLES),
    "🎖 称号 " + title_of(p)
  ]
  let h = 110 + len(lines) * 34
  p.ui_panel("stats_box", {at: "center", w: 560, h: h, bg: "#111827F2", radius: 22, layer: 35})
  p.ui_text("stats_t", "📊 " + p.name + " の成績", {parent: "stats_box", y: 28 / h, size: 20, bold: true, color: "#FDE68A"})
  let i = 0
  for line in lines do
    i = i + 1
    p.ui_text("stats_" + i, line, {parent: "stats_box", y: (40 + i * 34) / h, size: 15})
  end
  p.ui_button("stats_close", "閉じる", {parent: "stats_box", y: (h - 24) / h, w: 130, h: 32, size: 15, bg: "gray"})
end

func titles_menu(p)
  let h = 130 + len(TITLES) * 46
  p.ui_panel("title_box", {at: "center", w: 440, h: h, bg: "#1C1917F2", radius: 22, layer: 36})
  p.ui_text("title_t", "🎖 称号（🔮 " + (p.points or 0) + "）", {parent: "title_box", y: 26 / h, size: 19, bold: true, color: "#FDE68A"})
  let i = 0
  for t in TITLES do
    i = i + 1
    let name = t.name
    if name == "" then name = "（称号なし）" end
    let label = name + "  🔮" + t.price
    let bg = "#92400E"
    if contains(p.titles, t.id) then
      label = name + " をつける"
      bg = "#0F766E"
    end
    if p.title == t.id then
      label = "✅ " + name
      bg = "#374151"
    end
    p.ui_button("title_" + t.id, label, {parent: "title_box", y: (30 + i * 46) / h, w: 400, h: 38, size: 15, bg: bg})
  end
  p.ui_button("title_close", "閉じる", {parent: "title_box", y: (h - 26) / h, w: 130, h: 34, size: 15, bg: "gray"})
end

func pick_title(p, id)
  if not contains(p.titles, id) then
    let price = nil
    for t in TITLES do
      if t.id == id then price = t.price end
    end
    if price == nil then return end
    if (p.points or 0) < price then
      p.message("呪力ポイントが足りない", 1.2)
      p.sound("error")
      return
    end
    p.points = p.points - price
    append(p.titles, id)
    p.sound("goal")
    kit_quest_progress(p, "title", 1)
  end
  p.title = id
  titles_menu(p)
  hud(p)
end

on button(p, id)
  if id == "stats" then stats(p)
  elif id == "stats_close" then p.ui_remove("stats_box")
  elif id == "title_close" then p.ui_remove("title_box")
  elif starts_with(id, "title_") then pick_title(p, replace(id, "title_", ""))
  end
end
