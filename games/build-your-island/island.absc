-- island.absc — 島のしげん: 木・岩・鉄・金のそばで ⛏ をタップ。きかいが自動でふやし、作業台・かま・かじ場で加工。
-- ボートの水色のパッドで ぜんぶ売る。

let nodes = []       -- {b, res, hp, gone_at}
let is_clock = 0

func tag_text(b, key)
  for t in b.tags do
    if starts_with(t, key + "=") then return replace(t, key + "=", "") end
  end
  return nil
end

on start()
  for b in blocks("rnode") do
    let res = tag_text(b, "res") or "wood"
    append(nodes, {b: b, res: res, hp: NODE_HP[res], gone_at: 0})
  end
end

-- その島が その広さまで 広がっているか（広がっていない所の木は もどさない）
func land_ready(nd)
  let ring = num(tag_text(nd.b, "ring") or "0")
  if ring == 0 then return true end
  for k in 1 to ty_plots do
    let c = block("Claim " + k)
    if c != nil and abs(nd.b.x - c.x) < 20 then
      let owner = find(players(), func(q) return q.ty_plot == k end)
      return owner != nil and ty_owns(owner, "land" + ring)
    end
  end
  return false
end

func res_add(p, id, n)
  if p.res == nil then p.res = {} end
  p.res[id] = (p.res[id] or 0) + n
end

func res_of(p, id)
  return (p.res or {})[id] or 0
end

func harvest(p)
  if not kit_ready(p, "harvest", 0.3) then return end
  let best = nil
  let best_d = 4
  for nd in nodes do
    if nd.b.visible then
      let d = distance({x: p.x, y: 0, z: p.z}, {x: nd.b.x, y: 0, z: nd.b.z})
      if d < best_d then
        best_d = d
        best = nd
      end
    end
  end
  if best == nil then
    if kit_ready(p, "nonode", 3) then p.message("⛏ 木や岩のそばで タップ！", 1) end
    return
  end
  best.hp = best.hp - 1
  p.sound("hit")
  particles("dust", best.b, {amount: 4})
  if best.hp > 0 then return end
  best.b.visible = false
  best.b.solid = false
  best.gone_at = time()
  let n = NODE_GIVE[best.res]
  res_add(p, best.res, n)
  p.message(RES[best.res].name + " +" + n, 0.8)
  p.sound("pop")
  kit_quest_progress(p, "harvest", 1)
end

func sell_all(p, k)
  if p.ty_plot != k then return end
  let total = 0
  let mult = 1 + (p.ty_rebirths or 0) * ty_rebirth_bonus
  if ty_owns(p, "castle") then mult = mult * 2 end
  for id in RES_ORDER do
    let n = res_of(p, id)
    total = total + n * RES[id].value
  end
  total = floor(total * mult)
  if total <= 0 then
    p.message("🛶 売るものがない", 1)
    return
  end
  p.res = {}
  kit_give(p, total)
  p.ty_total = (p.ty_total or 0) + total
  p.message("🛶 ぜんぶ売った！ 💰" + kit_short(total), 1.8)
  p.sound("coin")
  kit_quest_progress(p, "sell", 1)
end

-- 毎秒: きかいが ふやす・加工する
ty_extra_income = func(p)
  for id in keys(BOTS) do
    if ty_owns(p, id) then res_add(p, BOTS[id].res, BOTS[id].n) end
  end
  for c in CRAFT do
    if ty_owns(p, c.station) then
      let ok = true
      for r in keys(c.from) do
        if res_of(p, r) < c.from[r] then ok = false end
      end
      if ok then
        for r in keys(c.from) do p.res[r] = p.res[r] - c.from[r] end
        res_add(p, c.make, 1)
      end
    end
  end
  return 0
end

func island_hud(p)
  let parts = []
  for id in RES_ORDER do
    let n = res_of(p, id)
    if n > 0 then append(parts, split(RES[id].name, " ")[1] + floor(n)) end
  end
  if len(parts) == 0 then append(parts, "⛏ 木や岩をとろう") end
  p.ui_text("is_hud", join(parts, "  "), {at: "top", dy: 86, size: 15, bold: true, color: "#FDE68A"})
end

on tick(dt)
  is_clock = is_clock + dt
  if is_clock < 1 then return end
  is_clock = 0
  let now = time()
  for nd in nodes do
    if not nd.b.visible and now - nd.gone_at > NODE_BACK and nd.gone_at > 0 and land_ready(nd) then
      nd.hp = NODE_HP[nd.res]
      nd.gone_at = 0
      nd.b.visible = true
      nd.b.solid = true
    end
  end
  for p in players() do
    if p.ty_plot != nil then island_hud(p) end
  end
end

on touch(p, b)
  if p.is_npc then return end
  if contains(b.tags, "trade") and kit_ready(p, "trade", 1.5) then sell_all(p, num(tag_text(b, "k"))) end
end

on button(p, id)
  if id == "harvest" then harvest(p) end
end
