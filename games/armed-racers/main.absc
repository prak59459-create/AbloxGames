-- Armed Racers — アイテムありのレース
-- 3レースのグランプリ。レースごとにコースを投票（オーバル・キャニオン）。3周でゴール。
-- 紫の箱でアイテム、黄色いコインで最高速アップ。ガレージで車を買う。
--
-- ファイル:
--   data.absc    表（コース2・車6・アイテム9・グランプリ）
--   common.absc  速さの計算
--   race.absc    投票・レース・チェックポイント・グランプリ
--   items.absc   アイテム・コイン・ブースト床・オイル・ボム・スリップストリーム
--   garage.absc  車・ベストラップ・成績
--   main.absc    このファイル

kit_setup("Armed Racers", "アイテムでじゃまして、1位でゴール！", [
  "🗳 レースの前にコースを投票（パッド）。3レースでグランプリ",
  "🔁 光る輪（チェックポイント）を順番に通って3周",
  "📦 紫の箱でアイテム: ブースト・ミサイル・オイル・シールド・ボム…",
  "⭐ うしろの人ほど強いアイテム（スター・サンダー・EMP）が出やすい",
  "🪙 コインを拾うと最高速アップ（当たると3まい落とす）",
  "💨 前の車のすぐうしろでスリップストリーム。🔧 ガレージで車を買おう"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["cars", "car", "gp_points"])

kit_quest("race", "レースを完走する", 1, 80)
kit_quest("first", "1位になる", 1, 250)
kit_quest("cup", "グランプリで優勝", 1, 600)
kit_quest("hits", "アイテムを5回当てる", 5, 150)
kit_quest("items", "アイテムを20回使う", 20, 100)
kit_quest("car", "新しい車を買う", 1, 50)

on start()
  start_vote()
  every(10, func() kit_leaderboard("🏆") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_show_money(p)
  p.cars = ["starter"]
  p.car = "starter"
  p.in_race = false
  p.gp_points = 0
  p.camera_distance = 9
  p.ui_button("garage", "🔧 ガレージ", {at: "right", dy: -60, w: 140, h: 46, size: 15, bg: "#B45309"})
  p.ui_button("stats", "📊", {at: "top_right", dy: 120, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  for t in TRACKS do
    p.ui_button("vote_" + t.id, "🗳 " + t.name, {at: "left", dy: -30 + (index_of(TRACKS, t) - 1) * 52, w: 200, h: 44, size: 14, bg: "#334155"})
  end
  if phase == "race" then p.message("レース中！ 次のレースから参加", 2) end
end
