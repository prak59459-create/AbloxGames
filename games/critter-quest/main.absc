-- Critter Quest — 草むらでクリッターに出会って、つかまえて、育てて、リーダーとチャンピオンに挑むターン制RPG
--
-- ファイル:
--   data.absc      クリッター24種・タイプ相性・技・道具・草むら・トレーナー
--   critters.absc  能力・経験値・技を覚える・進化・図鑑・連れ歩き
--   battle.absc    ターン制バトル
--   world.absc     草むら・トレーナー・センター・ショップ・ボックス・伝説のほこら
--   main.absc      このファイル

kit_setup("Critter Quest", "出会って、つかまえて、育てよう", [
  "🌾 草むらを歩くと野生のクリッターが飛び出す。奥の草むらほど強い",
  "⚔️ 技でたたかう。◎はこうかばつぐん、△はいまひとつ。同じタイプの技は1.5倍",
  "🔥>🌿>💧>🔥、⚡>💧🌪、🪨>🔥🌪❄️、❄️>🌿🌪、🌪>🌿、👻>👻",
  "🟠 弱らせたり、ねむらせたりしてからボールを投げるとつかまえやすい",
  "🏥 赤い建物で回復とあずかりボックス、🏪 青い建物でどうぐ、📖 研究所で図鑑",
  "🏅 4人のリーダーからバッジを集めて、最後はチャンピオン。その先に伝説が…",
  "レベルが上がると技を覚えたり、進化したりするよ"
])
kit_currency = "円"

kit_quest("catch5", "クリッターを5ひきつかまえる", 5, 300)
kit_quest("dex10", "図鑑で10種つかまえる", 10, 800)
kit_quest("dex20", "図鑑で20種つかまえる", 20, 3000)
kit_quest("lv20", "Lv.20 まで育てる", 1, 500)
kit_quest("evolve", "3回進化させる", 3, 600)
kit_quest("wins", "バトルに30回勝つ", 30, 500)
kit_quest("badges", "バッジを4つ集める", 4, 2000)
kit_quest("champion", "チャンピオンに勝つ", 1, 5000)

let STARTERS = ["hinokon", "mizupon", "happaru"]

func starter_panel(p)
  p.starter_open = true
  p.ui_panel("starter", {at: "center", w: 540, h: 230, bg: "#0F172AF2", radius: 22, layer: 30})
  p.ui_text("starter_t", "🧑‍🔬 はかせ「最初の相棒をえらぼう！」", {parent: "starter", y: 0.16, size: 19, bold: true})
  let i = 0
  for sid in STARTERS do
    i = i + 1
    let s = species_of(sid)
    p.ui_button("starter_" + sid, type_icon(s.type) + " " + s.name, {parent: "starter", x: (i - 0.5) / 3, y: 0.55, w: 150, h: 60, size: 17, bg: s.color, color: "#111111"})
  end
  p.ui_text("starter_h", "🔥ほのお はこうげき・💧みず はかたい・🌿くさ はねむらせる", {parent: "starter", y: 0.86, size: 13, color: "#CBD5E1"})
end

func pick_starter(p, sid)
  if not p.starter_open or not contains(STARTERS, sid) then return end
  p.starter_open = false
  p.ui_remove("starter")
  let c = make_critter(sid, 5)
  add_critter(p, c)
  p.items["ball"] = 5
  p.items["potion"] = 3
  p.message("🎉 " + c.name + " が仲間になった！ ボール5こと キズぐすり3こ ももらった", 3)
  refresh_buddy(p)
  hud(p)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.party = []
  p.box = []
  p.items = {}
  p.seen = {}
  p.caught = {}
  p.badges = []
  p.beaten = {}
  p.wins = 0
  p.catches = 0
  p.in_battle = false
  kit_give(p, 300)
  starter_panel(p)
  p.ui_button("open_team", "👥 チーム", {at: "right", dy: -40, w: 140, h: 46, size: 16, bg: "#0EA5E9"})
  p.ui_button("open_bag", "🎒 どうぐ", {at: "right", dy: 14, w: 140, h: 46, size: 16, bg: "#A16207"})
  p.ui_button("open_dex", "📖 図鑑", {at: "right", dy: 68, w: 140, h: 46, size: 16, bg: "#4338CA"})
end

on leave(p)
  gone(p.buddy)
  if p.battle != nil then
    gone(p.battle.foe_npc)
    gone(p.battle.my_npc)
  end
end

on respawn(p)
  if ready(p) and not p.in_battle then refresh_buddy(p) end
end

on button(p, id)
  if starts_with(id, "starter_") then
    pick_starter(p, replace(id, "starter_", ""))
    return
  end
  if not ready(p) then return end
  if starts_with(id, "mv_") then act_move(p, num(replace(id, "mv_", "")))
  elif id == "b_swap" and p.in_battle then swap_panel(p, false)
  elif id == "swap_close" then p.ui_remove("swap")
  elif starts_with(id, "sw_") and p.in_battle then act_swap(p, num(replace(id, "sw_", "")))
  elif id == "b_run" then act_run(p)
  elif id == "b_bag" or id == "open_bag" then bag_panel(p)
  elif id == "bagp_close" then p.ui_remove("bagp")
  elif starts_with(id, "use_") then use_item(p, replace(id, "use_", ""))
  elif id == "open_team" and not p.in_battle then team_panel(p)
  elif starts_with(id, "front_") and not p.in_battle then
    let i = num(replace(id, "front_", ""))
    let c = p.party[i]
    if c != nil then
      remove(p.party, i)
      insert(p.party, 1, c)
      refresh_buddy(p)
      team_panel(p)
      hud(p)
    end
  elif id == "team_close" then p.ui_remove("teambox")
  elif id == "open_dex" then dex_panel(p)
  elif id == "dex_close" then p.ui_remove("dex")
  elif starts_with(id, "buy_") then buy(p, replace(id, "buy_", ""))
  elif id == "shop_close" then p.ui_remove("shop")
  elif starts_with(id, "dep_") then deposit(p, num(replace(id, "dep_", "")))
  elif starts_with(id, "wd_") then withdraw(p, num(replace(id, "wd_", "")))
  elif id == "pc_close" then p.ui_remove("pc")
  end
end
