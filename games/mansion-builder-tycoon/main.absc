-- Mansion Builder Tycoon — 土台から26段階で、自分だけの大豪邸を建てよう
--
-- ファイル:
--   data.absc    26パーツ・ペンキ・強化
--   common.absc  家賃・ごうか度・画面
--   build.absc   土地・建てる・ペンキ・売る（転生）
--   money.absc   郵便受け・執事・強化
--   party.absc   パーティー・豪邸コンテスト
--   main.absc    このファイル

kit_setup("Mansion Builder Tycoon", "小さな土台から、大豪邸へ", [
  "🏡 道ぞいの色のパッドで土地をもらう（入るとあいている土地を自動でもらえる）",
  "🏗 緑のパッド（または🏗ボタン）で次のパーツを建てる。全部で26パーツ",
  "📬 家賃は郵便受け（青いパッド）にたまる。いっぱいになる前に集めよう。🤵執事がいると自動",
  "📈 強化で投資（家賃アップ）と大きな郵便受け",
  "🎨 ペンキでかべと屋根の色を変えられる",
  "🎉 リビングができたらパーティー！ ゲストがチップをくれる",
  "🏆 4分ごとに豪邸コンテスト。ごうか度が高いと賞金",
  "🏷 完成したら不動産屋で売って転生。家賃がずっと +50%"
])
kit_currency = "コイン"

kit_quest("build5", "パーツを5つ建てる", 5, 150)
kit_quest("build26", "26パーツ全部建てる", 26, 50000)
kit_quest("collect", "家賃を20回集める", 20, 500)
kit_quest("upgrade", "5回強化する", 5, 2000)
kit_quest("paint", "ペンキで色をかえる", 1, 500)
kit_quest("party", "パーティーを3回ひらく", 3, 3000)
kit_quest("contest", "豪邸コンテストで優勝", 1, 10000)
kit_quest("sell", "豪邸を売る", 1, 100000)

on start()
  every(10, func() kit_leaderboard("✨") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.ups = {}
  p.built = 0
  p.mail = 0
  p.sold = 0
  p.earned = 0
  p.paint = "cream"
  kit_give(p, 50)
  p.ui_button("build", "🏗 建てる", {at: "bottom_right", dx: -110, dy: -170, w: 150, h: 60, size: 18, bg: "#16A34A", radius: 16})
  p.ui_button("party", "🎉 パーティー", {at: "right", dy: -60, w: 150, h: 44, size: 14, bg: "#DB2777"})
  p.ui_button("open_ups", "🔧 強化", {at: "right", dy: -10, w: 150, h: 44, size: 15, bg: "#2563EB"})
  p.ui_button("open_paint", "🎨 ペンキ", {at: "right", dy: 40, w: 150, h: 44, size: 15, bg: "#A16207"})
  hud(p)
  for n in 1 to ESTATE_COUNT do
    if p.plot == nil and estates["" + n].owner == nil then claim(p, "" + n) end
  end
end
