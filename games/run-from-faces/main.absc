-- Run From The Faces — 巨大な顔から逃げる協力サバイバル
-- 4ステージの投票、5種類の顔、ダッシュとスタミナ、倒れた仲間の救助、アイテム、レベル、お店。
--
-- ファイル:
--   data.absc      表（ステージ・顔・アイテム・レベル）
--   common.absc    道具・レベル・画面
--   faces.absc     顔の動き
--   rounds.absc    ロビー・投票・ラウンド・結果
--   runner.absc    ダッシュ・倒れる・助ける・アイテム
--   main.absc      このファイル

kit_setup("Run From The Faces", "走れ！ 倒れた仲間は助けろ", [
  "😱 巨大な顔が追いかけてくる！ 3分間、1人でも逃げきればみんなの勝ち",
  "🏃 ダッシュボタンで速く走る（スタミナを使う）。緑のパッドで大ジャンプ",
  "😵 つかまると倒れる。近くで🤝「助ける」を3びょう続けると起こせる。30びょうでリタイア",
  "🎒 ステージの光る玉を拾って「使う」: 🥤速く 🍫スタミナ 💨見失わせる 🎈空へ ⭐1回守る",
  "😠ダッシュ顔は休むときがチャンス。👁ワープ顔はうしろに。😝ジャンプ顔は高い所にも来る"
])


-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["xp"])

kit_shop_title = "ランナーショップ"
kit_shop_add("lungs", "🫁 大きな肺（スタミナ +40）", 150, func(p)
  p.extra_stamina = (p.extra_stamina or 0) + 40
  kit_quest_progress(p, "shop", 1)
end)
kit_shop_add("shoes", "👟 はやい靴（速さ +8%）", 200, func(p)
  p.speed_bonus = min(0.24, (p.speed_bonus or 0) + 0.08)
  refresh_speed(p)
  kit_quest_progress(p, "shop", 1)
end)
kit_shop_add("medic", "🩹 救助の手（助けるのが速い）", 180, func(p)
  p.revive_bonus = min(1, (p.revive_bonus or 0) + 0.5)
  kit_quest_progress(p, "shop", 1)
end)
kit_shop_add("charm", "⭐ 最初からお守り", 250, func(p)
  p.start_shield = true
  kit_quest_progress(p, "shop", 1)
end)
kit_shop_add("hat_crown", "👑 王冠", 500, func(p) p.hat = "crown" end)
kit_shop_add("look_neon", "💚 ネオンジャージ", 120, func(p)
  p.color = "#22C55E"
  p.leg_color = "#14532D"
end)

kit_quest("survive", "ラウンドを逃げきる", 1, 150)
kit_quest("survive5", "5ラウンド逃げきる", 5, 500)
kit_quest("revive", "仲間を3人助ける", 3, 150)
kit_quest("items", "アイテムを5回使う", 5, 100)
kit_quest("run", "1km 走る", 1000, 150)
kit_quest("downed", "倒れる", 1, 20)
kit_quest("shop", "お店で2回買う", 2, 100)
kit_quest("level", "レベルを2回上げる", 2, 200)

on start()
  every(10, func() kit_leaderboard("🏃") end)
  after(5, func() open_vote() end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 30)
  p.xp = 0
  p.in_round = false
  p.downed = false
  p.out = false
  p.item = nil
  p.stamina = STAMINA
  p.times_downed = 0
  p.ui_button("sprint", "🏃", {at: "bottom_right", dx: -120, dy: -160, w: 100, h: 70, size: 30, bg: "#0EA5E9", radius: 18})
  p.ui_button("revive", "🤝 助ける", {at: "bottom_right", dx: -240, dy: -160, w: 110, h: 56, size: 16, bg: "#16A34A", radius: 16})
  p.ui_button("use", "🎒 使う", {at: "right", dy: 180, w: 150, h: 46, size: 16, bg: "#B45309"})
  if phase == "vote" then vote_panel(p) end
  if phase == "run" then p.message("👀 ラウンド中… 次のラウンドから参加", 2.5) end
  hud(p)
end

on leave(p)
  after(0.5, func() check_all_down() end)
end
