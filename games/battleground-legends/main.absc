-- Battleground Legends — 技を組み合わせて戦うバトルグラウンド
-- キャラ6人（4つの技＋覚醒で4つの強い技）・こぶしの4連コンボ・ガード・ダッシュ・受け身・
-- 覚醒ゲージ・こわせる地形・練習場・ボスレイド・連続KO・オーラ・称号。
--
-- ファイル:
--   data.absc     表（キャラと技・オーラ・称号・ボス）
--   common.absc   人さがし・画面・光の効果
--   combat.absc   ダメージ・コンボ・ガード・ダッシュ・受け身・覚醒
--   heroes.absc   技・キャラえらび
--   arena.absc    カカシ・ボスレイド・KO・オーラ屋
--   main.absc     このファイル

kit_setup("Battleground Legends", "コンボをつなげて最強をめざせ", [
  "👊 撃つボタンでこぶし。4発目で相手をふっとばす",
  "1〜4 のボタンでキャラの技。🧑 でキャラをえらぶ",
  "🛡 ガードでダメージ7割カット。💨 ダッシュ（← →で横）",
  "🌀 3回こうげきをうけると 受け身 でにげられる",
  "⚡ ダメージを与えるとゲージがたまる → 覚醒！技がぜんぶ強くなる",
  "🎯 黄色い床の練習場でカカシに技を試せる",
  "🚨 5分ごとにボスレイド。みんなでたおそう"
])
kit_currency = "KOポイント"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["hero", "heroes", "auras", "aura", "kos"])
kit_on_load = func(p)
  let h = hero_by_id(p.hero)
  p.color = h.color
  p.head_color = h.head
  move_buttons(p)
end


kit_quest("ko", "相手をたおす", 1, 30)
kit_quest("ko50", "50人たおす", 50, 800)
kit_quest("streak", "5連続KO", 1, 300)
kit_quest("awaken", "覚醒する", 1, 100)
kit_quest("moves", "技を50回使う", 50, 200)
kit_quest("hero", "新しいキャラを手に入れる", 1, 200)
kit_quest("boss", "ボスレイドに参加してたおす", 1, 400)

on join(p)
  p.hero = "fist"
  p.heroes = ["fist"]
  p.auras = ["default"]
  p.aura = "default"
  p.meter = 0
  p.awake = false
  p.kos = 0
  p.streak = 0
  let hero = hero_by_id("fist")
  p.color = hero.color
  p.head_color = hero.head
  p.give("こぶし")
  kit_welcome(p)
  kit_give(p, 50)
  p.ui_button("guard", "🛡", {at: "bottom_right", dx: -358, dy: -150, w: 70, h: 52, size: 22, bg: "#334155", radius: 14})
  p.ui_button("dash", "💨", {at: "bottom_right", dx: -358, dy: -210, w: 70, h: 52, size: 22, bg: "#0369A1", radius: 14})
  p.ui_button("dash_l", "←", {at: "bottom_right", dx: -436, dy: -150, w: 70, h: 52, size: 20, bg: "#0369A1", radius: 14})
  p.ui_button("dash_r", "→", {at: "bottom_right", dx: -436, dy: -210, w: 70, h: 52, size: 20, bg: "#0369A1", radius: 14})
  p.ui_button("open_heroes", "🧑 キャラ", {at: "right", dy: -120, w: 140, h: 50, size: 17, bg: "#1D4ED8"})
  p.ui_button("open_aura", "✨ オーラ", {at: "right", dy: -60, w: 140, h: 50, size: 17, bg: "#6D28D9"})
  kit_quest_button(p)
  kit_camera_button(p)
  move_buttons(p)
end

on respawn(p)
  if p.is_npc then return end
  p.give("こぶし")
  p.meter = 0
  p.hits_taken = 0
end
