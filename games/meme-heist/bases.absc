-- bases.absc — きち: 来た人は あいている きちを もらう。台のミームは 1秒ごとに お金をうみ、台の前の
-- 緑のプレートに たまる（ふむと受けとれる。金色のパッドで ぜんぶ）。赤いパッドで 🔒 ロック（レーザーで
-- ほかの人は入れない）。2かいは 転生2、3がいは 転生10 で ひらく。プレイヤーのいない きちは ライバルのもの（rivals.absc）。

let bases = []      -- k → {owner, rival, slots: {"f_s": slot}, lock_until, lasers, sign}
                    -- slot: {e: {id, mut, tr}, m: 見た目, bank: たまったお金, ready: 着く時刻, k, f, s}
let PLATES = {}     -- "k_f_s" → プレートのブロック
let plate_text = {} -- "k_f_s" → いまの文字
let bs_clock = 0
let laser_clock = 0
let plate_clock = 0
let save_clock = 0

on start()
  for k in 1 to len(BASES) do
    append(bases, {owner: nil, rival: nil, slots: {}, lock_until: 0, lasers: false, sign: ""})
    for f in 1 to 3 do
      for s in 1 to STANDS do PLATES[k + "_" + f + "_" + s] = block("Plate " + k + "_" + f + "_" + s) end
    end
  end
  for k in 1 to len(BASES) do
    paint_stands(k)
    update_sign(k)
  end
end

-- MARK: 台

func slot_at(k, f, s)
  return bases[k].slots[skey(f, s)]
end

func floors_open(k)
  let o = bases[k].owner
  if o == nil then
    let r = bases[k].rival
    if r != nil then return r.floors end
    return 1
  end
  let n = 1
  for f in 2 to 3 do
    if (o.rebirths or 0) >= FLOOR_REBIRTH[f] then n = f end
  end
  return n
end

func capacity(k)
  return floors_open(k) * STANDS
end

func free_stand(k)
  for f in 1 to floors_open(k) do
    for s in 1 to STANDS do
      if slot_at(k, f, s) == nil then return {f: f, s: s} end
    end
  end
  return nil
end

func slot_list(k)
  return values(bases[k].slots)
end

func meme_count(k)
  return len(bases[k].slots)
end

func base_mult(k)
  let o = bases[k].owner
  if o == nil then return 1 end
  return income_mult(o)
end

func slot_income(sl)
  return meme_income(sl.e) * base_mult(sl.k)
end

func base_income(k)
  let n = 0
  for sl in slot_list(k) do
    if sl.ready <= time() then n = n + slot_income(sl) end
  end
  return n
end

func slot_label(sl)
  meme_label(sl.m, sl.e, money(slot_income(sl)) + "/秒", nil)
end

func relabel_base(k)
  for sl in slot_list(k) do slot_label(sl) end
end

func relabel_all()
  for k in 1 to len(BASES) do
    if bases[k].owner != nil then relabel_base(k) end
  end
end

-- ミームを台に置く。from があれば そこから 歩いてくる
func place_meme(k, f, s, e, from)
  let top = stand_top(k, f, s)
  let start = top
  if from != nil then start = from end
  let m = build_model(e, start, face_yaw(k))
  idle_anim(m)
  let sl = {e: e, m: m, bank: 0, ready: 0, k: k, f: f, s: s}
  bases[k].slots[skey(f, s)] = sl
  slot_label(sl)
  if from != nil then
    let door = base_front(k)
    let d1 = max(0.4, distance(from, door) / 10)
    let d2 = max(0.4, distance(door, top) / 7)
    turn_to(m, yaw_to(from, door))
    mv(m.root, door, d1)
    sl.ready = time() + d1 + d2
    after(d1, func()
      if bases[k].slots[skey(f, s)] == sl and m.root != nil then
        turn_to(m, yaw_to(door, top))
        mv(m.root, top, d2)
      end
    end)
    after(d1 + d2, func()
      if bases[k].slots[skey(f, s)] == sl and m.root != nil then
        turn_to(m, face_yaw(k))
        particles("sparkles", top, {amount: 12})
      end
    end)
  end
  sync_save(k)
  return sl
end

-- 台から とる（見た目は消える）。たまっていたお金は もちぬしへ
func remove_meme(k, f, s)
  let sl = slot_at(k, f, s)
  if sl == nil then return nil end
  bases[k].slots[skey(f, s)] = nil
  destroy_model(sl.m)
  let o = bases[k].owner
  if o != nil and sl.bank >= 1 then pay(o, floor(sl.bank)) end
  set_plate(k, f, s, nil)
  sync_save(k)
  return sl.e
end

func clear_slots(k)
  for sl in slot_list(k) do
    bases[k].slots[skey(sl.f, sl.s)] = nil
    destroy_model(sl.m)
    set_plate(k, sl.f, sl.s, nil)
  end
end

-- ミームの 変異や特性が かわったとき: 見た目を作りなおす
func rebuild_slot(sl)
  let k = sl.k
  if bases[k].slots[skey(sl.f, sl.s)] != sl then return end
  destroy_model(sl.m)
  sl.m = build_model(sl.e, stand_top(k, sl.f, sl.s), face_yaw(k))
  idle_anim(sl.m)
  slot_label(sl)
  sync_save(k)
end

-- MARK: 台の色・プレート・看板

func paint_stands(k)
  let open = floors_open(k)
  let owned = bases[k].owner != nil
  for f in 1 to 3 do
    for s in 1 to STANDS do
      let ped = block("Ped " + k + "_" + f + "_" + s)
      let plate = PLATES[k + "_" + f + "_" + s]
      let pc = "#64748B"
      let lc = "#475569"
      if f <= open then
        pc = FLOOR_COLORS[f]
        if owned then lc = "#22C55E" else lc = "#86EFAC" end
      end
      if ped != nil and ped.color != pc then ped.color = pc end
      if plate != nil and plate.color != lc then plate.color = lc end
    end
  end
end

func set_plate(k, f, s, text)
  let key = k + "_" + f + "_" + s
  if plate_text[key] == text then return end
  plate_text[key] = text
  let plate = PLATES[key]
  if plate == nil then return end
  if text == nil then
    plate.label = nil
  else
    plate.label = [{text: text, color: "#86EFAC"}]
    plate.label_height = 0.5
    plate.label_size = 0.8
    plate.label_range = 26
  end
end

func update_plates(k)
  if bases[k].owner == nil then return end
  for sl in slot_list(k) do
    if sl.bank >= 1 then set_plate(k, sl.f, sl.s, money(floor(sl.bank))) else set_plate(k, sl.f, sl.s, nil) end
  end
end

func update_sign(k)
  let base = bases[k]
  let title = {text: "BASE " + k, color: "#FFFFFF"}
  let line = {text: "あいています", color: "#E5E7EB"}
  if base.owner != nil then
    title = {text: base.owner.name + " のきち", color: "#FFFFFF"}
    if is_locked(k) then
      line = {text: "🔒 ロック中 " + ceil(base.lock_until - time()), color: "#FCA5A5"}
    else
      line = {text: "🔓 あいてる", color: "#86EFAC"}
    end
  elif base.rival != nil then
    title = {text: "😈 " + base.rival.name, color: "#FDE68A"}
    if is_locked(k) then line = {text: "🔒 ロック中", color: "#FCA5A5"} else line = {text: "ぬすめるかも…", color: "#E5E7EB"} end
  end
  let key = title.text + "|" + line.text
  if key == base.sign then return end
  base.sign = key
  let sign = block("Base " + k + " Sign")
  if sign != nil then sign.label = [title, line] end
end

-- MARK: ロック

func is_locked(k)
  return time() < bases[k].lock_until
end

func lock_secs(p)
  return LOCK_SECS + 5 * (p.rebirths or 0)
end

func lock(p, k)
  if p.base != k then
    if kit_ready(p, "notmine", 3) then p.message("ここは ほかの人の きち。自分のきちの 赤いパッドで ロックしよう", 1.5) end
    return
  end
  if is_locked(k) then
    if kit_ready(p, "locked_already", 2) then p.message("🔒 まだ ロック中（あと " + ceil(bases[k].lock_until - time()) + "秒）", 1.2) end
    return
  end
  bases[k].lock_until = time() + lock_secs(p)
  p.message("🔒 ロック！ " + lock_secs(p) + "秒、ほかの人は入れない", 2)
  p.sound("door")
  kit_quest_progress(p, "lock", 1)
  update_sign(k)
end

func show_lasers(k, on_now)
  if bases[k].lasers == on_now then return end
  bases[k].lasers = on_now
  for b in blocks("laser" + k) do b.visible = on_now end
  if on_now then sound("laser", {volume: 0.4}) end
end

-- MARK: もらう・かえす

func claim(p)
  if p.base != nil then return end
  let k = nil
  for i in 1 to len(BASES) do
    if k == nil and bases[i].owner == nil then k = i end
  end
  if k == nil then
    p.message("きちが ぜんぶ うまっています。見学しよう！", 3)
    return
  end
  rival_leave(k)
  clear_slots(k)
  let base = bases[k]
  base.owner = p
  base.lock_until = time() + JOIN_LOCK
  p.base = k
  paint_stands(k)
  if p.memes != nil and len(p.memes) > 0 then
    restore_memes(p)
  else
    place_meme(k, 1, 3, {id: 1, mut: "none", tr: []}, nil)
  end
  update_sign(k)
  p.teleport(base_front(k) + {x: 0, y: 1, z: BASES[k].side * 2})
  p.yaw = face_yaw(k)
  p.message("🏠 きち " + k + " が あなたのもの！ 赤いカーペットで ミームを買おう（さいしょの" + JOIN_LOCK + "秒は ロック中）", 4)
  p.sound("goal")
end

-- セーブから 台にもどす
func restore_memes(p)
  let k = p.base
  if k == nil then return end
  clear_slots(k)
  let rest = []
  for it in p.memes or [] do
    let f = it.f or 1
    let s = it.s or 1
    if char_of(it.id) != nil then
      let e = {id: it.id, mut: it.mut or "none", tr: it.tr or []}
      if f <= floors_open(k) and s >= 1 and s <= STANDS and slot_at(k, f, s) == nil then
        let sl = place_meme(k, f, s, e, nil)
        sl.bank = it.b or 0
      else
        append(rest, {e: e, b: it.b or 0})
      end
    end
  end
  for r in rest do
    let st = free_stand(k)
    if st != nil then
      let sl = place_meme(k, st.f, st.s, r.e, nil)
      sl.bank = r.b
    end
  end
  sync_save(k)
end

func unclaim(p)
  let k = p.base
  if k == nil then return end
  sync_save(k)
  let base = bases[k]
  base.owner = nil
  base.lock_until = 0
  clear_slots(k)
  p.base = nil
  paint_stands(k)
  update_sign(k)
  after(8, func()
    if bases[k].owner == nil and bases[k].rival == nil then rival_arrive(k) end
  end)
end

-- 保存: きちのミームを その人に おぼえさせる（kit が 2秒ごとに 送る）
func sync_save(k)
  let o = bases[k].owner
  if o == nil then return end
  let list = []
  for sl in slot_list(k) do
    append(list, {id: sl.e.id, mut: sl.e.mut, tr: sl.e.tr, f: sl.f, s: sl.s, b: floor(sl.bank)})
  end
  o.memes = list
end

-- MARK: お金を受けとる

func pay(p, amount)
  if amount <= 0 then return end
  kit_give(p, amount)
  p.earned = (p.earned or 0) + amount
end

func collect_plate(p, k, f, s)
  if p.base != k then return end
  let sl = slot_at(k, f, s)
  if sl == nil or sl.bank < 1 then return end
  let amt = floor(sl.bank)
  sl.bank = 0
  set_plate(k, f, s, nil)
  pay(p, amt)
  p.message("💵 +" + money(amt), 0.8)
  p.sound("coin", {volume: 0.6, pitch: 1 + min(0.6, sl.f * 0.1)})
end

func collect_all(p, k)
  if p.base != k then
    if kit_ready(p, "notmine2", 3) then p.message("ここは ほかの人の きち", 1) end
    return
  end
  let total = 0
  for sl in slot_list(k) do
    if sl.bank >= 1 then
      total = total + floor(sl.bank)
      sl.bank = 0
      set_plate(k, sl.f, sl.s, nil)
    end
  end
  if total <= 0 then
    if kit_ready(p, "nocash", 2) then p.message("まだ お金が たまっていないよ", 1) end
    return
  end
  pay(p, total)
  p.message("💰 ぜんぶ受けとった！ +" + money(total), 1.5)
  p.sound("coin")
  particles("confetti", p, {amount: 20})
  kit_quest_progress(p, "collect", 1)
end

-- MARK: 🏠 きちのメニュー（ミームを見る・売る）

func sell_price(e)
  return meme_value(e)
end

func open_base_menu(p, page)
  let k = p.base
  if k == nil then return end
  let list = sort_by(slot_list(k), func(sl) return 0 - meme_income(sl.e) end)
  let per = 8
  let pages = max(1, ceil(len(list) / per))
  page = clamp(page or 1, 1, pages)
  p.bm_page = page
  let shown = slice(list, (page - 1) * per + 1, min(len(list), page * per))
  let h = 156 + max(1, len(shown)) * 44
  p.ui_remove("bm_box")
  p.ui_panel("bm_box", {at: "center", w: 700, h: h, bg: "#1E1B4BF2", radius: 22, layer: 40})
  let title = "🏠 きち" + k + " のミーム " + len(list) + "/" + capacity(k) + "   📈 " + money(base_income(k)) + "/秒"
  if pages > 1 then title = title + "   " + page + "/" + pages end
  p.ui_text("bm_t", title, {parent: "bm_box", y: 26 / h, size: 18, bold: true, color: "#C7D2FE"})
  if len(shown) == 0 then p.ui_text("bm_none", "赤いカーペットで ミームを買おう！", {parent: "bm_box", y: 76 / h, size: 15}) end
  let view = []
  let i = 0
  for sl in shown do
    i = i + 1
    let y = (34 + i * 44) / h
    let r = rarity_of(sl.e)
    let floor_mark = ["1F", "2F", "3F"][sl.f]
    p.ui_text("bm_n" + i, floor_mark + " " + meme_title(sl.e) + " " + trait_icons(sl.e), {parent: "bm_box", y: y, dx: -150, size: 14, color: r.color})
    p.ui_text("bm_i" + i, money(slot_income(sl)) + "/秒", {parent: "bm_box", y: y, dx: 110, size: 14, color: "#86EFAC"})
    p.ui_button("bmsell_" + i, "売る " + money(floor(sell_price(sl.e) * rebirth_mult(p))), {parent: "bm_box", y: y, dx: 265, w: 150, h: 34, size: 13, bg: "#16A34A"})
    append(view, {f: sl.f, s: sl.s, id: sl.e.id})
  end
  p.bm_view = view
  let by = (h - 30) / h
  p.ui_button("bm_close", "閉じる", {parent: "bm_box", y: by, w: 130, h: 38, size: 15, bg: "gray"})
  if pages > 1 then
    p.ui_button("bm_prev", "◀", {parent: "bm_box", y: by, dx: -150, w: 70, h: 38, size: 15, bg: "#4338CA"})
    p.ui_button("bm_next", "▶", {parent: "bm_box", y: by, dx: 150, w: 70, h: 38, size: 15, bg: "#4338CA"})
  end
end

func sell_from_menu(p, i)
  let k = p.base
  let v = (p.bm_view or [])[i]
  if k == nil or v == nil then return end
  let sl = slot_at(k, v.f, v.s)
  if sl == nil or sl.e.id != v.id then
    open_base_menu(p, p.bm_page)
    return
  end
  -- めずらしいミームは 2回おして 売る
  let c = char_of(sl.e.id)
  let key = v.f + "_" + v.s + "_" + v.id
  if c.r >= 4 and p.sell_confirm != key then
    p.sell_confirm = key
    p.message("⚠️ " + meme_title(sl.e) + " を ほんとうに 売る？ もう一度 おすと 売ります", 2.5)
    p.sound("tick")
    return
  end
  p.sell_confirm = nil
  let e = remove_meme(k, v.f, v.s)
  let price = floor(sell_price(e) * rebirth_mult(p))
  pay(p, price)
  p.message("💵 " + meme_title(e) + " を売った +" + money(price), 2)
  p.sound("coin")
  kit_quest_progress(p, "sell", 1)
  open_base_menu(p, p.bm_page)
end

-- MARK: まいフレーム

func push_out(k)
  for p in players() do
    if not p.is_npc and p.base != k and in_base(p.position, k) then
      p.teleport({x: p.x, y: 1, z: BASES[k].side * 8})
      if kit_ready(p, "lasered", 2) then p.message("🔴 ロック中！ レーザーで 入れない", 1.2) end
      p.sound("error")
    end
  end
end

func base_hud(p)
  let k = p.base
  if k == nil then return end
  let lk = "🔓 あいてる（赤いパッドで ロック）"
  if is_locked(k) then lk = "🔒 ロック " + ceil(bases[k].lock_until - time()) + "秒" end
  let bank = 0
  for sl in slot_list(k) do bank = bank + sl.bank end
  p.ui_text("bs_hud", "🏠 きち" + k + "   " + lk + "   📈 " + money(base_income(k)) + "/秒   🏦 " + money(floor(bank)),
            {at: "top", dy: 58, size: 15, bold: true, color: "#FFFFFF"})
end

on tick(dt)
  laser_clock = laser_clock + dt
  if laser_clock >= 0.2 then
    laser_clock = 0
    for k in 1 to len(BASES) do
      let locked = is_locked(k)
      show_lasers(k, locked)
      if locked then push_out(k) end
    end
  end
  bs_clock = bs_clock + dt
  if bs_clock < 1 then return end
  let gap = bs_clock
  bs_clock = 0
  let now = time()
  for k in 1 to len(BASES) do
    let base = bases[k]
    let o = base.owner
    if o != nil and not kit_here(o) then
      base.owner = nil
      clear_slots(k)
      paint_stands(k)
      o = nil
    end
    if o != nil then
      let mult = income_mult(o)
      for sl in slot_list(k) do
        if sl.ready <= now then sl.bank = sl.bank + meme_income(sl.e) * mult * gap end
      end
      base_hud(o)
    end
    update_sign(k)
  end
  plate_clock = plate_clock + gap
  if plate_clock >= 3 then
    plate_clock = 0
    for k in 1 to len(BASES) do update_plates(k) end
  end
  save_clock = save_clock + gap
  if save_clock >= 10 then
    save_clock = 0
    for k in 1 to len(BASES) do sync_save(k) end
  end
end

on touch(p, b)
  if p.is_npc then return end
  if contains(b.tags, "plate") then collect_plate(p, tag_num(b, "k"), tag_num(b, "f"), tag_num(b, "s"))
  elif contains(b.tags, "collectall") then collect_all(p, tag_num(b, "k"))
  elif contains(b.tags, "lock") then lock(p, tag_num(b, "k"))
  end
end

on button(p, id)
  if id == "base_menu" then open_base_menu(p, 1)
  elif id == "bm_close" then p.ui_remove("bm_box")
  elif id == "bm_prev" then open_base_menu(p, (p.bm_page or 1) - 1)
  elif id == "bm_next" then open_base_menu(p, (p.bm_page or 1) + 1)
  elif starts_with(id, "bmsell_") then sell_from_menu(p, num(replace(id, "bmsell_", "")))
  end
end

on loaded(p)
  -- 前の Meme Heist の セーブ（rebirth）から
  if p.rebirths == nil and p.saved != nil and p.saved.rebirth != nil then p.rebirths = min(3, p.saved.rebirth) end
  kit_later(p, 0.3, func()
    if p.base != nil then
      paint_stands(p.base)
      if p.memes != nil and len(p.memes) > 0 then restore_memes(p) end
      relabel_base(p.base)
    end
  end)
end

on leave(p)
  unclaim(p)
end
