-- bases.absc — 基地
-- 色つきパッドで基地をもらう。台（はじめ5つ・買うと10まで）にキャラの像がならぶ。
-- キャラは毎秒お金をうみ、基地の「金庫」にたまる → 基地の真ん中のパッドで受け取る。
-- 白いパッドでロック（レーザー）。ロックの長さは強化できる。🏠ボタンで売る・台を開ける。

let base_owner = {}   -- "1" → プレイヤーid
let base_slots = {}   -- "1:3" → {id, mut}
let statues = {}      -- "1:3" → [体, 頭]
let locked_until = {} -- "1" → 時間
let base_clock = 0
let income_bonus = 1  -- イベントで変わる

func slot_key(base, slot)
  return base + ":" + slot
end

func slot_block(base, slot)
  return block("Base " + base + " Slot " + slot)
end

func home_block(base)
  return block("Base " + base + " Home")
end

-- 基地の入り口の外（カーペット側）
func base_door(base)
  let home = home_block(base)
  let side = 1
  if home.x < 0 then side = -1 end
  return {x: side * 22, y: 0.5, z: home.z}
end

func is_locked(base)
  return locked_until[str(base)] != nil and time() < locked_until[str(base)]
end

-- MARK: 像

func place_statue(base, slot, id, mut)
  let key = slot_key(base, slot)
  clear_statue(base, slot)
  base_slots[key] = {id: id, mut: mut}
  let m = meme_by_id(id)
  let mu = MUTATIONS[mut or "none"]
  let pad = slot_block(base, slot)
  if pad == nil then return end
  let head_color = m.head
  let material = "plastic"
  if mu.color != nil then
    head_color = mu.color
    material = mu.material
  end
  let body = create_block({name: "Statue " + key, shape: "box", position: pad.position + {x: 0, y: 1.15, z: 0},
                           size: {x: 1.1, y: 1.3, z: 1.1}, color: m.color, material: material, solid: false})
  let head = create_block({name: "Statue " + key + " Head", shape: "sphere", position: pad.position + {x: 0, y: 2.3, z: 0},
                           size: 1.05, color: head_color, material: material, solid: false})
  statues[key] = [body, head]
end

func clear_statue(base, slot)
  let key = slot_key(base, slot)
  let parts = statues[key]
  if parts != nil then
    for b in parts do gone(b) end
  end
  remove(statues, key)
  remove(base_slots, key)
end

-- MARK: 台

func free_slot(p)
  if p.base == nil then return nil end
  for s in 1 to p.slots_open do
    if base_slots[slot_key(p.base, s)] == nil then return s end
  end
  return nil
end

-- 空いている台の数（歩いてくるキャラの分は予約ずみ）
func free_count(p)
  if p.base == nil then return 0 end
  let n = 0
  for s in 1 to p.slots_open do
    if base_slots[slot_key(p.base, s)] == nil then n = n + 1 end
  end
  return n - (p.pending or 0)
end

func base_income(p)
  if p.base == nil then return 0 end
  let total = 0
  for s in 1 to 10 do
    let item = base_slots[slot_key(p.base, s)]
    if item != nil then total = total + meme_income(item.id, item.mut) end
  end
  return total * rebirth_mult(p) * income_bonus
end

func base_memes(p)
  let list = []
  if p.base == nil then return list end
  for s in 1 to 10 do
    let item = base_slots[slot_key(p.base, s)]
    if item != nil then append(list, {slot: s, id: item.id, mut: item.mut}) end
  end
  return list
end

-- 自分の基地の台にキャラを置く（買った・盗んだ）
func put_in_base(p, id, mut)
  let s = free_slot(p)
  if s == nil then return false end
  place_statue(p.base, s, id, mut)
  if p.index == nil then p.index = [] end
  let key = id + ":" + (mut or "none")
  if not contains(p.index, key) then append(p.index, key) end
  if not contains(p.seen, id) then
    append(p.seen, id)
    kit_quest_progress(p, "index", 1)
  end
  let r = meme_by_id(id).rarity
  if r == "legendary" then kit_quest_progress(p, "legend", 1) end
  if r == "mythic" or r == "secret" then kit_quest_progress(p, "mythic", 1) end
  if mut != nil and mut != "none" then kit_quest_progress(p, "mutant", 1) end
  hud(p)
  return true
end

-- MARK: 基地をもらう・手放す

func claim_base(p, base)
  if p.base != nil then
    if p.base != base then p.message("あなたの基地は " + p.base + " です", 1.2) end
    return
  end
  if base_owner[base] != nil then
    p.message("ここは " + (player_by_id(base_owner[base]) or {name: "だれか"}).name + " の基地", 1.2)
    return
  end
  base_owner[base] = p.id
  p.base = base
  p.message("🏠 基地 " + base + " があなたの基地になった！カーペットのキャラを買おう", 3)
  p.sound("checkpoint")
  -- 開いている台の色を明るく
  for s in 1 to 10 do
    let pad = slot_block(base, s)
    if pad != nil then
      if s <= p.slots_open then pad.color = "#E4E4E7" else pad.color = "#4B5563" end
    end
  end
  hud(p)
end

func release_base(p)
  let base = p.base
  if base == nil then return end
  for s in 1 to 10 do clear_statue(base, s) end
  remove(base_owner, base)
  remove(locked_until, base)
  let laser = block("Base " + base + " Laser")
  if laser != nil then laser.visible = false end
  p.base = nil
end

-- MARK: 金庫

func vault_cap(p)
  return max(500, base_income(p) * 180)
end

func collect(p)
  if (p.vault or 0) < 1 then return end
  let n = floor(p.vault)
  p.vault = p.vault - n
  kit_give(p, n)
  p.message("💰 金庫から +" + kit_short(n), 1.2)
  p.sound("collect")
  hud(p)
end

-- MARK: ロック

func lock_base(p)
  if p.base == nil then return end
  if is_locked(p.base) then return end
  let left = cooldown_left(p, "lock")
  if left > 0 then
    p.message("🔒 次のロックまで " + ceil(left) + " 秒", 1.2)
    return
  end
  let secs = LOCK_LEVELS[p.lock_level].secs
  locked_until[p.base] = time() + secs
  start_cooldown(p, "lock", secs + 30)
  let laser = block("Base " + p.base + " Laser")
  if laser != nil then laser.visible = true end
  p.message("🔒 " + secs + "秒ロック！レーザーでだれも入れない", 2)
  p.sound("checkpoint")
  kit_quest_progress(p, "lock", 1)
end

func laser_touch(p, b)
  let base = split(b.name, " ")[2]
  if not is_locked(base) or p.base == base then return end
  -- はじき返す
  let home = home_block(base)
  let d = normalize(p.position - home.position)
  p.launch(d.x * 22, 8, d.z * 22)
  p.message("⚡ レーザー！ロック中の基地には入れない", 1.5)
  if p.carrying != nil then drop_carry(p, "レーザーでキャラを落とした") end
end

-- MARK: 🏠 基地メニュー

func base_menu(p)
  if p.base == nil then
    p.message("まず空いている基地の色つきパッドにさわろう", 2)
    return
  end
  let rows = 10
  let h = 200 + rows * 38
  p.ui_panel("bmenu", {at: "center", w: 560, h: h, bg: "#1E1B4BF2", radius: 22, layer: 30})
  p.ui_text("bmenu_t", "🏠 基地 " + p.base + "   💸 " + kit_short(base_income(p)) + "/秒", {parent: "bmenu", y: 24 / h, size: 20, bold: true, color: "#FDE68A"})
  for s in 1 to 10 do
    let y = (34 + s * 38) / h
    let item = base_slots[slot_key(p.base, s)]
    if s > p.slots_open then
      if s == p.slots_open + 1 then
        p.ui_button("unlock_slot", "🔓 台" + s + " を開ける  💰" + kit_short(SLOT_PRICES[s]), {parent: "bmenu", y: y, w: 480, h: 32, size: 14, bg: "#15803D"})
      else
        p.ui_text("bslot_" + s, "🔒 台" + s, {parent: "bmenu", y: y, size: 13, color: "#6B7280"})
      end
    elif item == nil then
      p.ui_text("bslot_" + s, "台" + s + "：あいている", {parent: "bmenu", y: y, size: 14, color: "#A5B4FC"})
    else
      let m = meme_by_id(item.id)
      p.ui_button("sell_" + s, "台" + s + "：" + meme_title(item.id, item.mut) + "  +" + kit_short(meme_income(item.id, item.mut)) + "/秒  [売る 💰" + kit_short(meme_value(item.id, item.mut) / 2) + "]",
                  {parent: "bmenu", y: y, w: 480, h: 32, size: 13, bg: RARITY[m.rarity].color})
    end
  end
  let lock = LOCK_LEVELS[p.lock_level]
  if p.lock_level < len(LOCK_LEVELS) then
    let next = LOCK_LEVELS[p.lock_level + 1]
    p.ui_button("lock_up", "🔒 ロック " + lock.secs + "秒 → " + next.secs + "秒  💰" + kit_short(next.price), {parent: "bmenu", y: (h - 80) / h, w: 400, h: 36, size: 14, bg: "#4338CA"})
  else
    p.ui_text("lock_max", "🔒 ロック " + lock.secs + "秒（最大）", {parent: "bmenu", y: (h - 80) / h, size: 14, color: "#C7D2FE"})
  end
  p.ui_button("bmenu_close", "閉じる", {parent: "bmenu", y: (h - 30) / h, w: 130, h: 38, size: 15, bg: "gray"})
end

func sell_slot(p, s)
  let item = base_slots[slot_key(p.base, s)]
  if item == nil then return end
  if p.sell_confirm != s then
    p.sell_confirm = s
    p.message("もう一度押すと " + meme_title(item.id, item.mut) + " を売ります", 1.5)
    return
  end
  p.sell_confirm = nil
  let price = floor(meme_value(item.id, item.mut) / 2)
  clear_statue(p.base, s)
  kit_give(p, price)
  p.message("💰 " + meme_title(item.id, item.mut) + " を売った +" + kit_short(price), 2)
  p.sound("collect")
  base_menu(p)
  hud(p)
end

func unlock_slot(p)
  let s = p.slots_open + 1
  if s > 10 then return end
  if not kit_pay(p, SLOT_PRICES[s]) then return end
  p.slots_open = s
  let pad = slot_block(p.base, s)
  if pad != nil then pad.color = "#E4E4E7" end
  p.message("🔓 台" + s + " が使えるようになった！", 2)
  p.sound("goal")
  kit_quest_progress(p, "slots", 1)
  base_menu(p)
end

func lock_upgrade(p)
  if p.lock_level >= len(LOCK_LEVELS) then return end
  let next = LOCK_LEVELS[p.lock_level + 1]
  if not kit_pay(p, next.price) then return end
  p.lock_level = p.lock_level + 1
  p.message("🔒 ロックが " + next.secs + "秒 になった！", 2)
  base_menu(p)
end

-- MARK: 画面

func hud(p)
  if not kit_here(p) then return end
  if p.base == nil then
    set_line(p, "base", "🏠 空いている基地の色つきパッドにさわろう", {at: "top", dy: 30, size: 16, color: "#FDE68A"})
    return
  end
  let lock = ""
  if is_locked(p.base) then lock = "   🔒 " + ceil(locked_until[p.base] - time()) + "秒" end
  set_line(p, "base", "🏠 基地 " + p.base + "   💸 " + kit_short(base_income(p)) + "/秒" + lock, {at: "top", dy: 30, size: 18, bold: true})
  let vault = "🏦 金庫 " + kit_short(p.vault or 0) + " / " + kit_short(vault_cap(p))
  if contains(p.gear, "magnet") then vault = "🧲 マグネットで自動回収中" end
  set_line(p, "vault", vault, {at: "top", dy: 56, size: 15, color: "#A7F3D0"})
  let rb = ""
  if p.rebirth > 0 then rb = "♻️ 転生 " + p.rebirth + "（×" + rebirth_mult(p) + "）" end
  set_line(p, "rb", rb, {at: "top_left", dy: 34, size: 15, color: "#F9A8D4"})
  p.score = floor(base_income(p))
end

on tick(dt)
  base_clock = base_clock + dt
  if base_clock < 1 then return end
  base_clock = 0
  for p in players() do
    if p.base != nil then
      let earn = base_income(p)
      if contains(p.gear, "magnet") then
        kit_give(p, earn)
      else
        p.vault = min(vault_cap(p), (p.vault or 0) + earn)
        let home = home_block(p.base)
        if home != nil and distance(p, home) < 3.5 then collect(p) end
      end
    end
    hud(p)
  end
  -- ロックが切れたらレーザーを消す
  for key in keys(locked_until) do
    if time() >= locked_until[key] then
      remove(locked_until, key)
      let laser = block("Base " + key + " Laser")
      if laser != nil then laser.visible = false end
      let owner = player_by_id(base_owner[key])
      if owner != nil then owner.message("🔓 ロックが切れた！", 1.5) end
    end
  end
  -- レインボーの像は色が変わる
  for key in keys(base_slots) do
    let item = base_slots[key]
    if item.mut == "rainbow" and statues[key] != nil then
      statues[key][2].color = random(["#F43F5E", "#F97316", "#FACC15", "#22C55E", "#3B82F6", "#A855F7"])
    end
  end
end

on touch(p, b)
  if p.is_npc then return end
  let parts = split(b.name, " ")
  if contains(b.tags, "claim") then
    claim_base(p, parts[2])
  elif contains(b.tags, "home") then
    if parts[2] == p.base then collect(p) end
  elif contains(b.tags, "lock") then
    if parts[2] == p.base then lock_base(p) end
  elif contains(b.tags, "laser") then
    laser_touch(p, b)
  end
end

on button(p, id)
  if id == "open_base" then base_menu(p)
  elif id == "bmenu_close" then
    p.ui_remove("bmenu")
    p.sell_confirm = nil
  elif starts_with(id, "sell_") then sell_slot(p, num(replace(id, "sell_", "")))
  elif id == "unlock_slot" then unlock_slot(p)
  elif id == "lock_up" then lock_upgrade(p)
  end
end

on leave(p)
  release_base(p)
end
