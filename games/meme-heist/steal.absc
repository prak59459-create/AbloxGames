-- steal.absc — ぬすむ: ロックしていない ほかのきちの台に近づいて「ぬすむ」。ミームを 頭の上に もちあげて
-- 自分のきちまで はこぶ（おそくなる・60秒まで）。もちぬしに タッチされたり、たたかれたり、ガードに
-- つかまったりすると ミームは もとの台に 歩いてもどる。自分のきちに入れば 大成功！

let st_clock = 0

func carry_height(p)
  return 3.1 * (p.size or 1)
end

-- MARK: ぬすむ

func steal_target(p)
  if p.carry != nil or p.base == nil then return nil end
  let k = base_at(p.position)
  if k == nil or k == p.base or is_locked(k) then return nil end
  let now = time()
  let best = nil
  let bd = 3.6
  for sl in slot_list(k) do
    if sl.ready <= now then
      let d = distance(p.position, stand_top(k, sl.f, sl.s))
      if d < bd then
        bd = d
        best = sl
      end
    end
  end
  return best
end

func try_steal(p, sl)
  if sl == nil or p.carry != nil or p.base == nil then return end
  let k = sl.k
  if bases[k].slots[skey(sl.f, sl.s)] != sl then return end
  if is_locked(k) then
    if kit_ready(p, "lockmsg", 2) then p.message("🔒 ロック中！", 1) end
    return
  end
  if free_stand(p.base) == nil then
    p.message("🏠 自分のきちの 台が いっぱい！ 先に 売るか 転生しよう", 2)
    p.sound("error")
    return
  end
  let owner = bases[k].owner
  let rival = bases[k].rival
  let e = remove_meme(k, sl.f, sl.s)
  uncloak(p)
  let m = build_model(e, p.position + {x: 0, y: carry_height(p), z: 0}, p.yaw)
  m.root.animation = "wobble"
  p.carry = {e: e, k: k, f: sl.f, s: sl.s, m: m, until: time() + CARRY_SECS, owner: owner, rival: rival}
  refresh_move(p)
  p.ui_remove("steal")
  p.steal_label = nil
  p.ui_button("drop", "🫳 もどす", {at: "bottom", dy: -150, w: 180, h: 48, size: 16, bg: "#57534E"})
  p.ui_bar("carry_bar", CARRY_SECS, CARRY_SECS, {at: "top", dy: 92, w: 260, h: 12, color: "#F472B6"})
  p.waypoint(block("Base " + p.base + " Sign"), "自分のきち", "#22C55E")
  p.message("🦹 " + meme_title(e) + " を ぬすんだ！ 自分のきちまで はこべ！（" + CARRY_SECS + "秒）", 2.5)
  p.sound("whoosh")
  kit_quest_progress(p, "steal_try", 1)
  if owner != nil and kit_here(owner) then
    owner.message("🚨 " + p.name + " が " + meme_title(e) + " を ぬすんだ！ タッチか 👋 で とりかえせ！", 3)
    owner.sound("alarm")
  end
  if rival != nil then rival_alarm(k, p) end
end

-- もとの台へ 歩いてもどる（台が うまっていたら あいている台へ）
func return_carry(p, why)
  let c = p.carry
  if c == nil then return end
  p.carry = nil
  destroy_model(c.m)
  let from = nil
  if kit_here(p) then
    from = p.position + {x: 0, y: 0.2, z: 0}
    refresh_move(p)
    p.ui_remove("drop")
    p.ui_remove("carry_bar")
    p.waypoint(nil)
  end
  let base = bases[c.k]
  if base.owner == c.owner and base.rival == c.rival and (c.owner == nil or kit_here(c.owner)) then
    let f = c.f
    let s = c.s
    if slot_at(c.k, f, s) != nil or f > floors_open(c.k) then
      let st = free_stand(c.k)
      if st != nil then
        f = st.f
        s = st.s
      else
        f = nil
      end
    end
    if f != nil then place_meme(c.k, f, s, c.e, from) end
  end
  if why != nil and why != "" and kit_here(p) then p.message(why, 2) end
end

func deliver(p)
  let c = p.carry
  let st = free_stand(p.base)
  if st == nil then
    if kit_ready(p, "fullbase", 3) then p.message("🏠 台が いっぱい！ 🏠メニューで 売って あけよう", 2) end
    return
  end
  p.carry = nil
  destroy_model(c.m)
  refresh_move(p)
  p.ui_remove("drop")
  p.ui_remove("carry_bar")
  p.waypoint(nil)
  place_meme(p.base, st.f, st.s, c.e, p.position)
  got_meme(p, c.e)
  p.steals = (p.steals or 0) + 1
  kit_quest_progress(p, "steal", 1)
  kit_quest_progress(p, "steal10", 1)
  if c.rival != nil then kit_quest_progress(p, "rival", 1) end
  p.message("🎉 ぬすみ 大成功！ " + meme_title(c.e) + " が 自分のきちに！", 2.5)
  p.sound("win")
  particles("confetti", p, {amount: 40})
  let r = char_of(c.e.id).r
  if r >= 4 then announce("🦹 " + p.name + " が " + RARITIES[r].name + " の " + meme_title(c.e) + " を ぬすみ出した！", 3) end
  if c.owner != nil and kit_here(c.owner) then
    c.owner.message("😢 " + meme_title(c.e) + " を ぬすまれた… 🔒 ロックを わすれずに！", 3)
  end
  if p.steals >= 25 then kit_badge(p, "thief25", "大どろぼう（25回）") end
end

-- だれかに たたかれたり 止められたりしたとき（ギアから よばれる）
func knock_drop(p, why)
  if p.carry != nil then return_carry(p, why) end
end

-- MARK: まいフレーム

on tick(dt)
  st_clock = st_clock + dt
  if st_clock < 0.25 then return end
  st_clock = 0
  let now = time()
  for p in players() do
    if not p.is_npc then
      let c = p.carry
      if c != nil then
        mv(c.m.root, p.position + {x: 0, y: carry_height(p), z: 0}, 0.25)
        p.ui_bar("carry_bar", max(0, c.until - now), CARRY_SECS)
        if p.base != nil and in_base(p.position, p.base) then
          deliver(p)
        elif now > c.until then
          return_carry(p, "⏰ 時間切れ… ミームは もとのきちへ 歩いていった")
        elif c.owner != nil and kit_here(c.owner) and distance(c.owner, p) < 3 then
          return_carry(p, "🚨 つかまった！ ミームを とりかえされた")
          c.owner.message("🛡 とりかえした！", 2)
          c.owner.sound("win")
          kit_quest_progress(c.owner, "defend", 1)
        end
      else
        let sl = steal_target(p)
        p.steal_pick = sl
        let label = nil
        if sl != nil then label = "🦹 ぬすむ: " + meme_title(sl.e) end
        if label != p.steal_label then
          p.steal_label = label
          if label == nil then
            p.ui_remove("steal")
          else
            p.ui_button("steal", label, {at: "bottom", dy: -210, w: 380, h: 54, size: 17, bg: "#7C3AED"})
          end
        end
      end
    end
  end
end

on button(p, id)
  if id == "steal" then try_steal(p, p.steal_pick)
  elif id == "drop" then return_carry(p, "🫳 ミームを もどした")
  end
end

on death(p)
  if not p.is_npc then return_carry(p, "") end
end

on leave(p)
  return_carry(p, "")
end
