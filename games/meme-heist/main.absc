-- MARK: 🧭 ワープ

let PLACES = [
  {name: "🏠 自分のきち", at: nil},
  {name: "🌀 ミームの門（カーペットの はじめ）", at: {x: -116, y: 1, z: 6.5}},
  {name: "🛠 ギア屋", at: {x: -160, y: 1, z: -13}},
  {name: "🎁 ラッキーブロック屋", at: {x: -160, y: 1, z: 13}},
  {name: "🌟 転生の祭だん", at: {x: -174, y: 1, z: 0}},
  {name: "📖 図鑑ボード", at: {x: -150, y: 1, z: 25}},
  {name: "🧪 合体マシン", at: {x: 158, y: 1, z: -17}},
  {name: "🔮 儀式の庭", at: {x: 160, y: 1, z: 13}},
  {name: "🎩 管理人ステージ", at: {x: 179, y: 1, z: 0}},
  {name: "🌮 タコスや", at: {x: 140, y: 1, z: -27}}
]

func open_places(p)
  let n = len(PLACES)
  let h = 110 + n * 44
  p.ui_remove("pl_box")
  p.ui_panel("pl_box", {at: "center", w: 440, h: h, bg: "#0F172AF0", radius: 22, layer: 40})
  p.ui_text("pl_t", "🧭 どこへ いく？", {parent: "pl_box", y: 26 / h, size: 19, bold: true, color: "#BAE6FD"})
  let i = 0
  for pl in PLACES do
    i = i + 1
    p.ui_button("pl_go" + i, pl.name, {parent: "pl_box", y: (30 + i * 44) / h, w: 380, h: 38, size: 15, bg: "#1E3A8A"})
  end
  p.ui_button("pl_close", "閉じる", {parent: "pl_box", y: (h - 26) / h, w: 130, h: 36, size: 15, bg: "gray"})
end

func go_place(p, i)
  let pl = PLACES[i]
  if pl == nil then return end
  p.ui_remove("pl_box")
  if p.carry != nil then
    p.message("🦹 はこんでいる時は ワープできない！ 走れ！", 1.5)
    return
  end
  if pl.at == nil then
    if p.base == nil then return end
    p.teleport(base_front(p.base) + {x: 0, y: 1, z: BASES[p.base].side * 2})
    p.yaw = face_yaw(p.base)
  else
    p.teleport(pl.at)
  end
  p.sound("teleport")
end

-- MARK: 画面

func rebirth_hud(p)
  let n = p.rebirths or 0
  p.ui_text("rb_hud", "🌟 転生 " + n + "   もうけ ×" + fixed(income_mult(p), 2) + "   📖 " + dex_count(p) + "/" + len(CHARS),
            {at: "top_left", dy: 34, size: 15, bold: true, color: "#FBCFE8"})
end

func side_buttons(p)
  p.ui_button("base_menu", "🏠 きち", {at: "right", dy: -214, w: 150, h: 46, size: 16, bg: "#4338CA"})
  p.ui_button("dex_menu", "📖 図鑑", {at: "right", dy: -162, w: 150, h: 46, size: 16, bg: "#0F766E"})
  p.ui_button("events_menu", "📅 イベント", {at: "right", dy: -110, w: 150, h: 46, size: 16, bg: "#7C3AED"})
  p.ui_button("places", "🧭 ワープ", {at: "right", dy: -58, w: 150, h: 46, size: 16, bg: "#0369A1"})
  kit_quest_button(p)
  kit_camera_button(p)
end

-- MARK: るすのあいだの もうけ（Ablox 2.3 から: today() を つかう）

func day_number(y, m, d)
  let yy = y
  if m <= 2 then yy = yy - 1 end
  let era = floor(yy / 400)
  let yoe = yy - era * 400
  let mp = (m + 9) % 12
  let doy = floor((153 * mp + 2) / 5) + d - 1
  let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
  return era * 146097 + doe
end

func clock_now()
  let d = today()
  return day_number(d.year, d.month, d.day) * 86400 + d.hour * 3600 + d.minute * 60 + d.second
end

func offline_pay(p)
  let now = clock_now()
  let last = p.last_seen
  p.last_seen = now
  if last == nil or p.base == nil then return end
  let gap = now - last
  if gap < 120 then return end
  let secs = min(gap, 3 * 3600)
  let amt = floor(base_income(p.base) * secs * 0.2)
  if amt <= 0 then return end
  pay(p, amt)
  p.message("💤 るすの あいだに ミームたちが かせいだ: +" + money(amt) + "（" + floor(secs / 60) + "分ぶん）", 4)
  p.sound("coin")
end

-- MARK: 入ってきた人

on join(p)
  kit_welcome(p)
  if p.coins == nil then p.coins = START_MONEY end
  kit_show_money(p)
  side_buttons(p)
  p.camera_distance = 14
  give_gear_items(p)
  rebirth_hud(p)
  kit_later(p, 0.6, func() claim(p) end)
end

on loaded(p)
  kit_later(p, 0.4, func()
    give_gear_items(p)
    rebirth_hud(p)
  end)
  kit_later(p, 1.5, func() offline_pay(p) end)
end

on start()
  every(15, func() kit_leaderboard("💰 かせいだ") end)
  every(30, func()
    for p in players() do
      if not p.is_npc and p.kit_loaded then p.last_seen = clock_now() end
    end
  end)
end

let mn_clock = 0
on tick(dt)
  mn_clock = mn_clock + dt
  if mn_clock < 2 then return end
  mn_clock = 0
  for p in players() do
    if not p.is_npc then
      let s = floor(p.earned or 0)
      if s != p.score then p.score = s end
      rebirth_hud(p)
    end
  end
end

on button(p, id)
  if id == "places" then open_places(p)
  elif id == "pl_close" then p.ui_remove("pl_box")
  elif starts_with(id, "pl_go") then go_place(p, num(replace(id, "pl_go", "")))
  end
end

on respawn(p)
  if p.is_npc then return end
  refresh_move(p)
  if p.base != nil then
    p.teleport(base_front(p.base) + {x: 0, y: 1, z: BASES[p.base].side * 2})
  end
end
