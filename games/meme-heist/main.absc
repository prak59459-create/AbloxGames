-- Meme Heist — ミームキャラを買って、守って、盗むゲーム
-- 22体のキャラ（6段階のめずらしさ）・6種類の変異・台10こ・ロック強化・ギア6種・転生4段階・イベント4種。
--
-- ファイル:
--   data.absc     表（キャラ・めずらしさ・変異・台・ロック・ギア・転生・イベント）
--   common.absc   人さがし・画面・キャラの名前とかせぎ
--   bases.absc    基地・台・像・金庫・ロック・🏠メニュー（売る・台を開ける）
--   memes.absc    カーペットのキャラ・買う・基地まで歩く・📖図鑑
--   steal.absc    盗む・運ぶ・落とす・持ち主に帰る
--   gear.absc     ギア屋とギア（バット・スラップ・糸・コイル・わな・マント・マグネット）
--   rebirth.absc  転生
--   events.absc   イベントとランキング
--   main.absc     このファイル

kit_setup("Meme Heist", "ミームキャラを集めて、盗んで、守れ！", [
  "🏠 まず空いている基地の色つきパッドにさわって自分の基地にする",
  "🛒 カーペットを歩くキャラに近づいて「買う」→ 基地まで歩いてきて台の像になる",
  "💸 キャラは毎秒お金をうむ。基地の真ん中のパッドで金庫から受け取る",
  "😈 ほかの基地の台にさわると盗める。自分の基地の真ん中まで運べ（45秒）",
  "🏏 たたかれる・糸・わな・レーザーで落とすと、キャラは持ち主に帰る",
  "🔒 白いパッドでロック（レーザー）。🏠で台を開ける・売る・ロック強化",
  "🛠 ギア屋（青）でギア、♻️ ピンクの祭だんで転生（ずっと何倍もかせげる）",
  "✨ ゴールド・ダイヤ・レインボー…変異キャラはかせぎが何倍も！"
])
kit_currency = "お金"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["gear", "seen", "index", "slots_open", "lock_level", "rebirth", "vault"])


-- MARK: クエスト

kit_quest("buy", "キャラを買う", 1, 50)
kit_quest("index", "8しゅるいのキャラを集める", 8, 3000)
kit_quest("legend", "レジェンドを手に入れる", 1, 10000)
kit_quest("mythic", "ミシック以上を手に入れる", 1, 50000)
kit_quest("mutant", "変異キャラを手に入れる", 1, 2000)
kit_quest("steal", "キャラを盗む", 1, 300)
kit_quest("steal10", "10回盗みに成功", 10, 20000)
kit_quest("defend", "盗まれたキャラを取り返す", 1, 1000)
kit_quest("lock", "基地をロックする", 1, 100)
kit_quest("slots", "台を開ける", 1, 1000)
kit_quest("gear", "ギアを手に入れる", 1, 500)
kit_quest("rebirth", "転生する", 1, 25000)

-- MARK: 入ってきた人

on join(p)
  p.gear = []
  p.seen = []
  p.index = []
  p.slots_open = 5
  p.lock_level = 1
  p.rebirth = 0
  p.vault = 0
  p.pending = 0
  kit_welcome(p)
  kit_give(p, 100)
  p.give("バット")
  p.ui_button("open_base", "🏠 基地", {at: "right", dy: -120, w: 150, h: 50, size: 17, bg: "#4338CA"})
  p.ui_button("open_index", "📖 図鑑", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0F766E"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end

on respawn(p)
  if p.is_npc then return end
  if contains(p.gear, "slap") then p.give("スラップハンド") else p.give("バット") end
end
