-- Meme Heist — ミームどろぼう
-- まん中の 赤いカーペットを ヘンなミームたちが 歩いてくる。買って 自分のきちの 台に ならべると、1秒ごとに お金をうむ。
-- ほかのきち（ライバルや 友だち）から ぬすんで、自分のきちまで はこぼう。自分のきちは 🔒 ロックで まもる。
-- 300体のミーム・8つのめずらしさ・10の変異・33の特性・50のイベント・12のギア・儀式・合体・転生15回・図鑑。
--
-- ファイル:
--   data.absc        めずらしさ・変異・特性・お金のあらわし方・きちの場所・ゲームの数字
--   chars.absc       300体（tools/meme-chars/make_chars.py が作る）
--   core.absc        キャラをさがす・ばいりつ・もうけ・きちの場所・走る速さ
--   models.absc      ミームの見た目（どうぶつ × もの をブロックで組み立てる）
--   bases.absc       きち・台・プレート・ロック・🏠メニュー（売る）
--   carpet.absc      カーペット・買う
--   steal.absc       ぬすむ・はこぶ・とりかえす
--   gear.absc        ギア屋と 12のギア
--   lucky.absc       ラッキーブロック
--   fusion.absc      合体マシン
--   rebirth.absc     転生
--   index.absc       ミーム図鑑
--   event_list.absc  50のイベントの表
--   events.absc      イベントを動かす・管理人 マエストロ・ポッポ・📅イベント図鑑
--   seasons.absc     きせつと曜日（タコスの火曜日・ハロウィン…）・さがしもの
--   rituals.absc     儀式
--   rivals.absc      ライバルのきち・どろぼうNPC
--   main.absc        このファイル（さいしょの画面・ボタン・クエスト・セーブ）

kit_setup("Meme Heist", "ミームを買って、ならべて、ぬすんで、まもりぬけ！", [
  "🛒 赤いカーペットを歩く ミームに 近づいて「買う」→ 自分のきちの 台へ 歩いていく",
  "💵 ミームは 1秒ごとに お金をうむ。台の前の 緑のプレートを ふむか、金色のパッドで ぜんぶ 受けとる",
  "🦹 ロックしていない きちの台に 近づいて「ぬすむ」→ 自分のきちまで はこぶ（60秒・おそくなる）",
  "🚨 もちぬしに タッチ・👋 されると もどされる。🔒 赤いパッドで ロックして まもろう",
  "🌧 イベント中は ミームに 特性（☔❄️🌠…）や 変異（🟡💎🌋🌈…）が ついて もうけが 何倍にも！",
  "🛠 ギア屋・🎁 ラッキーブロック屋・🌟 転生（西の広場）／🧪 合体・🔮 儀式・🎩 管理人ステージ（東の広場）",
  "🌟 転生すると もうけ アップ・2かい（転生2）・3がい（転生10）が ひらく",
  "🧭 ボタンで いろんな場所へ ワープできる（はこんでいる時は ダメ）"
])
kit_currency = "お金"
kit_keep(["memes", "rebirths", "dex", "dexm", "gear", "lucky", "fusion", "earned", "steals", "bought", "best_inc",
          "tacos", "taco_day", "hunt", "rituals", "evseen", "last_seen"])

