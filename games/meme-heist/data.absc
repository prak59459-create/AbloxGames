-- MARK: お金のあらわし方（$1.2K・$3.4M・$5B・$6T・$7Qa）
let MONEY_UNITS = [{n: 1000000000000000000, s: "Qi"}, {n: 1000000000000000, s: "Qa"}, {n: 1000000000000, s: "T"},
                   {n: 1000000000, s: "B"}, {n: 1000000, s: "M"}, {n: 1000, s: "K"}]

func short(n)
  if n == nil then return "0" end
  let a = abs(n)
  for u in MONEY_UNITS do
    if a >= u.n then
      let v = n / u.n
      if abs(v) >= 100 then return str(floor(v)) + u.s end
      return fixed(v, 1) + u.s
    end
  end
  return str(floor(n))
end

func money(n)
  return "$" + short(n)
end

