-- Disaster Island — 次々に来る15種類の自然災害を生きのびる
--
-- ファイル:
--   data.absc       災害15種・装備
--   common.absc     屋根の下？・ダメージ・画面
--   disasters.absc  災害のしくみ
--   round.absc      ラウンドの流れ・建物のもとどおり
--   shop.absc       装備と救急箱
--   main.absc       このファイル

kit_setup("Disaster Island", "何が来ても、生きのびろ", [
  "⏳ ロビーで待つと島へ。🚨 警報のヒントを見て、どこへ行くか決めよう",
  "🌊 洪水・津波は高いところ、🧪 酸性雨・🧊 吹雪・⚡ 雷・🏜 砂嵐は屋根の下",
  "☄️ いん石・🗿 巨人・🛸 UFO・🌋 火山は赤い影からにげる",
  "🫨 地震は建物からはなれる、🔥 火事は燃えている建物に近づかない",
  "🕳 ブラックホールは反対に走る、☀️ 熱波は日かげか池の中",
  "5ラウンドめからはダブル災害も！ 連続で生きのびるとコインがふえる",
  "🛒 ロビーのお店でヘルメット・シューズ・風船・救急箱"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["owned", "seen", "survived", "medkits"])


kit_quest("survive3", "3回生きのびる", 3, 100)
kit_quest("survive30", "30回生きのびる", 30, 2000)
kit_quest("seen", "10種類の災害を生きのびる", 10, 1500)
kit_quest("gear", "装備を3つ買う", 3, 300)

on start()
  every(10, func() kit_leaderboard("🏅") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.owned = {}
  p.seen = {}
  p.survived = 0
  p.streak = 0
  p.medkits = 1
  p.balloon_on = false
  p.in_round = false
  kit_give(p, 50)
  p.ui_button("open_shop", "🛒 お店", {at: "right", dy: -40, w: 130, h: 44, size: 15, bg: "#0369A1"})
  p.ui_button("medkit", "🩹", {at: "bottom_right", dx: -110, dy: -170, w: 70, h: 50, size: 20, bg: "#16A34A", radius: 14})
  p.teleport(lobby_spot())
  hud(p)
  if phase == "live" or phase == "warn" then p.message("🏝 いまラウンド中。次の災害から参加！", 3) end
end
