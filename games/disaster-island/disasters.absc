-- disasters.absc — 災害15種: はじめる・毎秒のうごき・かたづけ

let objs = []            -- 災害で作ったもの（かたづける）
let water = nil
let water_y = -1.5
let wave = nil
let wave_dir = 1
let twister = nil
let giant = nil
let ufo = nil
let hole = nil
let lava = nil
let burning = []
let wind = {x: 1, y: 0, z: 0}
let dz_clock = 0

func keep(x)
  append(objs, x)
  return x
end

func shadow(pos, radius, secs, color)
  let b = keep(create_block({name: "Warning", shape: "cylinder", position: {x: pos.x, y: 0.12, z: pos.z}, size: {x: radius * 2, y: 0.1, z: radius * 2},
                             color: color or "#EF4444", material: "neon", opacity: 0.45, solid: false}))
  after(secs, func() gone(b) end)
  return b
end

-- 空から何かが落ちてくる（いん石・溶岩の玉）。赤い影 → 落下 → まわりにダメージ
func drop_rock(from, land, color, radius, dmg)
  shadow(land, radius, 1.6, nil)
  let rock = keep(create_block({name: "Falling Rock", shape: "sphere", position: from, size: {x: 2.4, y: 2.4, z: 2.4}, color: color, material: "neon", solid: false}))
  rock.move_to(land + {x: 0, y: 1, z: 0}, 1.5)
  after(1.55, func()
    for p in survivors() do
      if flat_dist(p.position, land) < radius and p.y < land.y + 4 then
        hurt(p, dmg, "rock")
        p.launch(random(-8, 8), 10, random(-8, 8))
      end
    end
    gone(rock)
  end)
end

func island_spot()
  let a = random(0, 359)
  let r = random(0, 52)
  return {x: cos(a) * r, y: 0, z: sin(a) * r}
end

-- MARK: はじまり

func begin(id)
  if id == "flood" then
    water_y = -1.5
    water = keep(create_block({name: "Flood", position: {x: 0, y: water_y - 1, z: 0}, size: {x: 220, y: 2, z: 220}, color: "#1D4ED8", material: "glass",
                               opacity: 0.7, solid: false}))
  elif id == "tsunami" then
    wave_dir = random([-1, 1])
    wave = keep(create_block({name: "Tsunami", position: {x: 0, y: 5, z: wave_dir * -95}, size: {x: 200, y: 10, z: 8}, color: "#0EA5E9", material: "glass",
                              opacity: 0.8, solid: false}))
    wave.move_to({x: 0, y: 5, z: wave_dir * 95}, 14)
  elif id == "tornado" then
    twister = keep(create_block({name: "Tornado", shape: "cone", position: {x: -50, y: 9, z: -50}, size: {x: 9, y: 18, z: 9}, color: "#6B7280", material: "glass",
                                 opacity: 0.6, solid: false, rotation: {x: 180, y: 0, z: 0}}))
  elif id == "earthquake" then
    shake(0.5, 3)
  elif id == "blizzard" then
    world.sky = "#CBD5E1"
    world.light = 0.5
  elif id == "acid" then
    world.sky = "#65A30D"
  elif id == "lightning" then
    world.sky = "#1F2937"
    world.light = 0.3
  elif id == "sandstorm" then
    world.sky = "#D6B98C"
    world.light = 0.55
    wind = normalize({x: random(-10, 10), y: 0, z: random(-10, 10)} + {x: 0.1, y: 0, z: 0})
  elif id == "heatwave" then
    world.sky = "#FB923C"
    world.light = 1.1
  elif id == "fire" then
    burning = []
    let list = blocks("building")
    for i in 1 to 3 do ignite(random(list)) end
  elif id == "giant" then
    giant = keep(create_npc({name: "🗿 巨人", position: {x: 0, y: 2, z: -40}, color: "#78716C", head_color: "#A8A29E", size: 6, health: 999999, speed: 0.5, team: "disaster"}))
    giant.act_at = time() + 3
  elif id == "aliens" then
    ufo = keep(create_block({name: "UFO", shape: "cylinder", position: {x: 0, y: 26, z: 0}, size: {x: 16, y: 2, z: 16}, color: "#A78BFA", material: "metal", solid: false}))
    keep(create_block({name: "UFO Dome", shape: "sphere", position: {x: 0, y: 27.5, z: 0}, size: {x: 7, y: 4, z: 7}, color: "#BAE6FD", material: "glass", solid: false}))
  elif id == "blackhole" then
    hole = keep(create_block({name: "Black Hole", shape: "sphere", position: {x: 0, y: 6, z: 0}, size: {x: 5, y: 5, z: 5}, color: "#020617", material: "matte", solid: false}))
    keep(create_block({name: "Black Hole Ring", shape: "cylinder", position: {x: 0, y: 6, z: 0}, size: {x: 11, y: 0.2, z: 11}, color: "#A855F7", material: "neon",
                       solid: false, rotation: {x: 70, y: 0, z: 0}}))
  elif id == "volcano" then
    let base = block("Lava Basin").position
    lava = keep(create_block({name: "Lava Flow", position: base + {x: 0, y: -0.5, z: 0}, size: {x: 36, y: 0.6, z: 24}, color: "#F97316", material: "neon",
                              behavior: "hazard", solid: false}))
    lava.move(0, 1.2, 0, 30)
  end
end

-- 燃えはじめる
func ignite(b)
  if b == nil or contains(burning, b) or not b.visible then return end
  append(burning, b)
  b.color = "#F97316"
  b.material = "neon"
end

-- MARK: 毎秒

func disaster_step(id)
  if id == "flood" and still(water) then
    water_y = min(7, water_y + 0.3)
    water.y = water_y - 1
    for p in survivors() do
      if p.y < water_y - 0.8 then hurt(p, 8, "water") end
    end
  elif id == "tsunami" and still(wave) then
    for p in survivors() do
      if abs(p.z - wave.z) < 6 and p.y < 9 then
        hurt(p, 30, "water")
        p.launch(0, 14, wave_dir * 30)
      end
    end
    -- もう一度もどってくる
    if abs(wave.z - wave_dir * 95) < 3 then
      wave_dir = 0 - wave_dir
      wave.move_to({x: 0, y: 5, z: wave_dir * 95}, 14)
    end
  elif id == "meteor" then
    for i in 1 to 3 do
      let land = island_spot()
      drop_rock(land + {x: random(-20, 20), y: 60, z: random(-20, 20)}, land, "#44403C", 4, 50)
    end
  elif id == "volcano" then
    let peak = block("Volcano Peak").position
    for i in 1 to 2 do drop_rock(peak + {x: 0, y: 6, z: 0}, island_spot(), "#EA580C", 3.5, 40) end
  elif id == "earthquake" then
    let list = filter(blocks("building"), func(b) return b.visible and b.solid end)
    for i in 1 to 3 do
      if len(list) > 0 then
        let b = random(list)
        b.solid = false
        b.move(random(-2, 2), -8, random(-2, 2), 2.5)
        for p in survivors() do
          if distance(p, b) < 5 then hurt(p, 20, "rock") end
        end
      end
    end
    if random() < 0.3 then shake(0.4, 1) end
  elif id == "acid" then
    for p in survivors() do
      if not sheltered(p) then hurt(p, 4, "acid") end
    end
  elif id == "blizzard" then
    for p in survivors() do
      if not sheltered(p) then
        hurt(p, 2.5, "cold")
        p.speed = 0.65
      else
        p.speed = gear_speed(p)
      end
    end
  elif id == "lightning" then
    for p in survivors() do
      if not sheltered(p) and random() < 0.1 then strike(p, p.position) end
    end
  elif id == "sandstorm" then
    for p in survivors() do
      if not sheltered(p) then
        p.launch(wind.x * 9, 1, wind.z * 9)
        hurt(p, 2, "sand")
      end
    end
  elif id == "heatwave" then
    let pond = block("Pond")
    for p in survivors() do
      let cool = sheltered(p) or (pond != nil and flat_dist(p.position, pond.position) < 7)
      if not cool then hurt(p, 3, "heat") end
    end
  elif id == "fire" then
    -- 火が広がる
    let list = blocks("building")
    let spread = []
    for b in burning do
      for other in list do
        if not contains(burning, other) and distance(b, other) < 6 and random() < 0.12 then append(spread, other) end
      end
    end
    for b in spread do ignite(b) end
    for p in survivors() do
      for b in burning do
        if distance(p, b) < 3.5 then hurt(p, 7, "fire") end
      end
    end
  elif id == "giant" and still(giant) then
    let t = kit_nearest(giant, survivors())
    if t != nil then giant.follow(t) end
    if time() >= giant.act_at and t != nil then
      giant.act_at = time() + 3.5
      let spot = t.position
      giant.say("ドシーン！")
      shadow(spot, 5, 1.3, nil)
      after(1.3, func()
        for p in survivors() do
          if flat_dist(p.position, spot) < 5 then
            hurt(p, 40, "rock")
            p.launch(0, 16, 0)
          end
        end
      end)
    end
  elif id == "aliens" and still(ufo) then
    let t = random(survivors())
    if t != nil then
      ufo.move_to({x: t.x, y: 26, z: t.z}, 1.8)
      let spot = t.position
      shadow(spot, 3, 1.6, "#22D3EE")
      after(1.6, func()
        let beam = create_block({name: "Beam", shape: "cylinder", position: {x: spot.x, y: 13, z: spot.z}, size: {x: 5, y: 26, z: 5}, color: "#22D3EE",
                                 material: "neon", opacity: 0.5, solid: false})
        for p in survivors() do
          if flat_dist(p.position, spot) < 3 then
            hurt(p, 35, "beam")
            p.launch(0, 20, 0)
          end
        end
        after(0.5, func() gone(beam) end)
      end)
    end
  elif id == "blackhole" and still(hole) then
    for p in survivors() do
      let d = hole.position - p.position
      let dist = magnitude(d)
      if dist > 1 then
        let pull = normalize(d) * min(16, 260 / max(dist, 4))
        p.launch(pull.x, max(1, pull.y), pull.z)
      end
      if dist < 5 then hurt(p, 15, "hole") end
    end
  end
end

-- 雷: 黄色い影が出て、0.8秒後にまだそこにいたら落ちる（ループの中から呼ぶので関数に分ける）
func strike(p, pos)
  shadow(pos, 2.5, 0.8, "#FDE047")
  after(0.8, func()
    if still(p) and p.alive and flat_dist(p.position, pos) < 2.5 and not sheltered(p) then
      hurt(p, 45, "bolt")
      p.shake(0.5, 0.3)
      p.message("⚡ 雷が落ちた！", 1)
    end
  end)
end

-- 0.1秒ごと（たつまきは速く動く）
func fast_step(dt)
  if happening("tornado") and still(twister) then
    let t = kit_nearest(twister, survivors())
    if t != nil then
      let drift = normalize({x: t.x - twister.x, y: 0, z: t.z - twister.z}) * 7 * dt
      twister.position = twister.position + drift
      if flat_dist(twister.position, t.position) < 5 then
        t.launch(random(-18, 18), 24, random(-18, 18))
        hurt(t, 12, "wind")
      end
    end
  end
end

-- MARK: かたづけ

func cleanup()
  for x in objs do gone(x) end
  objs = []
  water = nil
  wave = nil
  twister = nil
  giant = nil
  ufo = nil
  hole = nil
  lava = nil
  burning = []
  world.sky = "#4FB6FF"
  world.light = 0.75
end
