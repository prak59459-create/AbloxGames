-- shop.absc — 装備（ヘルメット・シューズ・風船）と救急箱

func gear_speed(p)
  if p.owned["shoes"] then return 1.25 end
  return 1
end

-- ラウンドのはじめに装備をつける
func apply_gear(p)
  p.speed = gear_speed(p)
  if p.owned["balloon"] and p.balloon_on then p.gravity = 0.45 else p.gravity = 1 end
  if p.owned["helmet"] then p.hat = "cap" end
end

func shop_panel(p)
  let h = 120 + len(GEAR) * 50
  p.ui_remove("shop")
  p.ui_panel("shop", {at: "center", w: 540, h: h, bg: "#0C4A6EF2", radius: 20, layer: 30})
  p.ui_text("shop_t", "🛒 装備のお店   💰 " + kit_short(kit_money(p)), {parent: "shop", y: 22 / h, size: 17, bold: true, color: "#BAE6FD"})
  let i = 0
  for g in GEAR do
    i = i + 1
    let label = g.name + "  💰" + g.price + " — " + g.text
    if g.id != "medkit" and p.owned[g.id] then label = "✅ " + g.name + "（持っている）" end
    if g.id == "medkit" then label = label + "（いま " + p.medkits + "）" end
    p.ui_button("gear_" + g.id, label, {parent: "shop", y: (32 + i * 50) / h, w: 500, h: 42, size: 13, bg: "#0369A1"})
  end
  p.ui_button("shop_close", "閉じる", {parent: "shop", y: (h - 22) / h, w: 120, h: 28, size: 12, bg: "gray"})
end

func buy_gear(p, id)
  let g = nil
  for x in GEAR do
    if x.id == id then g = x end
  end
  if g == nil then return end
  if id != "medkit" and p.owned[id] then return end
  if id == "medkit" and p.medkits >= 5 then
    p.message("🩹 5こまで", 1)
    return
  end
  if kit_pay(p, g.price) then
    if id == "medkit" then p.medkits = p.medkits + 1 else p.owned[id] = true end
    if id == "balloon" then
      p.balloon_on = true
      balloon_button(p)
    end
    p.sound("collect")
    kit_quest_progress(p, "gear", 1)
    hud(p)
  end
  shop_panel(p)
end

func balloon_button(p)
  if not p.owned["balloon"] then return end
  let label = "🎈 OFF"
  if p.balloon_on then label = "🎈 ON" end
  p.ui_button("balloon", label, {at: "bottom_right", dx: -190, dy: -170, w: 90, h: 50, size: 15, bg: "#EC4899", radius: 14})
end

func use_medkit(p)
  if p.medkits <= 0 then
    p.message("🩹 救急箱がない（お店で買おう）", 1.2)
    return
  end
  if not p.alive or p.health >= p.max_health then return end
  p.medkits = p.medkits - 1
  p.heal(60)
  p.message("🩹 回復した！", 1)
  hud(p)
end

on touch(p, b)
  if p.is_npc or not ready(p) then return end
  if contains(b.tags, "shop") and quiet_ready(p, "shop", 2) then shop_panel(p) end
end

on button(p, id)
  if not ready(p) then return end
  if id == "open_shop" then shop_panel(p)
  elif starts_with(id, "gear_") then buy_gear(p, replace(id, "gear_", ""))
  elif id == "shop_close" then p.ui_remove("shop")
  elif id == "medkit" and quiet_ready(p, "medkit", 1) then use_medkit(p)
  elif id == "balloon" then
    p.balloon_on = not p.balloon_on
    if p.in_round then apply_gear(p) end
    balloon_button(p)
  end
end
