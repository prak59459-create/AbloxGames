-- Blade Summon Sim — 武器を召喚すると、まわりを回って勝手に敵をたおしてくれる放置系シミュレーター
--
-- ファイル:
--   data.absc    ワールド6つ・武器36本・レア度・強化・エンチャント・転生ショップ
--   common.absc  武器とプレイヤーの強さ・画面
--   blades.absc  召喚・合体・バッグ・図鑑
--   combat.absc  敵・エリート・ボス・自動攻撃・回る武器
--   shops.absc   道場・エンチャント・転生・ゲート・プレゼント
--   main.absc    このファイル

kit_setup("Blade Summon Sim", "召喚して、合体して、最強の武器軍団を", [
  "🎲 金色の祭壇で武器を召喚。ワールドごとに出る武器がちがう",
  "🗡 強い武器が自動で装備されて、まわりを回りながら近くの敵をこうげき",
  "⭐ 同じ武器・同じ★が3本そろうと合体して★が上がる（パワー×3.5）",
  "🥋 道場でスロット・範囲・スピード・運・コイン・足の速さを強化",
  "✨ エリートやボスの💎で、エンチャント（鋭さ・強欲・幸運・疾風・会心）",
  "🚪 オレンジのゲートはコインで開く。全部で6ワールド",
  "🔄 お金がたまったら転生。パワーとコインがずっと上がって、転生ショップも使える"
])
kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["bag", "serial", "found", "ups", "perks", "autosell", "automerge", "gems", "tokens", "rebirths", "unlocked", "world", "summons", "slain", "earned"])


kit_quest("summon", "10回召喚する", 10, 200)
kit_quest("summon100", "100回召喚する", 100, 3000)
kit_quest("kills", "敵を100体たおす", 100, 500)
kit_quest("kills1000", "敵を1000体たおす", 1000, 20000)
kit_quest("legend", "レジェンド以上を召喚する", 1, 1000)
kit_quest("merge", "5回合体する", 5, 800)
kit_quest("upgrade", "道場で10回強化する", 10, 1500)
kit_quest("world3", "3つ目のワールドへ", 2, 5000)
kit_quest("world6", "星の神殿へ", 5, 1000000)
kit_quest("boss", "ボスを3回たおす", 3, 5000)
kit_quest("enchant", "エンチャントを3回", 3, 3000)
kit_quest("rebirth", "転生する", 1, 10000)
kit_quest("tap", "こうげきボタンを200回", 200, 800)

on start()
  every(10, func() kit_leaderboard("⚔️") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.bag = []
  p.serial = 0
  p.found = {}
  p.ups = {}
  p.perks = []
  p.autosell = {}
  p.automerge = true
  p.gems = 0
  p.tokens = 0
  p.rebirths = 0
  p.unlocked = 1
  p.world = 1
  p.summons = 0
  p.slain = 0
  p.earned = 0
  p.gift_at = time() + GIFT_EVERY
  add_blade(p, "w1a", 0)
  kit_give(p, 150)
  apply_walk(p)
  p.ui_button("tap", "⚔️ こうげき", {at: "bottom_right", dx: -110, dy: -170, w: 160, h: 64, size: 18, bg: "#DC2626", radius: 16})
  p.ui_button("open_bag", "🗡 武器", {at: "right", dy: -40, w: 140, h: 42, size: 15, bg: "#1D4ED8"})
  p.ui_button("open_index", "📖 図鑑", {at: "right", dy: 10, w: 140, h: 42, size: 15, bg: "#4338CA"})
  p.ui_button("autosell", "🗑 自動売却 OFF", {at: "right", dy: 60, w: 140, h: 42, size: 13, bg: "#57534E"})
  rebuild_orbit(p)
  hud(p)
  p.message("🎲 金色の祭壇にさわって、最初の召喚をしよう！", 3)
end

on respawn(p)
  if not ready(p) then return end
  p.teleport(block("World " + p.world + " Spot").position + {x: 0, y: 1, z: 0})
  rebuild_orbit(p)
end

on button(p, id)
  if not ready(p) then return end
  if id == "autosell" then
    -- コモンとレアの自動売却を切りかえ
    let on_now = p.autosell["common"] == true
    p.autosell["common"] = not on_now
    p.autosell["rare"] = not on_now
    let label = "🗑 自動売却 OFF"
    if not on_now then label = "🗑 コモン・レア売却 ON" end
    p.ui_button("autosell", label, {at: "right", dy: 60, w: 140, h: 42, size: 12, bg: "#57534E"})
  end
end
