-- Aura Roll — オーラを引く運だめし

kit_setup("Aura Roll", "天気を読んで、1億分の1を引け", [
  "「🎲 ロール」でオーラを引く。レアほど見た目が豪華に",
  "天気（風・雨・星空・血の月）が変わると、特別なオーラが出る",
  "星空と血の月のときは運がアップ！",
  "ポーション屋（紫）で運やロールの速さを強化",
  "引いたオーラは「💎 装備」でいつでも付けかえられる"
])

let auras = [
  {name: "ふつう", chance: 2, color: "#E5E7EB", hat: "none"},
  {name: "アンコモン", chance: 4, color: "#86EFAC", hat: "none"},
  {name: "グッド", chance: 5, color: "#60A5FA", hat: "none"},
  {name: "ナチュラル", chance: 8, color: "#22C55E", hat: "none"},
  {name: "レア", chance: 16, color: "#3B82F6", hat: "antenna"},
  {name: "ディバイン", chance: 32, color: "#FDE68A", hat: "halo"},
  {name: "クリスタル", chance: 64, color: "#A5F3FC", hat: "antenna"},
  {name: "ルビー", chance: 350, color: "#DC2626", hat: "crown"},
  {name: "フォレスト", chance: 1000, color: "#15803D", hat: "halo"},
  {name: "ギャラクシー", chance: 5000, color: "#6D28D9", hat: "crown"},
  {name: "エクリプス", chance: 25000, color: "#111827", hat: "halo"},
  {name: "オーロラ", chance: 100000, color: "#2DD4BF", hat: "crown"},
  {name: "セレスティアル", chance: 1000000, color: "#FFFFFF", hat: "halo"},
  {name: "ゼウス", chance: 10000000, color: "#FACC15", hat: "crown"},
  {name: "オリジン", chance: 100000000, color: "#F0ABFC", hat: "crown"}
]
let weather_auras = {
  "風": {name: "ウィンドストーム", chance: 3000, color: "#BAE6FD", hat: "antenna"},
  "雨": {name: "スプラッシュ", chance: 2000, color: "#38BDF8", hat: "halo"},
  "星空": {name: "スターライト", chance: 8000, color: "#C4B5FD", hat: "crown"},
  "血の月": {name: "ブラッドムーン", chance: 20000, color: "#7F1D1D", hat: "crown"}
}
let weather = "晴れ"
let weather_luck = {"晴れ": 1, "風": 1.2, "雨": 1.3, "星空": 2, "血の月": 3}
let orbiters = {}

kit_shop_title = "ポーション屋"
kit_shop_add("luck", "運のポーション（2分 ×2）", 50, func(p) p.luck_until = time() + 120 end)
kit_shop_add("haste", "はやさのポーション（2分 ロール速い）", 40, func(p) p.haste_until = time() + 120 end)
kit_shop_add("glove", "ラッキーグローブ（ずっと運 +50%）", 300, func(p) p.gear = p.gear + 0.5 end)
kit_shop_add("auto", "オートロール", 200, func(p) p.auto = true end)

kit_quest("rolls", "100回ロール", 100, 60)
kit_quest("rare", "1/1000以上を引く", 1, 200)
kit_quest("weather", "天気のオーラを引く", 1, 300)

for a in auras do a.weight = 1 / a.chance end

func luck(p)
  let l = (1 + p.gear) * weather_luck[weather]
  if p.luck_until != nil and time() < p.luck_until then l = l * 2 end
  return l
end

func roll_once(p)
  let l = luck(p)
  -- 運が高いほど、レアの確率が上がる（1/chance → l/chance）
  let pool = copy(auras)
  let special = weather_auras[weather]
  if special != nil then append(pool, special) end
  let got = auras[1]
  for a in reverse(sort(pool, func(x, y) return x.chance < y.chance end)) do
    if random() < min(0.5, l / a.chance) then
      got = a
      break
    end
  end
  return got
end

func equip(p, a)
  p.equipped = a.name
  p.color = a.color
  p.hat = a.hat
  let old = orbiters[p.id]
  if old != nil then old.destroy() end
  remove(orbiters, p.id)
  if a.chance >= 1000 then
    orbiters[p.id] = create_block({name: "Aura " + p.name, shape: "sphere", position: p.position + {x: 0, y: 3, z: 0}, size: 0.8,
                                   color: a.color, material: "neon", solid: false})
  end
  show(p)
end

func show(p)
  p.ui_text("aura", "✨ " + (p.equipped or "なし") + "   🍀 ×" + fixed(luck(p), 1) + "   🎲 " + p.rolls + " 回",
            {at: "top", dy: 60, size: 17, bold: true})
end

func roll(p)
  let cd = 1.2
  if p.haste_until != nil and time() < p.haste_until then cd = 0.6 end
  if not kit_ready(p, "roll", cd) then return end
  let a = roll_once(p)
  p.rolls = p.rolls + 1
  kit_quest_progress(p, "rolls", 1)
  p.found[a.name] = a.chance
  p.ui_text("rolled", a.name + "（1/" + kit_short(a.chance) + "）", {at: "center", dy: -140, size: 28, bold: true, color: a.color})
  kit_later(p, 1.4, func() p.ui_remove("rolled") end)
  if a.chance >= 1000 then
    kit_quest_progress(p, "rare", 1)
    announce("🌟 " + p.name + " が「" + a.name + "」（1/" + kit_short(a.chance) + "）を引いた！", 5)
    p.fade(a.color, 0.2)
    kit_later(p, 0.4, func() p.fade(nil, 1) end)
    sound("goal")
  end
  for key in keys(weather_auras) do
    if weather_auras[key].name == a.name then kit_quest_progress(p, "weather", 1) end
  end
  if p.best == nil or a.chance > p.best then
    p.best = a.chance
    p.score = a.chance
    equip(p, a)
  end
  show(p)
end

func inventory(p)
  let list = sort(keys(p.found), func(a, b) return p.found[a] > p.found[b] end)
  let h = 110 + min(10, len(list)) * 42
  p.ui_panel("inv", {at: "center", w: 380, h: h, bg: "#1E1B4BF0", radius: 22, layer: 30})
  p.ui_text("inv_t", "💎 オーラ（" + len(list) + " 種）", {parent: "inv", y: 26 / h, size: 21, bold: true})
  let i = 0
  for name in slice(list, 1, 10) do
    i = i + 1
    p.ui_button("wear_" + name, name + "（1/" + kit_short(p.found[name]) + "）", {parent: "inv", y: (26 + i * 42) / h, w: 320, h: 36, size: 15, bg: "#4C1D95"})
  end
  p.ui_button("inv_close", "閉じる", {parent: "inv", y: (h - 24) / h, w: 120, h: 34, size: 14, bg: "gray"})
end

func find_aura(name)
  for a in auras do
    if a.name == name then return a end
  end
  for key in keys(weather_auras) do
    if weather_auras[key].name == name then return weather_auras[key] end
  end
  return auras[1]
end

on start()
  every(120, func()
    weather = random(["晴れ", "風", "雨", "星空", "血の月", "晴れ"])
    ui_text("weather", "天気: " + weather + "（運 ×" + weather_luck[weather] + "）", {at: "top", dy: 26, size: 18, bold: true})
    if weather == "星空" then world.sky = "#0B1026" elif weather == "血の月" then world.sky = "#450A0A" elif weather == "雨" then world.sky = "#475569" else
      world.sky_top = "#1E1B4B"
      world.sky_bottom = "#6D28D9"
    end
    announce("🌦 天気が「" + weather + "」になった", 3)
  end)
  every(1, func()
    for p in players() do
      if p.auto then roll(p) end
    end
  end)
  every(10, func() kit_leaderboard("✨ 最高レア") end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  p.rolls = 0
  p.gear = 0
  p.found = {}
  kit_give(p, 30)
  p.ui_button("roll", "🎲 ロール", {at: "bottom", dy: -100, w: 200, h: 64, size: 24, bg: "#7C3AED", radius: 20})
  p.ui_button("open_inv", "💎 装備", {at: "right", dy: -60, w: 150, h: 50, size: 17, bg: "#0EA5E9"})
  ui_text("weather", "天気: " + weather, {at: "top", dy: 26, size: 18, bold: true})
  show(p)
  -- ロールするとコインも少し
  every(5, func() if kit_here(p) then kit_give(p, 1) end end)
end

on leave(p)
  let o = orbiters[p.id]
  if o != nil then o.destroy() end
  remove(orbiters, p.id)
end

on tick(dt)
  for p in players() do
    let o = orbiters[p.id]
    if o != nil then
      let a = time() * 120
      o.position = p.position + {x: cos(a) * 1.4, y: 2.6, z: sin(a) * 1.4}
    end
  end
end

on touch(p, b)
  if not p.is_npc and contains(b.tags, "potions") and kit_ready(p, "shop", 3) then kit_open_shop(p) end
end

on button(p, id)
  if id == "roll" then roll(p)
  elif id == "open_inv" then inventory(p)
  elif id == "inv_close" then p.ui_remove("inv")
  elif starts_with(id, "wear_") then
    equip(p, find_aura(replace(id, "wear_", "")))
    p.ui_remove("inv")
  end
end
