-- Aura Roll — オーラを引く運だめし。天気を読み、ギアを作り、1億分の1を引け。
--
-- ファイル:
--   data.absc      オーラ・天気・素材・ギア・ポーション
--   common.absc    天気・運と速さ・画面
--   craft.absc     素材・クラフト台・運の塔
--   merchant.absc  天気のうつりかわり・旅の商人・ポーション
--   roll.absc      ロール・演出・保管庫・まわる光・図鑑・オートロール
--   main.absc      このファイル

kit_setup("Aura Roll", "天気を読んで、1億分の1を引け", [
  "🎲 ロールでオーラを引く。10回ごとに運 ×2 のボーナス",
  "🌦 天気（風・雨・雪・砂あらし・星空・血の月・グリッチ）で運が上がり、その天気だけのオーラも出る",
  "🍃 広場に落ちている素材を拾い、⚒ クラフト台でオーラと素材からギアを作ると運がずっと上がる",
  "🧙 ときどき旅の商人マリが来てポーションを売る。🗼 運の塔のてっぺんでも運のポーション",
  "💎 保管庫で好きなオーラを装備。📖 図鑑をうめよう"
])

kit_currency = "コイン"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["rolls", "storage", "seen", "mats", "gear", "has_auto"])

kit_shop_title = "ポーション屋"
kit_shop_add("auto", "🔁 オートロール（ボタンでON/OFF）", 200, func(p)
  p.has_auto = true
  p.auto = true
end)
kit_shop_add("luck", "🍀 運のポーション（2分 ×2）", 60, func(p) p.buffs.luck = max(p.buffs.luck or 0, time()) + 120 end)
kit_shop_add("speed", "⚡ はやさのポーション（2分）", 50, func(p) p.buffs.speed = max(p.buffs.speed or 0, time()) + 120 end)

kit_quest("rolls", "100回ロール", 100, 60)
kit_quest("rare", "1/1000以上を引く", 1, 200)
kit_quest("biome", "天気だけのオーラを引く", 1, 300)
kit_quest("collect", "オーラを15種類集める", 15, 250)
kit_quest("material", "素材を20こ拾う", 20, 80)
kit_quest("craft", "ギアを2つ作る", 2, 200)
kit_quest("potion", "商人からポーションを買う", 1, 60)
kit_quest("tower", "運の塔にのぼる", 1, 80)

on start()
  set_biome(BIOMES[1])
  merchant_next = time() + 45
  every(10, func() kit_leaderboard("✨ 最高レア") end)
  every(1, func() biome_hud() end)
end

on join(p)
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  kit_camera_button(p)
  kit_give(p, 30)
  p.rolls = 0
  p.storage = {}
  p.seen = {}
  p.mats = {}
  p.gear = {}
  p.buffs = {}
  p.orbs = []
  p.once_luck = 1
  p.auto = false
  p.has_auto = false
  p.ui_button("roll", "🎲 ロール", {at: "bottom", dy: -100, w: 200, h: 64, size: 24, bg: "#7C3AED", radius: 20})
  p.ui_button("open_inv", "💎 保管庫", {at: "right", dy: -60, w: 150, h: 46, size: 16, bg: "#0EA5E9"})
  p.ui_button("book", "📖 図鑑", {at: "right", dy: -8, w: 150, h: 46, size: 16, bg: "#4338CA"})
  p.ui_button("auto", "🔁 オート", {at: "right", dy: 180, w: 150, h: 46, size: 16, bg: "#334155"})
  biome_hud()
  hud(p)
end
