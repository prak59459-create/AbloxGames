-- roll.absc — ロール・演出・保管庫と装備・まわる光・図鑑・オートロール

let orbit_clock = 0

func roll_pool()
  return filter(AURAS, func(a) return a.biome == nil or a.biome == biome.id end)
end

-- 運が高いほど、レアの確率が上がる（1/chance → 運/chance）。いちばんレアなものから順にためす
func draw(p)
  let l = luck(p)
  let pool = reverse(sort(roll_pool(), func(x, y) return x.chance < y.chance end))
  for a in pool do
    if random() < min(0.5, l / a.chance) then return a end
  end
  return AURAS[1]
end

func roll(p)
  if not ready(p) then return end
  if not quiet_ready(p, "roll", roll_cooldown(p)) then return end
  let a = draw(p)
  p.once_luck = 1
  p.rolls = p.rolls + 1
  kit_quest_progress(p, "rolls", 1)
  p.storage[a.id] = stored(p, a.id) + 1
  let first = p.seen[a.id] != true
  p.seen[a.id] = true
  kit_give(p, 1 + a.tier * 2)
  p.ui_text("rolled", a.name + "（" + one_in(a.chance) + "）", {at: "center", dy: -140, size: 30, bold: true, color: a.color})
  kit_later(p, 1.4, func() p.ui_remove("rolled") end)
  if first then
    p.message("📖 新しいオーラ「" + a.name + "」を図鑑に登録！", 1.5)
    kit_quest_progress(p, "collect", 1)
  end
  if a.chance >= 1000 then cutscene(p, a) end
  if a.biome != nil then kit_quest_progress(p, "biome", 1) end
  if p.best == nil or a.chance > p.best then
    p.best = a.chance
    p.score = a.chance
    equip(p, a.id)
  end
  hud(p)
end

-- レアを引いたときの演出
func cutscene(p, a)
  kit_quest_progress(p, "rare", 1)
  p.fade(a.color, 0.25)
  kit_later(p, 0.5, func() p.fade(nil, 1.2) end)
  p.shake(0.2 + a.tier * 0.1, 0.6)
  sound("goal")
  if a.chance >= 25000 then
    announce("🌟🌟 " + p.name + " が「" + a.name + "」（" + one_in(a.chance) + "）を引いた！！", 6)
  else
    announce("🌟 " + p.name + " が「" + a.name + "」（" + one_in(a.chance) + "）を引いた！", 4)
  end
  -- 光の雨
  for i in 1 to 4 + a.tier * 2 do
    let s = create_block({name: "Star", shape: "sphere", position: p.position + {x: random(-5, 5), y: 6 + random(0, 4), z: random(-5, 5)}, size: 0.5,
                          color: a.color, material: "neon", solid: false})
    s.move_to(s.position - {x: 0, y: 6, z: 0}, 1.2)
    after(1.3, func() gone(s) end)
  end
  if a.tier >= 4 then kit_badge(p, "aura_" + a.id, "「" + a.name + "」を引いた") end
end

-- MARK: 装備とまわる光

func equip(p, id)
  let a = aura_by_id(id)
  if a == nil or stored(p, id) <= 0 then return end
  p.equipped = id
  p.color = a.color
  p.hat = a.hat
  for o in p.orbs do gone(o) end
  p.orbs = []
  let count = min(3, a.tier)
  if count > 0 then
    for i in 1 to count do
      append(p.orbs, create_block({name: "Aura Orb", shape: "sphere", position: p.position + {x: 0, y: 3, z: 0}, size: 0.4 + a.tier * 0.1,
                                   color: a.color, material: "neon", solid: false}))
    end
  end
  hud(p)
end

func orbit_step(secs)
  for p in players() do
    if ready(p) and len(p.orbs) > 0 then
      let n = len(p.orbs)
      let i = 0
      for o in p.orbs do
        i = i + 1
        if still(o) then
          let ang = time() * 150 + i * 360 / n
          o.move_to(p.position + {x: cos(ang) * 1.5, y: 2.4 + sin(ang * 2) * 0.3, z: sin(ang) * 1.5}, secs)
        end
      end
    end
  end
end

-- MARK: 保管庫と図鑑

func storage_panel(p)
  let owned = filter(AURAS, func(a) return stored(p, a.id) > 0 end)
  let list = reverse(sort(owned, func(x, y) return x.chance < y.chance end))
  let page = slice(list, 1, 10)
  let h = 110 + max(1, len(page)) * 42
  p.ui_remove("inv")
  p.ui_panel("inv", {at: "center", w: 420, h: h, bg: "#1E1B4BF0", radius: 22, layer: 30})
  p.ui_text("inv_t", "💎 保管庫（" + len(owned) + " 種）— タップで装備", {parent: "inv", y: 26 / h, size: 17, bold: true})
  let i = 0
  for a in page do
    i = i + 1
    let mark = ""
    if p.equipped == a.id then mark = "✅ " end
    p.ui_button("wear_" + a.id, mark + a.name + "（" + one_in(a.chance) + "） ×" + stored(p, a.id), {parent: "inv", y: (26 + i * 42) / h, w: 380, h: 36, size: 14, bg: "#4C1D95", color: a.color})
  end
  p.ui_button("inv_close", "閉じる", {parent: "inv", y: (h - 24) / h, w: 120, h: 34, size: 14, bg: "gray"})
end

func collection_panel(p)
  let total = len(AURAS)
  let found = len(filter(AURAS, func(a) return p.seen[a.id] == true end))
  let lines = []
  for a in AURAS do
    if p.seen[a.id] then append(lines, a.name) else append(lines, "？？？") end
  end
  p.ui_remove("book")
  p.ui_panel("book", {at: "center", w: 560, h: 330, bg: "#0F172AF2", radius: 22, layer: 30})
  p.ui_text("book_t", "📖 オーラ図鑑 " + found + " / " + total + "（" + floor(found * 100 / total) + "%）", {parent: "book", y: 0.08, size: 18, bold: true, color: "#C4B5FD"})
  for row in 0 to 7 do
    let part = slice(lines, row * 4 + 1, row * 4 + 4)
    if len(part) > 0 then p.ui_text("book_" + row, join(part, "・"), {parent: "book", y: 0.2 + row * 0.085, size: 12, color: "#E5E7EB"}) end
  end
  p.ui_button("book_close", "閉じる", {parent: "book", y: 0.92, w: 120, h: 32, size: 13, bg: "gray"})
  if found >= total then kit_badge(p, "all_auras", "オーラ図鑑をコンプリート") end
end

on tick(dt)
  orbit_clock = orbit_clock + dt
  if orbit_clock < 0.2 then return end
  let secs = orbit_clock
  orbit_clock = 0
  orbit_step(secs)
  for p in players() do
    if ready(p) and p.auto then roll(p) end
  end
end

on button(p, id)
  if not ready(p) then return end
  if id == "roll" then roll(p)
  elif id == "open_inv" then storage_panel(p)
  elif id == "inv_close" then p.ui_remove("inv")
  elif id == "book" then collection_panel(p)
  elif id == "book_close" then p.ui_remove("book")
  elif id == "auto" then
    if not p.has_auto then
      p.message("🔁 オートロールはポーション屋のショップで買える", 1.5)
    else
      p.auto = not p.auto
      p.message("🔁 オートロール " + (p.auto and "ON" or "OFF"), 1)
    end
  elif starts_with(id, "wear_") then
    equip(p, replace(id, "wear_", ""))
    p.ui_remove("inv")
  end
end

on leave(p)
  if p.orbs != nil then
    for o in p.orbs do gone(o) end
  end
end
