-- Tip Jar Plaza — 広場にブースを出して、チップ（ゲーム内のコイン）をおくり合う
--
-- ファイル:
--   data.absc        テーマ・改装・うらない・チップ・NPC
--   common.absc      ブースの記録・近くのブース・チップ入れ・看板
--   activities.absc  テーマごとの遊び（うらない・おかし・演奏・ドット絵・反射神経・ひとこと）
--   booth.absc       ブースを出す・たたむ・看板・改装・ゲストブック・いいね・ボタン
--   plaza.absc       NPCのお店とお客さん・風船・ゴミ・噴水・ステージ・昼と夜
--   tips.absc        チップをおくる・お礼
--   main.absc        このファイル
--
-- ※ チップはこのゲームの中だけのコインです。本物のお金はいっさい使いません。

kit_setup("Tip Jar Plaza", "ブースを出して、なかよくチップ", [
  "🏪 緑のパッドでブースを出す。🔮うらない 🍩おかし 🎵音楽 🎨アート 🎮ゲーム 💬おしゃべり から選べる",
  "💝 ほかのお店の前で「チップ」。金額とひとことをえらんでおくる",
  "❤️ いいね・📒 ひとこと・テーマの遊びで、お店の⭐が上がる。⭐が多いほどお客さんが来る",
  "🛠 もらったチップで改装（ひさし・ライト・植木・ネオン看板・大きなジャー）",
  "🎈 風船・🧹 ゴミひろい・⛲ 噴水・🎤 ステージでもチップがたまる",
  "※ 本物のお金はいっさい使いません"
])
kit_currency = "チップ"

-- セーブ: コイン・クエスト・実績のほかに、つぎも自分のiPadに保存する
kit_keep(["tips_given", "tips_got", "cleaned", "best_rx", "likes_given", "thanks_got"])


kit_quest("booth", "ブースを出す", 1, 20)
kit_quest("give", "チップを5回おくる", 5, 60)
kit_quest("get", "チップを100もらう", 100, 120)
kit_quest("like", "5つのお店にいいね", 5, 40)
kit_quest("note", "ゲストブックに3回書く", 3, 40)
kit_quest("themes", "4種類のお店で遊ぶ", 4, 80)
kit_quest("upgrade", "ブースを3回改装", 3, 100)
kit_quest("balloon", "風船を10こわる", 10, 60)
kit_quest("clean", "ゴミを10こひろう", 10, 60)
kit_quest("perform", "3回パフォーマンスする", 3, 80)
kit_quest("clap", "10回拍手する", 10, 40)
kit_quest("thanks", "お礼を3回おくる", 3, 50)

kit_shop_title = "広場のファッション"
kit_shop_add("cap", "🧢 キャップ", 20, func(p) p.hat = "cap" end)
kit_shop_add("antenna", "📡 アンテナ", 60, func(p) p.hat = "antenna" end)
kit_shop_add("halo", "😇 天使の輪", 150, func(p) p.hat = "halo" end)
kit_shop_add("crown", "👑 広場の王冠", 500, func(p) p.hat = "crown" end)
kit_shop_add("sunny", "🌻 ひまわりの服", 80, func(p)
  p.color = "#FACC15"
  p.leg_color = "#65A30D"
end)
kit_shop_add("night", "🌙 夜空の服", 80, func(p)
  p.color = "#1E3A8A"
  p.leg_color = "#FDE047"
end)
kit_shop_add("scooter", "🛴 キックスクーター", 250, func(p)
  p.ride = "scooter"
  p.ride_color = "#F472B6"
end)

func open_stats(p)
  p.ui_remove("stats")
  p.ui_panel("stats", {at: "center", w: 420, h: 250, bg: "#1C1917F0", radius: 18, layer: 35})
  p.ui_text("stats_t", "📊 " + p.name + " の記録", {parent: "stats", y: 0.12, size: 18, bold: true, color: "gold"})
  let mine = "まだお店はない"
  let key = booth_of(p)
  if key != nil then
    let b = booths[key]
    mine = theme_of(b.theme).name + " " + stars_text(booth_stars(b)) + "  💝" + b.raised + "  ❤️" + b.likes + "  🙋" + b.visits
  end
  let rx = "まだ"
  if p.best_rx != nil then rx = p.best_rx + " ms" end
  let lines = [
    "🏪 " + mine,
    "💝 おくった: " + p.tips_given + "   もらった: " + p.tips_got,
    "❤️ いいねした: " + (p.likes_given or 0) + "   🙏 お礼をもらった: " + (p.thanks_got or 0),
    "🧹 ひろったゴミ: " + (p.cleaned or 0) + "   ⚡ 反射神経: " + rx
  ]
  let i = 0
  for line in lines do
    i = i + 1
    p.ui_text("stats_" + i, line, {parent: "stats", y: 0.2 + i * 0.15, size: 14, color: "#E7E5E4"})
  end
  p.ui_button("stats_close", "閉じる", {parent: "stats", y: 0.9, w: 110, h: 28, size: 13, bg: "gray"})
end

on start()
  every(10, func() kit_leaderboard("💝 もらった") end)
end

on join(p)
  p.tips_given = 0
  p.tips_got = 0
  kit_welcome(p)
  kit_quest_button(p)
  kit_shop_button(p)
  p.ui_button("stats_open", "📊 記録", {at: "right", dy: 180, w: 150, h: 50, size: 17, bg: "#0F766E"})
  kit_give(p, 30)
  p.near = nil
  p.message("🏪 緑のパッドでお店を出そう！ チップはゲームの中だけのコインです", 3)
end

on leave(p)
  let key = booth_of(p)
  if key != nil then close_booth(key) end
end

on button(p, id)
  if id == "stats_open" then
    open_stats(p)
  elif id == "stats_close" then
    p.ui_remove("stats")
  end
end
