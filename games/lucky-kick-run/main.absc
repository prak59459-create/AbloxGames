-- Lucky Kick Run — ラッキーブロックをけって、大津波からにげる
-- ブロック4種・アイテム24種（6段階のめずらしさ）・ハズレ・キックのパワーゲージ・遠いほどレア・
-- 強化5種・転生・津波4種・ラッシュタイム・図鑑。
--
-- ファイル:
--   data.absc     表（ブロック・アイテム・ハズレ・強化・津波）
--   common.absc   画面・消す・待ち時間
--   kick.absc     ける・落ちる・拾う・運ぶ
--   bank.absc     金庫・強化ショップ・転生・図鑑
--   tsunami.absc  津波とラッシュ
--   main.absc     このファイル

kit_setup("Lucky Kick Run", "けって、拾って、運んで、にげろ！", [
  "⚽ 浜辺のラッキーブロックにさわる → ゲージが大きいときに「キック！」",
  "🎁 遠くにとぶほど中身がレア。にじ・ダイヤ・ぎんがブロックはもっとレア",
  "🎒 落ちた所まで走ってアイテムを拾う（重いと足がおそい）",
  "🏦 丘の上の紫の金庫まで運べばお金になる",
  "🌊 津波が来たら、決まった高さより上へ！のまれるとアイテムが流される",
  "🛒 浜辺の水色パッドで強化、♻️ 丘の上で転生（ずっと稼ぎアップ）"
])
kit_currency = "コイン"

kit_quest("kick", "ブロックを10回ける", 10, 50)
kit_quest("bank", "金庫に預ける", 1, 30)
kit_quest("bank10k", "合計1万コイン預ける", 10000, 2000)
kit_quest("index", "10しゅるい集める", 10, 800)
kit_quest("survive", "津波を5回生きのびる", 5, 200)
kit_quest("upgrade", "強化を5回", 5, 300)
kit_quest("snatch", "ほかの人の落とし物を拾う", 1, 50)
kit_quest("rebirth", "転生する", 1, 3000)

on join(p)
  p.carry = []
  p.up = {}
  p.index = []
  p.rebirth = 0
  kit_welcome(p)
  kit_give(p, 20)
  p.ui_button("open_shop", "🛒 強化", {at: "right", dy: -120, w: 140, h: 50, size: 17, bg: "#0369A1"})
  p.ui_button("open_index", "📖 図鑑", {at: "right", dy: -60, w: 140, h: 50, size: 17, bg: "#0F766E"})
  kit_quest_button(p)
  kit_camera_button(p)
  hud(p)
end
