-- kit_obby.absc — オビー（アスレチック）の共通エンジン（Ablox Games）
--
-- ステージの目じるしは、名前が「Stage 1」「Stage 2」…のブロック（地図ではチェックポイント）。
-- さわるとそのステージまで進んだことになり、落ちたらそこからやり直し。
-- いちばん最後は「Finish」ブロック。ゴールするとタイムとコインがもらえる。
-- 進んだステージ・ベストタイム・買ったものは自分の iPad に保存される。
--
--   obby_setup({stages: 40, fall: -12, coins: 5, finish_coins: 150, skip: 40})
--   obby_zones = [{from: 1, last: 10, name: "かんたん", color: "#22C55E"}, …]  -- 区間の名前（なくてもよい）
--   obby_on_stage = func(p, n) … end      -- 新しいステージについた
--   obby_on_finish = func(p, secs) … end  -- ゴール
--   obby_on_back = func(p) … end          -- 落ちてもどった
--   obby_perks_basic()                     -- ショップにスピード・ジャンプ・ふわふわ・キラキラを入れる

let obby_prefix = "Stage"
let obby_stages = 10
let obby_finish_name = "Finish"
let obby_spawn_name = "Spawn 1"
let obby_fall_y = -15
let obby_stage_coins = 5
let obby_finish_coins = 100
let obby_skip_price = 40
let obby_zones = []
let obby_on_stage = nil
let obby_on_finish = nil
let obby_on_back = nil
let obby_board = "obby_time"
let obby_clock = 0
let obby_trail_clock = 0
let obby_perks = []
let obby_hud_dy = 26

kit_keep(["stage", "obby_best", "obby_wins", "obby_best_time", "obby_owned", "obby_falls_total"])

func obby_setup(o)
  if o.stages != nil then obby_stages = o.stages end
  if o.prefix != nil then obby_prefix = o.prefix end
  if o.finish != nil then obby_finish_name = o.finish end
  if o.spawn != nil then obby_spawn_name = o.spawn end
  if o.fall != nil then obby_fall_y = o.fall end
  if o.coins != nil then obby_stage_coins = o.coins end
  if o.finish_coins != nil then obby_finish_coins = o.finish_coins end
  if o.skip != nil then obby_skip_price = o.skip end
  if o.board != nil then obby_board = o.board end
  if o.hud_dy != nil then obby_hud_dy = o.hud_dy end
end

func obby_block(n)
  if n == nil or n <= 0 then return block(obby_spawn_name) end
  return block(obby_prefix + " " + n)
end

func obby_zone(n)
  for z in obby_zones do
    if n >= z.from and n <= z.last then return z end
  end
  return nil
end

func obby_show(p)
  if not kit_here(p) then return end
  let n = p.stage or 0
  let z = obby_zone(max(1, n))
  let label = "🏁 ステージ " + n + " / " + obby_stages
  let color = "#FFFFFF"
  if z != nil then
    label = label + "   " + z.name
    color = z.color
  end
  p.ui_text("obby_stage", label, {at: "top", dy: obby_hud_dy, size: 20, bold: true, color: color})
  p.ui_bar("obby_bar", n, obby_stages, {at: "top", dy: obby_hud_dy + 24, w: 260, h: 8, color: color})
end

-- いまのステージのチェックポイントにもどす
func obby_back(p)
  if not kit_here(p) or not p.alive then return end
  let b = obby_block(p.stage or 0)
  if b == nil then b = obby_block(0) end
  if b != nil then p.teleport(b) end
  p.velocity = {x: 0, y: 0, z: 0}
  p.obby_falls = (p.obby_falls or 0) + 1
  p.obby_falls_total = (p.obby_falls_total or 0) + 1
  if obby_on_back != nil then obby_on_back(p) end
end

func obby_reach(p, n)
  if n <= (p.stage or 0) then return end
  p.stage = n
  if n > (p.obby_best or 0) then
    p.obby_best = n
    kit_give(p, obby_stage_coins)
  end
  p.sound("checkpoint")
  let z = obby_zone(n)
  if z != nil and z.from == n and n > 1 then
    p.message("🚩 " + z.name + " ゾーン！", 2)
    particles("confetti", p, {amount: 30})
  end
  obby_show(p)
  if obby_on_stage != nil then obby_on_stage(p, n) end
end

func obby_finish(p)
  if p.obby_done_at != nil and time() - p.obby_done_at < 8 then return end
  p.obby_done_at = time()
  let secs = time() - (p.obby_started or time())
  p.obby_wins = (p.obby_wins or 0) + 1
  let best = false
  if p.obby_best_time == nil or secs < p.obby_best_time then
    p.obby_best_time = secs
    best = true
  end
  leaderboard(obby_board, p, floor(secs * 10) / 10, {lower: true})
  kit_give(p, obby_finish_coins)
  announce("🏆 " + p.name + " がゴール！ " + kit_clock(secs) + "（" + fixed(secs, 1) + "秒）", 3)
  sound("win")
  particles("confetti", p, {amount: 80})
  let h = 230
  p.ui_panel("obby_done", {at: "center", w: 480, h: h, bg: "#000000D8", radius: 22, layer: 44})
  p.ui_text("obby_done_t", "🏆 ゴール！", {parent: "obby_done", y: 0.16, size: 30, bold: true, color: "gold"})
  let line = "タイム " + fixed(secs, 1) + "秒   落ちた回数 " + (p.obby_falls or 0)
  if best then line = line + "   ⭐ベスト！" end
  p.ui_text("obby_done_1", line, {parent: "obby_done", y: 0.38, size: 17})
  p.ui_text("obby_done_2", "💰 +" + obby_finish_coins + "   ゴール " + p.obby_wins + " 回目", {parent: "obby_done", y: 0.54, size: 16, color: "#FDE68A"})
  p.ui_button("obby_again", "🔁 もう一度（ステージ1から）", {parent: "obby_done", x: 0.5, y: 0.74, w: 330, h: 44, size: 16, bg: "#16A34A"})
  p.ui_button("obby_done_close", "閉じる", {parent: "obby_done", y: 0.91, w: 120, h: 30, size: 14, bg: "gray"})
  if obby_on_finish != nil then obby_on_finish(p, secs) end
end

func obby_restart(p)
  p.stage = 0
  p.obby_started = time()
  p.obby_falls = 0
  p.ui_remove("obby_done")
  let b = obby_block(0)
  if b != nil then p.teleport(b) end
  obby_show(p)
end

func obby_skip(p)
  let n = p.stage or 0
  if n >= obby_stages then
    p.message("もう最後のステージだよ！", 1.5)
    return
  end
  if p.has_item("⏭ スキップ") then
    p.take_item("⏭ スキップ")
  elif not kit_pay(p, obby_skip_price) then
    return
  end
  obby_reach(p, n + 1)
  let b = obby_block(n + 1)
  if b != nil then p.teleport(b) end
end

-- 行ったことのあるステージへ（区間の最初か、5ステージごと）
func obby_open_select(p)
  let marks = []
  if len(obby_zones) > 0 then
    for z in obby_zones do
      if z.from <= (p.obby_best or 0) or z.from == 1 then append(marks, {n: z.from, label: z.name}) end
    end
  else
    let k = 1
    while k <= obby_stages do
      if k <= max(1, p.obby_best or 0) then append(marks, {n: k, label: "ステージ " + k}) end
      k = k + 5
    end
  end
  let rows = ceil(len(marks) / 2)
  let h = 120 + rows * 50
  p.ui_remove("obby_sel")
  p.ui_panel("obby_sel", {at: "center", w: 520, h: h, bg: "#0F172AF0", radius: 20, layer: 46})
  p.ui_text("obby_sel_t", "📋 ステージをえらぶ（最高 " + (p.obby_best or 0) + "）", {parent: "obby_sel", y: 30 / h, size: 19, bold: true, color: "gold"})
  let i = 0
  for m in marks do
    let col = i % 2
    let row = floor(i / 2)
    p.ui_button("obby_go_" + m.n, m.label + "（" + m.n + "）", {parent: "obby_sel", x: 0.27 + col * 0.46, y: (78 + row * 50) / h,
                w: 220, h: 42, size: 14, bg: "#1D4ED8"})
    i = i + 1
  end
  p.ui_button("obby_sel_close", "閉じる", {parent: "obby_sel", y: (h - 26) / h, w: 120, h: 34, size: 14, bg: "gray"})
end

func obby_go(p, n)
  p.ui_remove("obby_sel")
  if n > max(1, p.obby_best or 0) then return end
  p.stage = n
  let b = obby_block(n)
  if b != nil then p.teleport(b) end
  obby_show(p)
end

-- MARK: ショップの定番（スピード・ジャンプ・ふわふわ・キラキラ）

func obby_owns(p, id)
  return p.obby_owned != nil and contains(p.obby_owned, id)
end

func obby_apply_perks(p)
  if not kit_here(p) then return end
  let s = 1
  let j = 1
  let g = 1
  if obby_owns(p, "speed") and p.obby_perk_off != true then s = 1.3 end
  if obby_owns(p, "jump") and p.obby_perk_off != true then j = 1.25 end
  if obby_owns(p, "float") and p.obby_perk_off != true then g = 0.75 end
  -- ゲームが自分の倍率をかけられる（コイル・ポーション・乗り物など）
  if p.obby_speed_mult != nil then s = s * p.obby_speed_mult end
  if p.obby_jump_mult != nil then j = j * p.obby_jump_mult end
  if p.obby_gravity_mult != nil then g = g * p.obby_gravity_mult end
  if p.speed != s then p.speed = s end
  if p.jump != j then p.jump = j end
  if p.gravity != g then p.gravity = g end
end

func obby_perk_buy(p, id)
  if p.obby_owned == nil then p.obby_owned = [] end
  if not contains(p.obby_owned, id) then append(p.obby_owned, id) end
  obby_apply_perks(p)
end

func obby_perks_basic()
  kit_shop_add("obby_speed", "👟 スピードくつ（ずっと 1.3ばい）", 400, func(p) obby_perk_buy(p, "speed") end)
  kit_shop_add("obby_jump", "🦘 ジャンプぐつ（ずっと 1.25ばい）", 500, func(p) obby_perk_buy(p, "jump") end)
  kit_shop_add("obby_float", "🎈 ふわふわ（重力 0.75）", 600, func(p) obby_perk_buy(p, "float") end)
  kit_shop_add("obby_trail", "✨ キラキラのあしあと", 250, func(p) obby_perk_buy(p, "trail") end)
  kit_shop_add("obby_skip", "⏭ スキップ券 1まい", obby_skip_price, func(p) p.give_item("⏭ スキップ", 1, "⏭") end)
end

-- MARK: イベント

on join(p)
  p.stage = 0
  p.obby_started = time()
  p.obby_falls = 0
  obby_show(p)
  p.ui_button("obby_back", "↩", {at: "bottom_right", dx: -24, dy: -250, w: 56, h: 56, size: 24, bg: "#00000099", radius: 28})
  if obby_skip_price > 0 then
    p.ui_button("obby_skip", "⏭ " + obby_skip_price, {at: "bottom_right", dx: -24, dy: -314, w: 86, h: 44, size: 15, bg: "#7C3AED", radius: 16})
  end
  p.ui_button("obby_select", "📋", {at: "top_right", dy: 180, w: 52, h: 52, size: 22, bg: "#00000099", radius: 26})
  obby_apply_perks(p)
end

-- 保存してあったステージからつづき
on loaded(p)
  kit_later(p, 0.3, func()
    obby_apply_perks(p)
    if (p.stage or 0) > obby_stages then p.stage = obby_stages end
    if (p.stage or 0) > 0 then
      let b = obby_block(p.stage)
      if b != nil then p.teleport(b) end
      p.message("💾 ステージ " + p.stage + " からつづき", 2)
    end
    obby_show(p)
  end)
end

on touch(p, b)
  if p.is_npc then return end
  let name = b.name
  if starts_with(name, obby_prefix + " ") then
    let n = num(replace(name, obby_prefix + " ", ""))
    if n != nil then obby_reach(p, n) end
  elif name == obby_finish_name then
    obby_finish(p)
  end
end

on tick(dt)
  obby_clock = obby_clock + dt
  obby_trail_clock = obby_trail_clock + dt
  if obby_clock >= 0.2 then
    obby_clock = 0
    for p in players() do
      if p.alive and p.y < obby_fall_y then obby_back(p) end
    end
  end
  if obby_trail_clock >= 0.7 then
    obby_trail_clock = 0
    for p in players() do
      if p.alive and obby_owns(p, "trail") then particles("sparkles", p, {amount: 5}) end
    end
  end
end

on button(p, id)
  if id == "obby_back" then
    if kit_ready(p, "obby_back", 1) then obby_back(p) end
  elif id == "obby_skip" then
    obby_skip(p)
  elif id == "obby_select" then
    obby_open_select(p)
  elif id == "obby_sel_close" then
    p.ui_remove("obby_sel")
  elif starts_with(id, "obby_go_") then
    obby_go(p, num(replace(id, "obby_go_", "")) or 1)
  elif id == "obby_again" then
    obby_restart(p)
  elif id == "obby_done_close" then
    p.ui_remove("obby_done")
  end
end

on use(p, item)
  if item == "⏭ スキップ" then obby_skip(p) end
end
